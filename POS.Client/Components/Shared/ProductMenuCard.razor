@namespace POS.Client.Components.Shared
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using POS.Shared.Models
@using POS.Shared.Helpers

<button type="button"
        class="product-card @(CartQuantity > 0 ? "in-cart" : "") @(ShowImage ? "has-image" : "text-only") @(HasValidImage ? "with-photo" : "no-photo")"
        style="--category-color: @CategoryColor;"
        title="@Product.Name"
        @onclick="OnSelect">
    @if (ShowImage)
    {
        <div class="product-media-container" aria-hidden="true">
            @if (HasValidImage)
            {
                <img src="@imageSource"
                     alt=""
                     class="product-image"
                     loading="lazy"
                     decoding="async"
                     @onerror="() => imageFailed = true" />
            }
            else
            {
                <div class="product-placeholder">
                    <i class="bi bi-image placeholder-icon"></i>
                </div>
            }
        </div>
        <div class="product-label-overlay">
            <span class="product-name">@Product.Name</span>
        </div>
    }
    else
    {
        <span class="product-name">@Product.Name</span>
    }

    @if (CartQuantity > 0)
    {
        var qtyLabel = CartItem.FormatProductCardQuantity(CartQuantity, Product.PricingMethod);
        <span class="product-qty" aria-label="@qtyLabel in order" title="@qtyLabel in order">@qtyLabel</span>
    }
</button>

@code {
    [Parameter, EditorRequired] public ProductDto Product { get; set; } = null!;
    [Parameter] public MenuDisplayMode DisplayMode { get; set; }
    [Parameter] public string CategoryColor { get; set; } = "#334155";
    [Parameter] public decimal CartQuantity { get; set; }
    [Parameter] public Uri? ApiBaseAddress { get; set; }
    [Parameter] public EventCallback OnSelect { get; set; }
    private bool ShowImage => DisplayMode == MenuDisplayMode.ImageAndText;
    private bool HasValidImage => ShowImage && !string.IsNullOrWhiteSpace(imageSource) && !imageFailed;
    private string? imageSource;
    private bool imageFailed;

    protected override void OnParametersSet()
    {
        string? source = null;
        if (ShowImage && !string.IsNullOrWhiteSpace(Product.ImageUrl))
        {
            var resolved = ProductImageUrl.Resolve(Product.ImageUrl, ApiBaseAddress?.ToString());
            if (!string.IsNullOrWhiteSpace(resolved))
            {
                source = resolved;
            }
            else
            {
                Uri? uri;
                if (ApiBaseAddress != null
                    ? Uri.TryCreate(ApiBaseAddress, Product.ImageUrl, out uri)
                    : Uri.TryCreate(Product.ImageUrl, UriKind.Absolute, out uri))
                {
                    if (uri?.Scheme is "http" or "https") source = uri.AbsoluteUri;
                }
            }
        }
        if (source != imageSource) imageFailed = false;
        imageSource = source;
    }
}
