@page "/new-sale"
@inject PosSessionService Session
@inject NavigationManager Navigation
@inject ICategoryService CategoryService
@inject IProductService ProductService
@inject CartService Cart
@inject HttpClient Http
@inject SweetAlertService Swal
@implements IDisposable

@if (!Session.IsAuthenticated)
{
    <div class="pos-loading-screen">
        <div class="spinner-border text-primary" role="status"></div>
        <span class="ms-2 text-muted">Redirecting to login...</span>
    </div>
}
else if (!IsSupported)
{
    <div class="sale-unavailable alert alert-warning" role="alert">
        <h4>New Sale unavailable</h4>
        @if (Session.Outlet?.BusinessTypeId == null || string.IsNullOrWhiteSpace(Session.Outlet.BusinessType))
        {
            <p>The branch business type is not configured. Contact an administrator.</p>
        }
        else
        {
            <p>Business type @Session.Outlet.BusinessType is not supported for New Sale. Contact an administrator.</p>
        }
    </div>
}
else
{
    <div class="new-sale-container">
        <!-- Left: Product Catalog & Search -->
        <div class="catalog-section">
            <!-- Top Search Bar -->
            <div class="search-bar-wrap mb-3">
                <div class="position-relative">
                    <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" @ref="searchInput" aria-label="Search item or scan barcode"
                           autocomplete="off" disabled="@(isLoading || quantityDialogOpen)"
                           @onkeydown="OnSearchKeyDown"
                           class="form-control form-control-lg search-input ps-5 pe-5"
                           placeholder="Search products by name, SKU, or barcode..."
                           value="@searchQuery"
                           @oninput="OnSearchInput" />
                    @if (!string.IsNullOrEmpty(searchQuery))
                    {
                        <button type="button" class="btn btn-link clear-search-btn" @onclick="ClearSearch" title="Clear search">
                            ✕
                        </button>
                    }
                </div>
            </div>

            @if (IsRetail)
            {
                <p class="small text-muted">Search an item or scan its barcode, then press Enter.</p>
                @if (!string.IsNullOrEmpty(scanError))
                {
                    <div class="scan-error alert alert-danger" role="alert">@scanError</div>
                }
                <div class="retail-results products-grid-scroll">
                    @if (isLoading)
                    {
                        <p>Loading catalog...</p>
                    }
                    else if (string.IsNullOrWhiteSpace(searchQuery))
                    {
                        <p class="text-muted">Search or scan to find an item.</p>
                    }
                    else if (!FilteredProducts.Any())
                    {
                        <p>No matching items.</p>
                    }
                    @foreach (var product in FilteredProducts)
                    {
                        <button type="button" class="retail-result" disabled="@quantityDialogOpen"
                                @onclick="() => ChooseQuantity(product)">
                            <span><strong>@product.Name</strong><small>@product.SKU · @product.Barcode</small></span>
                            <span>₱@product.Price.ToString("N2")</span>
                        </button>
                    }
                </div>
            }
            else
            {
            <!-- Categories Bar -->
            <div class="categories-bar mb-3">
                <button type="button"
                        class="category-pill @(selectedCategoryId == null ? "active" : "")"
                        @onclick="() => SelectCategory(null)">
                    All Categories
                </button>
                @foreach (var cat in categories)
                {
                    <button type="button"
                            class="category-pill @(selectedCategoryId == cat.CategoryId ? "active" : "")"
                            @onclick="() => SelectCategory(cat.CategoryId)">
                        @cat.Name
                    </button>
                }
            </div>

            <!-- Products Grid Area -->
            <div class="products-grid-scroll">
                @if (isLoading)
                {
                    <div class="text-center py-5 text-muted">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-2 small">Loading catalog...</p>
                    </div>
                }
                else if (!FilteredProducts.Any())
                {
                    <div class="empty-products text-center py-5">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-secondary mb-2">
                            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                            <line x1="8" y1="21" x2="16" y2="21"></line>
                            <line x1="12" y1="17" x2="12" y2="21"></line>
                        </svg>
                        <h6 class="fw-bold text-dark mb-1">No products found</h6>
                        <p class="text-muted small">Try a different category or search keyword.</p>
                    </div>
                }
                else
                {
                    <div class="products-grid">
                        @foreach (var product in FilteredProducts)
                        {
                            <div class="product-card" @onclick="() => AddToCart(product)" role="button" tabindex="0">
                                <div class="product-img-wrap">
                                    @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                    {
                                        <img src="@GetImageUrl(product.ImageUrl)"
                                             alt="@product.Name"
                                             class="product-img"
                                             loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="product-placeholder-icon">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                                                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                                                <line x1="12" y1="22.08" x2="12" y2="12"></line>
                                            </svg>
                                        </div>
                                    }
                                </div>
                                <div class="product-info">
                                    <div class="product-name" title="@product.Name">@product.Name</div>
                                    <div class="product-bottom">
                                        <span class="product-price">₱@product.Price.ToString("N2")</span>
                                        @if (!string.IsNullOrEmpty(product.UnitOfMeasure))
                                        {
                                            <span class="product-uom">@product.UnitOfMeasure</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
            }
        </div>

        <!-- Right: Current Order Cart -->
        <div class="order-section">
            <div class="order-card shadow-sm">
                <!-- Order Header -->
                <div class="order-header d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-0 text-dark">Current Order</h5>
                        <small class="text-muted">@Cart.TotalItems @(Cart.TotalItems == 1 ? "item" : "items")</small>
                    </div>
                    @if (Cart.Items.Any())
                    {
                        <button type="button" class="btn btn-outline-danger btn-sm clear-cart-btn" @onclick="ClearCart" title="Clear all items">
                            Clear
                        </button>
                    }
                </div>

                <!-- Cart Items List -->
                <div class="order-items-scroll">
                    @if (!Cart.Items.Any())
                    {
                        <div class="empty-cart text-center py-5">
                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-muted mb-2">
                                <circle cx="9" cy="21" r="1"></circle>
                                <circle cx="20" cy="21" r="1"></circle>
                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                            </svg>
                            <p class="text-muted fw-medium mb-1">Your cart is empty</p>
                            <small class="text-secondary">Tap any product on the left to add items</small>
                        </div>
                    }
                    else
                    {
                        <div class="cart-items-list">
                            @foreach (var item in Cart.Items)
                            {
                                <div class="cart-item-row">
                                    <div class="cart-item-info">
                                        <div class="cart-item-name" title="@item.ProductName">@item.ProductName</div>
                                        <div class="cart-item-unit-price text-muted">₱@item.Price.ToString("N2") each</div>
                                    </div>
                                    <div class="cart-item-actions d-flex align-items-center gap-2">
                                        <div class="qty-control d-flex align-items-center">
                                            <button type="button" class="qty-btn" @onclick="() => Cart.DecreaseQuantity(item.ProductId)" title="Decrease">
                                                −
                                            </button>
                                            <span class="qty-display">@item.Quantity</span>
                                            <button type="button" class="qty-btn" @onclick="() => Cart.IncreaseQuantity(item.ProductId)" title="Increase">
                                                +
                                            </button>
                                        </div>
                                        <div class="cart-item-total">
                                            ₱@item.LineTotal.ToString("N2")
                                        </div>
                                        <button type="button" class="btn-remove-item" @onclick="() => Cart.RemoveItem(item.ProductId)" title="Remove item">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <polyline points="3 6 5 6 21 6"></polyline>
                                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Order Summary & Checkout -->
                <div class="order-footer">
                    <div class="order-totals">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Subtotal</span>
                            <span class="fw-semibold">₱@Cart.Subtotal.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-baseline mb-3">
                            <span class="fw-bold fs-5 text-dark">Total</span>
                            <span class="fw-bolder fs-4 text-primary">₱@Cart.Total.ToString("N2")</span>
                        </div>
                    </div>
                    <button type="button"
                            class="btn btn-primary w-100 py-3 fw-bold btn-proceed-payment"
                            disabled="@(!Cart.Items.Any())"
                            @onclick="ProceedToPayment">
                        Proceed to Payment
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<CategoryDto> categories = new();
    private List<ProductDto> products = new();
    private int? selectedCategoryId = null;
    private string searchQuery = string.Empty;
    private bool isLoading = true;
    private bool IsRetail => Session.Outlet?.BusinessTypeId != null && Session.Outlet.BusinessType == "RETAIL";
    private bool IsSupported => IsRetail || (Session.Outlet?.BusinessTypeId != null && Session.Outlet.BusinessType == "FNB");
    private ElementReference searchInput;
    private bool restoreSearchFocus;
    private bool quantityDialogOpen;
    private string? scanError;
    private bool disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (restoreSearchFocus && !disposed && Session.IsAuthenticated && IsRetail && !isLoading && !quantityDialogOpen)
        {
            restoreSearchFocus = false;
            await searchInput.FocusAsync();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        Cart.OnChange += OnCartChanged;
        if (IsSupported) await LoadCatalogAsync();
        restoreSearchFocus = IsRetail;
    }

    private void OnCartChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        disposed = true;
        Cart.OnChange -= OnCartChanged;
    }

    private async Task LoadCatalogAsync()
    {
        isLoading = true;
        try
        {
            var catTask = IsRetail ? Task.FromResult(new List<CategoryDto>()) : CategoryService.GetCategoriesAsync();
            var prodTask = ProductService.GetProductsAsync();
            await Task.WhenAll(catTask, prodTask);

            categories = (await catTask).Where(c => !c.IsDeleted && c.IsActive).ToList();
            products = (await prodTask).Where(p => p.IsActive).ToList();
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error Loading Catalog",
                Text = ex.Message,
                Icon = SweetAlertIcon.Error
            });
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<ProductDto> FilteredProducts
    {
        get
        {
            if (IsRetail && string.IsNullOrWhiteSpace(searchQuery)) return Enumerable.Empty<ProductDto>();
            var query = products.AsEnumerable();

            if (selectedCategoryId.HasValue)
            {
                query = query.Where(p => p.CategoryId == selectedCategoryId.Value);
            }

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var q = searchQuery.Trim();
                query = query.Where(p =>
                    (p.Name != null && p.Name.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                    (p.SKU != null && p.SKU.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                    (p.Barcode != null && p.Barcode.Contains(q, StringComparison.OrdinalIgnoreCase)));
            }

            return query;
        }
    }

    private void SelectCategory(int? categoryId)
    {
        selectedCategoryId = categoryId;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        if (quantityDialogOpen) return;
        scanError = null;
        searchQuery = e.Value?.ToString() ?? string.Empty;
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (!IsRetail || isLoading || quantityDialogOpen || e.Key != "Enter" || e.Repeat) return;
        if (string.IsNullOrEmpty(searchQuery)) return;
        scanError = null;
        // Barcode identifiers are strings: exact match only, including leading zeros.
        var matches = products.Where(p => string.Equals(p.Barcode, searchQuery, StringComparison.Ordinal)).Take(2).ToList();
        if (matches.Count == 1) await ChooseQuantity(matches[0]);
        else
        {
            scanError = matches.Count == 0 ? "No product has this barcode." : "Multiple products have this barcode. Contact an administrator.";
            searchQuery = string.Empty;
            restoreSearchFocus = true;
        }
    }

    private async Task ChooseQuantity(ProductDto product)
    {
        if (quantityDialogOpen || disposed || !Session.IsAuthenticated) return;
        quantityDialogOpen = true;
        try
        {
            var result = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Quantity",
                Text = product.Name,
                Input = SweetAlertInputType.Text,
                InputLabel = "Quantity",
                InputValue = "1",
                ShowCancelButton = true,
                ConfirmButtonText = "Add to cart",
                ReturnFocus = false,
                InputAutoTrim = false,
                InputAttributes = new Dictionary<string, string> { ["inputmode"] = "numeric", ["autocomplete"] = "off" },
                InputValidator = new InputValidatorCallback(value => ValidQuantity(value, out _)
                    ? string.Empty : "Enter a positive whole number that fits the current order.")
            });
            if (result.IsConfirmed && ValidQuantity(result.Value, out var quantity))
                Cart.AddItem(product, quantity);
        }
        finally
        {
            quantityDialogOpen = false;
            searchQuery = string.Empty;
            restoreSearchFocus = true;
        }
    }

    private bool ValidQuantity(string? value, out int quantity) =>
        int.TryParse(value, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out quantity)
        && quantity > 0 && quantity <= int.MaxValue - Cart.TotalItems;

    private void ClearSearch()
    {
        searchQuery = string.Empty;
        scanError = null;
        restoreSearchFocus = true;
    }

    private void AddToCart(ProductDto product)
    {
        Cart.AddItem(product);
    }

    private async Task ClearCart()
    {
        var result = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Clear Current Order?",
            Text = "This will remove all items from the cart.",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Yes, clear",
            ConfirmButtonColor = "#dc2626"
        });

        if (result.IsConfirmed)
        {
            Cart.Clear();
        }
    }

    private async Task ProceedToPayment()
    {
        if (!Cart.Items.Any()) return;

        await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Proceed to Payment",
            Html = $"<p class='mb-2'>Ready to accept payment for <strong>{Cart.TotalItems}</strong> items.</p><h3 class='fw-bold text-primary mt-2'>₱{Cart.Total:N2}</h3>",
            Icon = SweetAlertIcon.Info,
            ConfirmButtonText = "Ready for Payment",
            ConfirmButtonColor = "#2563eb"
        });
        StateHasChanged();
    }

    private string GetImageUrl(string? rawUrl)
    {
        if (string.IsNullOrWhiteSpace(rawUrl)) return string.Empty;
        if (rawUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            rawUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return rawUrl;
        }

        var baseUrl = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";
        return $"{baseUrl}/{rawUrl.TrimStart('/')}";
    }
}
