                                                <input type="text" class="form-control form-control-sm" @bind="customerName" @bind:event="oninput" placeholder="Walk-in / Company name" />
                                            </div>
                                            <div class="col-12">
                                                <label class="form-label mb-0 text-muted" style="font-size: 0.7rem;">Billing Address</label>
                                                <input type="text" class="form-control form-control-sm" @bind="customerAddress" @bind:event="oninput" placeholder="Customer address" />
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label mb-0 text-muted" style="font-size: 0.7rem;">TIN</label>
                                                <input type="text" class="form-control form-control-sm" @bind="customerTin" @bind:event="oninput" placeholder="000-000-000-000" />
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label mb-0 text-muted" style="font-size: 0.7rem;">Business Style</label>
                                                <input type="text" class="form-control form-control-sm" @bind="customerBusinessStyle" @bind:event="oninput" placeholder="e.g. Retail" />
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- RIGHT COLUMN: Tender Action Panel -->
                        <div class="pos-payment-right-col">
                            @if (isSplitPaymentMode)
                            {
                                var remaining = currentOrderResponse.TotalAmount - paymentSplits.Sum(s => s.Amount);
                                @if (remaining > 0.01m)
                                {
                                    <div class="pos-action-panel">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <label class="pos-section-label mb-0">ADD SPLIT PAYMENT</label>
                                            <span class="badge bg-primary bg-opacity-10 text-primary fw-semibold" style="font-size: 0.75rem;">
                                                Due: ₱@remaining.ToString("N2")
                                            </span>
                                        </div>

                                        <!-- Split Method Selector -->
                                        <div class="row g-1 mb-3">
                                            @foreach (var pm in (paymentMethods.Any() ? paymentMethods : new List<PaymentMethodDto> { new() { Code = "CASH", Name = "Cash", RequiresReference = false } }))
                                            {
                                                var isSelected = currentSplitMethod?.Code == pm.Code;
                                                <div class="col-6">
                                                    <button type="button" class="btn btn-sm w-100 py-2 d-flex align-items-center justify-content-center gap-2 fw-semibold @(isSelected ? "btn-primary" : "btn-outline-secondary")"
