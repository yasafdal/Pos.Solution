        if (paymentShift != null && paymentShift.CashierId != Session.Username)
        {
            await Swal.FireAsync("Drawer unavailable", "This drawer belongs to another cashier.", SweetAlertIcon.Warning); return false;
        }
        if (!offline && paymentShift?.ShiftId < 0)
        {
            paymentShift = await POS.Client.Services.ShiftSession.OpenAsync(Http, new OpenShiftDto { TerminalId = paymentShift.TerminalId, BranchId = paymentShift.BranchId, OpeningFloat = paymentShift.OpeningFloat, ClientShiftId = paymentShift.ClientShiftId, OpenedAt = paymentShift.OpenedAt }, Session.Username!, false);
        }
        if (paymentShift != null && paymentShift.Status != "OPEN")
            throw new InvalidOperationException("The acknowledged shift is closed. Reconcile the drawer in My Shift before opening a new shift.");
        if (paymentShift == null || !paymentShift.OpeningConfirmed)
        {
            openingFloatText = string.Empty; openingError = null; openingShiftModal = true; return false;
        }
        if (paymentShift.CashierId != Session.Username)
        {
            await Swal.FireAsync("Drawer unavailable", "This drawer belongs to another cashier. Close that shift before opening your own.", SweetAlertIcon.Warning); return false;
        }
        return true;
    }

    private async Task ConfirmOpeningFloat()
    {
        if (openingBusy || isProcessingPayment || !openingShiftModal) return;
        if (!TryParseCashAmount(openingFloatText, out var amount))
        {
            openingError = "Enter opening cash from 0 to 9999999999999999.99 using up to two decimal places.";
            return;
        }
        openingBusy = true;
        openingOpenedAt ??= DateTime.UtcNow;
        openingError = null;
        try
        {
            var state = await ConnectivityService.CheckConnectivityAsync();
            paymentShift = await POS.Client.Services.ShiftSession.OpenAsync(Http, new OpenShiftDto { TerminalId = Session.Terminal!.TerminalId, BranchId = Session.Terminal.BranchId, OpeningFloat = amount, ClientShiftId = openingId, OpenedAt = openingOpenedAt }, Session.Username!, state != TerminalConnectivityState.OnlineAndHealthy);
            if (paymentShift.Status != "OPEN")
                throw new InvalidOperationException("This opening acknowledgement is for a closed shift. Reconcile the drawer in My Shift before starting another sale.");
            openingShiftModal = false;
            openingId = Guid.NewGuid().ToString("N");
            openingOpenedAt = null;
        }
        catch (Exception ex) { openingError = $"Unable to confirm opening cash. Your cart is preserved. Retry with the original amount or reconcile the drawer in My Shift. {ex.Message}"; }
        finally { openingBusy = false; }
        if (!openingShiftModal) await ProceedToPayment();
    }

    private async Task ProceedToPayment()
    {
        if (isProcessingPayment || openingBusy || openingShiftModal || isPaymentModalOpen || !Cart.Items.Any()) return;
        isProcessingPayment = true;
        paymentError = null;
        try
        {
            if (!await VerifyPaymentShift()) return;
            var createDto = new OrderCreateDto
            {
                BranchId = Session.Terminal?.BranchId ?? 1,
                OutletId = Session.Terminal?.OutletId ?? 1,
                TerminalId = Session.Terminal?.TerminalId ?? 1,
                CashierId = Session.Username ?? "cashier",
                OrderType = IsRetail ? "RETAIL" : selectedServiceMode,
                TableNumber = string.IsNullOrWhiteSpace(tableNumber) ? null : tableNumber.Trim(),
                HeadCount = headCount > 0 ? headCount : (int?)null,
                DiscountAmount = Cart.ActiveDiscountAmount,
                DiscountCode = Cart.ActiveDiscountCode != "NONE" ? Cart.ActiveDiscountCode : null,
                CustomerCardNumber = Cart.CustomerCardNumber,
                CustomerName = string.IsNullOrWhiteSpace(customerName) ? null : customerName.Trim(),
                CustomerAddress = string.IsNullOrWhiteSpace(customerAddress) ? null : customerAddress.Trim(),
                CustomerTin = string.IsNullOrWhiteSpace(customerTin) ? null : customerTin.Trim(),
                CustomerBusinessStyle = string.IsNullOrWhiteSpace(customerBusinessStyle) ? null : customerBusinessStyle.Trim(),
                Items = Cart.Items.Select(ci => new OrderItemCreateDto
                {
                    ProductId = ci.ProductId,
                    ProductName = ci.ProductName,
                    ProductShortCode = ci.ProductShortCode,
                    Quantity = ci.Quantity,
                    BasePrice = ci.BasePrice,
                    TaxName = ci.TaxName ?? "VATable",
                    IsKitchenItem = ci.IsKitchenItem,
                    IsBarItem = ci.IsBarItem,
                    Modifiers = ci.SelectedModifiers?.Select(m => new OrderItemModifierCreateDto
                    {
                        ModifierOptionId = m.ModifierOptionId,
                        ModifierName = m.Name,
                        AdditionalPrice = m.Price
                    }).ToList() ?? new()
                }).ToList()
            };

            var connectivityState = await ConnectivityService.CheckConnectivityAsync();
            isOffline = connectivityState != TerminalConnectivityState.OnlineAndHealthy;

            OrderResponseDto? order = null;
            if (!isOffline)
            {
                try
                {
                    order = await OrderService.CreateOrderAsync(createDto);
                }
                catch
                {
                    // If order creation fails due to sudden network drop, fall back to offline checkout
                    isOffline = true;
                }
            }

            if (isOffline)
            {
                var calcReq = new OrderCalculationRequestDto
                {
                    BranchTaxType = "VAT-Registered",
                    DiscountCode = createDto.DiscountCode ?? "NONE",
                    Items = createDto.Items.Select(i => new CartItemCalculationDto
                    {
                        ProductId = i.ProductId,
                        ProductName = i.ProductName ?? "Product",
                        Quantity = i.Quantity,
                        UnitPrice = i.BasePrice,
                        ModifierTotal = i.Modifiers?.Sum(m => m.AdditionalPrice) ?? 0m,
                        TaxName = i.TaxName ?? "VATable",
                        IsEligibleForStatutoryDiscount = true
                    }).ToList()
                };
                var calcRes = new POS.Shared.Services.LocalDiscountCalculationService().CalculateOrder(calcReq);

                // In offline mode, fabricate OrderResponseDto locally from cart to allow payment dialog
                order = new OrderResponseDto
                {
                    OrderId = DateTime.UtcNow.Ticks,
                    OrderNumber = "OFFLINE-PENDING",
                    BranchId = createDto.BranchId,
                    TerminalId = createDto.TerminalId,
                    CashierId = createDto.CashierId,
                    OrderType = createDto.OrderType,
                    OrderStatus = "PENDING",
                    PaymentStatus = "UNPAID",
                    Subtotal = calcRes.Subtotal,
                    DiscountAmount = calcRes.DiscountAmount,
                    VatableSales = calcRes.VatableSales,
                    VatExemptSales = calcRes.VatExemptSales,
                    ZeroRatedSales = calcRes.ZeroRatedSales,
                    VatAmount = calcRes.VatAmount,
                    TotalAmount = calcRes.TotalAmount,
                    CreatedAt = DateTime.UtcNow
                };

                if (!paymentMethods.Any(pm => pm.Code == "CASH"))
                {
                    paymentMethods = new List<PaymentMethodDto>
                    {
                        new PaymentMethodDto { Code = "CASH", Name = "Cash", IsActive = true }
                    };
                }
            }

            if (order == null)
            {
                paymentError = "Failed to create order on server.";
                await Swal.FireAsync("Error", paymentError, SweetAlertIcon.Error);
                return;
            }

            currentOrderResponse = order;
            cashTendered = order.TotalAmount;
            referenceNumber = string.Empty;
            if (paymentMethods.Any())
            {
                selectedPaymentMethod = paymentMethods.FirstOrDefault(pm => pm.Code == "CASH") ?? paymentMethods.First();
            }
            isPaymentModalOpen = true;
        }
        catch (Exception ex)
        {
            paymentError = $"Unable to prepare payment. Your cart is preserved. Check the drawer in My Shift and retry. {ex.Message}";
            await Swal.FireAsync("Payment unavailable", paymentError, SweetAlertIcon.Error);
        }
        finally
        {
            isProcessingPayment = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmPayment()
    {
        if (isProcessingPayment || openingBusy || openingShiftModal || currentOrderResponse == null) return;
        isProcessingPayment = true;
        paymentError = null;
        try
        {
            if (!await VerifyPaymentShift()) { isPaymentModalOpen = false; return; }

            PaymentProcessDto processDto;

            if (isSplitPaymentMode)
            {
                if (!paymentSplits.Any())
                {
                    paymentError = "Please add at least one payment split.";
                    return;
                }
                decimal totalSplits = paymentSplits.Sum(s => s.Amount);
                if (Math.Abs(totalSplits - currentOrderResponse.TotalAmount) > 0.01m)
                {
                    paymentError = $"Total split payments (₱{totalSplits:N2}) must equal order total (₱{currentOrderResponse.TotalAmount:N2}).";
                    return;
                }

                processDto = new PaymentProcessDto
                {
                    OrderId = currentOrderResponse.OrderId,
                    ProcessedBy = Session.Username ?? "cashier",
                    Splits = paymentSplits,
                    CustomerName = string.IsNullOrWhiteSpace(customerName) ? null : customerName.Trim(),
                    CustomerAddress = string.IsNullOrWhiteSpace(customerAddress) ? null : customerAddress.Trim(),
                    CustomerTin = string.IsNullOrWhiteSpace(customerTin) ? null : customerTin.Trim(),
                    CustomerBusinessStyle = string.IsNullOrWhiteSpace(customerBusinessStyle) ? null : customerBusinessStyle.Trim()
                };
            }
            else
            {
                if (selectedPaymentMethod == null) return;
                string methodCode = selectedPaymentMethod.Code;
                if (methodCode == "CASH" && cashTendered < currentOrderResponse.TotalAmount)
                {
                    paymentError = $"Amount tendered (₱{cashTendered:N2}) is less than total amount (₱{currentOrderResponse.TotalAmount:N2}).";
                    return;
                }

                if (selectedPaymentMethod.RequiresReference && string.IsNullOrWhiteSpace(referenceNumber))
                {
                    paymentError = $"Reference number / approval code is required for {selectedPaymentMethod.Name}.";
                    return;
                }

                processDto = new PaymentProcessDto
                {
                    OrderId = currentOrderResponse.OrderId,
                    PaymentMethod = methodCode,
                    Amount = currentOrderResponse.TotalAmount,
                    AmountTendered = methodCode == "CASH" ? cashTendered : currentOrderResponse.TotalAmount,
                    ReferenceNumber = string.IsNullOrWhiteSpace(referenceNumber) ? null : referenceNumber.Trim(),
                    ProcessedBy = Session.Username ?? "cashier",
                    CustomerName = string.IsNullOrWhiteSpace(customerName) ? null : customerName.Trim(),
                    CustomerAddress = string.IsNullOrWhiteSpace(customerAddress) ? null : customerAddress.Trim(),
                    CustomerTin = string.IsNullOrWhiteSpace(customerTin) ? null : customerTin.Trim(),
                    CustomerBusinessStyle = string.IsNullOrWhiteSpace(customerBusinessStyle) ? null : customerBusinessStyle.Trim()
                };
            }

            processDto.ShiftId = paymentShift?.ShiftId;
            if (isOffline)
            {
                // Process offline cash checkout locally
                if (selectedPaymentMethod?.Code != "CASH")
                {
                    paymentError = "Only Cash payments are allowed in Offline Mode.";
                    return;
                }

                var offlineCreateDto = new OrderCreateDto
                {
                    ShiftId = paymentShift?.ShiftId,
                    ClientShiftId = paymentShift?.ClientShiftId,
                    BranchId = Session.Terminal?.BranchId ?? 1,
                    OutletId = Session.Terminal?.OutletId ?? 1,
                    TerminalId = Session.Terminal?.TerminalId ?? 1,
                    CashierId = Session.Username ?? "cashier",
                    OrderType = IsRetail ? "RETAIL" : selectedServiceMode,
                    TableNumber = string.IsNullOrWhiteSpace(tableNumber) ? null : tableNumber.Trim(),
                    HeadCount = headCount > 0 ? headCount : (int?)null,
                    DiscountAmount = Cart.ActiveDiscountAmount,
                    DiscountCode = Cart.ActiveDiscountCode != "NONE" ? Cart.ActiveDiscountCode : null,
                    CustomerCardNumber = Cart.CustomerCardNumber,
                    CustomerName = string.IsNullOrWhiteSpace(customerName) ? null : customerName.Trim(),
                    CustomerAddress = string.IsNullOrWhiteSpace(customerAddress) ? null : customerAddress.Trim(),
                    CustomerTin = string.IsNullOrWhiteSpace(customerTin) ? null : customerTin.Trim(),
                    CustomerBusinessStyle = string.IsNullOrWhiteSpace(customerBusinessStyle) ? null : customerBusinessStyle.Trim(),
                    Items = Cart.Items.Select(ci => new OrderItemCreateDto
                    {
                        ProductId = ci.ProductId,
                        ProductName = ci.ProductName,
                        ProductShortCode = ci.ProductShortCode,
                        Quantity = ci.Quantity,
                        BasePrice = ci.BasePrice,
                        TaxName = ci.TaxName ?? "VATable",
                        IsKitchenItem = ci.IsKitchenItem,
                        IsBarItem = ci.IsBarItem,
                        Modifiers = ci.SelectedModifiers?.Select(m => new OrderItemModifierCreateDto
                        {
                            ModifierOptionId = m.ModifierOptionId,
                            ModifierName = m.Name,
                            AdditionalPrice = m.Price
                        }).ToList() ?? new()
                    }).ToList()
                };

                var offlineResult = await OfflineCheckoutService.ProcessOfflineCashSaleAsync(
                    offlineCreateDto,
                    cashTendered,
                    Session.Username ?? "cashier");

                if (!offlineResult.Success)
                {
                    paymentError = offlineResult.ErrorMessage ?? "Offline checkout failed.";
                    return;
                }

                // Close payment modal, clear cart, and open ReceiptPreview for offline printing/PDF
                isPaymentModalOpen = false;
                currentOrderResponse = null;
                isSplitPaymentMode = false;
                paymentSplits.Clear();
                Cart.Clear();
                tableNumber = string.Empty;
                headCount = 1;
                selectedServiceMode = "DINING";
                customerName = customerAddress = customerTin = customerBusinessStyle = string.Empty;
                paidOfflineReceipt = offlineResult.Receipt;
                return;
            }

            var payment = await PaymentService.ProcessPaymentAsync(processDto);
            if (payment == null || payment.PaymentStatus != "SUCCESS")
            {
                paymentError = "Payment processing failed on server.";
                return;
            }

            var paidOrderId = currentOrderResponse.OrderId;
            isPaymentModalOpen = false;
            currentOrderResponse = null;
            isSplitPaymentMode = false;
            paymentSplits.Clear();
            Cart.Clear();
            tableNumber = string.Empty;
            headCount = 1;
            selectedServiceMode = "DINING";
            paidReceiptOrderId = paidOrderId;
        }
        catch (Exception ex)
        {
            paymentError = $"Unable to complete payment. Your cart is preserved. Check the drawer and payment status before retrying. {ex.Message}";
        }
        finally
        {
            isProcessingPayment = false;
            StateHasChanged();
        }
    }

    private void ClosePaymentModal()
    {
        if (isProcessingPayment) return;
        isPaymentModalOpen = false;
        currentOrderResponse = null;
        paymentError = null;
        customerName = null;
        customerAddress = null;
        customerTin = null;
        customerBusinessStyle = null;
        showCustomerDetailsAccordion = false;
        StateHasChanged();
    }

    private IEnumerable<decimal> GetSuggestedAmounts(decimal total)
    {
        // Tender totals, not individual banknotes: works above ₱1,000 too.
        var suggestions = new SortedSet<decimal> { total };
        foreach (var increment in new[] { 100m, 500m, 1000m })
        {
            var rounded = decimal.Ceiling(total / increment) * increment;
            if (rounded > total) suggestions.Add(rounded);
        }
        return suggestions;
    }

    private string GetPaymentMethodIconByCode(string? code)
    {
        if (string.IsNullOrWhiteSpace(code)) return "bi-credit-card";
        var c = code.ToUpperInvariant();
        if (c.Contains("CASH")) return "bi-cash-stack";
        if (c.Contains("GCASH")) return "bi-phone";
        if (c.Contains("MAYA")) return "bi-wallet2";
        if (c.Contains("CARD") || c.Contains("VISA") || c.Contains("MASTER")) return "bi-credit-card-2-front";
        if (c.Contains("BANK") || c.Contains("TRANSFER")) return "bi-bank";
        return "bi-credit-card";
    }

    private string GetPaymentMethodIcon(PaymentMethodDto? pm)
    {
        if (pm == null) return "bi-credit-card";
        var code = (pm.Code ?? "").ToUpperInvariant();
        var name = (pm.Name ?? "").ToUpperInvariant();
        if (code.Contains("CASH") || name.Contains("CASH")) return "bi-cash-stack";
        if (code.Contains("GCASH") || name.Contains("GCASH")) return "bi-phone";
        if (code.Contains("MAYA") || name.Contains("MAYA")) return "bi-wallet2";
        if (code.Contains("CARD") || code.Contains("VISA") || code.Contains("MASTER") || name.Contains("CARD") || name.Contains("VISA") || name.Contains("MASTER")) return "bi-credit-card-2-front";
        if (code.Contains("BANK") || name.Contains("BANK") || code.Contains("TRANSFER")) return "bi-bank";
        return "bi-credit-card";
    }

    private void SelectPaymentMethod(PaymentMethodDto pm)
    {
        selectedPaymentMethod = pm;
        paymentError = null;
        if (pm.Code == "CASH" && currentOrderResponse != null)
        {
            cashTendered = currentOrderResponse.TotalAmount;
        }
    }

    private void AddCashBill(decimal bill)
    {
        if (currentOrderResponse == null) return;
        if (cashTendered == currentOrderResponse.TotalAmount)
        {
            cashTendered = bill;
        }
        else
        {
            cashTendered += bill;
        }
    }

    private bool IsConfirmDisabled()
    {
        if (isProcessingPayment || currentOrderResponse == null) return true;
        if (isSplitPaymentMode)
        {
            return Math.Abs(paymentSplits.Sum(s => s.Amount) - currentOrderResponse.TotalAmount) > 0.01m;
        }
        if (selectedPaymentMethod == null) return true;
        if (selectedPaymentMethod.RequiresReference && string.IsNullOrWhiteSpace(referenceNumber)) return true;
        if (selectedPaymentMethod.Code == "CASH" && cashTendered < currentOrderResponse.TotalAmount) return true;
        return false;
    }

    private async Task HoldCurrentSale()
    {
        if (!Cart.Items.Any()) return;

        var noteResult = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Hold Current Sale",
            Text = "Enter optional table number or customer name/notes for this ticket:",
            Input = SweetAlertInputType.Text,
            ShowCancelButton = true,
            ConfirmButtonText = "Park Ticket"
        });

        if (!noteResult.IsConfirmed) return;

        try
        {
            var createDto = new HeldSaleCreateDto
            {
                BranchId = Session.Terminal?.BranchId ?? 1,
                TerminalId = Session.Terminal?.TerminalId ?? 1,
                CashierId = Session.Username ?? "cashier",
                CustomerName = string.IsNullOrWhiteSpace(noteResult.Value) ? "Walk-in" : noteResult.Value.Trim(),
                Notes = "Suspended at " + DateTime.Now.ToString("HH:mm"),
                Subtotal = Cart.Subtotal,
                DiscountAmount = Cart.ActiveDiscountAmount,
                DiscountCode = Cart.ActiveDiscountCode != "NONE" ? Cart.ActiveDiscountCode : null,
                CustomerCardNumber = Cart.CustomerCardNumber,
                TotalAmount = Cart.Subtotal - Cart.ActiveDiscountAmount,
                Items = Cart.Items.Select(ci => new HeldSaleItemDto
                {
                    ProductId = ci.ProductId,
                    ProductName = ci.ProductName,
                    ProductShortCode = ci.ProductShortCode,
                    Quantity = ci.Quantity,
                    BasePrice = ci.BasePrice,
                    LineTotal = ci.LineTotal,
                    TaxName = ci.TaxName ?? "VATable",
                    Modifiers = ci.SelectedModifiers?.Select(m => new HeldSaleModifierDto
                    {
                        ModifierOptionId = m.ModifierOptionId,
                        ModifierName = m.Name,
                        AdditionalPrice = m.Price
                    }).ToList() ?? new()
                }).ToList()
            };

            var held = await HeldSaleService.CreateHeldSaleAsync(createDto);
            if (held != null)
            {
                Cart.Clear();
                await Swal.FireAsync("Sale Held!", $"Transaction successfully parked as {held.HoldReference}.", SweetAlertIcon.Success);
                Navigation.NavigateTo("/held-sales");
            }
            else
            {
                await Swal.FireAsync("Error", "Failed to suspend transaction.", SweetAlertIcon.Error);
            }
        }
        catch (Exception ex)
        {
            await Swal.FireAsync("Error", "Hold sale error: " + ex.Message, SweetAlertIcon.Error);
        }
    }
