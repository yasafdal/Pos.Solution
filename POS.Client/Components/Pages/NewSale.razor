@code {
    [CascadingParameter]
    public Layout.MainLayout? Layout { get; set; }

    private void ToggleNavMenu()
    {
        Layout?.ToggleNavMenu();
    }

    private async Task SwitchCashier()
    {
        if (Layout != null)
        {
            await Layout.SwitchCashierAsync();
            return;
        }
        Navigation.NavigateTo("/login");
    }

    private async Task LockTerminal()
    {
        if (Layout != null)
        {
            await Layout.LockTerminalAsync();
            return;
        }
        Session.ClearSession();
        Http.DefaultRequestHeaders.Authorization = null;
        Navigation.NavigateTo("/login");
    }

    private string selectedServiceMode = "DINING";
    private string tableNumber = string.Empty;
    private int headCount = 1;
    private void SetServiceMode(string mode) => selectedServiceMode = mode;

    private long? paidReceiptOrderId;
    private ReceiptDto? paidOfflineReceipt;
    private void CloseReceiptPreview()
    {
        paidReceiptOrderId = null;
        paidOfflineReceipt = null;
    }
    private List<CategoryDto> categories = new();
    private List<PaymentMethodDto> paymentMethods = new();
    private PaymentMethodDto? selectedPaymentMethod = null;
    private string referenceNumber = string.Empty;
    private List<ProductDto> products = new();
    private int? selectedCategoryId = null;
    private string searchQuery = string.Empty;
    private bool isLoading = true;
    private bool isOffline = false;
    private bool IsRetail => Session.Terminal?.BusinessTypeId != null && Session.Terminal.BusinessType == "RETAIL";
    private bool IsSupported => IsRetail || (Session.Terminal?.BusinessTypeId != null && Session.Terminal.BusinessType == "FNB");
    private ElementReference searchInput;
    private bool restoreSearchFocus;
    private bool quantityDialogOpen;
    private string? scanError;
    private bool disposed;
    private bool? bodyScrollLockState;
    private bool paymentModalWasOpen;
    private bool customizationModalWasOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var modalOpen = isPaymentModalOpen || isCustomizationOpen;
        if (bodyScrollLockState != modalOpen)
        {
            bodyScrollLockState = modalOpen;
            try
            {
                await Js.InvokeVoidAsync("posModal.setBodyScrollLock", modalOpen);
            }
            catch { }
        }

        if (modalOpen && !paymentModalWasOpen && !customizationModalWasOpen)
        {
            try
            {
                await Js.InvokeVoidAsync("posModal.focusActive");
            }
            catch { }
        }

        paymentModalWasOpen = isPaymentModalOpen;
        customizationModalWasOpen = isCustomizationOpen;

        if (restoreSearchFocus && !disposed && Session.IsAuthenticated && IsRetail && !isLoading && !quantityDialogOpen)
        {
            restoreSearchFocus = false;
            await searchInput.FocusAsync();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        Cart.OnChange += OnCartChanged;
        if (IsSupported) await LoadCatalogAsync();
        restoreSearchFocus = IsRetail;
    }

    private int previousCartItemCount = 0;

    private async void OnCartChanged()
    {
        selectedCartItems.IntersectWith(Cart.Items);
        bool shouldScroll = Cart.Items.Count > previousCartItemCount && Cart.Items.Count >= 6;
        previousCartItemCount = Cart.Items.Count;
        await InvokeAsync(StateHasChanged);

        if (shouldScroll)
        {
            try
            {
                await Js.InvokeVoidAsync("posScrollCartToBottom");
            }
            catch { }
        }
    }

    public void Dispose()
    {
        disposed = true;
        Cart.OnChange -= OnCartChanged;
        try
        {
            _ = Js.InvokeVoidAsync("posModal.setBodyScrollLock", false);
        }
        catch { }
    }

    private async Task LoadCatalogAsync()
    {
        isLoading = true;
        try
        {
            var connectivityState = await ConnectivityService.CheckConnectivityAsync();
            isOffline = connectivityState != TerminalConnectivityState.OnlineAndHealthy;
            if (!isOffline)
            {
                var catTask = CategoryService.GetCategoriesAsync();
                var prodTask = ProductService.GetProductsAsync();
                var pmTask = PaymentService.GetPaymentMethodsAsync();
                await Task.WhenAll(catTask, prodTask, pmTask);

                categories = (await catTask).Where(c => !c.IsDeleted && c.IsActive).ToList();
                products = (await prodTask).Where(p => p.IsActive && p.ProductType != "RawMaterial").ToList();
                paymentMethods = await pmTask;
            }
            else
            {
                // OFFLINE FALLBACK: Read from isolated local SQLite database instance
                using var db = new POS.Client.Data.LocalPosDbContext();
                db.InitializeDatabase();
                categories = db.Categories
                    .AsNoTracking()
                    .Select(c => new CategoryDto { CategoryId = c.CategoryId, Name = c.Name ?? string.Empty, ColorHex = c.ColorCode ?? POS.Shared.Helpers.CategoryColor.Default, IsActive = true })
                    .ToList();

                products = db.Products
                    .AsNoTracking()
                    .Select(p => new ProductDto
                    {
                        ProductId = p.ProductId,
                        Name = p.Name,
                        ShortCode = p.ShortCode,
                        SKU = p.SKU,
                        Barcode = p.Barcode,
                        UnitValue = p.UnitValue,
                        UnitOfMeasure = p.UnitOfMeasure,
                        ImageUrl = p.ImageUrl,
                        Price = p.Price,
                        CostPrice = p.CostPrice,
                        CategoryId = p.CategoryId,
                        CategoryName = p.CategoryName,
                        TaxId = p.TaxId,
                        TaxName = p.TaxName ?? "VATable",
                        ProductType = p.ProductType,
                        IsActive = p.IsActive,
                        IsKitchenItem = p.IsKitchenItem,
                        IsBarItem = p.IsBarItem
                    })
                    .ToList();

                paymentMethods = new List<PaymentMethodDto>
                {
                    new PaymentMethodDto { Code = "CASH", Name = "Cash", IsActive = true }
                };
            }

            if (paymentMethods.Any())
            {
                selectedPaymentMethod = paymentMethods.FirstOrDefault(pm => pm.Code == "CASH") ?? paymentMethods.First();
            }
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error Loading Catalog",
                Text = ex.Message,
                Icon = SweetAlertIcon.Error
            });
        }
        finally
        {
            isLoading = false;
        }
    }

    private Dictionary<int, CategoryDto> categoryMap = new();
    private List<CategoryDto>? categoryMapSource;

    private CategoryDto? FindCategory(int? categoryId)
    {
        if (!ReferenceEquals(categoryMapSource, categories))
        {
            categoryMap = categories.GroupBy(c => c.CategoryId).ToDictionary(g => g.Key, g => g.First());
            categoryMapSource = categories;
        }
        return categoryId.HasValue && categoryMap.TryGetValue(categoryId.Value, out var cat) ? cat : null;
    }

    private Dictionary<int, string> categoryColorMap = new();
    private List<CategoryDto>? categoryColorMapSource;

    private string GetCategoryColor(int? categoryId)
    {
        if (!categoryId.HasValue)
            return CategoryColor.NeutralFallback;

        if (!ReferenceEquals(categoryColorMapSource, categories))
        {
            categoryColorMap = categories.GroupBy(c => c.CategoryId)
                .ToDictionary(
                    g => g.Key,
                    g => CategoryColor.Normalize(g.First().ColorHex, CategoryColor.NeutralFallback)
                );
            categoryColorMapSource = categories;
        }

        return categoryColorMap.TryGetValue(categoryId.Value, out var color) ? color : CategoryColor.NeutralFallback;
    }

    private string GetCategoryName(int? categoryId) =>
        FindCategory(categoryId)?.Name ?? "Uncategorized";

    // Filtered list is recomputed only when the catalog, category or search text changes,
    // not on every render (the cart updating, for example, re-renders this page).
    private List<ProductDto> filteredCache = new();
    private List<ProductDto>? filteredSource;
    private int? filteredCategoryId;
    private string? filteredQuery;

    private List<ProductDto> FilteredProducts
    {
        get
        {
            if (ReferenceEquals(filteredSource, products) && filteredCategoryId == selectedCategoryId && filteredQuery == searchQuery)
                return filteredCache;

            filteredSource = products;
            filteredCategoryId = selectedCategoryId;
            filteredQuery = searchQuery;

            if (IsRetail && string.IsNullOrWhiteSpace(searchQuery))
            {
                filteredCache = new();
                return filteredCache;
            }

            var query = products.AsEnumerable();

            if (selectedCategoryId.HasValue)
            {
                query = query.Where(p => p.CategoryId == selectedCategoryId.Value);
            }

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var q = searchQuery.Trim();
                query = query.Where(p =>
                    (p.Name != null && p.Name.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                    (p.ShortCode != null && p.ShortCode.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                    (p.SKU != null && p.SKU.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                    (p.Barcode != null && p.Barcode.Contains(q, StringComparison.OrdinalIgnoreCase)));
            }

            filteredCache = query.OrderBy(p => p.Name ?? string.Empty, StringComparer.OrdinalIgnoreCase).ToList();
            return filteredCache;
        }
    }

    private sealed class CategoryProductGroup
    {
        public int? CategoryId { get; set; }
        public string CategoryName { get; set; } = string.Empty;
        public string ColorHex { get; set; } = POS.Shared.Helpers.CategoryColor.NeutralFallback;
        public List<ProductDto> Products { get; set; } = new();
    }

    private List<CategoryProductGroup> groupedCache = new();
    private List<ProductDto>? groupedCacheFilteredSource;

    private List<CategoryProductGroup> GroupedCategoryProducts
    {
        get
        {
            var filtered = FilteredProducts;
            if (ReferenceEquals(groupedCacheFilteredSource, filtered))
                return groupedCache;

            groupedCacheFilteredSource = filtered;

            if (!filtered.Any())
            {
                groupedCache = new();
                return groupedCache;
            }

            var productsByCategory = filtered
                .GroupBy(p => p.CategoryId)
                .ToDictionary(
                    g => g.Key,
                    g => g.OrderBy(p => p.Name ?? string.Empty, StringComparer.OrdinalIgnoreCase).ToList()
                );

            var groups = new List<CategoryProductGroup>();
            var knownCategoryIds = new HashSet<int>();

            foreach (var cat in categories)
            {
                knownCategoryIds.Add(cat.CategoryId);
                if (productsByCategory.TryGetValue(cat.CategoryId, out var prods) && prods.Any())
                {
                    groups.Add(new CategoryProductGroup
                    {
                        CategoryId = cat.CategoryId,
                        CategoryName = cat.Name,
                        ColorHex = GetCategoryColor(cat.CategoryId),
                        Products = prods
                    });
                }
            }

            // Products with missing or unresolved categories placed under "Uncategorized"
            var uncategorized = new List<ProductDto>();
            foreach (var kvp in productsByCategory)
            {
                if (kvp.Key <= 0 || !knownCategoryIds.Contains(kvp.Key))
                {
                    uncategorized.AddRange(kvp.Value);
                }
            }

            if (uncategorized.Any())
            {
                groups.Add(new CategoryProductGroup
                {
                    CategoryId = null,
                    CategoryName = "Uncategorized",
                    ColorHex = POS.Shared.Helpers.CategoryColor.NeutralFallback,
                    Products = uncategorized.OrderBy(p => p.Name ?? string.Empty, StringComparer.OrdinalIgnoreCase).ToList()
                });
            }

            groupedCache = groups;
            return groupedCache;
        }
    }

