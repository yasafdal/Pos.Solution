                                                    <i class="bi @GetPaymentMethodIcon(pm)"></i>
                                                </div>
                                                <div class="pos-method-info">
                                                    <span class="pos-method-name">@pm.Name</span>
                                                    <span class="pos-method-badge">@(pm.RequiresReference ? "Ref Required" : "Instant")</span>
                                                </div>
                                                @if (isSelected)
                                                {
                                                    <i class="bi bi-check-circle-fill pos-method-check"></i>
