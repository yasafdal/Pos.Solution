@page "/new-sale"
@inject PosSessionService Session
@inject NavigationManager Navigation
@using Microsoft.EntityFrameworkCore
@using POS.Shared.Helpers
@inject ICategoryService CategoryService
@inject IProductService ProductService
@inject IModifierService ModifierService
@inject IOrderService OrderService
@inject IPaymentService PaymentService
@inject IHeldSaleService HeldSaleService
@inject CartService Cart
@inject HttpClient Http
@inject SweetAlertService Swal
@inject POS.Client.Data.LocalPosDbContext LocalDb
@inject IPosConnectivityService ConnectivityService
@inject POS.Client.Services.IOfflineCheckoutService OfflineCheckoutService
@implements IDisposable

@if (!Session.IsAuthenticated)
{
    <div class="pos-loading-screen">
        <div class="spinner-border text-primary" role="status"></div>
        <span class="ms-2 text-muted">Redirecting to login...</span>
    </div>
}
else if (!IsSupported)
{
    <div class="sale-unavailable alert alert-warning" role="alert">
        <h4>New Sale unavailable</h4>
        @if (Session.Terminal?.BusinessTypeId == null || string.IsNullOrWhiteSpace(Session.Terminal.BusinessType))
        {
            <p>The branch business type is not configured. Contact an administrator.</p>
        }
        else
        {
            <p>Business type @Session.Terminal.BusinessType is not supported for New Sale. Contact an administrator.</p>
        }
    </div>
}
else
{
    <div class="new-sale-container">
        <!-- Left: Product Catalog & Search -->
        <div class="catalog-section">
            <!-- Top Search Bar -->
            <div class="search-bar-wrap mb-3">
                <div class="position-relative">
                    <i class="bi bi-search search-icon fs-5"></i>
                    <input type="text" @ref="searchInput" aria-label="Search item or scan barcode"
                           autocomplete="off" disabled="@(isLoading || quantityDialogOpen)"
                           @onkeydown="OnSearchKeyDown"
                           class="form-control form-control-lg search-input ps-5 pe-5"
                           placeholder="Search products by name, SKU, or barcode..."
                           value="@searchQuery"
                           @oninput="OnSearchInput" />
                    @if (!string.IsNullOrEmpty(searchQuery))
                    {
                        <button type="button" class="btn btn-link clear-search-btn" @onclick="ClearSearch" title="Clear search">
                            ✕
                        </button>
                    }
                </div>
            </div>

            @if (IsRetail)
            {
                <p class="small text-muted">Search an item or scan its barcode, then press Enter.</p>
                @if (!string.IsNullOrEmpty(scanError))
                {
                    <div class="scan-error alert alert-danger" role="alert">@scanError</div>
                }
                <div class="retail-results products-grid-scroll">
                    @if (isLoading)
                    {
                        <p>Loading catalog...</p>
                    }
                    else if (string.IsNullOrWhiteSpace(searchQuery))
                    {
                        <p class="text-muted">Search or scan to find an item.</p>
                    }
                    else if (!FilteredProducts.Any())
                    {
                        <p>No matching items.</p>
                    }
                    @foreach (var product in FilteredProducts)
                    {
                        <button type="button" class="retail-result" style="--category-color: @GetCategoryColor(product.CategoryId)" disabled="@quantityDialogOpen"
                                @onclick="() => ChooseQuantity(product)">
                            <span><strong>@product.Name</strong><small>@product.SKU · @product.Barcode</small><small>@GetCategoryName(product.CategoryId)</small></span>
                            <span>₱@product.Price.ToString("N2")</span>
                        </button>
                    }
                </div>
            }
            else
            {
            <!-- Categories Bar -->
            <div class="categories-bar mb-3">
                <button type="button"
                        class="category-pill @(selectedCategoryId == null ? "active" : "")"
                        aria-pressed="@(selectedCategoryId == null ? "true" : "false")"
                        @onclick="() => SelectCategory(null)">
                    All Categories
                </button>
                @foreach (var cat in categories)
                {
                    <button type="button"
                            class="category-pill category-colored @(selectedCategoryId == cat.CategoryId ? "active" : "")"
                            style="--category-color: @CategoryColor.Normalize(cat.ColorHex)"
                            aria-pressed="@(selectedCategoryId == cat.CategoryId ? "true" : "false")"
                            @onclick="() => SelectCategory(cat.CategoryId)">
                        @cat.Name
                    </button>
                }
            </div>

            <!-- Products Grid Area -->
            <div class="products-grid-scroll">
                @if (isLoading)
                {
                    <div class="text-center py-5 text-muted">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-2 small">Loading catalog...</p>
                    </div>
                }
                else if (!FilteredProducts.Any())
                {
                    <div class="empty-products text-center py-5">
                        <i class="bi bi-inbox fs-1 text-secondary mb-2 d-block"></i>
                        <h6 class="fw-bold text-dark mb-1">No products found</h6>
                        <p class="text-muted small">Try a different category or search keyword.</p>
                    </div>
                }
                else
                {
                    <div class="products-grid">
                        @foreach (var product in FilteredProducts)
                        {
                            <div class="product-card" style="--category-color: @GetCategoryColor(product.CategoryId)" @onclick="() => AddToCart(product)" role="button" tabindex="0">
                                <div class="product-img-wrap">
                                    @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                    {
                                        <img src="@GetImageUrl(product.ImageUrl)"
                                             alt="@product.Name"
                                             class="product-img"
                                             loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="product-placeholder-icon">
                                            <i class="bi bi-box-seam fs-2 text-secondary"></i>
                                        </div>
                                    }
                                </div>
                                <div class="product-info">
                                    <div class="product-category-wrap">
                                        <span class="product-category-chip" title="@GetCategoryName(product.CategoryId)">
                                            <span class="category-dot" style="background-color: @GetCategoryColor(product.CategoryId)"></span>
                                            <span class="category-name-text text-truncate">@GetCategoryName(product.CategoryId)</span>
                                        </span>
                                    </div>
                                    <div class="product-name" title="@product.Name">@product.Name</div>
                                    <div class="product-bottom">
                                        <span class="product-price">₱@product.Price.ToString("N2")</span>
                                        @if (!string.IsNullOrEmpty(product.UnitOfMeasure))
                                        {
                                            <span class="product-uom">@product.UnitOfMeasure</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
            }
        </div>

        <!-- Right: Current Order Cart -->
        <div class="order-section">
            <div class="order-card shadow-sm">
                <!-- Service Mode & Table / Pax Bar (for F&B) -->
                @if (!IsRetail)
                {
                    <div class="p-2 bg-light border-bottom">
                        <div class="d-flex gap-1 mb-2">
                            <button type="button" class="btn btn-sm flex-fill @(selectedServiceMode == "DINING" ? "btn-primary fw-bold" : "btn-outline-secondary")" @onclick='() => SetServiceMode("DINING")'>
                                <i class="bi bi-cup-hot me-1"></i> Dine-In
                            </button>
                            <button type="button" class="btn btn-sm flex-fill @(selectedServiceMode == "TAKEOUT" ? "btn-primary fw-bold" : "btn-outline-secondary")" @onclick='() => SetServiceMode("TAKEOUT")'>
                                <i class="bi bi-bag me-1"></i> Takeout
                            </button>
                            <button type="button" class="btn btn-sm flex-fill @(selectedServiceMode == "DELIVERY" ? "btn-primary fw-bold" : "btn-outline-secondary")" @onclick='() => SetServiceMode("DELIVERY")'>
                                <i class="bi bi-truck me-1"></i> Delivery
                            </button>
                        </div>

                        <div class="d-flex gap-2">
                            <div class="flex-fill">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-white"><i class="bi bi-grid-3x3-gap"></i></span>
                                    <input type="text" class="form-control" placeholder="Table #" @bind="tableNumber" />
                                </div>
                            </div>
                            @if (selectedServiceMode == "DINING")
                            {
                                <div style="width: 110px;">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-white" title="Guests / Pax"><i class="bi bi-people"></i></span>
                                        <input type="number" class="form-control" min="1" max="99" placeholder="Pax" @bind="headCount" />
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Order Header -->
                <div class="order-header d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <h5 class="fw-bold mb-0 text-dark">Current Order</h5>
                        <span class="order-badge">@Cart.TotalItems @(Cart.TotalItems == 1 ? "item" : "items")</span>
                    </div>
                    @if (Cart.Items.Any())
                    {
                        @if (selectedCartItems.Any())
                        {
                            <button type="button" class="delete-selected-btn" @onclick="DeleteSelectedItems" title="Delete selected items">
                                <i class="bi bi-trash3 me-1"></i> Delete (@selectedCartItems.Count)
                            </button>
                        }
                        else
                        {
                            <button type="button" class="clear-cart-btn" @onclick="ClearCart" title="Clear all items">
                                <i class="bi bi-trash3 me-1"></i> Clear
                            </button>
                        }
                    }
                </div>

                <!-- Cart Items List -->
                <div class="order-items-scroll">
                    @if (!Cart.Items.Any())
                    {
                        <div class="empty-cart text-center py-5">
                            <i class="bi bi-cart3 fs-1 text-muted mb-2 d-block"></i>
                            <p class="text-muted fw-medium mb-1">Your cart is empty</p>
                            <small class="text-secondary">Tap any product on the left to add items</small>
                        </div>
                    }
                    else
                    {
                        <div class="cart-items-list">
                            @foreach (var item in Cart.Items)
                            {
                                var isItemSelected = selectedCartItems.Contains(item);
                                <div class="cart-item-row @(isItemSelected ? "is-selected" : "")">
                                    <div class="cart-item-select">
                                        <label class="custom-checkbox" @onclick:stopPropagation="true">
                                            <input type="checkbox"
                                                   checked="@isItemSelected"
                                                   @onchange="() => ToggleSelectCartItem(item)" />
                                            <span class="checkmark"></span>
                                        </label>
                                    </div>
                                    <div class="cart-item-info">
                                        <div class="cart-item-name" title="@item.ProductName">@item.ProductName</div>
                                        <div class="cart-item-unit-price text-muted">₱@item.UnitPrice.ToString("N2") each</div>
                                        @if (item.SelectedModifiers != null && item.SelectedModifiers.Any())
                                        {
                                            <div class="cart-item-modifiers">
                                                @foreach (var mod in item.SelectedModifiers)
                                                {
                                                    <div class="cart-modifier-row">
                                                        <span>+ @mod.Name</span>
                                                        @if (mod.Price > 0)
                                                        {
                                                            <span class="mod-price">₱@mod.Price.ToString("N2")</span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="cart-item-actions">
                                        <div class="qty-control">
                                            <button type="button" class="qty-btn" @onclick="() => Cart.DecreaseQuantity(item)" title="Decrease">
                                                −
                                            </button>
                                            <span class="qty-display">@item.Quantity</span>
                                            <button type="button" class="qty-btn" @onclick="() => Cart.IncreaseQuantity(item)" title="Increase">
                                                +
                                            </button>
                                        </div>
                                        <div class="cart-item-total">
                                            ₱@item.LineTotal.ToString("N2")
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Order Summary & Checkout -->
                <div class="order-footer">
                    <div class="order-totals">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Subtotal</span>
                            <span class="fw-semibold">₱@Cart.Subtotal.ToString("N2")</span>
                        </div>
                        @if (Cart.ActiveDiscountCode != "NONE")
                        {
                            <div class="d-flex justify-content-between mb-2 text-success">
                                <span>Discount (@Cart.ActiveDiscountCode)</span>
                                <span class="fw-semibold">-₱@Cart.ActiveDiscountAmount.ToString("N2")</span>
                            </div>
                        }
                        <div class="d-flex justify-content-between align-items-baseline mb-3">
                            <span class="fw-bold fs-5 text-dark">Total</span>
                            <span class="fw-bolder fs-4 text-primary">₱@((Cart.Subtotal - Cart.ActiveDiscountAmount).ToString("N2"))</span>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mb-2">
                        <button type="button"
                                class="btn btn-outline-secondary w-50 py-2 fw-bold btn-discount"
                                disabled="@(!Cart.Items.Any())"
                                @onclick="OpenDiscountModal">
                            <i class="bi bi-percent me-1"></i> Discount
                        </button>
                        <button type="button"
                                class="btn btn-outline-warning w-50 py-2 fw-bold text-dark"
                                disabled="@(!Cart.Items.Any())"
                                @onclick="HoldCurrentSale">
                            <i class="bi bi-pause-fill me-1"></i> Hold Sale
                        </button>
                    </div>
                    <div class="d-grid">
                        <button type="button"
                                class="btn btn-primary w-100 py-3 fw-bold btn-proceed-payment"
                                disabled="@(!Cart.Items.Any())"
                                @onclick="ProceedToPayment">
                            Proceed to Payment
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Discount Modal Component -->
    <DiscountModal @ref="discountModalComponent" Cart="@Cart" OnDiscountChanged="@StateHasChanged" />

    <!-- Customization Modal -->
    @if (isCustomizationOpen && customizingProduct != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px);" role="dialog" aria-modal="true">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg customization-modal-dialog">
                <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                    <!-- Modal Header -->
                    <div class="modal-header border-bottom px-4 py-3 bg-white d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-3">
                            <div class="customization-product-icon">
                                <i class="bi bi-cup-hot-fill fs-3 text-primary"></i>
                            </div>
                            <div>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <h5 class="modal-title fw-bold text-dark mb-0">Customize @customizingProduct.Name</h5>
                                    @if (!string.IsNullOrEmpty(customizingProduct.CategoryName))
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1">
                                            @customizingProduct.CategoryName
                                        </span>
                                    }
                                </div>
                                <div class="text-secondary small mt-1">
                                    Base Price: <strong class="text-dark">₱@customizingProduct.Price.ToString("N2")</strong>
                                    @if (!string.IsNullOrEmpty(customizingProduct.SKU))
                                    {
                                        <span class="text-muted ms-2">• SKU: @customizingProduct.SKU</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <button type="button" class="btn-close shadow-none" @onclick="CloseCustomizationModal" aria-label="Close"></button>
                    </div>

                    <!-- Modal Body -->
                    <div class="modal-body px-4 py-3 bg-light-subtle">
                        @if (!string.IsNullOrEmpty(customizationError))
                        {
                            <div class="alert alert-danger d-flex align-items-center gap-2 py-2 mb-3 rounded-3" role="alert">
                                <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                                <div>@customizationError</div>
                            </div>
                        }

                        @foreach (var group in currentModifierGroups)
                        {
                            var set = selectedOptionIdsByGroup.TryGetValue(group.ModifierGroupId, out var s) ? s : new HashSet<int>();
                            var isSugar = IsSugarGroup(group);

                            <div class="modifier-group-section mb-4 p-3 bg-white rounded-4 border shadow-sm">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div class="d-flex align-items-center gap-2">
                                        @if (isSugar)
                                        {
                                            <div class="group-icon-pill bg-warning-subtle text-warning">
                                                <i class="bi bi-droplet-half fs-5"></i>
                                            </div>
                                        }
                                        else if (IsSizeGroup(group))
                                        {
                                            <div class="group-icon-pill bg-primary-subtle text-primary">
                                                <i class="bi bi-cup-straw fs-5"></i>
                                            </div>
                                        }
                                        else if (IsIceGroup(group))
                                        {
                                            <div class="group-icon-pill bg-info-subtle text-info">
                                                <i class="bi bi-snow fs-5"></i>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="group-icon-pill bg-secondary-subtle text-secondary">
                                                <i class="bi bi-sliders fs-5"></i>
                                            </div>
                                        }
                                        <div>
                                            <h6 class="fw-bold text-dark mb-0">
                                                @group.ModifierGroupName
                                                @if (group.IsRequired || group.MinSelections > 0)
                                                {
                                                    <span class="text-danger ms-1">*</span>
                                                }
                                            </h6>
                                        </div>
                                    </div>
                                    <div>
                                        @if (group.IsRequired || group.MinSelections > 0)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1">
                                                Required • @(group.MaxSelections == 1 ? "Select 1" : $"Select {group.MinSelections}-{group.MaxSelections}")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2.5 py-1">
                                                Optional @(group.MaxSelections > 0 ? $"(Max {group.MaxSelections})" : "")
                                            </span>
                                        }
                                    </div>
                                </div>

                                @if (isSugar)
                                {
                                    <!-- Specialized Sugar Level Grid -->
                                    <div class="sugar-selector-grid" role="group" aria-label="@group.ModifierGroupName">
                                        @foreach (var option in group.Options.Where(o => o.IsActive).OrderBy(o => o.DisplayOrder))
                                        {
                                            var isSelected = set.Contains(option.ModifierOptionId);
                                            var (pct, desc, fill, iconClass) = ParseSugarOption(option.Name);
                                            <button type="button"
                                                    class="sugar-option-card @(isSelected ? "selected" : "")"
                                                    aria-pressed="@(isSelected ? "true" : "false")"
                                                    @onclick="() => SelectRadioOption(group, option)">
                                                <div class="sugar-card-header">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <i class="bi @iconClass @(isSelected ? "text-primary" : "text-secondary") fs-5"></i>
                                                        <span class="sugar-pct">@pct</span>
                                                    </div>
                                                    <span class="sugar-radio-indicator">
                                                        @if (isSelected)
                                                        {
                                                            <i class="bi bi-check-circle-fill text-primary fs-5"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-circle text-muted fs-5"></i>
                                                        }
                                                    </span>
                                                </div>
                                                @if (!string.IsNullOrEmpty(desc))
                                                {
                                                    <div class="sugar-desc">@desc</div>
                                                }
                                                <div class="sugar-meter-track" title="@pct sweetness">
                                                    <div class="sugar-meter-fill" style="width: @(fill)%;"></div>
                                                </div>
                                                @if (option.Price > 0)
                                                {
                                                    <div class="sugar-price-tag">+₱@option.Price.ToString("N2")</div>
                                                }
                                            </button>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <!-- Standard Modifier Card Grid -->
                                    <div class="modifier-grid" role="group" aria-label="@group.ModifierGroupName">
                                        @foreach (var option in group.Options.Where(o => o.IsActive).OrderBy(o => o.DisplayOrder))
                                        {
                                            var isSelected = set.Contains(option.ModifierOptionId);
                                            <button type="button"
                                                    class="modifier-card @(isSelected ? "selected" : "")"
                                                    aria-pressed="@(isSelected ? "true" : "false")"
                                                    @onclick="() => { if (group.MaxSelections == 1) SelectRadioOption(group, option); else ToggleCheckboxOption(group, option, !isSelected); }">
                                                <div class="modifier-card-left">
                                                    <span class="modifier-indicator">
                                                        @if (group.MaxSelections == 1)
                                                        {
                                                            @if (isSelected)
                                                            {
                                                                <i class="bi bi-check-circle-fill text-primary fs-5"></i>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-circle text-muted fs-5"></i>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            @if (isSelected)
                                                            {
                                                                <i class="bi bi-check-square-fill text-primary fs-5"></i>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-square text-muted fs-5"></i>
                                                            }
                                                        }
                                                    </span>
                                                    <span class="modifier-name">@option.Name</span>
                                                </div>
                                                <div class="modifier-card-right">
                                                    @if (option.Price > 0)
                                                    {
                                                        <span class="price-badge extra">+₱@option.Price.ToString("N2")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="price-badge free">Included</span>
                                                    }
                                                </div>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Modal Footer -->
                    <div class="modal-footer border-top bg-white px-4 py-3 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-secondary small fw-semibold text-uppercase d-block" style="letter-spacing: 0.5px; font-size: 0.72rem;">Total Item Price</span>
                            <div class="d-flex align-items-baseline gap-2">
                                <div class="fw-bolder fs-3 text-primary">₱@CustomizationTotalPrice.ToString("N2")</div>
                                @if (CustomizationTotalPrice > customizingProduct.Price)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-0.5 small">
                                        +₱@((CustomizationTotalPrice - customizingProduct.Price).ToString("N2")) extras
                                    </span>
                                }
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-secondary px-4 py-2 rounded-3 fw-semibold" @onclick="CloseCustomizationModal">
                                Cancel
                            </button>
                            <button type="button" class="btn btn-primary px-4 py-2 rounded-3 fw-bold shadow-sm d-flex align-items-center gap-2" @onclick="ConfirmCustomization">
                                <i class="bi bi-cart-plus-fill"></i> Add to Cart
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}

@if (paidReceiptOrderId.HasValue || paidOfflineReceipt != null)
{
    <ReceiptPreview OrderId="@(paidReceiptOrderId ?? 0)" OfflineReceipt="@paidOfflineReceipt" OnClose="CloseReceiptPreview" />
}


@if (isPaymentModalOpen && currentOrderResponse != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.5); backdrop-filter: blur(3px);" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <div class="modal-header border-bottom px-4 py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-0">Payment Processing</h5>
                        <small class="text-muted">Order: @currentOrderResponse.OrderNumber</small>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="splitPaymentSwitch" checked="@isSplitPaymentMode" @onchange="@(e => ToggleSplitPayment(e.Value is bool b ? b : (bool.TryParse(e.Value?.ToString(), out var res) && res)))" />
                            <label class="form-check-label fw-semibold small text-primary" for="splitPaymentSwitch">Split Payment</label>
                        </div>
                        <button type="button" class="btn-close" @onclick="ClosePaymentModal" aria-label="Close"></button>
                    </div>
                </div>
                <div class="modal-body px-4 py-4">
                    @if (!string.IsNullOrEmpty(paymentError))
                    {
                        <div class="alert alert-danger py-2 mb-3" role="alert">@paymentError</div>
                    }
                    <div class="mb-3 text-center bg-light p-3 rounded-3">
                        <span class="text-muted small d-block">Total Amount Due</span>
                        <h2 class="fw-bold text-primary mb-0">₱@currentOrderResponse.TotalAmount.ToString("N2")</h2>
                        @if (isSplitPaymentMode)
                        {
                            var remaining = currentOrderResponse.TotalAmount - paymentSplits.Sum(s => s.Amount);
                            <div class="mt-2 d-flex justify-content-center gap-3 small">
                                <span class="text-success fw-semibold">Paid: ₱@paymentSplits.Sum(s => s.Amount).ToString("N2")</span>
                                <span class="text-danger fw-semibold">Remaining: ₱@remaining.ToString("N2")</span>
                            </div>
                        }
                    </div>

                    <!-- Customer Information Section (BIR / EOPT Compliant) -->
                    <div class="card border mb-3 bg-light rounded-3">
                        <div class="card-header bg-white py-2 px-3 d-flex justify-content-between align-items-center" style="cursor:pointer" @onclick="() => showCustomerDetailsAccordion = !showCustomerDetailsAccordion">
                            <span class="fw-semibold small text-dark">Customer Information (Optional / B2B)</span>
                            <span class="small text-primary">@(showCustomerDetailsAccordion ? "▲ Hide" : "▼ Add / Edit")</span>
                        </div>
                        @if (showCustomerDetailsAccordion)
                        {
                            <div class="card-body p-3">
                                <div class="row g-2">
                                    <div class="col-12">
                                        <label class="form-label small fw-semibold mb-1">Customer Name</label>
                                        <input type="text" class="form-control form-control-sm" @bind="customerName" @bind:event="oninput" placeholder="Walk-In / Company Name" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label small fw-semibold mb-1">Address</label>
                                        <input type="text" class="form-control form-control-sm" @bind="customerAddress" @bind:event="oninput" placeholder="Customer billing address" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small fw-semibold mb-1">TIN</label>
                                        <input type="text" class="form-control form-control-sm" @bind="customerTin" @bind:event="oninput" placeholder="Taxpayer ID Number" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small fw-semibold mb-1">Business Style</label>
                                        <input type="text" class="form-control form-control-sm" @bind="customerBusinessStyle" @bind:event="oninput" placeholder="e.g. Restaurant, Retail" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @if (isSplitPaymentMode)
                    {
                        @if (paymentSplits.Any())
                        {
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-dark small">Applied Splits</label>
                                <div class="list-group">
                                    @for (int i = 0; i < paymentSplits.Count; i++)
                                    {
                                        var idx = i;
                                        var split = paymentSplits[idx];
                                        <div class="list-group-item d-flex justify-content-between align-items-center py-2">
                                            <div>
                                                <span class="fw-bold">@split.PaymentMethod</span>: ₱@split.Amount.ToString("N2")
                                                @if (!string.IsNullOrEmpty(split.ReferenceNumber))
                                                {
                                                    <small class="text-muted ms-2">(Ref: @split.ReferenceNumber)</small>
                                                }
                                            </div>
                                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemovePaymentSplit(idx)">Remove</button>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (currentOrderResponse.TotalAmount - paymentSplits.Sum(s => s.Amount) > 0.01m)
                        {
                            <div class="card border bg-light p-3 mb-3">
                                <h6 class="fw-bold text-dark mb-2">Add Payment Split</h6>
                                <div class="mb-2">
                                    <label class="form-label small fw-semibold">Method</label>
                                    <div class="row g-2">
                                        @foreach (var pm in (paymentMethods.Any() ? paymentMethods : new List<PaymentMethodDto> { new() { Code = "CASH", Name = "Cash", RequiresReference = false } }))
                                        {
                                            var isSelected = currentSplitMethod?.Code == pm.Code;
                                            <div class="col-6">
                                                <button type="button" class="btn @(isSelected ? "btn-primary" : "btn-outline-primary") btn-sm w-100 py-2 fw-bold" @onclick="() => currentSplitMethod = pm">
                                                    @pm.Name
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="mb-2">
                                    <label class="form-label small fw-semibold">Split Amount (₱)</label>
                                    <input type="number" min="0.01" step="0.01" class="form-control form-control-sm fw-bold" @bind="currentSplitAmount" @bind:event="oninput" />
                                </div>

                                @if (currentSplitMethod?.RequiresReference == true)
                                {
                                    <div class="mb-2">
                                        <label class="form-label small fw-semibold">Reference Number <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control form-control-sm" @bind="currentSplitRef" @bind:event="oninput" placeholder="Reference or approval code..." />
                                    </div>
                                }

                                <button type="button" class="btn btn-dark btn-sm w-100 fw-bold mt-2" @onclick="AddPaymentSplit">+ Add This Split</button>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark">Payment Method</label>
                            <div class="row g-2">
                                @if (paymentMethods.Any())
                                {
                                    @foreach (var pm in paymentMethods)
                                    {
                                        var isSelected = selectedPaymentMethod?.Code == pm.Code;
                                        <div class="col-6 col-md-3">
                                            <button type="button" aria-pressed="@(isSelected ? "true" : "false")"
                                                    class="btn @(isSelected ? "btn-primary" : "btn-outline-primary") w-100 h-100 py-3 fw-bold d-flex flex-column align-items-center justify-content-center"
                                                    disabled="@isProcessingPayment"
                                                    @onclick="() => selectedPaymentMethod = pm">
                                                <span>@pm.Name @(isSelected ? "✓" : "")</span>
                                                @if (pm.RequiresReference)
                                                {
                                                    <small class="d-block fw-normal text-muted mt-1" style="font-size: 0.75rem;">Ref Required</small>
                                                }
                                                else
                                                {
                                                    <small class="d-block fw-normal text-transparent mt-1" style="font-size: 0.75rem; visibility: hidden;">Cash</small>
                                                }
                                            </button>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="col-4">
                                        <button type="button" aria-pressed="true" class="btn btn-outline-primary w-100 py-3 fw-bold" disabled="@isProcessingPayment">
                                            Cash ✓
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>

                        @if (selectedPaymentMethod != null && selectedPaymentMethod.RequiresReference)
                        {
                            <div class="mb-3">
                                <label for="ref-number" class="form-label fw-semibold text-dark">Reference Number / Approval Code <span class="text-danger">*</span></label>
                                <input id="ref-number" type="text" @bind="referenceNumber" @bind:event="oninput" disabled="@isProcessingPayment" class="form-control form-control-lg fw-bold" placeholder="Enter transaction ref or approval code..." />
                            </div>
                        }
                        else
                        {
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark">Quick Cash Tendered</label>
                            <div class="row g-2 mb-2">
                                @foreach (var amt in GetSuggestedAmounts(currentOrderResponse.TotalAmount))
                                {
                                    <div class="col-6 col-sm-3">
                                        <button type="button" aria-pressed="@(cashTendered == amt ? "true" : "false")" disabled="@isProcessingPayment" class="btn @(cashTendered == amt ? "btn-primary" : "btn-outline-primary") w-100 h-100 fw-bold py-3" @onclick="() => cashTendered = amt">
                                            @(amt == currentOrderResponse.TotalAmount ? $"Exact (₱{amt:N2})" : $"₱{amt:N0}")
                                        </button>
                                    </div>
                                }
                            </div>
                            <label for="cash-tendered" class="form-label">Amount Tendered (₱)</label>
                            <input id="cash-tendered" type="number" min="0" step="0.01" inputmode="decimal" disabled="@isProcessingPayment" class="form-control form-control-lg fw-bold" @bind="cashTendered" @bind:event="oninput" placeholder="Enter amount tendered..." />
                        </div>
                        <div class="d-flex justify-content-between align-items-center p-3 bg-success bg-opacity-10 rounded-3 border border-success border-opacity-25">
                            <span class="fw-bold text-success">Change Due:</span>
                            <span class="fs-4 fw-bold text-success">₱@(Math.Max(0m, cashTendered - currentOrderResponse.TotalAmount).ToString("N2"))</span>
                        </div>
                        }
                    }
                </div>
                <div class="modal-footer border-top bg-light px-4 py-3 d-flex justify-content-between align-items-center">
                    <button type="button" class="btn btn-outline-secondary px-4" @onclick="ClosePaymentModal">Cancel</button>
                    <button type="button" class="btn btn-success px-5 fw-bold" disabled="@((isSplitPaymentMode ? Math.Abs(paymentSplits.Sum(s => s.Amount) - currentOrderResponse.TotalAmount) > 0.01m : ((selectedPaymentMethod?.RequiresReference == true && string.IsNullOrWhiteSpace(referenceNumber)) || (selectedPaymentMethod?.Code == "CASH" && cashTendered < currentOrderResponse.TotalAmount))) || isProcessingPayment)" @onclick="ConfirmPayment">
                        @if (isProcessingPayment)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        Confirm Payment
                    </button>
                </div>
            </div>
        </div>
    </div>
}


@code {
    private string selectedServiceMode = "DINING";
    private string tableNumber = string.Empty;
    private int headCount = 1;
    private void SetServiceMode(string mode) => selectedServiceMode = mode;

    private long? paidReceiptOrderId;
    private ReceiptDto? paidOfflineReceipt;
    private void CloseReceiptPreview()
    {
        paidReceiptOrderId = null;
        paidOfflineReceipt = null;
    }
    private List<CategoryDto> categories = new();
    private List<PaymentMethodDto> paymentMethods = new();
    private PaymentMethodDto? selectedPaymentMethod = null;
    private string referenceNumber = string.Empty;
    private List<ProductDto> products = new();
    private int? selectedCategoryId = null;
    private string searchQuery = string.Empty;
    private bool isLoading = true;
    private bool isOffline = false;
    private bool IsRetail => Session.Terminal?.BusinessTypeId != null && Session.Terminal.BusinessType == "RETAIL";
    private bool IsSupported => IsRetail || (Session.Terminal?.BusinessTypeId != null && Session.Terminal.BusinessType == "FNB");
    private ElementReference searchInput;
    private bool restoreSearchFocus;
    private bool quantityDialogOpen;
    private string? scanError;
    private bool disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (restoreSearchFocus && !disposed && Session.IsAuthenticated && IsRetail && !isLoading && !quantityDialogOpen)
        {
            restoreSearchFocus = false;
            await searchInput.FocusAsync();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        Cart.OnChange += OnCartChanged;
        if (IsSupported) await LoadCatalogAsync();
        restoreSearchFocus = IsRetail;
    }

    private void OnCartChanged()
    {
        selectedCartItems.IntersectWith(Cart.Items);
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        disposed = true;
        Cart.OnChange -= OnCartChanged;
    }

    private async Task LoadCatalogAsync()
    {
        isLoading = true;
        try
        {
            var connectivityState = await ConnectivityService.CheckConnectivityAsync();
            isOffline = connectivityState != TerminalConnectivityState.OnlineAndHealthy;
            if (!isOffline)
            {
                var catTask = CategoryService.GetCategoriesAsync();
                var prodTask = ProductService.GetProductsAsync();
                var pmTask = PaymentService.GetPaymentMethodsAsync();
                await Task.WhenAll(catTask, prodTask, pmTask);

                categories = (await catTask).Where(c => !c.IsDeleted && c.IsActive).ToList();
                products = (await prodTask).Where(p => p.IsActive && p.ProductType != "RawMaterial").ToList();
                paymentMethods = await pmTask;
            }
            else
            {
                // OFFLINE FALLBACK: Read from isolated local SQLite database instance
                using var db = new POS.Client.Data.LocalPosDbContext();
                db.InitializeDatabase();
                categories = db.Categories
                    .AsNoTracking()
                    .Select(c => new CategoryDto { CategoryId = c.CategoryId, Name = c.Name ?? string.Empty, ColorHex = c.ColorCode ?? POS.Shared.Helpers.CategoryColor.Default, IsActive = true })
                    .ToList();

                products = db.Products
                    .AsNoTracking()
                    .Select(p => new ProductDto
                    {
                        ProductId = p.ProductId,
                        Name = p.Name,
                        ShortCode = p.ShortCode,
                        SKU = p.SKU,
                        Barcode = p.Barcode,
                        UnitValue = p.UnitValue,
                        UnitOfMeasure = p.UnitOfMeasure,
                        ImageUrl = p.ImageUrl,
                        Price = p.Price,
                        CostPrice = p.CostPrice,
                        CategoryId = p.CategoryId,
                        CategoryName = p.CategoryName,
                        TaxId = p.TaxId,
                        TaxName = p.TaxName ?? "VATable",
                        ProductType = p.ProductType,
                        IsActive = p.IsActive,
                        IsKitchenItem = p.IsKitchenItem
                    })
                    .ToList();

                paymentMethods = new List<PaymentMethodDto>
                {
                    new PaymentMethodDto { Code = "CASH", Name = "Cash", IsActive = true }
                };
            }

            if (paymentMethods.Any())
            {
                selectedPaymentMethod = paymentMethods.FirstOrDefault(pm => pm.Code == "CASH") ?? paymentMethods.First();
            }
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error Loading Catalog",
                Text = ex.Message,
                Icon = SweetAlertIcon.Error
            });
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetCategoryColor(int? categoryId) =>
        CategoryColor.Normalize(categories.FirstOrDefault(c => c.CategoryId == categoryId)?.ColorHex);

    private string GetCategoryName(int? categoryId) =>
        categories.FirstOrDefault(c => c.CategoryId == categoryId)?.Name ?? "Uncategorized";

    private IEnumerable<ProductDto> FilteredProducts
    {
        get
        {
            if (IsRetail && string.IsNullOrWhiteSpace(searchQuery)) return Enumerable.Empty<ProductDto>();
            var query = products.AsEnumerable();

            if (selectedCategoryId.HasValue)
            {
                query = query.Where(p => p.CategoryId == selectedCategoryId.Value);
            }

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var q = searchQuery.Trim();
                query = query.Where(p =>
                    (p.Name != null && p.Name.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                    (p.SKU != null && p.SKU.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                    (p.Barcode != null && p.Barcode.Contains(q, StringComparison.OrdinalIgnoreCase)));
            }

            return query;
        }
    }

    private void SelectCategory(int? categoryId)
    {
        selectedCategoryId = categoryId;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        if (quantityDialogOpen) return;
        scanError = null;
        searchQuery = e.Value?.ToString() ?? string.Empty;
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (!IsRetail || isLoading || quantityDialogOpen || e.Key != "Enter" || e.Repeat) return;
        if (string.IsNullOrEmpty(searchQuery)) return;
        scanError = null;
        // Barcode identifiers are strings: exact match only, including leading zeros.
        var matches = products.Where(p => string.Equals(p.Barcode, searchQuery, StringComparison.Ordinal)).Take(2).ToList();
        if (matches.Count == 1) await ChooseQuantity(matches[0]);
        else
        {
            scanError = matches.Count == 0 ? "No product has this barcode." : "Multiple products have this barcode. Contact an administrator.";
            searchQuery = string.Empty;
            restoreSearchFocus = true;
        }
    }

    private async Task ChooseQuantity(ProductDto product)
    {
        if (quantityDialogOpen || disposed || !Session.IsAuthenticated) return;
        quantityDialogOpen = true;
        try
        {
            var result = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Quantity",
                Text = product.Name,
                Input = SweetAlertInputType.Text,
                InputLabel = "Quantity",
                InputValue = "1",
                ShowCancelButton = true,
                ConfirmButtonText = "Add to cart",
                ReturnFocus = false,
                InputAutoTrim = false,
                InputAttributes = new Dictionary<string, string> { ["inputmode"] = "numeric", ["autocomplete"] = "off" },
                InputValidator = new InputValidatorCallback(value => ValidQuantity(value, out _)
                    ? string.Empty : "Enter a positive whole number that fits the current order.")
            });
            if (result.IsConfirmed && ValidQuantity(result.Value, out var quantity))
                Cart.AddItem(product, quantity);
        }
        finally
        {
            quantityDialogOpen = false;
            searchQuery = string.Empty;
            restoreSearchFocus = true;
        }
    }

    private bool ValidQuantity(string? value, out int quantity) =>
        int.TryParse(value, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out quantity)
        && quantity > 0 && quantity <= int.MaxValue - Cart.TotalItems;

    private void ClearSearch()
    {
        searchQuery = string.Empty;
        scanError = null;
        restoreSearchFocus = true;
    }

    private bool isCustomizationOpen = false;
    private ProductDto? customizingProduct = null;
    private List<ProductModifierGroupDto> currentModifierGroups = new();
    private Dictionary<int, HashSet<int>> selectedOptionIdsByGroup = new();
    private string? customizationError = null;

    private async Task AddToCart(ProductDto product)
    {
        if (IsRetail)
        {
            Cart.AddItem(product);
            return;
        }

        try
        {
            var connectivityState = await ConnectivityService.CheckConnectivityAsync();
            isOffline = connectivityState != TerminalConnectivityState.OnlineAndHealthy;
            List<ProductModifierGroupDto> groups = new();

            if (!isOffline)
            {
                var groupsTask = ModifierService.GetProductModifierGroupsAsync(product.ProductId);
                groups = await groupsTask;
            }
            else
            {
                // OFFLINE FALLBACK: Read exact product-modifier mapping from isolated local SQLite database
                using var db = new POS.Client.Data.LocalPosDbContext();
                db.InitializeDatabase();
                
                var mappedGroupIds = db.ProductModifierGroups
                    .AsNoTracking()
                    .Where(pmg => pmg.ProductId == product.ProductId)
                    .OrderBy(pmg => pmg.DisplayOrder)
                    .Select(pmg => pmg.ModifierGroupId)
                    .ToList();

                var localGroups = db.ModifierGroups
                    .AsNoTracking()
                    .Where(g => mappedGroupIds.Contains(g.ModifierGroupId))
                    .ToList();

                // Preserve display order from mapping
                localGroups = localGroups
                    .OrderBy(g => mappedGroupIds.IndexOf(g.ModifierGroupId))
                    .ToList();

                foreach (var g in localGroups)
                {
                    var options = db.ModifierOptions
                        .AsNoTracking()
                        .Where(o => o.ModifierGroupId == g.ModifierGroupId)
                        .OrderBy(o => o.ModifierOptionId)
                        .Select(o => new ModifierOptionDto
                        {
                            ModifierOptionId = o.ModifierOptionId,
                            ModifierGroupId = g.ModifierGroupId,
                            Name = o.Name,
                            Price = o.Price,
                            DisplayOrder = o.DisplayOrder,
                            IsActive = o.IsActive
                        })
                        .ToList();

                    groups.Add(new ProductModifierGroupDto
                    {
                        ModifierGroupId = g.ModifierGroupId,
                        ModifierGroupName = g.Name,
                        IsRequired = g.IsRequired,
                        MinSelections = g.MinSelections,
                        MaxSelections = g.MaxSelections,
                        Options = options
                    });
                }
            }
        
            if (groups != null && groups.Any())
            {
                customizingProduct = product;
                currentModifierGroups = groups;
                selectedOptionIdsByGroup.Clear();
                customizationError = null;

                foreach (var g in groups)
                {
                    selectedOptionIdsByGroup[g.ModifierGroupId] = new HashSet<int>();
                    if (g.IsRequired && g.MinSelections > 0 && g.Options.Any())
                    {
                        var firstOpt = g.Options.OrderBy(o => o.DisplayOrder).First();
                        selectedOptionIdsByGroup[g.ModifierGroupId].Add(firstOpt.ModifierOptionId);
                    }
                }

                isCustomizationOpen = true;
                StateHasChanged();
            }
            else
            {
                Cart.AddItem(product);
            }
        }
        catch (Exception ex)
        {
            customizationError = $"Error loading modifiers: {ex.Message}";
            Cart.AddItem(product);
        }
    }

    private void SelectRadioOption(ProductModifierGroupDto group, ModifierOptionDto option)
    {
        if (!selectedOptionIdsByGroup.ContainsKey(group.ModifierGroupId))
        {
            selectedOptionIdsByGroup[group.ModifierGroupId] = new HashSet<int>();
        }
        var set = selectedOptionIdsByGroup[group.ModifierGroupId];
        set.Clear();
        set.Add(option.ModifierOptionId);
        customizationError = null;
        StateHasChanged();
    }

    private bool IsSugarGroup(ProductModifierGroupDto group)
    {
        if (string.IsNullOrWhiteSpace(group.ModifierGroupName)) return false;
        var name = group.ModifierGroupName.ToLowerInvariant();
        return name.Contains("sugar") || name.Contains("sweet");
    }

    private bool IsSizeGroup(ProductModifierGroupDto group)
    {
        if (string.IsNullOrWhiteSpace(group.ModifierGroupName)) return false;
        var name = group.ModifierGroupName.ToLowerInvariant();
        return name.Contains("size") || name.Contains("cup");
    }

    private bool IsIceGroup(ProductModifierGroupDto group)
    {
        if (string.IsNullOrWhiteSpace(group.ModifierGroupName)) return false;
        var name = group.ModifierGroupName.ToLowerInvariant();
        return name.Contains("ice") || name.Contains("temp");
    }

    private (string Pct, string Label, int FillPercent, string IconClass) ParseSugarOption(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return ("0%", "Regular", 100, "bi-droplet-fill");

        var match = System.Text.RegularExpressions.Regex.Match(name, @"^(\d+%\s*)\(?(.*?)\)?$");
        if (match.Success)
        {
            var pct = match.Groups[1].Value.Trim();
            var label = match.Groups[2].Value.Trim(' ', '(', ')', '-', ':');
            if (string.IsNullOrEmpty(label)) label = "Sweetness";

            int.TryParse(pct.TrimEnd('%'), out int val);
            var fill = Math.Clamp(val, 0, 100);
            var icon = fill == 0 ? "bi-droplet" : (fill <= 50 ? "bi-droplet-half" : "bi-droplet-fill");
            return (pct, label, fill, icon);
        }

        var anyPctMatch = System.Text.RegularExpressions.Regex.Match(name, @"(\d+%)");
        if (anyPctMatch.Success)
        {
            var pct = anyPctMatch.Groups[1].Value;
            var cleanLabel = name.Replace(pct, "").Trim(' ', '(', ')', '-', ':');
            int.TryParse(pct.TrimEnd('%'), out int val);
            var fill = Math.Clamp(val, 0, 100);
            var icon = fill == 0 ? "bi-droplet" : (fill <= 50 ? "bi-droplet-half" : "bi-droplet-fill");
            return (pct, string.IsNullOrEmpty(cleanLabel) ? "Sweetness" : cleanLabel, fill, icon);
        }

        var lower = name.ToLowerInvariant();
        if (lower.Contains("no ") || lower.Contains("zero")) return ("0%", name, 0, "bi-droplet");
        if (lower.Contains("less") || lower.Contains("25")) return ("25%", name, 25, "bi-droplet");
        if (lower.Contains("half") || lower.Contains("50")) return ("50%", name, 50, "bi-droplet-half");
        if (lower.Contains("75")) return ("75%", name, 75, "bi-droplet-half");
        if (lower.Contains("regular") || lower.Contains("standard") || lower.Contains("100") || lower.Contains("normal")) return ("100%", name, 100, "bi-droplet-fill");
        if (lower.Contains("extra")) return ("120%", name, 100, "bi-droplet-fill");

        return (name, "", 50, "bi-droplet-half");
    }

    private void ToggleCheckboxOption(ProductModifierGroupDto group, ModifierOptionDto option, bool isChecked)
    {
        if (!selectedOptionIdsByGroup.ContainsKey(group.ModifierGroupId))
        {
            selectedOptionIdsByGroup[group.ModifierGroupId] = new HashSet<int>();
        }

        var set = selectedOptionIdsByGroup[group.ModifierGroupId];

        if (isChecked)
        {
            if (group.MaxSelections > 0 && set.Count >= group.MaxSelections)
            {
                customizationError = $"Group '{group.ModifierGroupName}' allows at most {group.MaxSelections} selections.";
                StateHasChanged();
                return;
            }
            set.Add(option.ModifierOptionId);
        }
        else
        {
            set.Remove(option.ModifierOptionId);
        }
        customizationError = null;
        StateHasChanged();
    }

    private decimal CustomizationTotalPrice
    {
        get
        {
            if (customizingProduct == null) return 0m;
            decimal total = customizingProduct.Price;
            foreach (var group in currentModifierGroups)
            {
                if (selectedOptionIdsByGroup.TryGetValue(group.ModifierGroupId, out var set))
                {
                    foreach (var optId in set)
                    {
                        var opt = group.Options.FirstOrDefault(o => o.ModifierOptionId == optId);
                        if (opt != null)
                        {
                            total += opt.Price;
                        }
                    }
                }
            }
            return total;
        }
    }

    private void ConfirmCustomization()
    {
        if (customizingProduct == null) return;

        foreach (var group in currentModifierGroups)
        {
            var set = selectedOptionIdsByGroup.TryGetValue(group.ModifierGroupId, out var s) ? s : new HashSet<int>();
            int count = set.Count;

            if (group.IsRequired && count < Math.Max(1, group.MinSelections))
            {
                customizationError = $"Please select at least {Math.Max(1, group.MinSelections)} option(s) for '{group.ModifierGroupName ?? "Modifier Group"}'.";
                return;
            }
            if (group.MinSelections > 0 && count < group.MinSelections)
            {
                customizationError = $"Please select at least {group.MinSelections} option(s) for '{group.ModifierGroupName ?? "Modifier Group"}'.";
                return;
            }
            if (group.MaxSelections > 0 && count > group.MaxSelections)
            {
                customizationError = $"Group '{group.ModifierGroupName ?? "Modifier Group"}' allows at most {group.MaxSelections} selections.";
                return;
            }
        }

        var selectedModifiers = new List<ModifierOptionDto>();
        foreach (var group in currentModifierGroups)
        {
            if (selectedOptionIdsByGroup.TryGetValue(group.ModifierGroupId, out var set))
            {
                foreach (var optId in set)
                {
                    var opt = group.Options.FirstOrDefault(o => o.ModifierOptionId == optId);
                    if (opt != null)
                    {
                        selectedModifiers.Add(opt);
                    }
                }
            }
        }

        Cart.AddItem(customizingProduct, 1, selectedModifiers);
        CloseCustomizationModal();
    }

    private void CloseCustomizationModal()
    {
        isCustomizationOpen = false;
        customizingProduct = null;
        currentModifierGroups.Clear();
        selectedOptionIdsByGroup.Clear();
        customizationError = null;
        StateHasChanged();
    }

