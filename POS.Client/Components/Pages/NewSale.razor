                                                        <i class="bi @GetPaymentMethodIcon(pm)"></i>
                                                        <span>@pm.Name</span>
                                                    </button>
                                                </div>
                                            }
                                        </div>

                                        <!-- Split Amount Input -->
                                        <div class="mb-3">
                                            <label class="form-label small fw-semibold text-dark mb-1">Split Amount (₱)</label>
                                            <div class="pos-tender-input-wrap">
                                                <span class="pos-currency-symbol">₱</span>
                                                <input type="number" min="0.01" step="0.01" inputmode="decimal" class="pos-tender-input"
                                                       @bind="currentSplitAmount" @bind:event="oninput" />
                                                <button type="button" class="pos-input-pill-btn" @onclick="() => currentSplitAmount = Math.Max(0m, remaining)">
                                                    Max
                                                </button>
                                            </div>
                                        </div>

                                        <!-- Reference If Required -->
                                        @if (currentSplitMethod?.RequiresReference == true)
                                        {
                                            <div class="mb-3">
                                                <label class="form-label small fw-semibold text-dark mb-1">
                                                    Reference / Approval Code <span class="text-danger">*</span>
                                                </label>
                                                <input type="text" class="form-control" @bind="currentSplitRef" @bind:event="oninput" placeholder="Enter reference number..." />
                                            </div>
                                        }

                                        <button type="button" class="btn btn-dark w-100 py-2 fw-bold d-flex align-items-center justify-content-center gap-2 rounded-3 mt-2" @onclick="AddPaymentSplit">
