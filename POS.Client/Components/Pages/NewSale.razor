@page "/new-sale"
@inject PosSessionService Session
@inject NavigationManager Navigation
@using Microsoft.EntityFrameworkCore
@using POS.Shared.Helpers
@inject ICategoryService CategoryService
@inject IProductService ProductService
@inject IModifierService ModifierService
@inject IOrderService OrderService
@inject IPaymentService PaymentService
@inject IHeldSaleService HeldSaleService
@inject CartService Cart
@inject HttpClient Http
@inject SweetAlertService Swal
@inject POS.Client.Data.LocalPosDbContext LocalDb
@inject IPosConnectivityService ConnectivityService
@inject POS.Client.Services.IOfflineCheckoutService OfflineCheckoutService
@inject IJSRuntime Js
@implements IDisposable

@if (!Session.IsAuthenticated)
{
    <div class="pos-loading-screen">
        <div class="spinner-border text-primary" role="status"></div>
        <span class="ms-2 text-muted">Redirecting to login...</span>
    </div>
}
else if (!IsSupported)
{
    <div class="sale-unavailable alert alert-warning" role="alert">
        <h4>New Sale unavailable</h4>
        @if (Session.Terminal?.BusinessTypeId == null || string.IsNullOrWhiteSpace(Session.Terminal.BusinessType))
        {
            <p>The branch business type is not configured. Contact an administrator.</p>
        }
        else
        {
            <p>Business type @Session.Terminal.BusinessType is not supported for New Sale. Contact an administrator.</p>
        }
    </div>
}
else
{
    <div class="new-sale-container">
        <!-- Left: Product Catalog & Search -->
        <div class="catalog-section">
            <!-- Header Bar Aligned with Left Container -->
            <header class="catalog-header-bar d-flex justify-content-between align-items-center mb-2">
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="hamburger-btn d-flex align-items-center justify-content-center" @onclick="ToggleNavMenu" aria-label="Toggle navigation" title="Toggle Menu">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <span class="terminal-identity">@Session.Terminal?.BranchCode • @Session.Terminal?.TerminalName</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="header-action-btn header-btn-switch" @onclick="SwitchCashier"><i class="bi bi-arrow-left-right me-1"></i>Switch Cashier</button>
                    <button type="button" class="header-action-btn header-btn-lock" @onclick="LockTerminal"><i class="bi bi-lock me-1"></i>Lock Terminal</button>
                </div>
            </header>

            @if (Layout != null && Layout.ConnectivityState != TerminalConnectivityState.OnlineAndHealthy)
            {
                <div class="alert alert-warning py-1 px-3 mb-2 small d-flex justify-content-between align-items-center rounded-3 shadow-sm" role="alert">
                    <div class="d-flex align-items-center gap-2 small fw-medium">
                        <i class="bi bi-exclamation-triangle-fill text-warning"></i>
                        <span>Offline Mode (@Layout.PendingCount pending sync)</span>
                    </div>
                    <span class="badge bg-secondary">Offline</span>
                </div>
            }

            <!-- Top Search Bar -->
            <div class="search-bar-wrap mb-2">
                <div class="position-relative">
                    <i class="bi bi-search search-icon fs-5"></i>
                    <input type="text" @ref="searchInput" aria-label="Search item or scan barcode"
                           autocomplete="off" disabled="@(isLoading || quantityDialogOpen)"
                           @onkeydown="OnSearchKeyDown"
                           class="form-control search-input ps-5 pe-5"
                           placeholder="Search by name, short code, SKU, or barcode..."
                           value="@searchQuery"
                           @oninput="OnSearchInput" />
                    @if (!string.IsNullOrEmpty(searchQuery))
                    {
                        <button type="button" class="btn btn-link clear-search-btn" @onclick="ClearSearch" title="Clear search">
                            ✕
                        </button>
                    }
                </div>
            </div>

            @if (IsRetail)
            {
                <p class="small text-muted">Search an item or scan its barcode, then press Enter.</p>
                @if (!string.IsNullOrEmpty(scanError))
                {
                    <div class="scan-error alert alert-danger" role="alert">@scanError</div>
                }
                <div class="retail-results products-grid-scroll">
                    @if (isLoading)
                    {
                        <p>Loading catalog...</p>
                    }
                    else if (string.IsNullOrWhiteSpace(searchQuery))
                    {
                        <p class="text-muted">Search or scan to find an item.</p>
                    }
                    else if (!FilteredProducts.Any())
                    {
                        <p>No matching items.</p>
                    }
                    @foreach (var product in FilteredProducts)
                    {
                        var catColor = GetCategoryColor(product.CategoryId);
                        <button type="button" class="retail-result" style="--category-color: @catColor;" disabled="@quantityDialogOpen"
                                @onclick="() => ChooseQuantity(product)">
                            <span><strong>@product.Name</strong><small>@product.SKU · @product.Barcode</small><small>@GetCategoryName(product.CategoryId)</small></span>
                            <span>₱@product.Price.ToString("N2")</span>
                        </button>
                    }
                </div>
            }
            else
            {
            <!-- Categories Bar -->
            <div class="categories-bar mb-2">
                <button type="button"
                        class="category-pill all-categories @(selectedCategoryId == null ? "active" : "")"
                        aria-pressed="@(selectedCategoryId == null ? "true" : "false")"
                        @onclick="() => SelectCategory(null)">
                    <i class="bi bi-grid-fill me-1" style="font-size: 0.8rem;"></i>
                    <span>All Categories</span>
                </button>
                @foreach (var cat in categories)
                {
                    var isSelected = selectedCategoryId == cat.CategoryId;
                    var catColor = GetCategoryColor(cat.CategoryId);
                    <button type="button"
                            class="category-pill category-item @(isSelected ? "active" : "")"
                            style="--category-color: @catColor;"
                            aria-pressed="@(isSelected ? "true" : "false")"
                            @onclick="() => SelectCategory(cat.CategoryId)">
                        <span class="category-dot" aria-hidden="true"></span>
                        <span>@cat.Name</span>
                    </button>
                }
            </div>

            <!-- Products Grid Area -->
            <div class="products-grid-scroll">
                @if (isLoading)
                {
                    <div class="text-center py-5 text-muted">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-2 small">Loading catalog...</p>
                    </div>
                }
                else if (!FilteredProducts.Any())
                {
                    <div class="empty-products text-center py-5">
                        <i class="bi bi-inbox fs-1 text-secondary mb-2 d-block"></i>
                        <h6 class="fw-bold text-dark mb-1">No products found</h6>
                        <p class="text-muted small">Try a different category or search keyword.</p>
                    </div>
                }
                else
                {
                    var inCart = CartQuantityByProduct();
                    if (selectedCategoryId == null)
                    {
                        <!-- All Categories: Grouped by Category -->
                        @foreach (var group in GroupedCategoryProducts)
                        {
                            <section class="category-group-section mb-4" @key="@(group.CategoryId ?? -1)">
                                <div class="category-group-header">
                                    <span class="category-heading-accent" style="--category-color: @group.ColorHex;" aria-hidden="true"></span>
                                    <h5 class="category-group-title">@group.CategoryName</h5>
                                    <span class="category-count-badge">@group.Products.Count</span>
                                </div>
                                <div class="products-grid">
                                    @foreach (var product in group.Products)
                                    {
                                        var cartQty = inCart.GetValueOrDefault(product.ProductId);
                                        var catColor = group.ColorHex;
                                        <button type="button" @key="product.ProductId"
                                                class="product-card @(cartQty > 0 ? "in-cart" : "")"
                                                style="--category-color: @catColor;"
                                                title="@product.Name"
                                                @onclick="() => AddToCart(product)">
                                            @if (cartQty > 0)
                                            {
                                                <span class="product-qty" aria-label="@cartQty in order">@cartQty</span>
                                            }
                                            <span class="product-name">@product.Name</span>
                                        </button>
                                    }
                                </div>
                            </section>
                        }
                    }
                    else
                    {
                        <!-- Single Category View -->
                        <div class="products-grid">
                            @foreach (var product in FilteredProducts)
                            {
                                var cartQty = inCart.GetValueOrDefault(product.ProductId);
                                var catColor = GetCategoryColor(product.CategoryId);
                                <button type="button" @key="product.ProductId"
                                        class="product-card @(cartQty > 0 ? "in-cart" : "")"
                                        style="--category-color: @catColor;"
                                        title="@product.Name"
                                        @onclick="() => AddToCart(product)">
                                    @if (cartQty > 0)
                                    {
                                        <span class="product-qty" aria-label="@cartQty in order">@cartQty</span>
                                    }
                                    <span class="product-name">@product.Name</span>
                                </button>
                            }
                        </div>
                    }
                }
            </div>
            }
        </div>

        <!-- Right: Current Order Cart -->
        <div class="order-section">
            <div class="order-card shadow-sm">
                <!-- Service Mode & Table / Pax Bar (for F&B) -->
                @if (!IsRetail)
                {
                    <div class="order-service-bar">
                        <div class="d-flex gap-1 mb-1">
                            <button type="button" class="service-mode-btn flex-fill @(selectedServiceMode == "DINING" ? "svc-dinein-active" : "svc-inactive")" @onclick='() => SetServiceMode("DINING")'>
                                <i class="bi bi-cup-hot me-1"></i> Dine-In
                            </button>
                            <button type="button" class="service-mode-btn flex-fill @(selectedServiceMode == "TAKEOUT" ? "svc-takeout-active" : "svc-inactive")" @onclick='() => SetServiceMode("TAKEOUT")'>
                                <i class="bi bi-bag me-1"></i> Takeout
                            </button>
                            <button type="button" class="service-mode-btn flex-fill @(selectedServiceMode == "DELIVERY" ? "svc-delivery-active" : "svc-inactive")" @onclick='() => SetServiceMode("DELIVERY")'>
                                <i class="bi bi-truck me-1"></i> Delivery
                            </button>
                        </div>

                        <div class="d-flex gap-2">
                            <div class="flex-fill">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text py-1"><i class="bi bi-grid-3x3-gap"></i></span>
                                    <input type="text" class="form-control py-1" placeholder="Table #" @bind="tableNumber" />
                                </div>
                            </div>
                            @if (selectedServiceMode == "DINING")
                            {
                                <div style="width: 105px;">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text py-1" title="Guests / Pax"><i class="bi bi-people"></i></span>
                                        <input type="number" class="form-control py-1" min="1" max="99" placeholder="Pax" @bind="headCount" />
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Order Header -->
                <div class="order-header d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <h6 class="fw-bold mb-0 text-dark">Current Order</h6>
                        <span class="order-badge">@Cart.TotalItems @(Cart.TotalItems == 1 ? "item" : "items")</span>
                    </div>
                    @if (Cart.Items.Any())
                    {
                        @if (selectedCartItems.Any())
                        {
                            <button type="button" class="delete-selected-btn" @onclick="DeleteSelectedItems" title="Delete selected items">
                                <i class="bi bi-trash3 me-1"></i> Delete (@selectedCartItems.Count)
                            </button>
                        }
                        else
                        {
                            <button type="button" class="clear-cart-btn" @onclick="ClearCart" title="Clear all items">
                                <i class="bi bi-trash3 me-1"></i> Clear
                            </button>
                        }
                    }
                </div>

                <!-- Cart Items List -->
                <div class="order-items-scroll @(Cart.Items.Count >= 6 ? "has-scroll" : "no-scroll")">
                    @if (!Cart.Items.Any())
                    {
                        <div class="empty-cart text-center py-5">
                            <i class="bi bi-cart3 fs-1 text-muted mb-2 d-block"></i>
                            <p class="text-muted fw-medium mb-1">Your cart is empty</p>
                            <small class="text-secondary">Tap any product on the left to add items</small>
                        </div>
                    }
                    else
                    {
                        <div class="cart-items-list">
                            @foreach (var item in Cart.Items)
                            {
                                var isItemSelected = selectedCartItems.Contains(item);
                                <div class="cart-item-row @(isItemSelected ? "is-selected" : "")">
                                    <div class="cart-item-select">
                                        <label class="custom-checkbox" @onclick:stopPropagation="true">
                                            <input type="checkbox"
                                                   checked="@isItemSelected"
                                                   @onchange="() => ToggleSelectCartItem(item)" />
                                            <span class="checkmark"></span>
                                        </label>
                                    </div>
                                    <div class="cart-item-info">
                                        <div class="cart-item-name" title="@item.ProductName">@item.ProductName</div>
                                        <div class="cart-item-unit-price text-muted">₱@item.UnitPrice.ToString("N2") each</div>
                                        @if (item.SelectedModifiers != null && item.SelectedModifiers.Any())
                                        {
                                            <div class="cart-item-modifiers">
                                                @foreach (var mod in item.SelectedModifiers)
                                                {
                                                    <div class="cart-modifier-row">
                                                        <span>+ @mod.Name</span>
                                                        @if (mod.Price > 0)
                                                        {
                                                            <span class="mod-price">₱@mod.Price.ToString("N2")</span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="cart-item-actions">
                                        <div class="qty-control">
                                            <button type="button" class="qty-btn" @onclick="() => Cart.DecreaseQuantity(item)" title="Decrease">
                                                −
                                            </button>
                                            <span class="qty-display">@item.Quantity</span>
                                            <button type="button" class="qty-btn" @onclick="() => Cart.IncreaseQuantity(item)" title="Increase">
                                                +
                                            </button>
                                        </div>
                                        <div class="cart-item-total">
                                            ₱@item.LineTotal.ToString("N2")
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Order Summary & Checkout -->
                <div class="order-footer">
                    <div class="order-totals">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted small">Subtotal</span>
                            <span class="fw-semibold small">₱@Cart.Subtotal.ToString("N2")</span>
                        </div>
                        @if (Cart.ActiveDiscountCode != "NONE")
                        {
                            <div class="d-flex justify-content-between mb-1 text-success small">
                                <span>Discount (@Cart.ActiveDiscountCode)</span>
                                <span class="fw-semibold small">-₱@Cart.ActiveDiscountAmount.ToString("N2")</span>
                            </div>
                        }
                        <div class="d-flex justify-content-between align-items-baseline mb-2">
                            <span class="fw-bold fs-6 text-dark">Total</span>
                            <span class="fw-bolder fs-4 text-primary">₱@((Cart.Subtotal - Cart.ActiveDiscountAmount).ToString("N2"))</span>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mb-2">
                        <button type="button"
                                class="footer-action-btn btn-discount"
                                disabled="@(!Cart.Items.Any())"
                                @onclick="OpenDiscountModal">
                            <i class="bi bi-percent me-1"></i> Discount
                        </button>
                        <button type="button"
                                class="footer-action-btn btn-hold-sale"
                                disabled="@(!Cart.Items.Any())"
                                @onclick="HoldCurrentSale">
                            <i class="bi bi-pause-fill me-1"></i> Hold Sale
                        </button>
                    </div>
                    <div class="d-grid">
                        <button type="button"
                                class="btn btn-primary w-100 py-2 fw-bold btn-proceed-payment"
                                disabled="@(isProcessingPayment || openingBusy || openingShiftModal || isPaymentModalOpen || !Cart.Items.Any())"
                                @onclick="ProceedToPayment">
                            Proceed to Payment
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Discount Modal Component -->
    <DiscountModal @ref="discountModalComponent" Cart="@Cart" OnDiscountChanged="@StateHasChanged" />

    <!-- Customization Modal -->
    @if (isCustomizationOpen && customizingProduct != null)
    {
        <div class="modal fade show d-block pos-sale-modal customization-modal-overlay" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.7); backdrop-filter: blur(5px); z-index: 1060;" role="dialog" aria-modal="true" aria-labelledby="customization-modal-title">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg customization-modal-dialog">
                <div class="modal-content customization-modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                    <!-- Modal Header -->
                    <div class="modal-header border-bottom px-4 py-3 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-3">
                            <div>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <h4 id="customization-modal-title" class="modal-title fw-bold text-white mb-0">@customizingProduct.Name</h4>
                                    @if (!string.IsNullOrEmpty(customizingProduct.CategoryName))
                                    {
                                        var catColor = GetCategoryColor(customizingProduct.CategoryId);
                                        <span class="badge rounded-pill px-2.5 py-1" style="background-color: @(catColor)22; color: @catColor; border: 1px solid @(catColor)44;">
                                            @customizingProduct.CategoryName
                                        </span>
                                    }
                                </div>
                                <div class="text-secondary small mt-1 d-flex align-items-center gap-2">
                                    @if (customizingProduct.Price > 0)
                                    {
                                        <span>Base Price: <strong class="text-white">₱@customizingProduct.Price.ToString("N2")</strong></span>
                                    }
                                    @if (!string.IsNullOrEmpty(customizingProduct.SKU))
                                    {
                                        <span class="text-muted">• SKU: @customizingProduct.SKU</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <button type="button" class="btn btn-link text-secondary p-1 modal-close-btn" @onclick="CloseCustomizationModal" aria-label="Close" title="Cancel">
                            <i class="bi bi-x-lg fs-5"></i>
                        </button>
                    </div>

                    <!-- Modal Body -->
                    <div class="modal-body px-4 py-3">
                        @if (!string.IsNullOrEmpty(customizationError))
                        {
                            <div class="alert alert-danger d-flex align-items-center gap-2 py-2 mb-3 rounded-3" role="alert">
                                <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                                <div>@customizationError</div>
                            </div>
                        }

                        @foreach (var group in currentModifierGroups)
                        {
                            var set = selectedOptionIdsByGroup.TryGetValue(group.ModifierGroupId, out var s) ? s : new HashSet<int>();
                            var isRadio = group.MaxSelections == 1;
                            var groupVisuals = GetModifierGroupVisuals(group);
                            var isRequired = group.IsRequired || group.MinSelections > 0;
                            var requiredMin = group.IsRequired ? Math.Max(1, group.MinSelections) : group.MinSelections;
                            var isFulfilled = (!isRequired || set.Count >= requiredMin) && (group.MaxSelections <= 0 || set.Count <= group.MaxSelections);

                            <section class="modifier-group-section mb-3 p-3 rounded-4" @key="group.ModifierGroupId">
                                <div class="d-flex justify-content-between align-items-center mb-2.5 flex-wrap gap-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="group-icon-pill @groupVisuals.PillClass">
                                            <i class="bi @groupVisuals.IconClass fs-5"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-white mb-0">
                                                @group.ModifierGroupName
                                                @if (isRequired)
                                                {
                                                    <span class="text-danger ms-1" title="Required selection">*</span>
                                                }
                                            </h6>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (isRequired)
                                        {
                                            <span class="badge modifier-rule-badge required">
                                                Required • @(isRadio ? "Choose 1" : (group.MinSelections == group.MaxSelections ? $"Choose {group.MinSelections}" : $"Choose {group.MinSelections}–{group.MaxSelections}"))
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge modifier-rule-badge optional">
                                                Optional @(group.MaxSelections > 0 ? $"• Max {group.MaxSelections}" : "")
                                            </span>
                                        }
                                        <span class="small fw-semibold @(isFulfilled && set.Count > 0 ? "text-success" : "text-secondary")">
                                            @if (isFulfilled && set.Count > 0)
                                            {
                                                <i class="bi bi-check2 me-1"></i>
                                            }
                                            (@set.Count@(group.MaxSelections > 0 ? $"/{group.MaxSelections}" : ""))
                                        </span>
                                    </div>
                                </div>

                                <!-- Modifier Options Grid -->
                                <div class="modifier-grid" role="group" aria-label="@group.ModifierGroupName">
                                    @foreach (var option in group.Options.Where(o => o.IsActive).OrderBy(o => o.DisplayOrder))
                                    {
                                        var isSelected = set.Contains(option.ModifierOptionId);
                                        <button type="button"
                                                class="modifier-card @(isSelected ? "selected" : "")"
                                                aria-pressed="@(isSelected ? "true" : "false")"
                                                role="@(isRadio ? "radio" : "checkbox")"
                                                aria-checked="@(isSelected ? "true" : "false")"
                                                @onclick="() => { if (isRadio) SelectRadioOption(group, option); else ToggleCheckboxOption(group, option, !isSelected); }">
                                            <div class="modifier-card-left">
                                                <span class="modifier-indicator">
                                                    @if (isRadio)
                                                    {
                                                        <i class="bi @(isSelected ? "bi-check-circle-fill text-primary" : "bi-circle text-secondary") fs-5"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi @(isSelected ? "bi-check-square-fill text-primary" : "bi-square text-secondary") fs-5"></i>
                                                    }
                                                </span>
                                                <span class="modifier-name">@option.Name</span>
                                            </div>
                                            <div class="modifier-card-right">
                                                @if (option.Price > 0)
                                                {
                                                    <span class="price-badge extra">+₱@option.Price.ToString("N2")</span>
                                                }
                                                else if (option.Price < 0)
                                                {
                                                    <span class="price-badge discount">-₱@Math.Abs(option.Price).ToString("N2")</span>
                                                }
                                                else
                                                {
                                                    <span class="price-badge free">Included</span>
                                                }
                                            </div>
                                        </button>
                                    }
                                </div>
                            </section>
                        }
                    </div>

                    <!-- Modal Footer -->
                    <div class="modal-footer border-top px-4 py-3 d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div>
                            <span class="text-secondary small fw-bold text-uppercase d-block" style="letter-spacing: 0.5px; font-size: 0.72rem;">Total Item Price</span>
                            <div class="d-flex align-items-baseline gap-2">
                                <div class="fw-bolder fs-3 text-primary">₱@CustomizationTotalPrice.ToString("N2")</div>
                                @if (CustomizationTotalPrice > customizingProduct.Price)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-0.5 small">
                                        +₱@((CustomizationTotalPrice - customizingProduct.Price).ToString("N2")) extras
                                    </span>
                                }
                            </div>
                        </div>

                        @{
                            var validation = GetCustomizationValidationState();
                        }

                        @if (!validation.IsValid && !string.IsNullOrEmpty(validation.MissingMessage))
                        {
                            <div class="customization-validation-pill d-flex align-items-center gap-1.5 small">
                                <i class="bi bi-info-circle-fill"></i>
                                <span>@validation.MissingMessage</span>
                            </div>
                        }

                        <div class="d-flex gap-2 ms-auto">
                            <button type="button" class="btn btn-outline-secondary px-3.5 py-2 rounded-3 fw-semibold" @onclick="CloseCustomizationModal">
                                Cancel
                            </button>
                            <button type="button"
                                    class="btn btn-primary px-4 py-2 rounded-3 fw-bold shadow-sm d-flex align-items-center gap-2"
                                    disabled="@(!validation.IsValid)"
                                    @onclick="ConfirmCustomization">
                                <i class="bi bi-cart-plus-fill fs-5"></i>
                                <span>Add to Cart</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}

@if (paidReceiptOrderId.HasValue || paidOfflineReceipt != null)
{
