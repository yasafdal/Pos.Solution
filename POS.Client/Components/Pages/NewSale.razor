@if (isPaymentModalOpen && currentOrderResponse != null)
{
        <div class="modal fade show d-block pos-sale-modal payment-modal-overlay" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.55); backdrop-filter: blur(4px); z-index: 1070;" role="dialog" aria-modal="true" aria-labelledby="payment-modal-title">
            <div class="modal-dialog modal-dialog-centered pos-payment-modal-dialog">
            <div class="modal-content pos-payment-modal-content">
                <!-- Modal Header -->
                <div class="pos-payment-header">
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h5 id="payment-modal-title" class="modal-title fw-bold text-white mb-0">Payment</h5>
                            @if (isOffline)
                            {
                                <span class="badge bg-warning text-dark fw-semibold" style="font-size: 0.7rem;">OFFLINE CASH ONLY</span>
                            }
                        </div>
                        <span class="text-secondary small">Order: <strong class="text-white">@currentOrderResponse.OrderNumber</strong></span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <!-- Touch-friendly Split Bill Toggle Pill -->
                        <button type="button"
                                class="pos-split-pill-toggle @(isSplitPaymentMode ? "active" : "")"
                                @onclick="() => ToggleSplitPayment(!isSplitPaymentMode)"
                                disabled="@isProcessingPayment"
                                role="switch"
                                aria-checked="@(isSplitPaymentMode ? "true" : "false")"
                                title="Toggle Split Bill Mode">
                            <span class="pos-split-pill-track">
                                <span class="pos-split-pill-thumb"></span>
                            </span>
                            <span class="pos-split-pill-text">Split Bill</span>
                            <span class="pos-split-pill-badge">@(isSplitPaymentMode ? "ON" : "OFF")</span>
                        </button>

                        <div class="vr mx-1" style="height: 26px; opacity: 0.2;"></div>

                        <!-- Touch-friendly Close Button -->
                        <button type="button" class="pos-modal-close-btn" @onclick="ClosePaymentModal" disabled="@isProcessingPayment" aria-label="Close payment" title="Close (Cancel)">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                </div>

                <!-- Modal Body (Single Scroll Container, No Double Scroll) -->
                <div class="pos-payment-body">
                    @if (!string.IsNullOrEmpty(paymentError))
                    {
                        <div class="alert alert-danger py-2 px-3 mb-3 d-flex align-items-center gap-2 small rounded-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                            <div>@paymentError</div>
                        </div>
                    }

                    <fieldset class="pos-payment-fields" disabled="@isProcessingPayment">
                    <div class="pos-payment-grid">
                        <!-- LEFT COLUMN: Due Card + Payment Methods + Customer Info -->
                        <div class="pos-payment-left-col">
                            <!-- Hero Amount Due Card -->
                            <div class="pos-due-card">
                                <div class="pos-due-label">TOTAL AMOUNT DUE</div>
                                <div class="pos-due-amount">₱@currentOrderResponse.TotalAmount.ToString("N2")</div>
                                @if (isSplitPaymentMode)
                                {
                                    var paid = paymentSplits.Sum(s => s.Amount);
                                    var remaining = currentOrderResponse.TotalAmount - paid;
                                    <div class="pos-split-progress-wrap mt-2">
                                        <div class="d-flex justify-content-between small text-white-50 mb-1">
                                            <span>Paid: ₱@paid.ToString("N2")</span>
                                            <span class="@(remaining <= 0.01m ? "text-success fw-bold" : "text-warning fw-semibold")">
                                                Remaining: ₱@(Math.Max(0m, remaining).ToString("N2"))
                                            </span>
                                        </div>
                                        <div class="progress" style="height: 5px; background: rgba(255,255,255,0.25);">
                                            <div class="progress-bar bg-success" style="width: @(Math.Min(100, currentOrderResponse.TotalAmount > 0 ? (paid / currentOrderResponse.TotalAmount * 100) : 0))%"></div>
                                        </div>
                                    </div>
