                            {
                                <!-- CARD / E-WALLET / DIGITAL TENDER -->
                                <div class="pos-action-panel">
                                    <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3 mb-3 border">
                                        <div class="pos-ref-icon-wrap">
                                            <i class="bi @GetPaymentMethodIcon(selectedPaymentMethod) text-primary fs-3"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-0">@selectedPaymentMethod.Name</h6>
                                            <div class="text-muted small">Exact charge: <strong class="text-primary">₱@currentOrderResponse.TotalAmount.ToString("N2")</strong></div>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label for="ref-number" class="pos-section-label">
                                            REFERENCE / APPROVAL CODE <span class="text-danger">*</span>
                                        </label>
                                        <div class="position-relative">
                                            <input id="ref-number" type="text" @bind="referenceNumber" @bind:event="oninput"
                                                   disabled="@isProcessingPayment"
                                                   class="form-control form-control-lg fw-bold ps-3"
                                                   placeholder="Enter terminal ref or approval code..." />
                                        </div>
                                        <div class="form-text small text-muted mt-2">
                                            <i class="bi bi-info-circle me-1"></i> Check POS terminal receipt slip or customer's e-wallet success screen.
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <!-- CASH TENDER -->
                                <div class="pos-action-panel">
                                    <!-- Quick Cash Suggestions -->
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <label class="pos-section-label mb-0">QUICK TENDER SHORTCUTS</label>
                                    </div>
                                    <div class="pos-quick-cash-row">
                                        @foreach (var amt in GetSuggestedAmounts(currentOrderResponse.TotalAmount))
                                        {
                                            var isExact = amt == currentOrderResponse.TotalAmount;
                                            var isSelected = cashTendered == amt;
                                            <button type="button"
                                                    class="pos-quick-cash-btn @(isExact ? "exact" : "") @(isSelected ? "active" : "")"
                                                    disabled="@isProcessingPayment"
                                                    @onclick="() => cashTendered = amt">
                                                @(isExact ? $"Exact (₱{amt:N2})" : $"₱{amt:N0}")
                                            </button>
                                        }
                                    </div>

                                    <!-- Amount Tendered Input -->
                                    <div class="mb-2">
                                        <label for="cash-tendered" class="pos-section-label">AMOUNT TENDERED</label>
                                        <div class="pos-tender-input-wrap">
                                            <span class="pos-currency-symbol">₱</span>
                                            <input id="cash-tendered" type="number" min="0" step="0.01" inputmode="decimal"
                                                   disabled="@isProcessingPayment"
                                                   class="pos-tender-input"
                                                   @bind="cashTendered" @bind:event="oninput"
                                                   placeholder="0.00" />
                                            <button type="button" class="pos-input-pill-btn" title="Set to Exact Amount"
                                                    @onclick="() => cashTendered = currentOrderResponse.TotalAmount">
                                                Exact
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Quick Bill Denominations (+20, +50, +100, +500, +1000) -->
                                    <div class="pos-denominations-wrap mb-3">
                                        <span class="text-muted small fw-semibold me-2" style="font-size: 0.72rem;">Add Bills:</span>
                                        <div class="d-flex gap-1 flex-wrap">
                                            @foreach (var bill in new[] { 20m, 50m, 100m, 500m, 1000m })
                                            {
                                                var b = bill;
                                                <button type="button" class="pos-denom-btn" @onclick="() => AddCashBill(b)">
                                                    +₱@b.ToString("N0")
                                                </button>
                                            }
                                            <button type="button" class="pos-denom-btn text-danger border-danger-subtle" title="Clear to 0" @onclick="() => cashTendered = 0m">
                                                Clear
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Live Change Due Display -->
                                    @if (cashTendered >= currentOrderResponse.TotalAmount)
                                    {
                                        <div class="pos-change-card success">
                                            <div>
                                                <div class="pos-change-label">CHANGE DUE</div>
                                                <small class="opacity-75">Return to customer</small>
                                            </div>
                                            <div class="pos-change-val">₱@(Math.Max(0m, cashTendered - currentOrderResponse.TotalAmount).ToString("N2"))</div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="pos-change-card warning">
                                            <div>
                                                <div class="pos-change-label">AMOUNT SHORT</div>
                                                <small class="opacity-75">Tendered is below total</small>
                                            </div>
                                            <div class="pos-change-val">-₱@((currentOrderResponse.TotalAmount - cashTendered).ToString("N2"))</div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                    </fieldset>
                </div>
                <div class="pos-payment-footer">
                    <button type="button" class="btn btn-outline-secondary px-4 py-2 rounded-3 fw-semibold" @onclick="ClosePaymentModal" disabled="@isProcessingPayment">
                        Cancel
                    </button>
                    <button type="button" class="pos-confirm-btn"
                            disabled="@IsConfirmDisabled()"
                            @onclick="ConfirmPayment">
                        @if (isProcessingPayment)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Processing...</span>
                        }
                        else
                        {
                            <i class="bi bi-check2-circle fs-5"></i>
                            <span>Confirm Payment</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}


