    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (!IsRetail || isLoading || quantityDialogOpen || e.Key != "Enter" || e.Repeat) return;
        if (string.IsNullOrEmpty(searchQuery)) return;
        scanError = null;
        // Barcode identifiers are strings: exact match only, including leading zeros.
        var matches = products.Where(p => string.Equals(p.Barcode, searchQuery, StringComparison.Ordinal)).Take(2).ToList();
        if (matches.Count == 1) await ChooseQuantity(matches[0]);
        else
        {
            scanError = matches.Count == 0 ? "No product has this barcode." : "Multiple products have this barcode. Contact an administrator.";
            searchQuery = string.Empty;
            restoreSearchFocus = true;
        }
    }

    private async Task ChooseQuantity(ProductDto product)
    {
        if (quantityDialogOpen || disposed || !Session.IsAuthenticated) return;
        quantityDialogOpen = true;
        try
        {
            var result = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Quantity",
                Text = product.Name,
                Input = SweetAlertInputType.Text,
                InputLabel = "Quantity",
                InputValue = "1",
                ShowCancelButton = true,
                ConfirmButtonText = "Add to cart",
                ReturnFocus = false,
                InputAutoTrim = false,
                InputAttributes = new Dictionary<string, string> { ["inputmode"] = "numeric", ["autocomplete"] = "off" },
                InputValidator = new InputValidatorCallback(value => ValidQuantity(value, out _)
                    ? string.Empty : "Enter a positive whole number that fits the current order.")
            });
            if (result.IsConfirmed && ValidQuantity(result.Value, out var quantity))
                Cart.AddItem(product, quantity);
        }
        finally
        {
            quantityDialogOpen = false;
            searchQuery = string.Empty;
            restoreSearchFocus = true;
        }
    }

    private bool ValidQuantity(string? value, out int quantity) =>
        int.TryParse(value, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out quantity)
        && quantity > 0 && quantity <= int.MaxValue - Cart.TotalItems;

