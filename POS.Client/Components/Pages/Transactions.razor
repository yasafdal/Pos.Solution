@page "/transactions"
@inject PosSessionService Session
@inject NavigationManager Navigation
@inject POS.Client.Services.IClientTransactionHistoryService TransactionService
@inject IReceiptPrinter ReceiptPrinter
@inject SweetAlertService Swal
@inject IUserService UserService
@inject HttpClient Http
@inject POS.Client.Services.IPosConnectivityService ConnectivityService
@inject POS.Client.Workers.IOfflineBackgroundSyncService BackgroundSyncService
@inject POS.Client.Services.IOfflineTransactionSyncService TransactionSyncService
@using POS.Shared.Constants
@using POS.Shared.Models
@using POS.Shared.Interfaces
@using POS.Shared.Services
@using POS.Client.Data
@using Microsoft.EntityFrameworkCore
@implements IDisposable

@if (!Session.IsAuthenticated)
{
    <div class="p-4 text-center text-muted">
        <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
        Redirecting to login...
    </div>
}
else if (!Session.CanViewTransactionHistory)
{
    <div class="p-4">
        <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-3 rounded-4 p-4" role="alert">
            <div>
                <h5 class="fw-bold mb-1"><i class="bi bi-shield-lock-fill me-2"></i>Access Restricted</h5>
                <div class="small">Transaction History is restricted to authorized supervisory roles (Admin, Manager, or Senior Cashier).</div>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-primary fw-bold rounded-3 px-4 py-2" @onclick='() => Navigation.NavigateTo("/new-sale", replace: true)'>
                    <i class="bi bi-cart-fill me-1"></i> Go to New Sale
                </button>
                <button type="button" class="btn btn-outline-dark fw-semibold rounded-3 px-3 py-2" @onclick='() => Navigation.NavigateTo("/", replace: true)'>
                    Dashboard
                </button>
            </div>
        </div>
    </div>
}
else
{
    <div class="transaction-page p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
            <div>
                <h3 class="fw-bold text-dark mb-1">
                    @if (activeMode == "reprint")
                    {
                        <i class="bi bi-printer-fill text-primary me-2"></i><span>Reprint Receipt</span>
                    }
                    else if (activeMode == "void")
                    {
                        <i class="bi bi-x-circle-fill text-danger me-2"></i><span>Void Transaction</span>
                    }
                    else
                    {
                        <i class="bi bi-receipt text-info me-2"></i><span>Transaction History</span>
                    }
                </h3>
                <p class="text-secondary small mb-0">
                    Sales since @currentBusinessDayStartLocal.ToString("MMM dd, yyyy 04:00 tt") for Terminal #@(Session.Terminal?.TerminalId.ToString() ?? "—") (@(Session.Terminal?.TerminalName ?? "Terminal"))
                    @if (isOfflineMode)
                    {
                        <span class="badge bg-warning text-dark px-2 py-1 ms-2"><i class="bi bi-wifi-off me-1"></i> Offline Mode (Local)</span>
                    }
                </p>
                @if (!string.IsNullOrEmpty(loadError))
                {
                    <div class="alert alert-warning py-2 px-3 mt-2 mb-0 small" role="alert">@loadError</div>
                }
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <div class="btn-group" role="group" aria-label="Transaction Workspace Mode">
                    <button type="button" class="btn btn-sm @(activeMode == "all" ? "btn-primary fw-bold" : "btn-outline-secondary text-light") px-3" @onclick='() => SetWorkspaceMode("all")'>
                        <i class="bi bi-list-ul me-1"></i>All
                    </button>
                    <button type="button" class="btn btn-sm @(activeMode == "reprint" ? "btn-primary fw-bold" : "btn-outline-secondary text-light") px-3" @onclick='() => SetWorkspaceMode("reprint")'>
                        <i class="bi bi-printer me-1"></i>Reprint
                    </button>
                    <button type="button" class="btn btn-sm @(activeMode == "void" ? "btn-danger fw-bold" : "btn-outline-secondary text-light") px-3" @onclick='() => SetWorkspaceMode("void")'>
                        <i class="bi bi-x-circle me-1"></i>Void
                    </button>
                </div>
                <button class="btn btn-outline-primary btn-sm px-3 fw-medium rounded-3" @onclick="LoadTransactions">
                    <i class="bi bi-arrow-repeat me-1"></i> Refresh
                </button>
            </div>
        </div>

        @if (activeMode == "reprint")
        {
            <div class="alert alert-info py-2 px-3 mb-3 d-flex align-items-center justify-content-between small rounded-3 border-0" style="background: rgba(59, 130, 246, 0.15); color: #93c5fd;">
                <span><i class="bi bi-printer-fill me-2"></i><strong>Reprint Mode:</strong> Showing paid transactions for the current business day. Tap <strong>Reprint</strong> on any row or open <strong>View</strong> to reprint preparation tickets.</span>
            </div>
        }
        else if (activeMode == "void")
        {
            <div class="alert alert-danger py-2 px-3 mb-3 d-flex align-items-center justify-content-between small rounded-3 border-0" style="background: rgba(239, 68, 68, 0.15); color: #fca5a5;">
                <span><i class="bi bi-shield-lock-fill me-2"></i><strong>Void Mode:</strong> Select a paid transaction and tap <strong>Void</strong> to enter the void reason and Supervisor / Manager PIN authorization.</span>
            </div>
        }

        <!-- Filter Card -->
        <div class="transaction-filter-card card p-3 mb-4">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label text-dark fw-semibold small mb-1">Search Invoice / Order #</label>
                    <input type="text" class="form-control form-control-sm rounded-3" placeholder="e.g. 5000001" @bind="filter.InvoiceNumber" />
                </div>
                <div class="col-md-4">
                    <label class="form-label text-dark fw-semibold small mb-1">Payment Status</label>
                    <select class="form-select form-select-sm rounded-3" @bind="filter.PaymentStatus">
                        <option value="">All Statuses</option>
                        <option value="PAID">Paid</option>
                        <option value="UNPAID">Unpaid</option>
                        <option value="VOIDED">Voided</option>
                    </select>
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button class="btn btn-primary btn-sm rounded-3 px-3 fw-bold shadow-sm w-100 py-2" @onclick="LoadTransactions">
                        Filter
                    </button>
                    <button class="btn btn-outline-secondary btn-sm rounded-3 px-3 fw-medium w-100 py-2" @onclick="ResetFilters">
                        Reset
                    </button>
                </div>
            </div>
        </div>

        <!-- Transactions Table Card -->
        <div class="transaction-table-card card">
            @if (transactions == null)
            {
                <div class="text-center py-5 text-muted">
                    <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                    Loading transactions...
                </div>
            }
            else if (!transactions.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-receipt fs-1 text-secondary mb-2 d-block"></i>
                    <p class="mb-0 fw-medium">No completed transactions found.</p>
                </div>
            }
            else
            {
                <div class="transaction-table-scroll table-responsive">
                <table class="transaction-table table align-middle mb-0">
                <thead class="table-light text-uppercase fs-7 text-secondary">
                    <tr>
                        <th class="py-3 px-4">Date / Time</th>
                        <th class="py-3">Invoice #</th>
                        <th class="py-3">Order #</th>
                        <th class="py-3">Cashier</th>
                        <th class="py-3">Status</th>
                        <th class="py-3 text-end">Total</th>
                        <th class="py-3 text-end px-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in transactions)
                    {
                        <tr>
                            <td class="transaction-date px-4 small">@POS.Shared.Services.BusinessDayClock.FormatManila(t.CreatedAt, "MMM dd, yyyy")<span>@POS.Shared.Services.BusinessDayClock.FormatManila(t.CreatedAt, "HH:mm")</span></td>
                            <td class="transaction-invoice fw-semibold font-monospace">@(t.InvoiceNumber ?? "—")</td>
                            <td>@t.OrderNumber</td>
                            <td>@t.CashierId</td>
                            <td>
                                @if (t.PaymentStatus == "PAID")
                                {
                                    <span class="transaction-status-badge paid">PAID</span>
                                }
                                else if (t.PaymentStatus == "VOIDED" || t.OrderStatus == "VOIDED")
                                {
                                    <span class="transaction-status-badge voided">VOIDED</span>
                                }
                                else
                                {
                                    <span class="transaction-status-badge unpaid">UNPAID</span>
                                }
                            </td>
                            <td class="transaction-total text-end fw-bold">₱@t.TotalAmount.ToString("N2")</td>
                            <td class="transaction-actions text-end px-4">
                                <div class="d-flex justify-content-end gap-2">
                                    <button type="button" class="btn btn-sm btn-info text-white rounded-3 px-3" @onclick="() => ViewDetails(t.OrderId)" title="View Details">
                                        <i class="bi bi-eye"></i> View
                                    </button>
                                    @if (t.PaymentStatus == "PAID")
                                    {
                                        <button type="button" class="btn btn-sm @(activeMode == "reprint" ? "btn-primary fw-bold shadow-sm" : "btn-secondary") text-white rounded-3 px-3" @onclick="() => ReprintInvoice(t.OrderId)" title="Reprint Receipt">
                                            <i class="bi bi-printer"></i> Reprint
                                        </button>
                                        @if (t.OrderStatus != "VOIDED")
                                        {
                                            <button type="button" class="btn btn-sm @(activeMode == "void" ? "btn-danger fw-bold shadow-sm text-white" : "btn-outline-danger") rounded-3 px-3" @onclick="() => OpenVoidModal(t)" title="Void Transaction">
                                                <i class="bi bi-x-circle"></i> Void
                                            </button>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
                </table>
                </div>
            }
        </div>
    </div>

    <!-- Transaction Detail Modal -->
    @if (isDetailModalOpen && selectedOrder != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.5); backdrop-filter: blur(3px);" role="dialog" aria-modal="true">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
                <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                    <div class="modal-header border-bottom px-4 py-3 d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="fw-bold text-dark mb-0">Transaction Receipt (#@selectedOrder.OrderNumber)</h5>
                            <small class="text-secondary">Invoice: @(selectedOrder.InvoiceNumber ?? "N/A") | Time: @POS.Shared.Services.BusinessDayClock.FormatManila(selectedOrder.CreatedAt, "yyyy-MM-dd HH:mm")</small>
                        </div>
                        <button type="button" class="btn-close shadow-none" @onclick="CloseDetailModal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body px-4 py-3 bg-light">
                        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                            <div class="text-center mb-3">
                                @if (!string.IsNullOrWhiteSpace(Session.Terminal?.ReceiptLogoDataUri))
                                {
                                    <div class="mb-2">
                                        <img src="@Session.Terminal!.ReceiptLogoDataUri" alt="Receipt Logo" style="max-width: 160px; max-height: 70px; width: auto; height: auto; object-fit: contain; filter: grayscale(100%) contrast(135%);" />
                                    </div>
                                }
                                <h5 class="fw-bold mb-1">@(Session.Terminal?.BranchName ?? $"Terminal #{selectedOrder.TerminalId}")</h5>
                                @if (!string.IsNullOrWhiteSpace(Session.Terminal?.BranchTagline))
                                {
                                    <div class="text-secondary small mb-1" style="font-size: 0.85rem;">@Session.Terminal.BranchTagline</div>
                                }
                                <small class="text-muted">Terminal #@selectedOrder.TerminalId &bull; Cashier: @selectedOrder.CashierId</small>
                            </div>
                            <hr />
                            <div class="mb-3">
                                @foreach (var item in selectedOrder.Items)
                                {
                                    <div class="d-flex justify-content-between mb-2">
                                        <div>
                                            <span class="fw-semibold text-dark">@(item.IsComplimentary ? $"{item.ProductName} [COMPLIMENTARY]" : item.ProductName)</span><br />
                                            <small class="text-secondary">@ReceiptPresentationHelper.FormatItemSubline(item, "₱")</small>
                                            @if (item.Modifiers != null && item.Modifiers.Any())
                                            {
                                                <div class="ps-2 mt-1">
                                                    @foreach (var mod in item.Modifiers)
                                                    {
                                                        <div class="text-secondary" style="font-size: 0.78rem;">+ @mod.ModifierName @(mod.AdditionalPrice > 0 ? $"(+₱{mod.AdditionalPrice:N2})" : (ReceiptPresentationHelper.ShouldShowFreeModifierLabel(item, mod) ? "(Free)" : ""))</div>
                                                    }
                                                </div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(item.SpecialInstructions))
                                            {
                                                <div class="ps-2 mt-1">
                                                    <span class="badge bg-warning-subtle text-dark border border-warning-subtle fw-semibold" style="font-size: 0.75rem; white-space: normal; text-align: left;">
                                                        <i class="bi bi-chat-left-text me-1"></i>@item.SpecialInstructions
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                        <span class="fw-bold text-dark">₱@item.LineTotal.ToString("N2")</span>
                                    </div>
                                }
                            </div>
                            <hr />
                            <div class="d-flex justify-content-between mb-1"><span>Subtotal</span><span>₱@selectedOrder.Subtotal.ToString("N2")</span></div>
                            @if ((Session.Terminal?.VatDisplay ?? true) && (selectedOrder.VatAmount > 0 || selectedOrder.VatableSales > 0 || selectedOrder.VatExemptSales > 0 || selectedOrder.ZeroRatedSales > 0))
                            {
                                @if (selectedOrder.VatableSales > 0)
                                {
                                    <div class="d-flex justify-content-between text-muted small"><span>Vatable Sales</span><span>₱@selectedOrder.VatableSales.ToString("N2")</span></div>
                                }
                                @if (selectedOrder.VatExemptSales > 0)
                                {
                                    <div class="d-flex justify-content-between text-muted small"><span>VAT-Exempt Sales</span><span>₱@selectedOrder.VatExemptSales.ToString("N2")</span></div>
                                }
                                @if (selectedOrder.ZeroRatedSales > 0)
                                {
                                    <div class="d-flex justify-content-between text-muted small"><span>Zero-Rated Sales</span><span>₱@selectedOrder.ZeroRatedSales.ToString("N2")</span></div>
                                }
                                <div class="d-flex justify-content-between text-muted small"><span>VAT (12%)</span><span>₱@selectedOrder.VatAmount.ToString("N2")</span></div>
                            }
                            @if (selectedOrder.DiscountAmount > 0)
                            {
                                <div class="d-flex justify-content-between text-success"><span>Discount @(!string.IsNullOrWhiteSpace(selectedOrder.DiscountCode) ? $"({selectedOrder.DiscountCode})" : "")</span><span>₱-@selectedOrder.DiscountAmount.ToString("N2")</span></div>
                            }
                            <div class="d-flex justify-content-between fw-bold fs-5 mt-2 pt-2 border-top"><span>Total Paid</span><span>₱@selectedOrder.TotalAmount.ToString("N2")</span></div>
                            @{
                                var summary = ReceiptPresentationHelper.SummarizeItems(selectedOrder.Items);
                            }
                            <div class="d-flex justify-content-between text-muted small mt-2 pt-2 border-top"><span>Total Items</span><span>@summary.TotalItemsDisplay</span></div>
                            @if (summary.HasWeightTotals)
                            {
                                @if (summary.WeightTotals.Count == 1)
                                {
                                    <div class="d-flex justify-content-between text-muted small"><span>Total Weight</span><span>@summary.WeightTotals[0].FormattedWithUnit</span></div>
                                }
                                else
                                {
                                    @foreach (var wt in summary.WeightTotals)
                                    {
                                        <div class="d-flex justify-content-between text-muted small"><span>Total Weight (@wt.Unit)</span><span>@wt.FormattedWithUnit</span></div>
                                    }
                                }
                            }
                        </div>
                    </div>
                    <div class="modal-footer border-top bg-white px-4 py-3 d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-outline-secondary rounded px-4 fw-medium" @onclick="CloseDetailModal">Close</button>
                        @if (selectedOrder.PaymentStatus == "PAID" && selectedOrder.OrderStatus != "VOIDED")
                        {
                            <button type="button" class="btn btn-outline-danger rounded px-3 fw-bold" @onclick="() => OpenVoidModal(selectedOrder)">
                                <i class="bi bi-x-circle me-1"></i> Void
                            </button>
                            <button type="button" class="btn btn-outline-warning text-dark rounded px-3 fw-bold" @onclick="() => OpenReturnModal(selectedOrder)">
                                <i class="bi bi-arrow-counterclockwise me-1"></i> Return
                            </button>
                        }
                        @if (selectedOrder.Items.Any(i => i.IsKitchenItem || i.IsBarItem))
                        {
                            <button type="button" class="btn btn-outline-primary rounded px-3 fw-bold" @onclick="() => ReprintPreparationTickets(selectedOrder)">
                                <i class="bi bi-receipt-cutoff me-1"></i> Reprint Prep Ticket
                            </button>
                        }
                        <button type="button" class="btn btn-primary rounded px-4 fw-bold shadow-sm" @onclick="() => ReprintInvoice(selectedOrder.OrderId)">
                            <i class="bi bi-printer me-1"></i> Reprint
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
    <!-- Void Modal -->
    @if (isVoidModalOpen && selectedOrder != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.5); backdrop-filter: blur(3px);" role="dialog" aria-modal="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                    <div class="modal-header border-bottom px-4 py-3 bg-danger text-white">
                        <h5 class="modal-title fw-bold mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i> Void Transaction (#@selectedOrder.OrderNumber)</h5>
                        <button type="button" class="btn-close btn-close-white shadow-none" @onclick="CloseVoidModal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body px-4 py-4">
                        <div class="alert alert-warning small mb-3">
                            <strong>Warning:</strong> Voiding this transaction will mark the entire sale and invoice as voided and record offsetting refund entries. This action requires manager authorization.
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark small">Void Reason <span class="text-danger">*</span></label>
                            <textarea class="form-control rounded-3" rows="3" placeholder="Enter reason for voiding transaction..." @bind="voidReason"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark small">Supervisor / Manager PIN <span class="text-danger">*</span></label>
                            <input type="password" class="form-control rounded-3" placeholder="Enter 4-digit PIN or username" @bind="voidApproverPin" />
                        </div>
                    </div>
                    <div class="modal-footer border-top bg-light px-4 py-3 d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-outline-secondary rounded px-4 fw-medium" @onclick="CloseVoidModal">Cancel</button>
                        <button type="button" class="btn btn-danger rounded px-4 fw-bold shadow-sm" @onclick="ConfirmVoid">Authorize & Void</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Return / Refund Modal -->
    @if (isReturnModalOpen && selectedOrder != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.5); backdrop-filter: blur(3px);" role="dialog" aria-modal="true">
            <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
                <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                    <div class="modal-header border-bottom px-4 py-3 bg-warning text-dark">
                        <h5 class="modal-title fw-bold mb-0"><i class="bi bi-arrow-counterclockwise me-2"></i> Return & Refund Items (#@selectedOrder.OrderNumber)</h5>
                        <button type="button" class="btn-close shadow-none" @onclick="CloseReturnModal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body px-4 py-4">
                        <p class="text-secondary small mb-3">Select items and quantities to return. Specify the restock disposition for each returned item.</p>

                        <div class="table-responsive mb-4">
                            <table class="table align-middle mb-0">
                                <thead class="table-light fs-7 text-uppercase text-secondary">
                                    <tr>
                                        <th>Product</th>
                                        <th class="text-center">Purchased</th>
                                        <th class="text-center" style="width: 120px;">Return Qty</th>
                                        <th class="text-center" style="width: 160px;">Disposition</th>
                                        <th class="text-end">Unit Price</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in selectedOrder.Items)
                                    {
                                        <tr>
                                            <td>
                                                <span class="fw-semibold text-dark">@item.ProductName</span>
                                            </td>
                                            <td class="text-center fw-bold">@item.Quantity.ToString("0.###")</td>
                                            <td class="text-center">
                                                <input type="number" step="1" min="0" max="@item.Quantity" class="form-control form-control-sm text-center fw-bold" @bind="returnQuantities[item.OrderItemId]" />
                                            </td>
                                            <td class="text-center">
                                                <select class="form-select form-select-sm" @bind="returnDispositions[item.OrderItemId]">
                                                    <option value="RESTOCK">Restock (Sellable)</option>
                                                    <option value="DAMAGED">Damaged / Waste</option>
                                                    <option value="DISCARD">Discard</option>
                                                </select>
                                            </td>
                                            <td class="text-end fw-semibold">₱@item.UnitPrice.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-semibold text-dark small">Return Reason <span class="text-danger">*</span></label>
                                <textarea class="form-control rounded-3" rows="2" placeholder="Reason for return/refund..." @bind="returnReason"></textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold text-dark small">Supervisor / Manager PIN <span class="text-danger">*</span></label>
                                <input type="password" class="form-control rounded-3" placeholder="Enter supervisor PIN or username" @bind="returnApproverPin" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-top bg-light px-4 py-3 d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-outline-secondary rounded px-4 fw-medium" @onclick="CloseReturnModal">Cancel</button>
                        <button type="button" class="btn btn-warning px-4 fw-bold shadow-sm" @onclick="ConfirmReturn">Process Return & Refund</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "mode")]
    public string? Mode { get; set; }

    private string activeMode = "all";
    private string? lastAppliedMode = null;

    private List<OrderResponseDto>? transactions;
    private TransactionFilterDto filter = new();

    private bool isDetailModalOpen = false;
    private OrderResponseDto? selectedOrder;

    private string? loadError;
    private DateTime currentBusinessDayStartLocal;
    private bool isOfflineMode = false;

    public static DateTime GetBusinessDayStart(DateTime localTime)
    {
        var baseDate = localTime.TimeOfDay < TimeSpan.FromHours(4)
            ? localTime.Date.AddDays(-1)
            : localTime.Date;
        return baseDate.AddHours(4);
    }

    protected override void OnInitialized()
    {
        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", replace: true);
            return;
        }

        if (!Session.CanViewTransactionHistory)
        {
            transactions = new();
            Navigation.NavigateTo("/", replace: true);
            return;
        }

        TransactionSyncService.OnSyncStateChanged += HandleBackgroundSyncOrConnectivityChanged;
        ConnectivityService.ConnectivityChanged += HandleConnectivityChanged;
    }

    private void HandleConnectivityChanged(object? sender, POS.Client.Services.TerminalConnectivityState state) =>
        HandleBackgroundSyncOrConnectivityChanged();

    private void HandleBackgroundSyncOrConnectivityChanged()
    {
        if (!Session.IsAuthenticated || !Session.CanViewTransactionHistory)
            return;

        _ = InvokeAsync(async () =>
        {
            await LoadTransactions();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        TransactionSyncService.OnSyncStateChanged -= HandleBackgroundSyncOrConnectivityChanged;
        ConnectivityService.ConnectivityChanged -= HandleConnectivityChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!Session.IsAuthenticated)
        {
            transactions = new();
            Navigation.NavigateTo("/login", replace: true);
            return;
        }

        if (!Session.CanViewTransactionHistory)
        {
            transactions = new();
            isDetailModalOpen = false;
            isVoidModalOpen = false;
            isReturnModalOpen = false;
            Navigation.NavigateTo("/", replace: true);
            return;
        }

        var targetMode = string.IsNullOrWhiteSpace(Mode) ? "all" : Mode.Trim().ToLowerInvariant();
        if (targetMode != "reprint" && targetMode != "void")
        {
            targetMode = "all";
        }

        if (lastAppliedMode != targetMode)
        {
            lastAppliedMode = targetMode;
            activeMode = targetMode;
            filter.PaymentStatus = (activeMode == "reprint" || activeMode == "void") ? "PAID" : "";
            isDetailModalOpen = false;
            isVoidModalOpen = false;
            isReturnModalOpen = false;
            await LoadTransactions();
        }
    }

    private void SetWorkspaceMode(string mode)
    {
        if (!Session.CanViewTransactionHistory) return;
        var url = mode == "all" ? "/transactions" : $"/transactions?mode={mode}";
        Navigation.NavigateTo(url);
    }

    // Terminal scope is fixed: this terminal's branch + terminal, current business day only (4:00 AM cutoff).
    // The user-editable filter fields (invoice #, status) never override it.
    private void ApplyTerminalScope()
    {
        var startLocal = POS.Shared.Services.BusinessDayClock.GetCurrentBusinessDayStartLocal();
        currentBusinessDayStartLocal = startLocal;
        filter.BranchId = Session.Terminal?.BranchId;
        filter.TerminalId = Session.Terminal?.TerminalId;
        filter.DateFrom = startLocal;
        filter.DateTo = null;
        filter.Page = 1;
        filter.PageSize = 100;
    }

    private async Task LoadTransactions()
    {
        loadError = null;
        isOfflineMode = false;
        if (!Session.IsAuthenticated || !Session.CanViewTransactionHistory)
        {
            transactions = new();
            return;
        }

        if (Session.Terminal == null)
        {
            // Without an outlet the query would be unscoped and return every terminal's sales.
            transactions = new();
            loadError = "No outlet is assigned to this terminal. Transactions cannot be shown.";
            return;
        }

        ApplyTerminalScope();

        bool isOnline = false;
        try
        {
            var netState = await ConnectivityService.CheckConnectivityAsync();
            isOnline = (netState == POS.Client.Services.TerminalConnectivityState.OnlineAndHealthy);
        }
        catch
        {
            isOnline = false;
        }

        if (isOnline)
        {
            try
            {
                await POS.Client.Services.DeviceActivationService.EnsureOnlineBearerTokenAsync(Http, Session);
                try
                {
                    using var checkDb = new POS.Client.Data.LocalPosDbContext();
                    checkDb.InitializeDatabase();
                    if (await checkDb.SyncOutboxes.AsNoTracking().AnyAsync(o => o.Status == "PENDING" || o.Status == "RETRY_PENDING"))
                    {
                        _ = Task.Run(async () =>
                        {
                            try { await BackgroundSyncService.TriggerManualSyncAsync(); } catch { }
                        });
                    }
                }
                catch { }

                var onlineList = await TransactionService.GetTransactionsAsync(filter) ?? new();
                var localList = await QueryLocalTransactionsAsync();
                transactions = MergeOnlineAndLocalTransactions(onlineList, localList);
                return;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Online transaction load failed, attempting local fallback: {ex.Message}");
            }
        }

        await LoadLocalTransactionsAsync();
    }

    private static List<OrderResponseDto> MergeOnlineAndLocalTransactions(
        List<OrderResponseDto> onlineList,
        List<OrderResponseDto> localList)
    {
        var merged = new List<OrderResponseDto>(onlineList);
        var seenInvoices = new HashSet<string>(
            onlineList.Where(o => !string.IsNullOrWhiteSpace(o.InvoiceNumber)).Select(o => o.InvoiceNumber!.Trim()),
            StringComparer.OrdinalIgnoreCase);
        var seenOrderNumbers = new HashSet<string>(
            onlineList.Where(o => !string.IsNullOrWhiteSpace(o.OrderNumber)).Select(o => o.OrderNumber.Trim()),
            StringComparer.OrdinalIgnoreCase);

        foreach (var localTx in localList)
        {
            bool existsOnline =
                (!string.IsNullOrWhiteSpace(localTx.InvoiceNumber) && seenInvoices.Contains(localTx.InvoiceNumber.Trim())) ||
                (!string.IsNullOrWhiteSpace(localTx.OrderNumber) && seenOrderNumbers.Contains(localTx.OrderNumber.Trim()));

            if (!existsOnline)
            {
                merged.Add(localTx);
            }
        }

        return merged
            .OrderByDescending(o => o.CreatedAt)
            .ThenByDescending(o => o.OrderId)
            .Take(100)
            .ToList();
    }

    private async Task LoadLocalTransactionsAsync()
    {
        if (!Session.IsAuthenticated || !Session.CanViewTransactionHistory)
        {
            transactions = new();
            return;
        }

        try
        {
            isOfflineMode = true;
            transactions = await QueryLocalTransactionsAsync();
        }
        catch (Exception ex)
        {
            transactions = new();
            loadError = "Unable to load local transactions: " + ex.Message;
        }
    }

    private Task<List<OrderResponseDto>> QueryLocalTransactionsAsync() =>
        TransactionService.GetLocalTransactionsAsync(filter);

    private void ResetFilters()
    {
        if (!Session.CanViewTransactionHistory) return;
        filter = new TransactionFilterDto();
        _ = LoadTransactions();
    }

    private async Task ViewDetails(long orderId)
    {
        if (!Session.CanViewTransactionHistory) return;
        try
        {
            if (isOfflineMode || orderId <= 0)
            {
                selectedOrder = transactions?.FirstOrDefault(t => t.OrderId == orderId);
                if (selectedOrder != null)
                {
                    isDetailModalOpen = true;
                    return;
                }
            }

            selectedOrder = await TransactionService.GetTransactionByIdAsync(orderId);
            isDetailModalOpen = true;
        }
        catch (Exception ex)
        {
            selectedOrder = transactions?.FirstOrDefault(t => t.OrderId == orderId);
            if (selectedOrder != null)
            {
                isDetailModalOpen = true;
            }
            else
            {
                Console.WriteLine("Failed to load details: " + ex.Message);
            }
        }
    }

    private void CloseDetailModal() => isDetailModalOpen = false;

    private async Task ReprintPreparationTickets(OrderResponseDto target)
    {
        if (!Session.CanViewTransactionHistory) return;
        try
        {
            using var db = new POS.Client.Data.LocalPosDbContext();
            db.InitializeDatabase();
            int termId = Session.Terminal?.TerminalId ?? target.TerminalId;
            var cfg = db.TerminalConfigs.AsNoTracking().FirstOrDefault(t => t.TerminalId == termId);
            var receiptDto = new ReceiptDto
            {
                OrderId = target.OrderId,
                OrderNumber = target.OrderNumber,
                InvoiceNumber = target.InvoiceNumber,
                BranchId = target.BranchId,
                TerminalId = target.TerminalId,
                TerminalName = !string.IsNullOrWhiteSpace(target.TerminalName) ? target.TerminalName : (Session.Terminal?.TerminalName ?? "Terminal"),
                CashierId = target.CashierId,
                OrderType = target.OrderType,
                TableNumber = target.TableNumber,
                HeadCount = target.HeadCount,
                CreatedAt = target.CreatedAt,
                Items = target.Items
            };

            var tickets = PreparationTicketRouter.GenerateTickets(receiptDto, cfg?.KitchenPrinterName, cfg?.BarPrinterName);
            if (!tickets.Any())
            {
                await Swal.FireAsync("Info", "No Kitchen or Bar items on this transaction.", SweetAlertIcon.Info);
                return;
            }

            foreach (var ticket in tickets)
            {
                await ReceiptPrinter.PrintPreparationTicketAsync(ticket);
            }
            await Swal.FireAsync("Success", $"Sent {tickets.Count} preparation ticket(s) to printer.", SweetAlertIcon.Success);
        }
        catch (Exception ex)
        {
            await Swal.FireAsync("Error", "Preparation ticket print failed: " + ex.Message, SweetAlertIcon.Error);
        }
    }

    private async Task ReprintInvoice(long orderId)
    {
        if (!Session.CanViewTransactionHistory) return;
        if (isOfflineMode || orderId <= 0)
        {
            var target = transactions?.FirstOrDefault(t => t.OrderId == orderId);
            if (target != null)
            {
                var offlineReceipt = new ReceiptDto
                {
                    OrderId = target.OrderId,
                    OrderNumber = target.OrderNumber,
                    InvoiceNumber = target.InvoiceNumber,
                    InvoiceIssuedAt = target.CreatedAt,
                    BranchId = target.BranchId,
                    BranchName = Session.Terminal?.BranchName ?? "Store",
                    BranchTagline = Session.Terminal?.BranchTagline,
                    BranchCode = Session.Terminal?.BranchCode ?? string.Empty,
                    BranchAddress = Session.Terminal?.BranchAddress ?? string.Empty,
                    BranchPhone = Session.Terminal?.BranchPhone ?? string.Empty,
                    ReceiptLogoUrl = Session.Terminal?.ReceiptLogoUrl,
                    ReceiptLogoDataUri = Session.Terminal?.ReceiptLogoDataUri,
                    VatDisplay = Session.Terminal?.VatDisplay ?? true,
                    TerminalId = target.TerminalId,
                    TerminalName = Session.Terminal?.TerminalName ?? "Terminal",
                    CashierId = target.CashierId,
                    OrderType = target.OrderType,
                    TableNumber = target.TableNumber,
                    HeadCount = target.HeadCount,
                    CreatedAt = target.CreatedAt,
                    PaidAt = target.CreatedAt,
                    Subtotal = target.Subtotal,
                    DiscountAmount = target.DiscountAmount,
                    DiscountCode = target.DiscountCode,
                    TotalAmount = target.TotalAmount,
                    VatableSales = target.VatableSales,
                    VatExemptSales = target.VatExemptSales,
                    ZeroRatedSales = target.ZeroRatedSales,
                    VatAmount = target.VatAmount,
                    CustomerName = target.CustomerName,
                    CustomerAddress = target.CustomerAddress,
                    CustomerTin = target.CustomerTin,
                    CustomerBusinessStyle = target.CustomerBusinessStyle,
                    IsReprint = true,
                    Items = target.Items,
                    Payments = target.Payments
                };
                await ReceiptPrinter.PrintAsync(offlineReceipt);
                await Swal.FireAsync("Success", "Offline receipt sent to printer.", SweetAlertIcon.Success);
                return;
            }
        }

        if (!Session.CanViewTransactionHistory)
        {
            await Swal.FireAsync("Access Denied", "Your role is not authorized to reprint historical receipts.", SweetAlertIcon.Error);
            return;
        }

        try
        {
            var receipt = await TransactionService.GetTransactionReceiptAsync(orderId, true);
            if (receipt != null)
            {
                PosSessionService.EnsureReceiptLogoPopulated(receipt, Session);
                await ReceiptPrinter.PrintAsync(receipt);
                await Swal.FireAsync("Success", "Receipt sent to printer successfully.", SweetAlertIcon.Success);
            }
            else
            {
                await Swal.FireAsync("Error", "Could not retrieve receipt data for reprinting.", SweetAlertIcon.Error);
            }
        }
        catch (Exception ex)
        {
            await Swal.FireAsync("Error", "Reprint failed: " + ex.Message, SweetAlertIcon.Error);
        }
    }

    private bool isVoidModalOpen = false;
    private string voidReason = "";
    private string voidApproverPin = "";

    private bool isReturnModalOpen = false;
    private string returnReason = "";
    private string returnApproverPin = "";
    private Dictionary<long, decimal> returnQuantities = new();
    private Dictionary<long, string> returnDispositions = new();

    private void OpenVoidModal(OrderResponseDto order)
    {
        if (!Session.CanViewTransactionHistory) return;
        isDetailModalOpen = false;
        selectedOrder = order;
        voidReason = "";
        voidApproverPin = "";
        isVoidModalOpen = true;
    }

    private void CloseVoidModal() => isVoidModalOpen = false;

    private async Task ConfirmVoid()
    {
        if (!Session.CanViewTransactionHistory) return;
        if (isOfflineMode)
        {
            await Swal.FireAsync("Offline Mode", "Void operations require an active online connection to verify supervisor authorization.", SweetAlertIcon.Warning);
            return;
        }

        if (selectedOrder == null || string.IsNullOrWhiteSpace(voidReason) || string.IsNullOrWhiteSpace(voidApproverPin))
        {
            await Swal.FireAsync("Warning", "Please provide a void reason and supervisor PIN.", SweetAlertIcon.Warning);
            return;
        }

        try
        {
            var res = await TransactionService.VoidTransactionAsync(selectedOrder.OrderId, voidReason, voidApproverPin);
            if (res != null)
            {
                await Swal.FireAsync("Success", $"Transaction #{selectedOrder.OrderNumber} successfully voided.", SweetAlertIcon.Success);
                isVoidModalOpen = false;
                selectedOrder = null;
                await LoadTransactions();
            }
            else
            {
                await Swal.FireAsync("Error", "Failed to void transaction. Verify supervisor authorization.", SweetAlertIcon.Error);
            }
        }
        catch (Exception ex)
        {
            await Swal.FireAsync("Error", "Void error: " + ex.Message, SweetAlertIcon.Error);
        }
    }

    private void OpenReturnModal(OrderResponseDto order)
    {
        if (!Session.CanViewTransactionHistory) return;
        isDetailModalOpen = false;
        selectedOrder = order;
        returnReason = "";
        returnApproverPin = "";
        returnQuantities.Clear();
        returnDispositions.Clear();
        foreach (var item in order.Items)
        {
            returnQuantities[item.OrderItemId] = 0;
            returnDispositions[item.OrderItemId] = "RESTOCK";
        }
        isReturnModalOpen = true;
    }

    private void CloseReturnModal() => isReturnModalOpen = false;

    private async Task ConfirmReturn()
    {
        if (!Session.CanViewTransactionHistory) return;
        if (isOfflineMode)
        {
            await Swal.FireAsync("Offline Mode", "Return and refund operations require an active online connection to verify supervisor authorization.", SweetAlertIcon.Warning);
            return;
        }

        if (selectedOrder == null || string.IsNullOrWhiteSpace(returnReason) || string.IsNullOrWhiteSpace(returnApproverPin))
        {
            await Swal.FireAsync("Warning", "Please provide a return reason and supervisor PIN.", SweetAlertIcon.Warning);
            return;
        }

        var itemsToReturn = returnQuantities
            .Where(kv => kv.Value > 0)
            .Select(kv => new ReturnItemRequestDto
            {
                OriginalOrderItemId = kv.Key,
                Quantity = kv.Value,
                RestockDisposition = returnDispositions.ContainsKey(kv.Key) ? returnDispositions[kv.Key] : "RESTOCK"
            })
            .ToList();

        if (!itemsToReturn.Any())
        {
            await Swal.FireAsync("Warning", "Please specify a return quantity greater than zero for at least one item.", SweetAlertIcon.Warning);
            return;
        }

        try
        {
            var req = new ReturnRequestDto
            {
                OriginalOrderId = selectedOrder.OrderId,
                BranchId = selectedOrder.BranchId,
                TerminalId = selectedOrder.TerminalId,
                ReturnReason = returnReason,
                ApprovedByPinOrUsername = returnApproverPin,
                RefundMethod = "CASH",
                Items = itemsToReturn
            };

            var res = await TransactionService.ProcessReturnAsync(req);
            if (res != null)
            {
                await Swal.FireAsync("Success", $"Return reference {res.ReturnReference} processed successfully. Refund: ₱{res.TotalRefundAmount:N2}", SweetAlertIcon.Success);
                isReturnModalOpen = false;
                selectedOrder = null;
                await LoadTransactions();
            }
            else
            {
                await Swal.FireAsync("Error", "Failed to process return. Check supervisor authorization or item quantities.", SweetAlertIcon.Error);
            }
        }
        catch (Exception ex)
        {
            await Swal.FireAsync("Error", "Return error: " + ex.Message, SweetAlertIcon.Error);
        }
    }
