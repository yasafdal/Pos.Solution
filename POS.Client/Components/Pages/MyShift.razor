@page "/my-shift"
@inject PosSessionService Session
@inject NavigationManager Navigation

@if (!Session.IsAuthenticated)
{
    Navigation.NavigateTo("/login");
}
else
{
    <div class="p-4">
        <h3 class="fw-bold text-dark mb-1">My Shift</h3>
        <p class="text-muted small">Shift summary, cash reconciliations, and end-of-shift reports</p>
        <div class="card p-4 border-0 shadow-sm rounded-3 mt-3">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center">
                    <i class="bi bi-clock-history fs-3"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-0">Active Shift: @Session.Username</h5>
                    <span class="text-muted small">Role: @Session.Role • Terminal: @Session.Outlet?.OutletName</span>
                </div>
            </div>
        </div>
    </div>
}
