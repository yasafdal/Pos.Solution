@page "/my-shift"
@inject PosSessionService Session
@inject NavigationManager Navigation
@inject HttpClient Http
@inject POS.Client.Services.IPosConnectivityService ConnectivityService
@inject POS.Client.Services.IReceiptPrinter ReceiptPrinter
@using System.Globalization
@using System.Net.Http.Json
@using POS.Shared.Models
@using POS.Client.Services

@if (!Session.IsAuthenticated)
{
    Navigation.NavigateTo("/login");
}
else
{
    <div class="p-3 p-md-4 pos-myshift-page">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
                <h3 class="fw-bold text-light mb-1">My Shift &amp; Blind Closing</h3>
                <p class="text-secondary small mb-0">Cash denomination counting, payment declarations, and Cashier Declaration Acknowledgment</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                @if (lastClosedShift?.CashierDeclaration != null)
                {
                    <button type="button" class="btn btn-outline-info rounded-3 px-3 py-2 fw-semibold" @onclick="ReprintLastDeclarationAsync" disabled="@printing">
                        <i class="bi bi-printer me-1"></i> @(printing ? "Printing..." : $"Reprint Declaration (Shift #{lastClosedShift.ShiftId})")
                    </button>
                }
                <button type="button" class="btn btn-outline-light rounded-3 px-3 py-2 fw-semibold" @onclick='() => Navigation.NavigateTo("/cash-drawer")'>
                    <i class="bi bi-cash-stack me-1"></i> Cash Drawer &amp; Supervisor Reconciliation
                </button>
            </div>
        </div>

        @if (error != null)
        {
            <div class="alert alert-danger rounded-3">@error</div>
        }
        @if (successMessage != null)
        {
            <div class="alert alert-success rounded-3">@successMessage</div>
        }
        @if (printWarning != null)
        {
            <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2 rounded-3">
                <span><i class="bi bi-printer-fill me-1"></i> @printWarning</span>
                @if (lastClosedShift?.CashierDeclaration != null)
                {
                    <button type="button" class="btn btn-sm btn-dark fw-bold rounded-3" @onclick="ReprintLastDeclarationAsync" disabled="@printing">
                        Reprint Declaration Acknowledgment
                    </button>
                }
            </div>
        }

        <input id="counted" class="form-control d-none" type="text" inputmode="decimal" @bind="countedText" @bind:event="oninput" disabled="@busy" readonly />

        @if (shift != null)
        {
            <div class="pos-shift-card rounded-4 p-3 mb-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 bg-primary bg-opacity-25 text-info rounded-circle d-flex align-items-center justify-content-center">
                            <i class="bi bi-clock-history fs-4"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold text-light mb-0">Shift #@shift.ShiftId • Cashier: @shift.CashierId</h5>
                            <span class="text-secondary small">
                                Opened @shift.OpenedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm") • Terminal: @(Session.Terminal?.TerminalName ?? $"#{shift.TerminalId}")
                            </span>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-3 text-end">
                        <div>
                            <span class="text-secondary small d-block">Opening Float (Include in Count)</span>
                            <strong class="text-light">₱@shift.OpeningFloat.ToString("N2")</strong>
                        </div>
                        <div>
                            <span class="text-secondary small d-block">Total Counted Cash</span>
                            <strong class="text-success">₱@TotalCountedCash.ToString("N2")</strong>
                        </div>
                        <div>
                            <span class="text-secondary small d-block">Declared Non-Cash Total</span>
                            <strong class="text-info">₱@DeclaredNonCashTotal.ToString("N2")</strong>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tab Bar for My Shift Closing -->
            <div class="pos-tabs-wrapper mb-3">
                <div class="pos-tabs-nav" role="tablist" aria-label="My Shift Closing Tabs">
                    <button type="button"
                            role="tab"
                            aria-selected="@(activeTab == "CASH_COUNT")"
                            class="pos-tab-btn @(activeTab == "CASH_COUNT" ? "active" : "")"
                            @onclick='() => SelectTab("CASH_COUNT")'>
                        <i class="bi bi-coin text-warning"></i>
                        <span>1. Cash Count</span>
                        <span class="badge rounded-pill bg-dark text-success border border-success border-opacity-50 font-monospace">₱@TotalCountedCash.ToString("N2")</span>
                    </button>
                    <button type="button"
                            role="tab"
                            aria-selected="@(activeTab == "OTHER_PAYMENTS")"
                            class="pos-tab-btn @(activeTab == "OTHER_PAYMENTS" ? "active" : "")"
                            @onclick='() => SelectTab("OTHER_PAYMENTS")'>
                        <i class="bi bi-credit-card-2-front text-info"></i>
                        <span>2. Other Payments</span>
                        <span class="badge rounded-pill bg-dark text-info border border-info border-opacity-50 font-monospace">₱@DeclaredNonCashTotal.ToString("N2")</span>
                    </button>
                    <button type="button"
                            role="tab"
                            aria-selected="@(activeTab == "REVIEW_CLOSE")"
                            class="pos-tab-btn @(activeTab == "REVIEW_CLOSE" ? "active" : "")"
                            @onclick='() => SelectTab("REVIEW_CLOSE")'>
                        <i class="bi bi-clipboard2-check-fill text-primary"></i>
                        <span>3. Review &amp; Close</span>
                        <span class="badge rounded-pill @(isDeclarationConfirmed ? "bg-success text-white" : "bg-secondary bg-opacity-50 text-light")">
                            @(isDeclarationConfirmed ? "Confirmed" : "Final Step")
                        </span>
                    </button>
                </div>
            </div>

            @if (activeTab == "CASH_COUNT")
            {
                <div class="pos-shift-card rounded-4 p-3 p-md-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                        <div>
                            <h5 class="fw-bold text-light mb-1">1. Cash Count (Coins &amp; Bills)</h5>
                            <p class="small text-info mb-0">
                                Count all physical cash currently in the drawer, including the remaining opening float (₱@shift.OpeningFloat.ToString("N2")).
                            </p>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-3" @onclick="ResetDenominations" disabled="@busy">
                            Reset Counts
                        </button>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-12 col-md-6">
                            <div class="pos-shift-subpanel rounded-3 p-3 h-100">
                                <div class="d-flex justify-content-between mb-2 pb-1 border-bottom border-secondary border-opacity-25">
                                    <span class="fw-bold small text-warning">COINS (₱0.01 – ₱20)</span>
                                    <span class="small text-light fw-bold font-monospace">₱@CoinsSubtotal.ToString("N2")</span>
                                </div>
                                <div class="d-flex flex-column gap-2">
                                    @foreach (var row in denominationRows.Where(r => r.Type == "COIN"))
                                    {
                                        <div class="d-flex align-items-center justify-content-between gap-2">
                                            <span class="fw-bold text-light small" style="min-width: 68px;">₱@FormatDenom(row.Denomination)</span>
                                            <div class="input-group input-group-sm" style="max-width: 132px;">
                                                <button type="button" class="btn btn-outline-secondary px-2" disabled="@(busy || row.Quantity <= 0)" @onclick="() => StepQty(row, -1)">−</button>
                                                <input type="text" inputmode="numeric" class="form-control text-center fw-bold bg-dark text-light border-secondary @(row.HasError ? "is-invalid" : "")"
                                                       value="@row.RawQuantity" disabled="@busy"
                                                       @oninput="(e) => OnQtyInput(row, e.Value?.ToString())" />
                                                <button type="button" class="btn btn-outline-secondary px-2" disabled="@busy" @onclick="() => StepQty(row, 1)">+</button>
                                            </div>
                                            <span class="font-monospace small text-info text-end" style="min-width: 82px;">₱@row.Subtotal.ToString("N2")</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="pos-shift-subpanel rounded-3 p-3 h-100 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex justify-content-between mb-2 pb-1 border-bottom border-secondary border-opacity-25">
                                        <span class="fw-bold small text-success">BILLS (₱20 – ₱1,000)</span>
                                        <span class="small text-light fw-bold font-monospace">₱@BillsSubtotal.ToString("N2")</span>
                                    </div>
                                    <div class="d-flex flex-column gap-2">
                                        @foreach (var row in denominationRows.Where(r => r.Type == "BILL"))
                                        {
                                            <div class="d-flex align-items-center justify-content-between gap-2">
                                                <span class="fw-bold text-light small" style="min-width: 68px;">₱@FormatDenom(row.Denomination)</span>
                                                <div class="input-group input-group-sm" style="max-width: 132px;">
                                                    <button type="button" class="btn btn-outline-secondary px-2" disabled="@(busy || row.Quantity <= 0)" @onclick="() => StepQty(row, -1)">−</button>
                                                    <input type="text" inputmode="numeric" class="form-control text-center fw-bold bg-dark text-light border-secondary @(row.HasError ? "is-invalid" : "")"
                                                           value="@row.RawQuantity" disabled="@busy"
                                                           @oninput="(e) => OnQtyInput(row, e.Value?.ToString())" />
                                                    <button type="button" class="btn btn-outline-secondary px-2" disabled="@busy" @onclick="() => StepQty(row, 1)">+</button>
                                                </div>
                                                <span class="font-monospace small text-success text-end" style="min-width: 82px;">₱@row.Subtotal.ToString("N2")</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="mt-3 pt-2 border-top border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
                                    <span class="small fw-bold text-secondary">TOTAL COUNTED CASH</span>
                                    <span class="fs-5 fw-bolder text-success font-monospace">₱@TotalCountedCash.ToString("N2")</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4 pt-3 border-top border-secondary border-opacity-25">
                        <button type="button" class="btn btn-primary rounded-3 px-4 py-2 fw-bold" @onclick="GoToOtherPayments" disabled="@busy">
                            Next: Other Payments <i class="bi bi-arrow-right ms-1"></i>
                        </button>
                    </div>
                </div>
            }
            else if (activeTab == "OTHER_PAYMENTS")
            {
                <div class="pos-shift-card rounded-4 p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="fw-bold text-light mb-0">2. Other Payment Methods (Cashier-Declared Totals)</h5>
                        <span class="badge bg-info-subtle text-info">Cashier-Declared Totals</span>
                    </div>
                    <p class="small text-secondary mb-3">
                        Manually enter declared totals from payment slips or supporting terminal records (not automatically verified).
                    </p>

                    <div class="row g-3">
                        @foreach (var decl in nonCashDeclarations)
                        {
                            <div class="col-12 col-md-6">
                                <div class="pos-shift-subpanel rounded-3 p-3 @(decl.HasError ? "border border-danger" : "")">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="fw-bold text-light small">@decl.PaymentMethodName (@decl.PaymentMethodCode)</span>
                                        @if (!decl.IsActive)
                                        {
                                            <span class="badge bg-warning text-dark" style="font-size: 0.65rem;">Inactive • Used in Shift</span>
                                        }
                                    </div>
                                    <div class="input-group input-group-sm mt-1">
                                        <span class="input-group-text bg-dark text-light border-secondary">₱</span>
                                        <input type="text" inputmode="decimal" class="form-control fw-bold font-monospace bg-dark text-light border-secondary @(decl.HasError ? "is-invalid" : "")"
                                               value="@decl.RawAmount" disabled="@busy"
                                               @oninput="(e) => OnDeclarationInput(decl, e.Value?.ToString())" />
                                    </div>
                                    <small class="text-secondary d-block mt-1">Enter actual total from payment slips or terminal records.</small>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top border-secondary border-opacity-25">
                        <button type="button" class="btn btn-outline-light rounded-3 px-3 py-2 fw-semibold" @onclick='() => SelectTab("CASH_COUNT")' disabled="@busy">
                            <i class="bi bi-arrow-left me-1"></i> Back: Cash Count
                        </button>
                        <button type="button" class="btn btn-primary rounded-3 px-4 py-2 fw-bold" @onclick="StartReview" disabled="@busy">
                            Next: Review &amp; Close <i class="bi bi-arrow-right ms-1"></i>
                        </button>
                    </div>
                </div>
            }
            else if (activeTab == "REVIEW_CLOSE")
            {
                <div class="pos-shift-card rounded-4 p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold text-light mb-0">3. Review Declaration &amp; Submit Closing</h5>
                        <span class="badge @(isDeclarationConfirmed ? "bg-success" : "bg-primary")">@(isDeclarationConfirmed ? "CONFIRMED" : "REVIEW & CONFIRM")</span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <div class="pos-shift-subpanel rounded-3 p-3 h-100 small">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-bold text-warning text-uppercase" style="font-size: 0.72rem;">Entered Cash Count Summary</span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" @onclick='() => { reviewing = false; isDeclarationConfirmed = false; activeTab = "CASH_COUNT"; }'>Edit</button>
                                </div>
                                <div class="d-flex justify-content-between py-1"><span>Coins Subtotal:</span><span class="font-monospace">₱@CoinsSubtotal.ToString("N2")</span></div>
                                <div class="d-flex justify-content-between py-1"><span>Bills Subtotal:</span><span class="font-monospace">₱@BillsSubtotal.ToString("N2")</span></div>
                                <div class="d-flex justify-content-between pt-1 border-top border-secondary border-opacity-25 fw-bold">
                                    <span>Total Counted Cash:</span>
                                    <span class="text-success font-monospace">₱@TotalCountedCash.ToString("N2")</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="pos-shift-subpanel rounded-3 p-3 h-100">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-bold text-info text-uppercase" style="font-size: 0.72rem;">Declared Non-Cash Totals</span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" @onclick='() => { reviewing = false; isDeclarationConfirmed = false; activeTab = "OTHER_PAYMENTS"; }'>Edit</button>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-sm table-dark align-middle mb-0" style="font-size: 0.8rem;">
                                        <thead>
                                            <tr class="text-secondary">
                                                <th>Payment Method</th>
                                                <th class="text-end">Cashier-Declared Total</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var d in nonCashDeclarations)
                                            {
                                                <tr>
                                                    <td>@d.PaymentMethodName</td>
                                                    <td class="text-end font-monospace fw-bold">₱@d.DeclaredAmount.ToString("N2")</td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr class="border-top border-secondary">
                                                <th class="text-secondary">Total Non-Cash Declared</th>
                                                <th class="text-end font-monospace text-info">₱@DeclaredNonCashTotal.ToString("N2")</th>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-light">
                            Optional General Notes
                        </label>
                        <textarea rows="2" maxlength="255" class="form-control rounded-3 bg-dark text-light border-secondary"
                                  @bind="closingNotes" @bind:event="oninput" disabled="@busy"
                                  placeholder="Optional general shift notes..."></textarea>
                    </div>

                    <div class="p-2 px-3 rounded-3 mb-3 border border-primary bg-primary bg-opacity-10 small text-light">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="confirmMyShiftBlindCheck" @bind="isDeclarationConfirmed" disabled="@busy" />
                            <label class="form-check-label fw-semibold text-warning" for="confirmMyShiftBlindCheck">
                                I confirm that my cash counts (₱@TotalCountedCash.ToString("N2")) and non-cash declarations (₱@DeclaredNonCashTotal.ToString("N2")), including any ₱0.00 entries, are complete and accurate.
                            </label>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between gap-2">
                        <button type="button" class="btn btn-outline-light rounded-3 py-2 px-3" disabled="@busy" @onclick='() => { reviewing = false; isDeclarationConfirmed = false; activeTab = "OTHER_PAYMENTS"; }'>
                            <i class="bi bi-arrow-left me-1"></i> Back: Other Payments
                        </button>
                        <button type="button" class="btn btn-danger rounded-3 py-2 px-4 fw-bold"
                                disabled="@(busy || !isDeclarationConfirmed || !TryParseCashAmount(countedText, out _) || shift.CashierId != Session.Username || shift.PendingApprovalsCount > 0)"
                                @onclick="Close">
                            @(busy ? "Submitting & Printing..." : "Submit Closing & Print Acknowledgment")
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="pos-shift-card rounded-4 p-4">
                <p class="mb-2 text-light fw-semibold">No active shift. Payment will ask you to explicitly confirm opening float.</p>
                @if (lastClosedShift != null)
                {
                    <div class="pos-shift-subpanel rounded-3 p-3 mt-3 small">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold text-info">Last Closed Shift #@lastClosedShift.ShiftId (@lastClosedShift.CashierId)</span>
                            <span class="badge bg-primary">LOCKED &amp; SUBMITTED</span>
                        </div>
                        <div>Total Counted Cash: ₱@((lastClosedShift.ActualCountedBalance ?? 0m).ToString("N2")) • Total Non-Cash Declared: ₱@lastClosedShift.TotalNonCashDeclared.ToString("N2")</div>
                        @if (!string.IsNullOrWhiteSpace(lastClosedShift.Notes))
                        {
                            <div class="text-light mt-1">General Notes: @lastClosedShift.Notes</div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

<style>
    .pos-myshift-page { color: #f8fafc; overflow-x: hidden; }
    .pos-shift-card { background-color: #1e293b; border: 1px solid #334155; }
    .pos-shift-subpanel { background-color: #0f172a; border: 1px solid #334155; }
    .pos-tabs-wrapper { max-width: 100%; overflow: hidden; }
    .pos-tabs-nav {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        overflow-x: auto;
        white-space: nowrap;
        flex-wrap: nowrap;
        padding: 0.45rem;
        background-color: #0f172a;
        border: 1px solid #334155;
        border-radius: 0.85rem;
    }
    .pos-tab-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.55rem 0.95rem;
        border-radius: 0.65rem;
        border: 1px solid transparent;
        background-color: transparent;
        color: #94a3b8;
        font-weight: 600;
        font-size: 0.88rem;
        cursor: pointer;
        flex-shrink: 0;
    }
    .pos-tab-btn.active {
        background-color: #1e293b;
        color: #f8fafc;
        border-color: #3b82f6;
    }
    .pos-tab-btn:focus-visible {
        outline: 2px solid #38bdf8;
        outline-offset: 2px;
    }
</style>

@code {
    private sealed class DenomItem
    {
        public string Type { get; init; } = "BILL";
        public decimal Denomination { get; init; }
        public string Label { get; init; } = string.Empty;
        public int Quantity { get; set; }
        public string RawQuantity { get; set; } = "0";
        public bool HasError { get; set; }
        public decimal Subtotal => Math.Round(Denomination * Quantity, 2, MidpointRounding.AwayFromZero);
    }

    private sealed class DeclItem
    {
        public string PaymentMethodCode { get; init; } = string.Empty;
        public string PaymentMethodName { get; init; } = string.Empty;
        public bool IsActive { get; init; } = true;
        public decimal DeclaredAmount { get; set; }
        public string RawAmount { get; set; } = "0.00";
        public bool HasError { get; set; }
    }

    private CashDrawerShiftDto? shift;
    private CashDrawerShiftDto? lastClosedShift;
    private string activeTab = "CASH_COUNT";
    private string countedText = "0.00";
    private string closingNotes = string.Empty;
    private string clientCloseId = Guid.NewGuid().ToString("N");
    private List<DenomItem> denominationRows = new();
    private List<DeclItem> nonCashDeclarations = new();

    private decimal CoinsSubtotal => denominationRows.Where(r => r.Type == "COIN").Sum(r => r.Subtotal);
    private decimal BillsSubtotal => denominationRows.Where(r => r.Type == "BILL").Sum(r => r.Subtotal);
    private decimal TotalCountedCash => Math.Round(CoinsSubtotal + BillsSubtotal, 2, MidpointRounding.AwayFromZero);
    private decimal DeclaredNonCashTotal => Math.Round(nonCashDeclarations.Sum(d => d.DeclaredAmount), 2, MidpointRounding.AwayFromZero);

    // Match numeric(18,2) without culture-dependent separators or silent rounding.
    private static bool TryParseCashAmount(string? text, out decimal amount)
    {
        amount = 0m;
        if (string.IsNullOrWhiteSpace(text)) return false;
        var point = text.IndexOf('.');
        if (point >= 0 && text.Length - point - 1 > 2) return false;
        return decimal.TryParse(text, System.Globalization.NumberStyles.AllowDecimalPoint,
            System.Globalization.CultureInfo.InvariantCulture, out amount)
            && amount >= 0m && amount <= 9999999999999999.99m;
    }

    private bool busy;
    private bool reviewing;
    private bool isDeclarationConfirmed;
    private bool printing;
    private bool isOffline;
    private string? error;
    private string? successMessage;
    private string? printWarning;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated || Session.Terminal == null) return;
        ResetDenominations();
        try
        {
            var state = await ConnectivityService.CheckConnectivityAsync();
            isOffline = state != TerminalConnectivityState.OnlineAndHealthy;
            shift = await ShiftSession.CurrentDtoAsync(Http, Session.Terminal.TerminalId, isOffline);
            if (shift != null)
            {
                var configured = shift.ConfiguredNonCashMethods.Count > 0
                    ? shift.ConfiguredNonCashMethods
                    : shift.PaymentReconciliations.Where(r => !r.IsCash).Select(r => new PaymentMethodDeclarationDto
                    {
                        PaymentMethodCode = r.PaymentMethodCode,
                        PaymentMethodName = r.PaymentMethodName,
                        IsActive = r.IsActive,
                        DisplayOrder = r.DisplayOrder
                    }).ToList();

                nonCashDeclarations = configured
                    .Select(r => new DeclItem
                    {
                        PaymentMethodCode = r.PaymentMethodCode,
                        PaymentMethodName = r.PaymentMethodName,
                        IsActive = r.IsActive,
                        DeclaredAmount = 0m,
                        RawAmount = "0.00"
                    }).ToList();
            }
            else
            {
                lastClosedShift = await ShiftSession.LastClosedDtoAsync(Http, Session.Terminal.TerminalId, isOffline);
            }
        }
        catch
        {
            error = "Unable to load shift.";
        }
    }

    private void ResetDenominations()
    {
        denominationRows = CashDenominationCatalog.CreateDefaultLines()
            .Select(d => new DenomItem
            {
                Type = d.Type,
                Denomination = d.Denomination,
                Label = d.Label,
                Quantity = 0,
                RawQuantity = "0"
            }).ToList();
        countedText = "0.00";
        isDeclarationConfirmed = false;
    }

    private void OnQtyInput(DenomItem row, string? val)
    {
        string trimmed = (val ?? string.Empty).Trim();
        row.RawQuantity = trimmed;
        if (string.IsNullOrEmpty(trimmed)) { row.Quantity = 0; row.HasError = false; }
        else if (int.TryParse(trimmed, NumberStyles.None, CultureInfo.InvariantCulture, out int q) && q >= 0 && q <= 1_000_000) { row.Quantity = q; row.HasError = false; }
        else { row.HasError = true; }
        isDeclarationConfirmed = false;
        countedText = TotalCountedCash.ToString("0.00", CultureInfo.InvariantCulture);
    }

    private void StepQty(DenomItem row, int delta)
    {
        row.Quantity = Math.Max(0, row.Quantity + delta);
        row.RawQuantity = row.Quantity.ToString(CultureInfo.InvariantCulture);
        row.HasError = false;
        isDeclarationConfirmed = false;
        countedText = TotalCountedCash.ToString("0.00", CultureInfo.InvariantCulture);
    }

    private void OnDeclarationInput(DeclItem decl, string? val)
    {
        string trimmed = (val ?? string.Empty).Trim();
        decl.RawAmount = trimmed;
        if (string.IsNullOrEmpty(trimmed)) { decl.DeclaredAmount = 0m; decl.HasError = false; }
        else if (TryParseCashAmount(trimmed, out var parsed)) { decl.DeclaredAmount = parsed; decl.HasError = false; }
        else { decl.HasError = true; }
        isDeclarationConfirmed = false;
    }

    private void SelectTab(string tab)
    {
        if (tab == "REVIEW_CLOSE")
        {
            StartReview();
            return;
        }
        activeTab = tab;
    }

    private void GoToOtherPayments()
    {
        error = null;
        if (denominationRows.Any(r => r.HasError))
        {
            error = "All denomination quantities must be non-negative whole numbers.";
            activeTab = "CASH_COUNT";
            return;
        }
        activeTab = "OTHER_PAYMENTS";
    }

    private void StartReview()
    {
        error = null;
        if (denominationRows.Any(r => r.HasError)) { error = "All denomination quantities must be non-negative whole numbers."; activeTab = "CASH_COUNT"; return; }
        if (nonCashDeclarations.Any(d => d.HasError)) { error = "All cashier-declared payment amounts must be valid non-negative decimals (up to 2 decimal places)."; activeTab = "OTHER_PAYMENTS"; return; }
        countedText = TotalCountedCash.ToString("0.00", CultureInfo.InvariantCulture);
        reviewing = true;
        activeTab = "REVIEW_CLOSE";
    }

    private async Task Close()
    {
        if (busy || shift == null || shift.CashierId != Session.Username) return;
        if (!TryParseCashAmount(countedText, out var amount))
        {
            error = "Enter counted cash from 0 to 9999999999999999.99 using up to two decimal places.";
            return;
        }
        if (denominationRows.Any(r => r.HasError) || nonCashDeclarations.Any(d => d.HasError))
        {
            error = "Resolve invalid denomination quantities or payment declaration amounts before closing.";
            return;
        }
        if (!isDeclarationConfirmed)
        {
            error = "Explicitly confirm your blind closing declaration before submitting.";
            return;
        }
        busy = true;
        error = null;
        printWarning = null;
        try
        {
            var closeDto = new CloseShiftDto
            {
                ShiftId = shift.ShiftId,
                ClientShiftId = shift.ClientShiftId,
                ClientCloseId = clientCloseId,
                BranchId = shift.BranchId,
                TerminalId = shift.TerminalId,
                CashierId = Session.Username,
                ClosedAt = DateTime.UtcNow,
                ActualCountedBalance = amount,
                IsDeclarationConfirmed = isDeclarationConfirmed,
                Denominations = denominationRows.Select(r => new CashDenominationLineDto
                {
                    Type = r.Type,
                    Denomination = r.Denomination,
                    Quantity = r.Quantity,
                    Subtotal = r.Subtotal
                }).ToList(),
                PaymentDeclarations = nonCashDeclarations.Select(d => new PaymentMethodDeclarationDto
                {
                    PaymentMethodCode = d.PaymentMethodCode,
                    PaymentMethodName = d.PaymentMethodName,
                    DeclaredAmount = d.DeclaredAmount
                }).ToList(),
                Notes = string.IsNullOrWhiteSpace(closingNotes) ? null : closingNotes.Trim()
            };

            var closed = await POS.Client.Services.ShiftSession.CloseAsync(Http, closeDto, Session.Username, isOffline);
            lastClosedShift = closed;
            shift = null;
            reviewing = false;
            isDeclarationConfirmed = false;
            clientCloseId = Guid.NewGuid().ToString("N");
            successMessage = $"Shift #{closed.ShiftId} declaration submitted and shift closed.";

            if (closed.CashierDeclaration != null)
            {
                try
                {
                    printing = true;
                    await ReceiptPrinter.PrintCashierDeclarationAsync(closed.CashierDeclaration, Session.Terminal?.ReceiptPrinterName);
                }
                catch (Exception pEx)
                {
                    printWarning = $"Shift is closed and saved, but Declaration Acknowledgment printing failed ({pEx.Message}). Use Reprint to try again without creating another declaration.";
                }
                finally { printing = false; }
            }
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private async Task ReprintLastDeclarationAsync()
    {
        if (lastClosedShift?.CashierDeclaration == null || printing) return;
        lastClosedShift.CashierDeclaration.IsReprint = true;
        printing = true;
        try
        {
            await ReceiptPrinter.PrintCashierDeclarationAsync(lastClosedShift.CashierDeclaration, Session.Terminal?.ReceiptPrinterName);
            printWarning = null;
            successMessage = $"Reprinted Cashier Declaration Acknowledgment for Shift #{lastClosedShift.ShiftId}.";
        }
        catch (Exception ex)
        {
            printWarning = $"Reprint failed: {ex.Message}. Saved closing record remains intact.";
        }
        finally { printing = false; }
    }

    private static string FormatDenom(decimal d) => d < 1m ? d.ToString("0.00", CultureInfo.InvariantCulture) : d.ToString("N0", CultureInfo.InvariantCulture);
}
