@using System.Net.Http.Headers
@page "/login"
@page "/terminal-locked"
@implements IDisposable
@layout Layout.AuthLayout
@inject IUserService UserService
@inject ITerminalService TerminalService
@inject PosSessionService Session
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IReferenceDataSyncService ReferenceDataSync
@inject IDeviceActivationService ActivationService
@inject IJSRuntime Js

<div class="pos-login-card">
    @if (lockStatus?.IsTerminalLocked == true)
    {
        <!-- POS Terminal Locked Screen -->
        <div class="pos-header">
            <div class="pos-logo-icon" style="background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%); box-shadow: 0 10px 15px -3px rgba(220, 38, 38, 0.4);">
                <i class="bi bi-shield-lock-fill fs-2"></i>
            </div>
            <h2 class="pos-title">POS Terminal Locked</h2>
            <p class="pos-subtitle text-danger fw-semibold">Z-Reading Finalized for Current Business Day</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="pos-error-badge w-100">
                <i class="bi bi-exclamation-circle-fill me-1"></i>
                <span>@errorMessage</span>
            </div>
        }

        <div class="w-100 rounded-4 p-3 mb-3" style="background: rgba(15, 23, 42, 0.85); border: 1px solid rgba(239, 68, 68, 0.35);">
            <div class="small text-light mb-3" style="line-height: 1.5;">
                @(lockStatus.LockMessage ?? "End-of-Day Z-Reading has been finalized for this POS Terminal for the current business day. No logins or sales are permitted until 4:00 AM (Asia/Manila).")
            </div>

            <div class="d-flex justify-content-between py-1 border-top border-secondary border-opacity-25 small">
                <span class="text-secondary">Terminal</span>
                <span class="fw-semibold text-white">@(provisionedTerminalName ?? $"Terminal #{lockStatus.TerminalId}")</span>
            </div>
            <div class="d-flex justify-content-between py-1 border-top border-secondary border-opacity-25 small">
                <span class="text-secondary">Business Date</span>
                <span class="fw-semibold text-white font-monospace">@(lockStatus.ClosedBusinessDate ?? "—")</span>
            </div>
            <div class="d-flex justify-content-between py-1 border-top border-secondary border-opacity-25 small">
                <span class="text-secondary">Z-Reading Finalized By</span>
                <span class="fw-semibold text-warning">@(lockStatus.LockedByCashier ?? "Supervisor")</span>
            </div>
            @if (lockStatus.LockedAtUtc.HasValue)
            {
                <div class="d-flex justify-content-between py-1 border-top border-secondary border-opacity-25 small">
                    <span class="text-secondary">Finalized At</span>
                    <span class="text-white">@POS.Shared.Services.BusinessDayClock.FormatManilaDateTime(lockStatus.LockedAtUtc.Value)</span>
                </div>
            }
            @if (lockStatus.UnlockAtUtc.HasValue)
            {
                <div class="d-flex justify-content-between py-1 border-top border-secondary border-opacity-25 small">
                    <span class="text-secondary">Automatic Unlock</span>
                    <span class="fw-bold text-info">@POS.Shared.Services.BusinessDayClock.FormatManilaDateTime(lockStatus.UnlockAtUtc.Value)</span>
                </div>
            }
        </div>

        @if (lockStatus.ClockTamperDetected)
        {
            <div class="pos-error-badge w-100 mb-3">
                <i class="bi bi-clock-history me-1"></i>
                <span>Untrusted device clock change detected. Terminal remains locked until verified 4:00 AM (Asia/Manila).</span>
            </div>
        }

        <button type="button"
                class="btn btn-outline-light w-100 rounded-3 py-2 fw-semibold"
                @onclick="RefreshTerminalLockStatusAsync"
                disabled="@isLoading">
            <i class="bi bi-arrow-clockwise me-1"></i>
            Check Unlock Status
        </button>

        <div class="pos-footer w-100 flex-column">
            <div class="helper-text text-center">
                Terminal &amp; closing cashier restrictions reset automatically at 4:00 AM (Asia/Manila).
            </div>
            @if (ShowDevServerSwitcher)
            {
                <div class="mt-3 pt-2 text-center border-top border-secondary border-opacity-25 w-100">
                    <button type="button" class="btn btn-link text-secondary text-decoration-none p-0 font-monospace" style="font-size: 0.72rem;" @onclick="ToggleServerEndpointAsync" title="Click to switch between Localhost and UAT">
                        <i class="bi bi-hdd-network me-1"></i>Server: @CurrentServerDisplay <i class="bi bi-pencil-square ms-1"></i>
                    </button>
                </div>
            }
        </div>
    }
    else
    {
    <!-- POS Terminal Branding -->
    <div class="pos-header">
        <div class="pos-logo-icon">
            <i class="bi bi-display fs-2"></i>
        </div>
        <h2 class="pos-title">POS Terminal</h2>
        <p class="pos-subtitle">Enter your 4-digit PIN to begin</p>
    </div>

    <!-- Error Alert -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="pos-error-badge">
            <i class="bi bi-exclamation-circle-fill me-1"></i>
            <span>@errorMessage</span>
        </div>
    }
    else if (lockStatus?.HasUnresolvedPreviousDayShift == true)
    {
        <div class="w-100 rounded-3 px-3 py-2 mb-3 small text-start" style="background: rgba(245, 158, 11, 0.16); border: 1px solid rgba(245, 158, 11, 0.55); color: #fde68a;">
            <div class="fw-bold d-flex align-items-center gap-1 mb-1">
                <i class="bi bi-exclamation-triangle-fill text-warning"></i>
                <span>Unresolved Previous-Day Cashier Shift</span>
            </div>
            <div class="mb-1">
                Business Date: <strong class="font-monospace">@lockStatus.UnresolvedShiftBusinessDate</strong> •
                Original Cashier: <strong>@lockStatus.UnresolvedShiftCashierId</strong>
            </div>
            @if (string.Equals(lockStatus.UnresolvedShiftRecoveryStatus, TerminalClosingLockDto.RecoveryStatusUnverifiedCash, StringComparison.OrdinalIgnoreCase))
            {
                <div class="text-danger fw-semibold mb-1">
                    <i class="bi bi-search me-1"></i>Cash Unverified — Flagged for Investigation
                    @if (!string.IsNullOrWhiteSpace(lockStatus.UnresolvedShiftInvestigationReason))
                    {
                        <span>: @lockStatus.UnresolvedShiftInvestigationReason</span>
                    }
                </div>
            }
            <div style="font-size: 0.78rem; color: #fef3c7;">
                A new cashier cannot take over this drawer. A Manager or Supervisor must enter their PIN to review and perform Overnight Shift Recovery.
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(lockStatus?.ActiveShiftOwnerCashierId))
    {
        <div class="w-100 rounded-3 px-3 py-2 mb-3 small text-center" style="background: rgba(59, 130, 246, 0.14); border: 1px solid rgba(59, 130, 246, 0.35); color: #bfdbfe;">
            <i class="bi bi-person-lock me-1"></i>
            Open shift assigned to <strong>@lockStatus.ActiveShiftOwnerCashierId</strong>. Only this cashier may resume until Close Cashier is completed.
        </div>
    }

    <!-- PIN Visual Dots -->
    <div class="pin-display">
        @for (int i = 0; i < 4; i++)
        {
            var isFilled = pin.Length > i;
            <div class="pin-dot @(isFilled ? "filled" : "")"></div>
        }
    </div>

    <!-- POS Numpad Grid -->
    <div class="numpad-grid">
        <button type="button" class="numpad-btn" @onclick="() => AppendDigit('1')" disabled="@isLoading">1</button>
        <button type="button" class="numpad-btn" @onclick="() => AppendDigit('2')" disabled="@isLoading">2</button>
        <button type="button" class="numpad-btn" @onclick="() => AppendDigit('3')" disabled="@isLoading">3</button>

        <button type="button" class="numpad-btn" @onclick="() => AppendDigit('4')" disabled="@isLoading">4</button>
        <button type="button" class="numpad-btn" @onclick="() => AppendDigit('5')" disabled="@isLoading">5</button>
        <button type="button" class="numpad-btn" @onclick="() => AppendDigit('6')" disabled="@isLoading">6</button>

        <button type="button" class="numpad-btn" @onclick="() => AppendDigit('7')" disabled="@isLoading">7</button>
        <button type="button" class="numpad-btn" @onclick="() => AppendDigit('8')" disabled="@isLoading">8</button>
        <button type="button" class="numpad-btn" @onclick="() => AppendDigit('9')" disabled="@isLoading">9</button>

        <button type="button" class="numpad-btn action-btn clear-btn" @onclick="ClearPin" disabled="@isLoading">
            <span>C</span>
        </button>
        <button type="button" class="numpad-btn" @onclick="() => AppendDigit('0')" disabled="@isLoading">0</button>
        <button type="button" class="numpad-btn action-btn backspace-btn" @onclick="Backspace" disabled="@isLoading">
            <i class="bi bi-backspace-fill fs-5"></i>
        </button>
    </div>

    <!-- Status / Loading -->
    <div class="pos-footer">
        @if (isLoading)
        {
            <div class="loading-indicator">
                <span class="spinner"></span>
                <span>Authenticating cashier...</span>
            </div>
        }
        else
        {
            <div class="helper-text">Tap keypad to enter PIN</div>
        }
        @if (ShowDevServerSwitcher)
        {
            <div class="mt-3 pt-2 text-center border-top border-secondary border-opacity-25 w-100">
                <button type="button" class="btn btn-link text-secondary text-decoration-none p-0 font-monospace" style="font-size: 0.72rem;" @onclick="ToggleServerEndpointAsync" title="Click to switch between Localhost and UAT">
                    <i class="bi bi-hdd-network me-1"></i>Server: @CurrentServerDisplay <i class="bi bi-pencil-square ms-1"></i>
                </button>
            </div>
        }
    </div>
    }
</div>

<style>
    .pos-login-card {
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 1.5rem;
        padding: 2.5rem 2rem;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        color: #f8fafc;
        display: flex;
        flex-direction: column;
        align-items: center;
        user-select: none;
    }

    .pos-header {
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .pos-logo-icon {
        width: 64px;
        height: 64px;
        border-radius: 1rem;
        background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
        color: #ffffff;
        box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.4);
    }

    .pos-title {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0;
        color: #f8fafc;
        letter-spacing: -0.025em;
    }

    .pos-subtitle {
        font-size: 0.9rem;
        color: #94a3b8;
        margin: 0.35rem 0 0;
    }

    .pos-error-badge {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(239, 68, 68, 0.15);
        border: 1px solid rgba(239, 68, 68, 0.4);
        color: #fca5a5;
        font-size: 0.85rem;
        font-weight: 500;
        padding: 0.5rem 1rem;
        border-radius: 0.75rem;
        margin-bottom: 1.25rem;
        animation: shake 0.3s ease-in-out;
    }

    @@keyframes shake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-6px); }
        75% { transform: translateX(6px); }
    }

    .pin-display {
        display: flex;
        justify-content: center;
        gap: 1.25rem;
        margin-bottom: 2rem;
        padding: 0.75rem 0;
    }

    .pin-dot {
        width: 18px;
        height: 18px;
        border-radius: 50%;
        border: 2px solid #475569;
        background: transparent;
        transition: all 0.18s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .pin-dot.filled {
        background: #3b82f6;
        border-color: #60a5fa;
        transform: scale(1.15);
        box-shadow: 0 0 12px rgba(59, 130, 246, 0.6);
    }

    .hidden-pin-input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
        width: 0;
        height: 0;
    }

    .numpad-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.85rem;
        width: 100%;
        max-width: 320px;
    }

    .numpad-btn {
        height: 68px;
        border-radius: 1rem;
        border: 1px solid #334155;
        background: #0f172a;
        color: #f8fafc;
        font-size: 1.5rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.12s ease;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.2);
    }

    .numpad-btn:hover:not(:disabled) {
        background: #1e293b;
        border-color: #475569;
        transform: translateY(-2px);
    }

    .numpad-btn:active:not(:disabled) {
        background: #334155;
        transform: translateY(1px);
    }

    .numpad-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .action-btn {
        font-size: 1.15rem;
    }

    .clear-btn {
        color: #f87171;
        background: rgba(239, 68, 68, 0.1);
        border-color: rgba(239, 68, 68, 0.25);
    }

    .clear-btn:hover:not(:disabled) {
        background: rgba(239, 68, 68, 0.2);
        border-color: rgba(239, 68, 68, 0.4);
    }

    .backspace-btn {
        color: #94a3b8;
    }

    .pos-footer {
        margin-top: 1.75rem;
        min-height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .helper-text {
        font-size: 0.8rem;
        color: #64748b;
    }

    .loading-indicator {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #60a5fa;
        font-size: 0.85rem;
        font-weight: 500;
    }

    .spinner {
        width: 14px;
        height: 14px;
        border: 2px solid rgba(96, 165, 250, 0.25);
        border-top-color: #60a5fa;
        border-radius: 50%;
        animation: spin 0.7s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>

@code {
    private string pin = string.Empty;
    private bool isLoading = false;
    private string? errorMessage;
    private TerminalClosingLockDto? lockStatus;
    private string? provisionedTerminalName;
    private int provisionedTerminalId;
    private int provisionedBranchId;
    private System.Threading.Timer? _lockCheckTimer;

    protected override async Task OnInitializedAsync()
    {
        if (!await ActivationService.IsDeviceProvisionedAsync())
        {
            Navigation.NavigateTo("/activate", replace: true);
            return;
        }

        await RefreshTerminalLockStatusAsync();
        await MauiProgram.NotifySplashReadyAsync(Js);

        _lockCheckTimer = new System.Threading.Timer(async _ =>
        {
            try
            {
                await InvokeAsync(async () =>
                {
                    bool wasLocked = lockStatus?.IsTerminalLocked == true;
                    await RefreshTerminalLockStatusAsync();
                    if (wasLocked && lockStatus?.IsTerminalLocked != true)
                    {
                        errorMessage = null;
                    }
                    StateHasChanged();
                });
            }
            catch { }
        }, null, TimeSpan.FromSeconds(15), TimeSpan.FromSeconds(15));
    }

    private async Task RefreshTerminalLockStatusAsync()
    {
        try
        {
            var provisioned = await ActivationService.GetProvisionedTerminalAsync();
            if (provisioned != null)
            {
                provisionedTerminalId = provisioned.TerminalId;
                provisionedBranchId = provisioned.BranchId;
                provisionedTerminalName = !string.IsNullOrWhiteSpace(provisioned.TerminalCode)
                    ? $"{provisioned.TerminalCode} — {provisioned.TerminalName}"
                    : provisioned.TerminalName;
                lockStatus = await POS.Client.Services.ShiftSession.GetTerminalLockStatusAsync(
                    Http, provisioned.TerminalId, null, offline: false);
            }
        }
        catch { }
    }

    private static bool ShowDevServerSwitcher =>
#if DEBUG
        true;
#else
        false;
#endif

    private string CurrentServerDisplay =>
#if DEBUG
        Http.BaseAddress?.ToString().TrimEnd('/') ?? "http://localhost:5032";
#else
        string.Empty;
#endif

#if DEBUG
    private async Task ToggleServerEndpointAsync()
#else
    private Task ToggleServerEndpointAsync()
#endif
    {
#if DEBUG
        var current = Http.BaseAddress?.ToString().TrimEnd('/') ?? "http://localhost:5032";
        var isLocal = current.Contains("localhost", StringComparison.OrdinalIgnoreCase) || current.Contains("127.0.0.1");
        var nextTarget = isLocal ? "https://dev-uat.agressolutions.com/" : "http://localhost:5032/";
        var nextLabel = isLocal ? "UAT Cloud (https://dev-uat.agressolutions.com/)" : "Local API (http://localhost:5032/)";

        var confirm = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Switch Backend Server",
            Html = $"Current server:<br><code>{current}</code><br><br>Switch to:<br><strong>{nextLabel}</strong>?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            ConfirmButtonText = "Switch & Reconnect",
            CancelButtonText = "Cancel"
        });

        if (confirm.IsConfirmed)
        {
            Microsoft.Maui.Storage.Preferences.Default.Set("UAT_ApiBaseUrl", nextTarget);
            Http.BaseAddress = new Uri(nextTarget);
            await RefreshTerminalLockStatusAsync();
            await Swal.FireAsync(new SweetAlertOptions
            {
                Toast = true,
                Position = SweetAlertPosition.TopEnd,
                ShowConfirmButton = false,
                Timer = 2500,
                Icon = SweetAlertIcon.Success,
                Title = $"Target set to {nextTarget}"
            });
            StateHasChanged();
        }
#else
        return Task.CompletedTask;
#endif
    }

    public void Dispose()
    {
        _lockCheckTimer?.Dispose();
    }

    private async Task AppendDigit(char digit)
    {
        if (pin.Length >= 4 || isLoading) return;

        errorMessage = null;
        pin += digit;

        if (pin.Length == 4)
        {
            await SubmitPinAsync();
        }
    }

    private void ClearPin()
    {
        if (isLoading) return;
        pin = string.Empty;
        errorMessage = null;
    }

    private void Backspace()
    {
        if (isLoading) return;
        if (pin.Length > 0) pin = pin[..^1];
        errorMessage = null;
    }

    private static string ComputePinHash(string rawPin) =>
        Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(rawPin.Trim())));

    private async Task CacheOnlineLoginAsync(string rawPin, string username, string role, TerminalConfigDto outlet, string address)
    {
        List<UserDto>? allUsers = null;
        try
        {
            allUsers = await UserService.GetUsersAsync();
        }
        catch { }

        try
        {
            await POS.Client.Data.LocalPosDbContext.WriteLock.WaitAsync();
            try
            {
                using var db = new POS.Client.Data.LocalPosDbContext();
                db.InitializeDatabase();

                var validPinUsers = allUsers?.Where(u => !string.IsNullOrWhiteSpace(u.PinCode) && u.PinCode != "****").ToList();
                if (validPinUsers != null && validPinUsers.Count > 0)
                {
                    await Microsoft.EntityFrameworkCore.RelationalDatabaseFacadeExtensions.ExecuteSqlRawAsync(
                        db.Database, "DELETE FROM LocalCashiers;");
                    db.ChangeTracker.Clear();

                    var cashierSyncUtc = POS.Shared.Services.BusinessDayClock.UtcNow();
                    foreach (var u in validPinUsers)
                    {
                        db.Cashiers.Add(new POS.Client.Data.LocalCashier
                        {
                            UserId = u.UserId,
                            Username = u.Username,
                            Role = u.Role,
                            PinHash = ComputePinHash(u.PinCode!),
                            SyncedAtUtc = cashierSyncUtc
                        });
                    }
                }
                else
                {
                    var cashierSyncUtc = POS.Shared.Services.BusinessDayClock.UtcNow();
                    string pinHash = ComputePinHash(rawPin);
                    var existingCashier = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.FirstOrDefaultAsync(
                        db.Cashiers, c => c.Username == username || c.PinHash == pinHash);
                    if (existingCashier != null)
                    {
                        existingCashier.Username = username;
                        existingCashier.Role = role;
                        existingCashier.PinHash = pinHash;
                        existingCashier.SyncedAtUtc = cashierSyncUtc;
                    }
                    else
                    {
                        int nextId = (db.Cashiers.Any() ? db.Cashiers.Max(c => c.UserId) : 0) + 1;
                        db.Cashiers.Add(new POS.Client.Data.LocalCashier
                        {
                            UserId = nextId,
                            Username = username,
                            Role = role,
                            PinHash = pinHash,
                            SyncedAtUtc = cashierSyncUtc
                        });
                    }
                }

                var existingBranch = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.FirstOrDefaultAsync(
                    db.Branches, b => b.BranchId == outlet.BranchId);
                if (existingBranch != null)
                {
                    existingBranch.Name = outlet.BranchName;
                    existingBranch.BranchTagline = outlet.BranchTagline;
                    existingBranch.Code = outlet.BranchCode;
                    existingBranch.Address = outlet.BranchAddress;
                    existingBranch.Phone = outlet.BranchPhone;
                    existingBranch.TaxType = string.IsNullOrWhiteSpace(outlet.BranchTaxType) ? "VAT-Registered" : outlet.BranchTaxType;
                    existingBranch.VatDisplay = outlet.VatDisplay;
                    existingBranch.BusinessTypeId = outlet.BusinessTypeId ?? 1;
                    existingBranch.BusinessType = outlet.BusinessType ?? "FNB";
                    existingBranch.ReceiptLogoUrl = outlet.ReceiptLogoUrl;
                    if (string.IsNullOrWhiteSpace(outlet.ReceiptLogoUrl))
                    {
                        existingBranch.ReceiptLogoDataUri = null;
                        existingBranch.ReceiptLogoUpdatedAt = null;
                    }
                    else
                    {
                        if (!string.IsNullOrWhiteSpace(outlet.ReceiptLogoDataUri))
                            existingBranch.ReceiptLogoDataUri = outlet.ReceiptLogoDataUri;
                        existingBranch.ReceiptLogoUpdatedAt = outlet.ReceiptLogoUpdatedAt;
                    }
                    existingBranch.UpdatedAt = DateTime.UtcNow;
                }
                else if (outlet.BranchId > 0)
                {
                    db.Branches.Add(new POS.Client.Data.LocalBranch
                    {
                        BranchId = outlet.BranchId,
                        Name = outlet.BranchName,
                        BranchTagline = outlet.BranchTagline,
                        Code = outlet.BranchCode,
                        Address = outlet.BranchAddress,
                        Phone = outlet.BranchPhone,
                        TaxType = string.IsNullOrWhiteSpace(outlet.BranchTaxType) ? "VAT-Registered" : outlet.BranchTaxType,
                        VatDisplay = outlet.VatDisplay,
                        BusinessTypeId = outlet.BusinessTypeId ?? 1,
                        BusinessType = outlet.BusinessType ?? "FNB",
                        ReceiptLogoUrl = outlet.ReceiptLogoUrl,
                        ReceiptLogoDataUri = outlet.ReceiptLogoDataUri,
                        ReceiptLogoUpdatedAt = outlet.ReceiptLogoUpdatedAt,
                        IsActive = true,
                        UpdatedAt = DateTime.UtcNow
                    });
                }

                var existingOutlet = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.FirstOrDefaultAsync(
                    db.TerminalConfigs, o => o.TerminalId == outlet.TerminalId);
                if (existingOutlet != null)
                {
                    existingOutlet.OutletId = outlet.OutletId; existingOutlet.OutletName = outlet.OutletName;
                    existingOutlet.TerminalCode = outlet.TerminalCode; existingOutlet.IpAddress = outlet.IpAddress;
                    existingOutlet.PTUNumber = outlet.PTUNumber; existingOutlet.MINNumber = outlet.MINNumber; existingOutlet.SerialNumber = outlet.SerialNumber;
                    existingOutlet.BranchId = outlet.BranchId;
                    existingOutlet.BusinessTypeId = outlet.BusinessTypeId ?? 1;
                    existingOutlet.BusinessType = outlet.BusinessType ?? "FNB";
                    existingOutlet.BranchName = outlet.BranchName;
                    existingOutlet.BranchTagline = outlet.BranchTagline;
                    existingOutlet.BranchCode = outlet.BranchCode;
                    existingOutlet.BranchAddress = outlet.BranchAddress;
                    existingOutlet.BranchPhone = outlet.BranchPhone;
                    existingOutlet.BranchTaxType = string.IsNullOrWhiteSpace(outlet.BranchTaxType) ? "VAT-Registered" : outlet.BranchTaxType;
                    existingOutlet.VatDisplay = outlet.VatDisplay;
                    existingOutlet.ReceiptLogoUrl = outlet.ReceiptLogoUrl;
                    if (string.IsNullOrWhiteSpace(outlet.ReceiptLogoUrl))
                    {
                        existingOutlet.ReceiptLogoDataUri = null;
                        existingOutlet.ReceiptLogoUpdatedAt = null;
                    }
                    else
                    {
                        if (!string.IsNullOrWhiteSpace(outlet.ReceiptLogoDataUri))
                        {
                            existingOutlet.ReceiptLogoDataUri = outlet.ReceiptLogoDataUri;
                        }
                        existingOutlet.ReceiptLogoUpdatedAt = outlet.ReceiptLogoUpdatedAt;
                    }
                    existingOutlet.TerminalName = outlet.TerminalName;
                    existingOutlet.TerminalIdentifier = address;
                }
                else
                {
                    db.TerminalConfigs.Add(new POS.Client.Data.LocalTerminalConfig
                    {
                        TerminalId = outlet.TerminalId,
                        OutletId = outlet.OutletId, OutletName = outlet.OutletName, TerminalCode = outlet.TerminalCode,
                        IpAddress = outlet.IpAddress, PTUNumber = outlet.PTUNumber, MINNumber = outlet.MINNumber, SerialNumber = outlet.SerialNumber,
                        BranchId = outlet.BranchId,
                        BusinessTypeId = outlet.BusinessTypeId ?? 1,
                        BusinessType = outlet.BusinessType ?? "FNB",
                        MenuDisplayMode = outlet.MenuDisplayMode == MenuDisplayMode.ImageAndText
                            ? MenuDisplayMode.ImageAndText : MenuDisplayMode.TextOnly,
                        BranchName = outlet.BranchName,
                        BranchTagline = outlet.BranchTagline,
                        BranchCode = outlet.BranchCode,
                        BranchAddress = outlet.BranchAddress,
                        BranchPhone = outlet.BranchPhone,
                        ReceiptLogoUrl = outlet.ReceiptLogoUrl,
                        ReceiptLogoDataUri = outlet.ReceiptLogoDataUri,
                        ReceiptLogoUpdatedAt = outlet.ReceiptLogoUpdatedAt,
                        VatDisplay = outlet.VatDisplay,
                        TerminalName = outlet.TerminalName,
                        BranchTaxType = string.IsNullOrWhiteSpace(outlet.BranchTaxType) ? "VAT-Registered" : outlet.BranchTaxType,
                        TerminalIdentifier = address
                    });
                }
                await db.SaveChangesAsync();
            }
            finally
            {
                POS.Client.Data.LocalPosDbContext.WriteLock.Release();
            }
        }
        catch { }
    }

    private async Task<bool> TryOfflinePinLoginAsync(string rawPin)
    {
        try
        {
            using var db = new POS.Client.Data.LocalPosDbContext();
            db.InitializeDatabase();
            string pinHash = ComputePinHash(rawPin);

            var localCashier = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.FirstOrDefaultAsync(
                Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.AsNoTracking(db.Cashiers),
                c => c.PinHash == pinHash);
            if (localCashier == null || !POS.Shared.Constants.PosPermissions.IsApprovedClientRole(localCashier.Role)) return false;

            var localOutlet = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.FirstOrDefaultAsync(
                Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.AsNoTracking(db.TerminalConfigs));
            if (localOutlet == null || localOutlet.OutletId <= 0) return false; // Refresh legacy ownership online before a new offline session.

            var currentLock = await POS.Client.Services.ShiftSession.GetTerminalLockStatusAsync(
                Http, localOutlet.TerminalId, localCashier.Username, offline: true);
            if (currentLock.IsCashierRestricted || currentLock.IsTerminalLocked)
            {
                lockStatus = currentLock;
                throw new InvalidOperationException(
                    currentLock.CashierRestrictionMessage ??
                    currentLock.LockMessage ??
                    "POS Terminal is locked for the remainder of the current business day until 4:00 AM (Asia/Manila).");
            }
            if (currentLock.HasUnresolvedPreviousDayShift)
            {
                if (!POS.Client.Services.ShiftSession.IsSupervisorRole(localCashier.Role))
                {
                    lockStatus = currentLock;
                    throw new InvalidOperationException(
                        currentLock.UnresolvedShiftMessage ??
                        TerminalClosingLockDto.ActiveShiftOwnedByAnotherCashierMessage);
                }
            }
            else if (currentLock.IsShiftOwnedByAnotherCashier)
            {
                lockStatus = currentLock;
                throw new InvalidOperationException(
                    currentLock.ActiveShiftOwnershipMessage ??
                    TerminalClosingLockDto.ActiveShiftOwnedByAnotherCashierMessage);
            }

            var localBranch = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.FirstOrDefaultAsync(
                Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.AsNoTracking(db.Branches),
                b => b.BranchId == localOutlet.BranchId);

            var outletDto = new TerminalConfigDto
            {
                TerminalId = localOutlet.TerminalId,
                OutletId = localOutlet.OutletId, OutletName = localOutlet.OutletName, TerminalCode = localOutlet.TerminalCode,
                DeviceIdentifier = !string.IsNullOrWhiteSpace(localOutlet.TerminalIdentifier) ? localOutlet.TerminalIdentifier : localOutlet.DeviceUuid,
                Uuid = localOutlet.DeviceUuid,
                IpAddress = localOutlet.IpAddress, PTUNumber = localOutlet.PTUNumber, MINNumber = localOutlet.MINNumber, SerialNumber = localOutlet.SerialNumber,
                BranchId = localOutlet.BranchId,
                BusinessTypeId = localBranch?.BusinessTypeId ?? localOutlet.BusinessTypeId ?? 1,
                BusinessType = localBranch?.BusinessType ?? localOutlet.BusinessType ?? "FNB",
                MenuDisplayMode = localOutlet.MenuDisplayMode == MenuDisplayMode.ImageAndText
                    ? MenuDisplayMode.ImageAndText : MenuDisplayMode.TextOnly,
                BranchName = !string.IsNullOrWhiteSpace(localBranch?.Name) ? localBranch.Name : (localOutlet.BranchName ?? localOutlet.TerminalName),
                BranchTagline = localBranch != null ? localBranch.BranchTagline : localOutlet.BranchTagline,
                BranchCode = !string.IsNullOrWhiteSpace(localBranch?.Code) ? localBranch.Code : (localOutlet.BranchCode ?? $"BR-{localOutlet.BranchId:D2}"),
                BranchAddress = localBranch?.Address ?? localOutlet.BranchAddress,
                BranchPhone = localBranch?.Phone ?? localOutlet.BranchPhone,
                BranchTaxType = !string.IsNullOrWhiteSpace(localBranch?.TaxType) ? localBranch.TaxType : localOutlet.BranchTaxType,
                VatDisplay = localBranch?.VatDisplay ?? localOutlet.VatDisplay,
                ReceiptLogoUrl = localBranch?.ReceiptLogoUrl ?? localOutlet.ReceiptLogoUrl,
                ReceiptLogoDataUri = localBranch?.ReceiptLogoDataUri ?? localOutlet.ReceiptLogoDataUri,
                ReceiptLogoUpdatedAt = localBranch?.ReceiptLogoUpdatedAt ?? localOutlet.ReceiptLogoUpdatedAt,
                TerminalName = localOutlet.TerminalName
            };

            // Clear any prior user's bearer token before activating the new account's session
            POS.Client.Services.DeviceActivationService.ActiveTerminalToken = null;
            Http.DefaultRequestHeaders.Authorization = null;

            var sessionToken = "OFFLINE-SESSION-TOKEN";
            Session.SetSession(sessionToken, localCashier.Username, localCashier.Role, outletDto);

            var tokenProbe = await POS.Client.Services.DeviceActivationService.EnsureOnlineBearerTokenWithStatusAsync(Http, Session, forceRefresh: false);
            if (!tokenProbe.Success && !tokenProbe.IsTransientError &&
                tokenProbe.RejectionStatus is System.Net.HttpStatusCode.Forbidden or System.Net.HttpStatusCode.Locked or System.Net.HttpStatusCode.Conflict)
            {
                Session.ClearSession();
                POS.Client.Services.DeviceActivationService.ActiveTerminalToken = null;
                Http.DefaultRequestHeaders.Authorization = null;
                await RefreshTerminalLockStatusAsync();
                throw new InvalidOperationException(string.IsNullOrWhiteSpace(tokenProbe.ErrorMessage)
                    ? TerminalClosingLockDto.ActiveShiftOwnedByAnotherCashierMessage
                    : tokenProbe.ErrorMessage);
            }

            if (tokenProbe.Success)
            {
                try
                {
                    var auth = await UserService.PinLoginAsync(rawPin, localOutlet.TerminalId, localOutlet.BranchId);
                    if (auth != null && !string.IsNullOrWhiteSpace(auth.Value.Token))
                    {
                        sessionToken = auth.Value.Token;
                        Session.SetSession(sessionToken, auth.Value.Username, auth.Value.Role, outletDto);
                        Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", sessionToken);

                        using var actResp = await Http.PostAsJsonAsync("api/cashier-sessions/activate", new CashierSessionActivateDto
                        {
                            BranchId = localOutlet.BranchId,
                            TerminalId = localOutlet.TerminalId,
                            DeviceIdentifier = localOutlet.DeviceUuid ?? localOutlet.TerminalIdentifier ?? string.Empty
                        });
                        if (actResp.StatusCode is System.Net.HttpStatusCode.Forbidden or System.Net.HttpStatusCode.Locked or System.Net.HttpStatusCode.Conflict)
                        {
                            string actErr = (await actResp.Content.ReadAsStringAsync()).Trim('"');
                            Session.ClearSession();
                            POS.Client.Services.DeviceActivationService.ActiveTerminalToken = null;
                            Http.DefaultRequestHeaders.Authorization = null;
                            await RefreshTerminalLockStatusAsync();
                            throw new InvalidOperationException(string.IsNullOrWhiteSpace(actErr)
                                ? TerminalClosingLockDto.ActiveShiftOwnedByAnotherCashierMessage
                                : actErr);
                        }
                    }

                    await ReferenceDataSync.SyncReferenceDataAsync(localOutlet.TerminalId, Http);
                }
                catch (InvalidOperationException)
                {
                    // Authoritative server rejection (403/409/423): NEVER swallow or fall back to offline login!
                    Session.ClearSession();
                    POS.Client.Services.DeviceActivationService.ActiveTerminalToken = null;
                    Http.DefaultRequestHeaders.Authorization = null;
                    await RefreshTerminalLockStatusAsync();
                    throw;
                }
                catch
                {
                    // Non-fatal network error: continue with verified local offline session
                }
            }

            await Session.RefreshCachedMenuDisplayModeAsync();

            if (!localOutlet.IsInitialized)
            {
                Navigation.NavigateTo("/initialization");
                return true;
            }

            Navigation.NavigateTo(currentLock.HasUnresolvedPreviousDayShift ? "/cash-drawer" : "/");
            return true;
        }
        catch (InvalidOperationException)
        {
            throw;
        }
        catch
        {
            return false;
        }
    }

    private async Task SubmitPinAsync()
    {
        if (string.IsNullOrWhiteSpace(pin) || isLoading) return;

        isLoading = true;
        errorMessage = null;

        try
        {
            await RefreshTerminalLockStatusAsync();
            if (lockStatus?.IsTerminalLocked == true)
            {
                errorMessage = lockStatus.LockMessage ?? "POS Terminal is locked for the remainder of the current business day until 4:00 AM (Asia/Manila).";
                return;
            }

            // Local-First: Always authenticate against local SQLite cache first (zero network dependency).
            if (await TryOfflinePinLoginAsync(pin))
            {
                return;
            }

            (string Token, string Username, string Role)? authResult = null;
            bool isNetworkError = false;
            try
            {
                authResult = await UserService.PinLoginAsync(
                    pin,
                    provisionedTerminalId > 0 ? provisionedTerminalId : null,
                    provisionedBranchId > 0 ? provisionedBranchId : null);
            }
            catch (InvalidOperationException)
            {
                await RefreshTerminalLockStatusAsync();
                throw;
            }
            catch (Exception)
            {
                isNetworkError = true;
            }

            if (authResult != null)
            {
                var (token, username, role) = authResult.Value;

                var provisioned = await ActivationService.GetProvisionedTerminalAsync();
                if (provisioned == null || string.IsNullOrWhiteSpace(provisioned.DeviceUuid))
                {
                    Navigation.NavigateTo("/activate", replace: true);
                    return;
                }

                var postAuthLock = await POS.Client.Services.ShiftSession.GetTerminalLockStatusAsync(
                    Http, provisioned.TerminalId, username, offline: false);
                if (postAuthLock.IsCashierRestricted || postAuthLock.IsTerminalLocked)
                {
                    lockStatus = postAuthLock;
                    throw new InvalidOperationException(
                        postAuthLock.CashierRestrictionMessage ??
                        postAuthLock.LockMessage ??
                        "POS Terminal is locked for the remainder of the current business day until 4:00 AM (Asia/Manila).");
                }
                if (postAuthLock.HasUnresolvedPreviousDayShift)
                {
                    if (!POS.Client.Services.ShiftSession.IsSupervisorRole(role))
                    {
                        lockStatus = postAuthLock;
                        throw new InvalidOperationException(
                            postAuthLock.UnresolvedShiftMessage ??
                            TerminalClosingLockDto.ActiveShiftOwnedByAnotherCashierMessage);
                    }
                }
                else if (postAuthLock.IsShiftOwnedByAnotherCashier)
                {
                    lockStatus = postAuthLock;
                    throw new InvalidOperationException(
                        postAuthLock.ActiveShiftOwnershipMessage ??
                        TerminalClosingLockDto.ActiveShiftOwnedByAnotherCashierMessage);
                }

                var deviceUuid = provisioned.DeviceUuid;
                var outlet = await TerminalService.ResolveTerminalAsync(null, token, deviceUuid);
                if (outlet == null)
                {
                    errorMessage = "This device UUID is not paired to an active terminal.";
                    return;
                }
                if (!string.IsNullOrEmpty(outlet.Token))
                {
                    token = outlet.Token;
                }
                POS.Client.Services.DeviceActivationService.ActiveTerminalToken = null;
                Http.DefaultRequestHeaders.Authorization = null;
                Session.SetSession(token, username, role, outlet);
                await CacheOnlineLoginAsync(pin, username, role, outlet, deviceUuid);

                // Set token for future API requests FIRST so ReferenceDataSync has Authorization header
                Http.DefaultRequestHeaders.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

                // Notify backend cashier session activation (strictly enforcing open shift ownership)
                try
                {
                    using var actResponse = await Http.PostAsJsonAsync("api/cashier-sessions/activate", new CashierSessionActivateDto
                    {
                        BranchId = outlet.BranchId,
                        TerminalId = outlet.TerminalId,
                        DeviceIdentifier = deviceUuid
                    });
                    if (actResponse.StatusCode is System.Net.HttpStatusCode.Forbidden or System.Net.HttpStatusCode.Locked or System.Net.HttpStatusCode.Conflict)
                    {
                        string actErr = (await actResponse.Content.ReadAsStringAsync()).Trim('"');
                        Session.ClearSession();
                        Http.DefaultRequestHeaders.Authorization = null;
                        await RefreshTerminalLockStatusAsync();
                        throw new InvalidOperationException(string.IsNullOrWhiteSpace(actErr)
                            ? TerminalClosingLockDto.ActiveShiftOwnedByAnotherCashierMessage
                            : actErr);
                    }

                    // Ensure token is attached for reference data sync call
                    Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
                    var syncResult = await ReferenceDataSync.SyncReferenceDataAsync(outlet.TerminalId, Http);
                    Console.WriteLine($"[Login] ReferenceDataSync result: {syncResult} for TerminalId: {outlet.TerminalId}");
                }
                catch (InvalidOperationException)
                {
                    throw;
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[Login] ReferenceDataSync exception: {ex.Message}");
                }

                // Use the committed cache even when the reference request failed; never use an uncommitted response.
                await Session.RefreshCachedMenuDisplayModeAsync();

                // Check first-time initialization completion
                using (var db = new POS.Client.Data.LocalPosDbContext())
                {
                    db.InitializeDatabase();
                    var termConfig = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.FirstOrDefaultAsync(
                        db.TerminalConfigs, t => t.TerminalId == outlet.TerminalId);
                    if (termConfig?.IsInitialized != true)
                    {
                        Navigation.NavigateTo("/initialization");
                        return;
                    }
                }

                // Navigate to Supervisor Overnight Recovery screen if a previous-day shift is unresolved, else main POS dashboard
                Navigation.NavigateTo(postAuthLock.HasUnresolvedPreviousDayShift ? "/cash-drawer" : "/");
            }
            else if (isNetworkError && await TryOfflinePinLoginAsync(pin))
            {
                return;
            }
            else if (await TryOfflinePinLoginAsync(pin))
            {
                return;
            }
            else
            {
                errorMessage = isNetworkError
                    ? "Offline PIN not found in local cache. Log in online once to sync staff PINs."
                    : "Invalid PIN. Please try again.";
                pin = string.Empty;
            }
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            if (await TryOfflinePinLoginAsync(pin)) return;
            errorMessage = $"Server error: {ex.Message}";
            pin = string.Empty;
        }
        finally
        {
            if (errorMessage != null)
            {
                Session.ClearSession();
                Http.DefaultRequestHeaders.Authorization = null;
                pin = string.Empty;
            }
            isLoading = false;
        }
    }
