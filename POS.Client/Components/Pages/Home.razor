@page "/"
@page "/dashboard"
@using POS.Client.Data
@inject PosSessionService Session
@inject NavigationManager Navigation
@inject POS.Client.Services.IPosConnectivityService ConnectivityService
@inject POS.Client.Workers.IOfflineBackgroundSyncService BackgroundSyncService
@inject POS.Client.Data.LocalPosDbContext LocalDb
@implements IDisposable

@code {
    private TerminalConnectivityState _connectivityState = TerminalConnectivityState.Unknown;
    private int _pendingCount = 0;
    private int _conflictedCount = 0;
    private DateTime? _lastSuccessfulSync = null;
    private DateTime _lastCheckTime = DateTime.UtcNow;
    private bool _isSyncing = false;
    private System.Threading.Timer? _statusTimer;

    protected override async Task OnInitializedAsync()
    {
        await RefreshStatusAsync();
        _statusTimer = new System.Threading.Timer(async _ => await InvokeAsync(RefreshStatusAsync), null, TimeSpan.Zero, TimeSpan.FromSeconds(15));
    }

    private async Task RefreshStatusAsync()
    {
        _lastCheckTime = DateTime.UtcNow;
        _connectivityState = await ConnectivityService.CheckConnectivityAsync();

        try
        {
            using var db = new LocalPosDbContext();
            db.InitializeDatabase();
            _pendingCount = db.SyncOutboxes.Count(o => o.Status == "PENDING" || o.Status == "RETRY_PENDING");
            _conflictedCount = db.SyncOutboxes.Count(o => o.Status == "NEEDS_ATTENTION");
            
            var lastSynced = db.SyncOutboxes
                .Where(o => o.Status == "SYNCED")
                .OrderByDescending(o => o.OutboxId)
                .FirstOrDefault();

            if (lastSynced != null)
            {
                _lastSuccessfulSync = lastSynced.CreatedAt;
            }
        }
        catch
        {
            // Suppress status read errors
        }

        StateHasChanged();
    }

    private async Task ManualSyncAsync()
    {
        _isSyncing = true;
        StateHasChanged();
        try
        {
            await BackgroundSyncService.TriggerManualSyncAsync();
            await RefreshStatusAsync();
        }
        finally
        {
            _isSyncing = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        _statusTimer?.Dispose();
    }
}


@if (!Session.IsAuthenticated)
{
    <div class="pos-loading-screen">
        <div class="spinner-border text-primary" role="status"></div>
        <span class="ms-2 text-muted">Redirecting to terminal login...</span>
    </div>
}
else
{
    <div class="pos-terminal-container">


        <!-- Main Terminal Body -->
        <main class="pos-main-content">
            <div class="alert alert-primary d-flex align-items-center rounded-3 p-3 mb-4 shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill fs-4 me-2 flex-shrink-0"></i>
                <div>
                    <strong>Welcome, @Session.Username!</strong> Terminal session is active. Ready to process orders.
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-4">
                    <div class="card shadow-sm border-0 rounded-3 p-3">
                        <h6 class="text-muted text-uppercase fw-bold small">Current Cashier</h6>
                        <h4 class="fw-bolder mb-1">@Session.Username</h4>
                        <span class="badge bg-info text-dark align-self-start">@Session.Role</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card shadow-sm border-0 rounded-3 p-3">
                        <h6 class="text-muted text-uppercase fw-bold small">Active Shift</h6>
                        <h4 class="fw-bolder mb-1">Open</h4>
                        <span class="text-success small fw-medium">Ready for transactions</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card shadow-sm border-0 rounded-3 p-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <h6 class="text-muted text-uppercase fw-bold small mb-0">Terminal Status</h6>
                            <button class="btn btn-sm btn-outline-secondary py-0 px-2" @onclick="ManualSyncAsync" disabled="@_isSyncing" title="Sync Pending Transactions">
                                @if (_isSyncing)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                }
                                else
                                {
                                    <i class="bi bi-arrow-repeat"></i> <span>Sync Now</span>
                                }
                            </button>
                        </div>
                        <h4 class="fw-bolder mb-1">
                            @if (_isSyncing)
                            {
                                <span class="text-primary">SYNCING</span>
                            }
                            else if (_conflictedCount > 0)
                            {
                                <span class="text-danger">NEEDS_ATTENTION</span>
                            }
                            else if (_connectivityState == TerminalConnectivityState.OnlineAndHealthy)
                            {
                                <span class="text-success">ONLINE</span>
                            }
                            else
                            {
                                <span class="text-warning">OFFLINE</span>
                            }
                        </h4>
                        <div class="small text-muted d-flex flex-column gap-1 mt-1">
                            <span>Pending Transactions: <strong>@_pendingCount</strong></span>
                            @if (_conflictedCount > 0)
                            {
                                <span class="text-danger">Conflicts/Errors: <strong>@_conflictedCount</strong></span>
                            }
                            <span>Last Sync: @(_lastSuccessfulSync?.ToString("hh:mm tt") ?? "None")</span>
                            <span class="text-muted" style="font-size: 0.75rem;">Checked: @_lastCheckTime.ToString("hh:mm:ss tt")</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4 p-4 bg-light rounded-3 border d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold mb-1">Ready to create a sale?</h5>
                    <p class="text-muted mb-0 small">Access product catalog, manage customer cart, and proceed to payment.</p>
                </div>
                <div class="d-flex gap-3">
                    <button type="button" class="btn btn-primary px-4 py-2 fw-semibold d-flex align-items-center gap-2 rounded-3 shadow-sm" @onclick="@(() => Navigation.NavigateTo("/new-sale"))">
                        <i class="bi bi-cart-fill"></i>
                        Start New Sale
                    </button>
                </div>
            </div>
        </main>
    </div>
}

<style>
    .pos-loading-screen {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 80vh;
    }

    .pos-terminal-container {
        padding: 1.5rem;
    }

    .pos-top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 1.25rem;
        margin-bottom: 1.5rem;
        border-bottom: 1px solid #e2e8f0;
    }

    .pos-user-status {
        display: flex;
        align-items: center;
    }
</style>

@code {
    protected override void OnInitialized()
    {
        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
        }
    }
}
