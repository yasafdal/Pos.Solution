@page "/"
@page "/dashboard"
@inject PosSessionService Session
@inject NavigationManager Navigation

@if (!Session.IsAuthenticated)
{
    <div class="pos-loading-screen">
        <div class="spinner-border text-primary" role="status"></div>
        <span class="ms-2 text-muted">Redirecting to terminal login...</span>
    </div>
}
else
{
    <div class="pos-terminal-container">


        <!-- Main Terminal Body -->
        <main class="pos-main-content">
            <div class="alert alert-primary d-flex align-items-center rounded-3 p-3 mb-4 shadow-sm" role="alert">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-2 flex-shrink-0">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
                <div>
                    <strong>Welcome, @Session.Username!</strong> Terminal session is active. Ready to process orders.
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-4">
                    <div class="card shadow-sm border-0 rounded-3 p-3">
                        <h6 class="text-muted text-uppercase fw-bold small">Current Cashier</h6>
                        <h4 class="fw-bolder mb-1">@Session.Username</h4>
                        <span class="badge bg-info text-dark align-self-start">@Session.Role</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card shadow-sm border-0 rounded-3 p-3">
                        <h6 class="text-muted text-uppercase fw-bold small">Active Shift</h6>
                        <h4 class="fw-bolder mb-1">Open</h4>
                        <span class="text-success small fw-medium">Ready for transactions</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card shadow-sm border-0 rounded-3 p-3">
                        <h6 class="text-muted text-uppercase fw-bold small">Terminal Status</h6>
                        <h4 class="fw-bolder mb-1">Connected</h4>
                        <span class="text-muted small">PostgreSQL Backend</span>
                    </div>
                </div>
            </div>

            <div class="mt-4 p-4 bg-light rounded-3 border d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold mb-1">Ready to create a sale?</h5>
                    <p class="text-muted mb-0 small">Access product catalog, manage customer cart, and proceed to payment.</p>
                </div>
                <button type="button" class="btn btn-primary px-4 py-2 fw-semibold d-flex align-items-center gap-2 rounded-3 shadow-sm" @onclick="@(() => Navigation.NavigateTo("/new-sale"))">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    </svg>
                    Start New Sale
                </button>
            </div>
        </main>
    </div>
}

<style>
    .pos-loading-screen {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 80vh;
    }

    .pos-terminal-container {
        padding: 1.5rem;
    }

    .pos-top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 1.25rem;
        margin-bottom: 1.5rem;
        border-bottom: 1px solid #e2e8f0;
    }

    .pos-user-status {
        display: flex;
        align-items: center;
    }
</style>

@code {
    protected override void OnInitialized()
    {
        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
        }
    }


}
