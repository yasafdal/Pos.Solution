@inject IDiscountService DiscountService
@inject PosSessionService Session
@inject IReferenceDataSyncService ReferenceDataSync
@inject HttpClient Http
@using Microsoft.EntityFrameworkCore
@using POS.Shared.Models
@using POS.Shared.Interfaces
@using POS.Shared.Services
@using Microsoft.AspNetCore.Components.Web

@if (isDiscountModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.5); backdrop-filter: blur(3px);" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable discount-modal-dialog">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <!-- Header -->
                <div class="modal-header border-bottom px-3 py-2.5 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold text-dark mb-0">Apply Discount</h5>
                        <small class="text-secondary">Select statutory or store discount</small>
                    </div>
                    <button type="button" class="btn-close shadow-none" @onclick="CloseDiscountModal" aria-label="Close"></button>
                </div>

                <!-- Body (Single Vertical Scroll Container) -->
                <div class="modal-body p-3">
                    @if (!string.IsNullOrEmpty(discountError))
                    {
                        <div class="alert alert-danger py-2 mb-2 rounded-3 small" role="alert">
                            @discountError
                        </div>
                    }

                    <!-- 5-Column Grid of Discounts -->
                    @if (availableDiscounts != null && SortedDiscounts.Any())
                    {
                        <div class="discount-grid">
                            @foreach (var dt in SortedDiscounts)
                            {
                                var isSelected = selectedDiscountCode == dt.Code;
                                <button type="button"
                                        class="discount-item-btn @(isSelected ? "selected" : "")"
                                        @onclick="() => SelectDiscountType(dt)"
                                        aria-pressed="@(isSelected ? "true" : "false")">
                                    @if (isSelected)
                                    {
                                        <i class="bi bi-check-circle-fill discount-check-icon"></i>
                                    }
                                    <div class="discount-icon-wrap">
                                        <i class="bi @GetDiscountIcon(dt) discount-icon"></i>
                                    </div>
                                    <span class="discount-item-name" title="@dt.Name">@FormatDiscountName(dt.Name)</span>
                                    <span class="discount-item-badge @GetBadgeColorClass(dt)">@GetBadgeText(dt)</span>
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4 small">
                            <i class="bi bi-percent fs-3 d-block mb-1 text-secondary"></i>
                            No active discounts available.
                        </div>
                    }

                    <!-- Beneficiary ID Input (Only when required) -->
                    @if (selectedDiscountType != null && selectedDiscountType.RequiresIdentification)
                    {
                        <div class="discount-input-box mt-3">
                            <label class="form-label fw-semibold small text-dark mb-1">
                                Beneficiary ID / Card Number <span class="text-danger">*</span>
                            </label>
                            <input type="text"
                                   class="form-control"
                                   @bind="cardOrIdNumber"
                                   @bind:event="oninput"
                                   placeholder="Enter ID number..." />
                        </div>
                    }

                    <!-- Manual Discount Input (Percentage % or Fixed Amount ₱ when Manual is selected) -->
                    @if (selectedDiscountType != null && selectedDiscountType.Code == "MANUAL")
                    {
                        <div class="discount-input-box mt-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-semibold small text-dark mb-0">
                                    @(manualInputMode == "FIXED" ? "Discount Amount (₱)" : "Discount Percentage (%)") <span class="text-danger">*</span>
                                </label>
                                <div class="btn-group btn-group-sm" role="group" aria-label="Manual discount mode">
                                    <button type="button"
                                            class="btn @(manualInputMode == "PERCENTAGE" ? "btn-primary" : "btn-outline-secondary")"
                                            @onclick='() => SetManualInputMode("PERCENTAGE")'>
                                        % Percent
                                    </button>
                                    <button type="button"
                                            class="btn @(manualInputMode == "FIXED" ? "btn-primary" : "btn-outline-secondary")"
                                            @onclick='() => SetManualInputMode("FIXED")'>
                                        ₱ Fixed
                                    </button>
                                </div>
                            </div>
                            @if (manualInputMode == "FIXED")
                            {
                                <div class="input-group" style="max-width: 220px;">
                                    <span class="input-group-text bg-light">₱</span>
                                    <input type="number"
                                           min="0"
                                           max="@Cart.Subtotal"
                                           step="0.01"
                                           class="form-control fw-bold"
                                           @bind="manualFixedAmount"
                                           @bind:event="oninput" />
                                </div>
                                <small class="text-muted d-block mt-1">Eligible amount: ₱@Cart.Subtotal.ToString("N2")</small>
                            }
                            else
                            {
                                <div class="input-group" style="max-width: 180px;">
                                    <input type="number"
                                           min="0"
                                           max="100"
                                           step="0.5"
                                           class="form-control fw-bold"
                                           @bind="manualPercentage"
                                           @bind:event="oninput" />
                                    <span class="input-group-text bg-light">%</span>
                                </div>
                                <small class="text-muted d-block mt-1">Allowed range: 0% to 100%</small>
                            }
                        </div>
                    }
                </div>

                <!-- Footer -->
                <div class="modal-footer border-top bg-light px-3 py-2.5 d-flex justify-content-between align-items-center">
                    <div>
                        @if (Cart.ActiveDiscountCode != "NONE")
                        {
                            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="ClearDiscount">
                                Remove Discount
                            </button>
                        }
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary px-3" @onclick="CloseDiscountModal">
                            Cancel
                        </button>
                        <button type="button" class="btn btn-primary px-4 fw-bold" @onclick="ConfirmDiscount" disabled="@(selectedDiscountType == null || !selectedDiscountType.IsActive)">
                            Apply
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public CartService Cart { get; set; } = null!;
    [Parameter] public EventCallback OnDiscountChanged { get; set; }

    private bool isDiscountModalOpen = false;
    private List<DiscountTypeDto>? availableDiscounts;
    private DiscountTypeDto? selectedDiscountType;
    private string selectedDiscountCode = "NONE";
    private string? cardOrIdNumber;
    private string manualInputMode = "PERCENTAGE";
    private decimal manualPercentage = 0m;
    private decimal manualFixedAmount = 0m;
    private string? discountError;

    private void SetManualInputMode(string mode)
    {
        manualInputMode = mode;
        discountError = null;
    }

    public async Task OpenAsync()
    {
        availableDiscounts = null;

        // Best-effort incremental sync from PostgreSQL -> SQLite (non-fatal when offline)
        try
        {
            await DeviceActivationService.EnsureOnlineBearerTokenAsync(Http, Session);
            await ReferenceDataSync.SyncDiscountTypesIncrementalAsync(Http);
        }
        catch { }

        int totalCachedCount = 0;
        try
        {
            var localResult = await ReferenceDataSyncService.LoadActiveDiscountsFromLocalDbAsync();
            totalCachedCount = localResult.TotalLocalCount;
            if (totalCachedCount > 0)
            {
                availableDiscounts = localResult.ActiveDiscounts;
            }
        }
        catch { }

        // Only query the live endpoint directly if SQLite has never been synced yet
        if (totalCachedCount == 0)
        {
            try
            {
                var remoteAll = await DiscountService.GetDiscountTypesAsync();
                if (remoteAll.Count > 0)
                {
                    // Persist all records (active and inactive) to SQLite for offline parity
                    try
                    {
                        await POS.Client.Data.LocalPosDbContext.WriteLock.WaitAsync();
                        try
                        {
                            using var db = new POS.Client.Data.LocalPosDbContext();
                            db.InitializeDatabase();
                            var dtos = remoteAll.Select(d => new OfflineDiscountDto
                            {
                                DiscountId = d.DiscountTypeId,
                                Code = d.Code,
                                Name = d.Name,
                                DiscountCategory = d.DiscountCategory,
                                DiscountMethod = d.DiscountMethod,
                                DiscountValue = d.DiscountValue,
                                IsStatutory = d.IsStatutory,
                                RequiresIdentification = d.RequiresIdentification,
                                RequiresApproval = d.RequiresApproval,
                                IsActive = d.IsActive,
                                UpdatedAtUtc = d.UpdatedAt != default ? d.UpdatedAt : d.CreatedAt
                            }).ToList();
                            await ReferenceDataSyncService.UpsertDiscountsInPlaceAsync(db, dtos, DateTime.UtcNow);
                            await db.SaveChangesAsync();
                        }
                        finally
                        {
                            POS.Client.Data.LocalPosDbContext.WriteLock.Release();
                        }
                    }
                    catch { }

                    availableDiscounts = remoteAll.Where(d => d.IsActive).ToList();
                    totalCachedCount = remoteAll.Count;
                }
            }
            catch { }
        }

        if (availableDiscounts == null)
        {
            if (totalCachedCount == 0)
            {
                availableDiscounts = new List<DiscountTypeDto>
                {
                    new() { Code = "NONE", Name = "No Discount", DiscountCategory = "NONE", DiscountMethod = "PERCENTAGE", DiscountValue = 0, IsActive = true },
                    new() { Code = "SC", Name = "Senior Citizen (20%)", DiscountCategory = "STATUTORY", DiscountMethod = "PERCENTAGE", DiscountValue = 20, IsStatutory = true, RequiresIdentification = true, IsActive = true },
                    new() { Code = "PWD", Name = "PWD (20%)", DiscountCategory = "STATUTORY", DiscountMethod = "PERCENTAGE", DiscountValue = 20, IsStatutory = true, RequiresIdentification = true, IsActive = true },
                    new() { Code = "BNPC", Name = "Basic Commodities (5%)", DiscountCategory = "STATUTORY", DiscountMethod = "PERCENTAGE", DiscountValue = 5, IsStatutory = true, IsActive = true },
                    new() { Code = "EMPLOYEE", Name = "Employee Discount", DiscountCategory = "CORPORATE", DiscountMethod = "PERCENTAGE", DiscountValue = 10, RequiresIdentification = true, IsActive = true },
                    new() { Code = "MANUAL", Name = "Manual Custom Discount", DiscountCategory = "CUSTOM", DiscountMethod = "PERCENTAGE", DiscountValue = 0, IsActive = true }
                };
            }
            else
            {
                availableDiscounts = new List<DiscountTypeDto>();
            }
        }

        selectedDiscountCode = Cart.ActiveDiscountCode;
        selectedDiscountType = availableDiscounts.FirstOrDefault(d => d.IsActive && string.Equals(d.Code, selectedDiscountCode, StringComparison.OrdinalIgnoreCase))
            ?? availableDiscounts.FirstOrDefault(d => d.IsActive);
        selectedDiscountCode = selectedDiscountType?.Code ?? "NONE";
        cardOrIdNumber = Cart.CustomerCardNumber;
        manualPercentage = Cart.ManualDiscountPercentage;
        manualFixedAmount = Cart.ManualDiscountAmount;
        manualInputMode = Cart.ManualDiscountAmount > 0m ? "FIXED" : "PERCENTAGE";
        discountError = null;
        isDiscountModalOpen = true;
    }

    private void CloseDiscountModal() => isDiscountModalOpen = false;

    private void SelectDiscountType(DiscountTypeDto dt)
    {
        selectedDiscountType = dt;
        selectedDiscountCode = dt.Code;
        discountError = null;
    }

    private IEnumerable<DiscountTypeDto> SortedDiscounts
    {
        get
        {
            if (availableDiscounts == null) return Enumerable.Empty<DiscountTypeDto>();

            // Display only active discount types, keeping custom/manual discount at the bottom
            return availableDiscounts
                .Where(d => d.IsActive)
                .OrderBy(d => IsCustomDiscount(d) ? 1 : 0);
        }
    }

    private static bool IsCustomDiscount(DiscountTypeDto dt)
    {
        if (dt == null) return false;
        var code = (dt.Code ?? "").ToUpperInvariant();
        var cat = (dt.DiscountCategory ?? "").ToUpperInvariant();
        var name = (dt.Name ?? "").ToLowerInvariant();

        return code == "MANUAL" || cat == "CUSTOM" || name.Contains("manual") || name.Contains("custom");
    }

    private string FormatDiscountName(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return string.Empty;
        return System.Text.RegularExpressions.Regex.Replace(name, @"\s*\(\d+%\)\s*$", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase).Trim();
    }

    private string GetBadgeText(DiscountTypeDto dt)
    {
        if (dt.Code == "NONE") return "0%";
        if (dt.Code == "MANUAL")
        {
            if (manualInputMode == "FIXED" && manualFixedAmount > 0m) return $"₱{manualFixedAmount:N2}";
            return manualPercentage > 0m ? $"{manualPercentage:0.##}%" : "Custom";
        }
        if (dt.DiscountMethod == "PERCENTAGE")
        {
            return dt.DiscountValue > 0 ? $"{dt.DiscountValue:0.##}%" : "0%";
        }
        return $"₱{dt.DiscountValue:N2}";
    }

    private string GetBadgeColorClass(DiscountTypeDto dt)
    {
        var code = (dt.Code ?? "").ToUpperInvariant();
        if (code == "NONE") return "badge-slate";
        if (code == "MANUAL") return "badge-purple";

        if (dt.DiscountMethod == "PERCENTAGE")
        {
            if (dt.DiscountValue >= 20) return "badge-green";
            if (dt.DiscountValue >= 10) return "badge-blue";
            if (dt.DiscountValue > 0) return "badge-amber";
            return "badge-slate";
        }

        if (dt.DiscountValue > 0) return "badge-green";
        return "badge-slate";
    }

    private string GetDiscountIcon(DiscountTypeDto dt)
    {
        var code = (dt.Code ?? "").ToUpperInvariant();
        var name = (dt.Name ?? "").ToLowerInvariant();

        if (code == "NONE") return "bi-slash-circle";
        if (code == "SC" || name.Contains("senior")) return "bi-person-heart";
        if (code == "PWD" || name.Contains("disability")) return "bi-person-wheelchair";
        if (code == "BNPC" || name.Contains("basic")) return "bi-basket2";
        if (code == "SOLO_PARENT" || name.Contains("solo")) return "bi-people";
        if (code == "ATHLETE" || name.Contains("athlete")) return "bi-trophy";
        if (code == "VALOR" || name.Contains("valor")) return "bi-shield-check";
        if (code == "EMPLOYEE" || name.Contains("employee") || name.Contains("staff")) return "bi-person-badge";
        if (code == "PROMO" || name.Contains("promo")) return "bi-tag";
        if (code == "MANUAL" || name.Contains("manual")) return "bi-sliders";

        return "bi-percent";
    }

    private async Task ConfirmDiscount()
    {
        if (selectedDiscountType == null) return;
        discountError = null;

        if (!selectedDiscountType.IsActive)
        {
            discountError = $"Discount '{FormatDiscountName(selectedDiscountType.Name)}' is inactive and cannot be applied.";
            return;
        }

        if (!Cart.Items.Any())
        {
            discountError = "Add items to the cart before applying a discount.";
            return;
        }

        if (selectedDiscountType.RequiresIdentification && string.IsNullOrWhiteSpace(cardOrIdNumber))
        {
            discountError = $"Beneficiary ID or Card Number is required for {FormatDiscountName(selectedDiscountType.Name)}.";
            return;
        }

        decimal appliedManualPct = 0m;
        decimal appliedManualAmt = 0m;
        string? appliedMethod = null;
        decimal? appliedValue = null;

        string normalizedCode = (selectedDiscountCode ?? "NONE").Trim().ToUpperInvariant();
        if (normalizedCode == "NONE")
        {
            await ClearDiscount();
            return;
        }

        if (normalizedCode == "MANUAL")
        {
            if (manualInputMode == "FIXED")
            {
                if (manualFixedAmount < 0m)
                {
                    discountError = "Invalid discount value. Discount amount cannot be negative.";
                    return;
                }
                if (manualFixedAmount > Cart.Subtotal)
                {
                    discountError = $"Discount amount cannot exceed the eligible amount (₱{Cart.Subtotal:N2}).";
                    return;
                }
                appliedManualAmt = manualFixedAmount;
                appliedMethod = "FIXED";
                appliedValue = manualFixedAmount;
            }
            else
            {
                if (manualPercentage < 0m)
                {
                    discountError = "Invalid discount value. Discount percentage cannot be negative.";
                    return;
                }
                if (manualPercentage > LocalDiscountCalculationService.MaxPercentageLimit)
                {
                    discountError = "Discount percentage cannot exceed the allowed limit (0% to 100%).";
                    return;
                }
                appliedManualPct = manualPercentage;
                appliedMethod = "PERCENTAGE";
                appliedValue = manualPercentage;
            }
        }
        else
        {
            var defErr = LocalDiscountCalculationService.ValidateDiscountTypeDefinition(
                selectedDiscountType.Code,
                selectedDiscountType.DiscountMethod,
                selectedDiscountType.DiscountValue);
            if (defErr != null)
            {
                discountError = defErr;
                return;
            }

            if (string.Equals(selectedDiscountType.DiscountMethod, "FIXED", StringComparison.OrdinalIgnoreCase)
                && selectedDiscountType.DiscountValue > Cart.Subtotal)
            {
                discountError = $"Discount amount cannot exceed the eligible amount (₱{Cart.Subtotal:N2}).";
                return;
            }

            appliedMethod = selectedDiscountType.DiscountMethod;
            appliedValue = selectedDiscountType.DiscountValue;
        }

        try
        {
            string branchTaxType = Session.Terminal?.BranchTaxType ?? "VAT-Registered";
            var req = new OrderCalculationRequestDto
            {
                BranchTaxType = branchTaxType,
                DiscountCode = normalizedCode,
                DiscountMethod = appliedMethod,
                DiscountValue = appliedValue,
                ManualDiscountPercentage = appliedManualPct,
                ManualDiscountAmount = appliedManualAmt,
                Items = Cart.Items.Select(ci => new CartItemCalculationDto
                {
                    ProductId = ci.ProductId,
                    ProductName = ci.ProductName,
                    Quantity = ci.Quantity,
                    UnitPrice = ci.IsComplimentary ? 0m : ci.BasePrice,
                    TargetAmount = ci.IsComplimentary ? 0m : ci.TargetAmount,
                    ModifierTotal = ci.IsComplimentary ? 0m : ci.SelectedModifiers.Sum(m => m.Price),
                    IsComplimentary = ci.IsComplimentary,
                    TaxName = ci.TaxName ?? "VATable",
                    IsEligibleForStatutoryDiscount = true
                }).ToList()
            };

            OrderCalculationResultDto res;
            try
            {
                res = await DiscountService.CalculateOrderAsync(req);
            }
            catch (HttpRequestException)
            {
                res = new LocalDiscountCalculationService().CalculateOrder(req);
            }
            catch (TaskCanceledException)
            {
                res = new LocalDiscountCalculationService().CalculateOrder(req);
            }

            if (res.TotalAmount < 0m || res.DiscountAmount < 0m || res.DiscountAmount > res.Subtotal + 0.01m)
            {
                discountError = "The applied discounts exceed the eligible transaction amount.";
                return;
            }

            Cart.ApplyDiscount(
                normalizedCode,
                res.DiscountAmount,
                cardOrIdNumber,
                appliedMethod,
                appliedValue,
                appliedManualPct,
                appliedManualAmt,
                0m,
                branchTaxType,
                res.TotalAmount,
                selectedDiscountType.DiscountTypeId > 0 ? selectedDiscountType.DiscountTypeId : null);
            isDiscountModalOpen = false;
            await OnDiscountChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            discountError = ex.Message;
        }
    }

    private async Task ClearDiscount()
    {
        Cart.ClearDiscount();
        isDiscountModalOpen = false;
        await OnDiscountChanged.InvokeAsync();
    }
}
