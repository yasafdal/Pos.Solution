@page "/activate"
@page "/device-activation"
@layout Layout.AuthLayout
@using POS.Client.Services
@inject IDeviceActivationService ActivationService
@inject NavigationManager Navigation
@inject HttpClient Http

<div class="pos-activation-card">
    <div class="pos-header">
        <div class="pos-logo-icon">
            <i class="bi bi-key-fill fs-2"></i>
        </div>
        <h2 class="pos-title">One-Time Device Activation</h2>
        <p class="pos-subtitle">Enter the 6-digit Activation Code generated by the Back-Office Admin to pair and provision this POS terminal.</p>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="pos-error-badge">
            <i class="bi bi-exclamation-circle-fill me-1"></i>
            <span>@errorMessage</span>
        </div>
    }

    <div class="w-100 mb-3">
        <label for="activationCodeInput" class="form-label text-light small fw-semibold mb-2">6-Digit Activation Code</label>
        <input id="activationCodeInput"
               type="text"
               inputmode="numeric"
               maxlength="6"
               class="form-control form-control-lg text-center font-monospace fw-bold activation-code-input"
               placeholder="000000"
               @bind="activationCode"
               @bind:event="oninput"
               disabled="@isActivating" />
    </div>

    <button type="button"
            class="btn btn-primary btn-lg w-100 fw-bold rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-2"
            disabled="@(isActivating || string.IsNullOrWhiteSpace(activationCode) || activationCode.Trim().Length != 6)"
            @onclick="HandleActivateAsync">
        @if (isActivating)
        {
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            <span>Activating Device...</span>
        }
        else
        {
            <i class="bi bi-shield-check"></i>
            <span>Activate Device</span>
        }
    </button>

    <div class="pos-footer mt-4 pt-3 border-top border-secondary border-opacity-25 w-100 text-center">
        <small class="text-secondary d-block mb-1" style="font-size: 0.78rem;">
            Generates a permanent hardware UUID locally and downloads BIR registration details (PTU, MIN, Serial #) into local SQLite storage.
        </small>
        <small class="text-secondary font-monospace" style="font-size: 0.72rem;">
            Server: @(Http.BaseAddress?.ToString().TrimEnd('/') ?? "https://dev-uat.agressolutions.com")
        </small>
    </div>
</div>

<style>
    .pos-activation-card {
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 1.5rem;
        padding: 2.5rem 2rem;
        width: 100%;
        max-width: 440px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        color: #f8fafc;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .pos-header {
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .pos-logo-icon {
        width: 64px;
        height: 64px;
        border-radius: 1rem;
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
        color: #ffffff;
        box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.4);
    }

    .pos-title {
        font-size: 1.45rem;
        font-weight: 700;
        margin: 0;
        color: #f8fafc;
    }

    .pos-subtitle {
        font-size: 0.88rem;
        color: #94a3b8;
        margin: 0.5rem 0 0;
        line-height: 1.4;
    }

    .activation-code-input {
        background: #0f172a;
        border: 2px solid #334155;
        color: #f8fafc;
        font-size: 1.75rem;
        letter-spacing: 0.35rem;
        border-radius: 0.85rem;
        padding: 0.75rem 1rem;
    }

    .activation-code-input:focus {
        background: #0f172a;
        border-color: #3b82f6;
        color: #ffffff;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.25);
    }

    .pos-error-badge {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(239, 68, 68, 0.15);
        border: 1px solid rgba(239, 68, 68, 0.4);
        color: #fca5a5;
        font-size: 0.85rem;
        font-weight: 500;
        padding: 0.6rem 1rem;
        border-radius: 0.75rem;
        margin-bottom: 1.25rem;
        width: 100%;
    }
</style>

@code {
    private string activationCode = string.Empty;
    private bool isActivating = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (await ActivationService.IsDeviceProvisionedAsync())
        {
            Navigation.NavigateTo("/login", replace: true);
        }
    }

    private async Task HandleActivateAsync()
    {
        if (isActivating) return;
        errorMessage = null;

        var digitsOnly = new string(activationCode.Where(char.IsDigit).ToArray());
        if (digitsOnly.Length != 6)
        {
            errorMessage = "Activation Code must be 6 digits.";
            return;
        }

        isActivating = true;
        try
        {
            var result = await ActivationService.ActivateDeviceAsync(digitsOnly);
            if (result.Success)
            {
                Navigation.NavigateTo("/login", replace: true);
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Activation failed: {ex.Message}";
        }
        finally
        {
            isActivating = false;
        }
    }
}
