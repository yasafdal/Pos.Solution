@page "/z-reading"
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@using POS.Client.Data
@inject PosSessionService Session
@inject HttpClient Http
@inject IPosConnectivityService Connectivity
@inject IReceiptPrinter Printer
@inject NavigationManager Navigation

<PageTitle>POS Readings — X-Reading &amp; Z-Reading</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 px-4 pt-3 pb-2 border-bottom" style="border-color: rgba(255,255,255,0.1) !important;">
    <div class="d-flex align-items-center gap-2">
        <i class="bi bi-file-earmark-bar-graph-fill text-info fs-4"></i>
        <div>
            <h5 class="fw-bold text-light mb-0">POS Readings &amp; Fiscal Reports</h5>
            <small class="text-secondary">Anytime Read-Only X-Reading, Cashier Access Controls, and End-of-Day Z-Reading</small>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-sm @(activeTab == "x" ? "btn-info text-dark fw-bold" : "btn-outline-info fw-semibold") rounded-3 px-3" @onclick='() => SwitchTabAsync("x")'>
            <i class="bi bi-file-earmark-text me-1"></i> X-Reading (Anytime Audit)
        </button>
        <button type="button" class="btn btn-sm @(activeTab == "z" ? "btn-primary fw-bold" : "btn-outline-primary fw-semibold") rounded-3 px-3" @onclick='() => SwitchTabAsync("z")'>
            <i class="bi bi-file-earmark-lock me-1"></i> Z-Reading (End of Day)
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary rounded-3 px-3 fw-semibold" @onclick='() => Navigation.NavigateTo("/cash-drawer")'>
            <i class="bi bi-cash-stack me-1"></i> Close Cashier / Shift
        </button>
    </div>
</div>

@if (!Session.IsAuthenticated)
{
    <div class="p-4">
        <div class="alert alert-warning rounded-4 p-4" role="alert">Please sign in to access POS Readings.</div>
    </div>
}
else if (activeTab == "x")
{
    <section class="z-reading-page" aria-labelledby="x-title">
        <h3 id="x-title">X-Reading — Anytime Audit Snapshot</h3>
        <p class="text-secondary">@Session.Terminal?.BranchName / @Session.Terminal?.OutletName — @Session.Terminal?.TerminalName</p>
        <div class="z-reading-notice">
            <strong>Strictly Read-Only Audit Report.</strong>
            Generates live accumulated figures for the Business Date (04:00–04:00 PHT) even while cashiers are actively working.
            Can be run repeatedly online or offline. Never closes shifts, locks cashiers/terminals, or resets counters.
        </div>
        @if (xError != null) { <div class="alert alert-danger" role="alert">@xError</div> }
        @if (xNotice != null) { <div class="alert alert-info" role="status">@xNotice</div> }

        <div class="z-reading-controls">
            <div>
                <label for="x-date">Business date</label>
                <input id="x-date" class="form-control" type="date" value="@xBusinessDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" @onchange="ChangeXDate" disabled="@xBusy" />
            </div>
            @if (!Authorized)
            {
                <div>
                    <label for="x-sup-pin">Supervisor PIN</label>
                    <input id="x-sup-pin" class="form-control" type="password" inputmode="numeric" @bind="xSupervisorPin" @bind:event="oninput" placeholder="Enter supervisor PIN" disabled="@xBusy" />
                </div>
            }
            <button type="button" class="btn btn-info text-dark fw-bold" disabled="@xBusy" @onclick="GenerateXReadingAsync">
                <i class="bi bi-arrow-repeat me-1"></i> @(xBusy ? "Generating..." : "Generate X-Reading")
            </button>
            @if (xReport != null)
            {
                <button type="button" class="btn btn-outline-primary fw-semibold" disabled="@xBusy" @onclick="PrintXReadingAsync">
                    <i class="bi bi-printer me-1"></i> Print X-Reading
                </button>
            }
        </div>

        @if (xReport != null)
        {
            <div class="z-reading-checks" role="status">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                    <h5 class="mb-0">X-Reading Snapshot — Business Date @xReport.BusinessDate</h5>
                    <span class="badge @(xReport.ActiveShiftCount > 0 ? "bg-success" : "bg-secondary")">
                        @xReport.ActiveShiftCount Open Shift(s) / @xReport.ClosedShiftCount Closed Shift(s)
                    </span>
                </div>
                <div class="row g-2 small mb-2">
                    <div class="col-6 col-md-3"><strong>Gross Sales:</strong> ₱@xReport.GrossSales.ToString("N2")</div>
                    <div class="col-6 col-md-3"><strong>Discounts:</strong> ₱@xReport.TotalDiscounts.ToString("N2")</div>
                    <div class="col-6 col-md-3"><strong>Voids / Refunds:</strong> ₱@xReport.TotalRefundsAndVoids.ToString("N2")</div>
                    <div class="col-6 col-md-3"><strong>Net Sales:</strong> ₱@xReport.NetSales.ToString("N2")</div>
                </div>
                <div class="small text-secondary">Generated At: @POS.Shared.Services.BusinessDayClock.FormatManila(xReport.GeneratedAt, "yyyy-MM-dd HH:mm:ss") PHT</div>
                @if (xReport.CashierSummaries.Count > 0)
                {
                    <div class="mt-2 small">
                        <strong>Per-Cashier Breakdown:</strong>
                        <ul class="mb-0 mt-1">
                            @foreach (var cs in xReport.CashierSummaries)
                            {
                                <li>@cs.CashierId — @(cs.OpenShifts > 0 ? "OPEN" : "CLOSED") (@cs.ShiftCount shift(s), @cs.TransactionCount tx) — Gross ₱@cs.GrossSales.ToString("N2") / Net ₱@cs.NetSales.ToString("N2")</li>
                            }
                        </ul>
                    </div>
                }
            </div>
            <iframe class="z-reading-preview" title="X-Reading audit report preview" sandbox="" srcdoc="@XReadingHtmlFormatter.Format(xReport)"></iframe>
        }
    </section>
}
else if (!Authorized)
{
    <div class="p-4">
        <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-3 rounded-4 p-4" role="alert">
            <div>
                <h6 class="fw-bold mb-1"><i class="bi bi-shield-lock-fill me-2"></i>Senior Cashier or Supervisor Authorization Required for Z-Reading</h6>
                <div class="small">End-of-Day Z-Reading finalization requires a Senior Cashier, Manager, or Admin session. Use the Anytime X-Reading tab (with Supervisor PIN) for mid-day audit readings.</div>
            </div>
            <button type="button" class="btn btn-dark fw-bold rounded-3 px-4 py-2" @onclick='() => SwitchTabAsync("x")'>
                <i class="bi bi-file-earmark-text me-1"></i> Open Anytime X-Reading
            </button>
        </div>
    </div>
}
else
{
    <section class="z-reading-page" aria-labelledby="z-title">
        <h3 id="z-title">Z-Reading — End of Day</h3>
        <p class="text-secondary">@Session.Terminal?.BranchName / @Session.Terminal?.OutletName — @Session.Terminal?.TerminalName</p>
        <div class="z-reading-notice">
            <strong>Finalize on the original terminal only.</strong>
            Business dates run from 04:00 to next 04:00, Philippine time. X-Reading printing is not a prerequisite.
            Finalizing Z-Reading permanently saves an immutable report and <strong>locks this terminal until 4:00 AM</strong> for the finalized Business Date.
        </div>
        @if (error != null) { <div class="alert alert-danger" role="alert">@error</div> }
        @if (notice != null) { <div class="alert alert-info" role="status">@notice</div> }
        <div class="z-reading-controls">
            <div>
                <label for="z-terminal">Terminal</label>
                <input id="z-terminal" class="form-control" readonly value="@($"{Session.Terminal?.TerminalCode} — {Session.Terminal?.TerminalName}")" />
            </div>
            <div>
                <label for="z-date">Business date</label>
                <input id="z-date" class="form-control" type="date" value="@businessDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" @onchange="ChangeDate" disabled="@busy" />
            </div>
            <button type="button" class="btn btn-outline-primary" disabled="@busy" @onclick="RefreshAsync">@(busy ? "Checking..." : "Check readiness / Load saved")</button>
        </div>
        @if (readiness != null && report == null)
        {
            <div class="z-reading-checks" role="status">
                <h5>Readiness checks</h5>
                @if (blockers.Count > 0)
                {
                    <ul>@foreach (var blocker in blockers) { <li>@blocker</li> }</ul>
                }
                else
                {
                    <p class="mb-0">All available checks passed. Complete the confirmation below before finalizing.</p>
                }
                @foreach (var warning in readiness.Warnings) { <p class="text-warning mt-2 mb-0">@warning</p> }
                @if (readiness.NextBusinessDate.HasValue) { <p class="mt-2 mb-0">Next date to finalize: @readiness.NextBusinessDate.Value.ToString("yyyy-MM-dd")</p> }
            </div>
            <label class="z-reading-confirm">
                <input type="checkbox" @bind="confirmed" disabled="@busy" />
                <span>I have closed all cashier shifts, verified cash accountability, resolved pending payments/orders, and synchronized every device using this terminal identity. Finalizing this Z-Reading will lock this terminal until 4:00 AM and cannot be undone.</span>
            </label>
            <div class="z-reading-actions">
                <button type="button" class="btn btn-primary" disabled="@(busy || !confirmed || blockers.Count > 0 || !readiness.CanGenerate)" @onclick="GenerateAsync">
                    @(busy ? "Working..." : "Generate & Finalize Z-Reading")
                </button>
            </div>
        }
        @if (report != null)
        {
            <div class="z-reading-notice" role="status">
                <strong>Finalized report — Z @report.ZNumber</strong>. Terminal is locked for Business Date @report.BusinessDate.ToString("yyyy-MM-dd") until 4:00 AM. Printing does not create another report.
                @if (unknownPrint) { <span class="text-warning">A previous print outcome is unknown. Check the printer before requesting another copy.</span> }
            </div>
            @if (unknownPrint)
            {
                <label class="z-reading-confirm"><input type="checkbox" @bind="pendingPrintAcknowledged" disabled="@busy" /><span>I checked the printer and saved audit. I want a new, explicitly marked reprint despite the unknown previous outcome.</span></label>
            }
            <div class="z-reading-actions">
                <div class="print-reason">
                    <label for="z-print-reason">Print / reprint reason</label>
                    <input id="z-print-reason" class="form-control" @bind="printReason" @bind:event="oninput" maxlength="255" disabled="@busy" placeholder="e.g. Original copy, paper jam, supervisor copy" />
                </div>
                <button type="button" class="btn btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(printReason) || (unknownPrint && !pendingPrintAcknowledged))" @onclick="PrintAsync">@(busy ? "Working..." : "Print saved report / Reprint")</button>
                <button type="button" class="btn btn-danger fw-bold" disabled="@busy" @onclick="LockAndSignOut">
                    <i class="bi bi-shield-lock-fill me-1"></i> Lock Terminal &amp; Sign Out
                </button>
            </div>
            <details class="z-reading-audit"><summary>Print audit (@printAudit.Count attempts)</summary>
                <ul>@foreach (var a in printAudit) { <li>@POS.Shared.Services.BusinessDayClock.FormatManila(a.StartedAt, "yyyy-MM-dd HH:mm:ss") PHT — @a.RequestedBy — @a.Status — @(a.IsReprint ? "REPRINT" : "Original attempt") — @a.Reason @a.ErrorMessage</li> }</ul>
            </details>
            <iframe class="z-reading-preview" title="Saved Z-Reading report preview" sandbox="" srcdoc="@ZReadingHtmlFormatter.Format(report)"></iframe>
        }

        @if (activeRestrictions.Count > 0)
        {
            <div class="z-reading-checks mt-3">
                <h5>Closed Cashiers Today (Supervisor Reopen)</h5>
                <p class="small text-secondary mb-2">These cashiers have completed Close Cashier on this terminal for the current Business Date. Historical closed shift records are preserved immutably when reopening access.</p>
                @if (reopenNotice != null) { <div class="alert alert-success py-2 small">@reopenNotice</div> }
                @if (reopenError != null) { <div class="alert alert-danger py-2 small">@reopenError</div> }
                <div class="mb-2">
                    <label for="reopen-reason" class="small">Reopen Reason (Required)</label>
                    <input id="reopen-reason" class="form-control form-control-sm" @bind="reopenReason" @bind:event="oninput" maxlength="500" placeholder="e.g. Cashier closed early by mistake — resuming evening shift" disabled="@reopenBusy" />
                </div>
                <ul class="list-unstyled mb-0">
                    @foreach (var r in activeRestrictions)
                    {
                        <li class="d-flex flex-wrap justify-content-between align-items-center gap-2 py-2 border-top border-secondary border-opacity-25">
                            <div class="small">
                                <strong>@r.CashierId</strong> — Closed @POS.Shared.Services.BusinessDayClock.FormatManila(r.ClosedAtUtc, "HH:mm") PHT (Business Date @r.BusinessDate)
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-warning fw-semibold"
                                    disabled="@(reopenBusy || string.IsNullOrWhiteSpace(reopenReason))"
                                    @onclick="() => ReopenCashierAsync(r)">
                                <i class="bi bi-unlock me-1"></i> Reopen Access
                            </button>
                        </li>
                    }
                </ul>
            </div>
        }
    </section>
}

@code {
    private string activeTab = "z";
    private DateOnly businessDate = POS.Shared.Services.BusinessDayClock.GetCurrentBusinessDate();
    private DateOnly xBusinessDate = POS.Shared.Services.BusinessDayClock.GetCurrentBusinessDate();
    private XReadingReportDto? xReport;
    private bool xBusy;
    private string? xError, xNotice;
    private string xSupervisorPin = string.Empty;

    private List<CashierClosingRestrictionDto> activeRestrictions = new();
    private string reopenReason = string.Empty;
    private bool reopenBusy;
    private string? reopenError, reopenNotice;

    private ZReadingReadinessDto? readiness;
    private ZReadingReportDto? report;
    private List<string> blockers = new();
    private bool busy, confirmed, unknownPrint;
    private string? error, notice;
    private string printReason = string.Empty;
    private List<ZReadingPrintAttemptDto> printAudit = new();
    private bool pendingPrintAcknowledged;
    private string PrintKey => $"z-reading-print-pending-{report?.Id}";
    private string OperationKey => $"z-reading-operation-{Session.Terminal?.TerminalId}-{businessDate:yyyy-MM-dd}";
    private bool Authorized => Session.IsAuthenticated && ShiftSession.IsSupervisorRole(Session.Role);
    private string Query => $"terminalId={Session.Terminal!.TerminalId}&businessDate={businessDate:yyyy-MM-dd}";

    protected override async Task OnInitializedAsync()
    {
        if (!Authorized)
        {
            activeTab = "x";
            return;
        }
        await RefreshAsync();
        await LoadActiveCashierRestrictionsAsync();
    }

    private async Task SwitchTabAsync(string tab)
    {
        activeTab = tab;
        if (tab == "z" && Authorized && readiness == null && report == null)
        {
            await RefreshAsync();
            await LoadActiveCashierRestrictionsAsync();
        }
    }

    private void ChangeXDate(ChangeEventArgs e)
    {
        if (DateOnly.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var d))
        {
            xBusinessDate = d;
            xReport = null;
        }
    }

    private async Task GenerateXReadingAsync()
    {
        if (xBusy || Session.Terminal == null) return;
        xBusy = true; xError = null; xNotice = null;
        try
        {
            var connState = await Connectivity.CheckConnectivityAsync();
            bool offline = connState != TerminalConnectivityState.OnlineAndHealthy || Session.Token == "OFFLINE-SESSION-TOKEN";
            xReport = await ShiftSession.GetAnytimeXReadingAsync(
                Http,
                Session.Terminal.TerminalId,
                xBusinessDate,
                offline: offline,
                supervisorPin: Authorized ? null : xSupervisorPin,
                isSupervisorCaller: Authorized,
                reprint: false);
            xNotice = offline
                ? "Read-only X-Reading generated from local SQLite (offline mode). No shifts or counters were modified."
                : "Read-only X-Reading snapshot generated. No shifts, locks, or counters were modified.";
        }
        catch (Exception ex) { xError = ex.Message; }
        finally { xBusy = false; }
    }

    private async Task PrintXReadingAsync()
    {
        if (xBusy || xReport == null) return;
        xBusy = true; xError = null;
        try
        {
            await Printer.PrintXReadingAsync(xReport, Session.Terminal?.ReceiptPrinterName);
            xNotice = "X-Reading sent to receipt printer (read-only snapshot).";
        }
        catch (Exception ex) { xError = $"Printing X-Reading failed: {ex.Message}"; }
        finally { xBusy = false; }
    }

    private async Task LoadActiveCashierRestrictionsAsync()
    {
        if (Session.Terminal == null) return;
        try
        {
            var connState = await Connectivity.CheckConnectivityAsync();
            bool offline = connState != TerminalConnectivityState.OnlineAndHealthy || Session.Token == "OFFLINE-SESSION-TOKEN";
            var lockState = await ShiftSession.GetTerminalLockStatusAsync(Http, Session.Terminal.TerminalId, null, offline);
            activeRestrictions = lockState.ActiveCashierRestrictions ?? new List<CashierClosingRestrictionDto>();
        }
        catch { }
    }

    private async Task ReopenCashierAsync(CashierClosingRestrictionDto restriction)
    {
        if (reopenBusy || Session.Terminal == null || string.IsNullOrWhiteSpace(reopenReason)) return;
        reopenBusy = true; reopenError = null; reopenNotice = null;
        try
        {
            var connState = await Connectivity.CheckConnectivityAsync();
            bool offline = connState != TerminalConnectivityState.OnlineAndHealthy || Session.Token == "OFFLINE-SESSION-TOKEN";
            await ShiftSession.ReopenCashierRestrictionAsync(
                Http,
                new ReopenCashierRestrictionRequestDto
                {
                    TerminalId = Session.Terminal.TerminalId,
                    CashierId = restriction.CashierId,
                    BusinessDate = restriction.BusinessDate,
                    Reason = reopenReason.Trim()
                },
                Session.Username ?? string.Empty,
                Session.Role,
                offline);
            reopenReason = string.Empty;
            reopenNotice = $"Reopened access for cashier '{restriction.CashierId}' on {restriction.BusinessDate}. Historical closed shift records remain preserved.";
            await LoadActiveCashierRestrictionsAsync();
        }
        catch (Exception ex) { reopenError = ex.Message; }
        finally { reopenBusy = false; }
    }

    private void LockAndSignOut()
    {
        Session.ClearSession();
        Http.DefaultRequestHeaders.Authorization = null;
        Navigation.NavigateTo("/terminal-locked", replace: true);
    }

    private async Task ChangeDate(ChangeEventArgs e)
    {
        if (busy) return;
        if (!DateOnly.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date)) return;
        businessDate = date;
        confirmed = false;
        readiness = null;
        report = null;
        await RefreshAsync();
    }

    private async Task RequireOnlineAsync()
    {
        if (!Authorized) throw new InvalidOperationException("Supervisor authorization is required.");
        if (Session.Token == "OFFLINE-SESSION-TOKEN" || await Connectivity.CheckConnectivityAsync() != TerminalConnectivityState.OnlineAndHealthy)
            throw new InvalidOperationException("Connect to the server to generate, retrieve, or authorize printing a Z-Reading. Pending data is preserved.");
    }

    private static async Task CheckResponseAsync(HttpResponseMessage response)
    {
        if (!response.IsSuccessStatusCode)
            throw new InvalidOperationException($"Server rejected the request ({(int)response.StatusCode}): {await response.Content.ReadAsStringAsync()}");
    }

    private async Task RefreshCoreAsync()
    {
        await RequireOnlineAsync();
        using var saved = await Http.GetAsync($"api/z-readings/by-date?{Query}");
        if (saved.IsSuccessStatusCode)
        {
            report = await saved.Content.ReadFromJsonAsync<ZReadingReportDto>();
            await LoadPrintAuditAsync();
            return;
        }
        if (saved.StatusCode != System.Net.HttpStatusCode.NotFound) await CheckResponseAsync(saved);
        using var response = await Http.GetAsync($"api/z-readings/readiness?{Query}");
        await CheckResponseAsync(response);
        readiness = await response.Content.ReadFromJsonAsync<ZReadingReadinessDto>() ?? throw new InvalidOperationException("Readiness response is empty.");
        blockers = readiness.Blockers.ToList();
        if (string.IsNullOrWhiteSpace(Session.Terminal?.DeviceIdentifier)) blockers.Add("Device identity is missing. Reconnect and resolve terminal registration before finalizing.");
        using var db = new LocalPosDbContext(); db.InitializeDatabase();
        blockers.AddRange(await ZReadingLocalReadiness.GetBlockersAsync(db, Session.Terminal!.TerminalId));
    }

    private async Task RefreshAsync()
    {
        if (busy) return;
        busy = true; error = null; notice = null; report = null; readiness = null; blockers.Clear(); confirmed = false;
        printAudit.Clear(); unknownPrint = false; pendingPrintAcknowledged = false;
        try { await RefreshCoreAsync(); }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private async Task GenerateAsync()
    {
        if (busy || !Authorized || !confirmed || readiness?.CanGenerate != true || blockers.Count > 0) return;
        busy = true; error = null; notice = null;
        try
        {
            await RequireOnlineAsync();
            // Hold the existing local write gate while checking and finalizing; never clear outboxes.
            await LocalPosDbContext.WriteLock.WaitAsync();
            try
            {
                using var db = new LocalPosDbContext(); db.InitializeDatabase();
                var pending = await ZReadingLocalReadiness.GetBlockersAsync(db, Session.Terminal!.TerminalId);
                if (pending.Count > 0) throw new InvalidOperationException(string.Join(" ", pending));
                var operationId = Preferences.Default.Get(OperationKey, string.Empty);
                if (string.IsNullOrEmpty(operationId))
                {
                    operationId = Guid.NewGuid().ToString("N");
                    Preferences.Default.Set(OperationKey, operationId);
                }
                using var response = await Http.PostAsJsonAsync("api/z-readings/generate", new GenerateZReadingRequest
                {
                    TerminalId = Session.Terminal.TerminalId, BusinessDate = businessDate, ClientOperationId = operationId,
                    AllLocalOutboxesDrained = true, NoUnresolvedLocalTransactions = true, SoleDeviceCompletenessConfirmed = true,
                    DeviceIdentifier = Session.Terminal.DeviceIdentifier ?? string.Empty
                });
                await CheckResponseAsync(response);
                report = await response.Content.ReadFromJsonAsync<ZReadingReportDto>() ?? throw new InvalidOperationException("Empty response. Load the saved report before retrying; the operation ID has been retained.");
                confirmed = false;
                notice = $"Z-Reading #{report.ZNumber} finalized and saved. Terminal is now locked for Business Date {businessDate:yyyy-MM-dd} until 4:00 AM. You may print the saved report before signing out.";
            }
            finally { LocalPosDbContext.WriteLock.Release(); }
            if (report != null && Session.Terminal != null)
            {
                await ShiftSession.ApplyLocalTerminalZLockAsync(
                    Session.Terminal.TerminalId,
                    businessDate,
                    Session.Username ?? "Supervisor",
                    report.GeneratedAt);
            }
            await LoadPrintAuditAsync();
        }
        catch (Exception ex) { error = ex.Message + " If the request timed out, load the saved report before retrying. The same operation ID will be reused."; }
        finally { busy = false; }
    }

    private async Task LoadPrintAuditAsync()
    {
        if (report == null) return;
        printAudit = await Http.GetFromJsonAsync<List<ZReadingPrintAttemptDto>>($"api/z-readings/{report.Id}/print-attempts")
            ?? throw new InvalidOperationException("Print audit response is empty.");
        unknownPrint = printAudit.Any(x => x.Status is "STARTED" or "UNKNOWN") || Preferences.Default.ContainsKey(PrintKey);
        pendingPrintAcknowledged = false;
    }

    private async Task PrintAsync()
    {
        if (busy || !Authorized || report == null || string.IsNullOrWhiteSpace(printReason) || (unknownPrint && !pendingPrintAcknowledged)) return;
        busy = true; error = null; notice = null;
        try
        {
            await RequireOnlineAsync();
            var operationId = Guid.NewGuid().ToString("N");
            // Persist before HTTP: restart never resumes an uncertain printer submission automatically.
            Preferences.Default.Set(PrintKey, operationId);
            using var started = await Http.PostAsJsonAsync($"api/z-readings/{report.Id}/print-attempts", new StartZReadingPrintRequest
            {
                ClientOperationId = operationId, Reason = printReason.Trim(), PrinterName = Session.Terminal?.ReceiptPrinterName
            });
            await CheckResponseAsync(started);
            var attempt = await started.Content.ReadFromJsonAsync<ZReadingPrintAttemptDto>() ?? throw new InvalidOperationException("Print authorization was not acknowledged. No print was requested.");
            if (attempt.ClientOperationId != operationId || attempt.ZReadingId != report.Id || attempt.Status != "STARTED")
                throw new InvalidOperationException("Print authorization does not match this new attempt. No print was requested.");
            await LoadPrintAuditAsync();
            if (!printAudit.Any(x => x.Id == attempt.Id && x.Status == "STARTED" && x.ClientOperationId == operationId))
                throw new InvalidOperationException("Saved print authorization could not be verified. No print was requested.");
            string outcome, detail;
            try
            {
                var accepted = await Printer.PrintZReadingAsync(attempt.Report, attempt.PrinterName, attempt.IsReprint);
                outcome = accepted ? "ACCEPTED" : "UNKNOWN";
                detail = accepted ? "Driver accepted the job; physical paper output is not verified." : "Print dialog closed; printed/cancelled outcome cannot be verified.";
            }
            catch (Exception ex) { outcome = "UNKNOWN"; detail = "Printer operation threw; acceptance is unverified. " + ex.Message; }
            if (detail.Length > 2000) detail = detail[..2000];
            using var completed = await Http.PostAsJsonAsync($"api/z-readings/{report.Id}/print-attempts/{attempt.Id}/complete", new CompleteZReadingPrintRequest { Status = outcome, ErrorMessage = detail });
            await CheckResponseAsync(completed);
            await LoadPrintAuditAsync();
            if (!printAudit.Any(x => x.Id == attempt.Id && x.Status == outcome))
                throw new InvalidOperationException("Print completion could not be verified. Check the saved audit before requesting another copy.");
            Preferences.Default.Remove(PrintKey);
            unknownPrint = printAudit.Any(x => x.Status is "STARTED" or "UNKNOWN");
            printReason = string.Empty;
            notice = $"{outcome}: {detail} The finalized report is unchanged.";
        }
        catch (Exception ex) { unknownPrint = true; pendingPrintAcknowledged = false; error = ex.Message + " Check the printer and saved print audit before retrying; report generation is not repeated."; }
        finally { busy = false; }
    }
}
