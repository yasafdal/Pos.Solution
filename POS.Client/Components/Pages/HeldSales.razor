@page "/held-sales"
@inject PosSessionService Session
@inject NavigationManager Navigation

@if (!Session.IsAuthenticated)
{
    Navigation.NavigateTo("/login");
}
else
{
    <div class="p-4">
        <h3 class="fw-bold text-dark mb-1">Held Sales</h3>
        <p class="text-muted small">Parked orders and paused customer tickets</p>
        <div class="card p-4 border-0 shadow-sm rounded-3 mt-3">
            <div class="text-center py-5 text-muted">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mb-2 text-secondary">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="10" y1="15" x2="10" y2="9"></line>
                    <line x1="14" y1="15" x2="14" y2="9"></line>
                </svg>
                <p class="mb-0 fw-medium">No held sales currently active.</p>
            </div>
        </div>
    </div>
}
