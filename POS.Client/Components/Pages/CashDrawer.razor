    private async Task LoadShiftData()
    {
        isLoading = true;
        try
        {
            var terminalId = Session.Terminal?.TerminalId ?? 1;
            var state = await ConnectivityService.CheckConnectivityAsync();
            isOffline = state != TerminalConnectivityState.OnlineAndHealthy;

            if (!isOffline)
            {
                try
                {
                    var onlineCats = await Http.GetFromJsonAsync<List<CashMovementCategoryDto>>("api/cash-drawer/categories");
                    if (onlineCats != null && onlineCats.Count > 0)
                    {
                        categories = onlineCats;
                        await CacheCategoriesLocallyAsync(onlineCats);
                    }
                }
                catch { }
            }

            if (categories.Count == 0)
            {
                await LoadOfflineCategoriesAsync();
            }

            try
            {
                currentShift = await ShiftSession.CurrentDtoAsync(Http, terminalId, isOffline);
            }
            catch
            {
                isOffline = true;
                currentShift = await ShiftSession.CurrentDtoAsync(Http, terminalId, offline: true);
            }

            if (currentShift != null)
            {
                SyncNonCashDeclarationRows(currentShift);
            }
            else
            {
                lastClosedShift = await ShiftSession.LastClosedDtoAsync(Http, terminalId, isOffline, isSupervisor: IsSupervisorUnlocked, supervisorPin: unlockedSupervisorPin);
            }

            if (selectedCategoryId == 0 && FilteredCategories.Any())
            {
                selectedCategoryId = FilteredCategories.First().CategoryId;
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CacheCategoriesLocallyAsync(List<CashMovementCategoryDto> onlineCats)
    {
        await LocalPosDbContext.WriteLock.WaitAsync();
        try
        {
            using var db = new LocalPosDbContext();
            db.InitializeDatabase();
            await db.Database.ExecuteSqlRawAsync("DELETE FROM LocalCashMovementCategories;");
            db.ChangeTracker.Clear();
            foreach (var c in onlineCats)
            {
                db.CashMovementCategories.Add(new LocalCashMovementCategory
                {
                    CategoryId = c.CategoryId,
                    Name = c.Name,
                    Description = c.Description,
                    MovementType = c.MovementType,
                    RequiresApproval = c.RequiresApproval,
                    ApprovalThreshold = c.ApprovalThreshold,
                    IsActive = c.IsActive
                });
            }
            await db.SaveChangesAsync();
        }
        catch { }
        finally
        {
            LocalPosDbContext.WriteLock.Release();
        }
    }

    private async Task LoadOfflineCategoriesAsync()
    {
        using var db = new LocalPosDbContext();
        db.InitializeDatabase();
        var localCats = await db.CashMovementCategories.AsNoTracking().Where(c => c.IsActive).ToListAsync();
        if (localCats.Count > 0)
        {
            categories = localCats.Select(c => new CashMovementCategoryDto
            {
                CategoryId = c.CategoryId,
                Name = c.Name,
                Description = c.Description,
                MovementType = c.MovementType,
                RequiresApproval = c.RequiresApproval,
                ApprovalThreshold = c.ApprovalThreshold,
                IsActive = c.IsActive
            }).ToList();
        }
    }

