@page "/cash-drawer"
@using System.Globalization
@using POS.Shared.Models
@using POS.Client.Data
@using POS.Client.Services
@using POS.Client.Workers
@using Microsoft.EntityFrameworkCore
@inject PosSessionService Session
@inject HttpClient Http
@inject IPosConnectivityService ConnectivityService
@inject IOfflineBackgroundSyncService SyncManager
@inject IReceiptPrinter ReceiptPrinter
@inject CurrieTechnologies.Razor.SweetAlert2.SweetAlertService Swal
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Cash Drawer &amp; Blind Shift Closing - POS</PageTitle>

<div class="w-100 py-3 px-3 px-md-4 pos-closing-page">
    <!-- Top Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h2 class="fw-bolder mb-0 text-light" style="letter-spacing: -0.5px;">Cash Drawer &amp; Blind Shift Closing</h2>
                @if (isOffline)
                {
                    <span class="badge bg-warning text-dark">OFFLINE MODE</span>
                }
                else
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle">ONLINE</span>
                }
            </div>
            <span class="text-secondary" style="font-size: 0.92rem;">
                Terminal #@(Session.Terminal?.TerminalId ?? 1) (@(Session.Terminal?.TerminalName ?? "Terminal")) • Cashier: @(Session.Username ?? "Unknown") (@(Session.Role ?? "Cashier"))
            </span>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (lastClosedShift?.CashierDeclaration != null)
            {
                <button type="button" class="btn btn-outline-light rounded-3 px-3 py-2 fw-semibold" @onclick="OpenLastClosedDeclarationModal" disabled="@isPrintingDeclaration">
                    <i class="bi bi-file-earmark-check me-1"></i> View / Reprint Declaration (Shift #@lastClosedShift.ShiftId)
                </button>
            }
            @if (IsSupervisorUnlocked && lastClosedShift?.XReading != null)
            {
                <button type="button" class="btn btn-outline-info rounded-3 px-3 py-2 fw-semibold" @onclick="OpenLastClosedXReadingModal" disabled="@isPrintingXReading">
                    <i class="bi bi-printer me-1"></i> Supervisor X-Reading (Shift #@lastClosedShift.ShiftId)
                </button>
            }
            <button type="button" class="btn btn-outline-secondary rounded-3 px-3 py-2 fw-semibold" @onclick="TriggerSyncAndReloadAsync" disabled="@isLoading">
                <i class="bi bi-cloud-arrow-up me-1"></i> Sync &amp; Refresh
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(statusAlertMessage))
    {
        <div class="alert @(statusAlertIsError ? "alert-danger" : "alert-success") alert-dismissible fade show rounded-3 shadow-sm mb-3" role="alert">
            <i class="bi @(statusAlertIsError ? "bi-exclamation-octagon-fill" : "bi-check-circle-fill") me-2"></i>
            @statusAlertMessage
            <button type="button" class="btn-close" @onclick="() => statusAlertMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(printWarningMessage))
    {
        <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2 rounded-3 shadow-sm mb-3" role="alert">
            <div>
                <i class="bi bi-printer-fill me-2"></i>
                <strong>Print Notice:</strong> @printWarningMessage
            </div>
            <div class="d-flex gap-2">
                @if (lastClosedShift?.CashierDeclaration != null)
                {
                    <button type="button" class="btn btn-sm btn-dark fw-bold rounded-3" @onclick="ReprintSavedDeclarationAsync" disabled="@isPrintingDeclaration">
                        <i class="bi bi-arrow-repeat me-1"></i> @(isPrintingDeclaration ? "Reprinting..." : "Reprint Declaration Acknowledgment")
                    </button>
                }
                @if (IsSupervisorUnlocked && lastClosedShift?.XReading != null)
                {
                    <button type="button" class="btn btn-sm btn-outline-dark fw-bold rounded-3" @onclick="ReprintSavedXReadingAsync" disabled="@isPrintingXReading">
                        <i class="bi bi-printer me-1"></i> @(isPrintingXReading ? "Reprinting..." : "Reprint X-Reading")
                    </button>
                }
            </div>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted small mt-2">Loading cash drawer shift records...</p>
        </div>
    }
    else if (currentShift == null)
    {
        <div class="row g-4 justify-content-center">
            <div class="col-12 col-lg-5">
                <!-- Open Shift Card -->
                <div class="pos-panel-card rounded-4 p-4 p-md-5 text-center h-100">
                    <div class="mb-3 text-primary">
                        <i class="bi bi-cash-stack" style="font-size: 3rem;"></i>
                    </div>
                    <h4 class="fw-bold mb-2 text-light">No Active Cashier Drawer Shift</h4>
                    <p class="text-secondary small mb-4">
                        Opening float is drawer starting cash, not sales revenue. Confirm the starting float in PHP (₱) below to open the drawer shift.
                    </p>

                    <div class="mb-3 text-start">
                        <label class="form-label fw-semibold text-light small">Opening Float Amount (₱)</label>
                        <input type="number" step="0.01" min="0" class="form-control form-control-lg rounded-3 fw-bold" @bind="openFloatInput" placeholder="0.00" />
                    </div>

                    <div class="mb-4 text-start">
                        <label class="form-label fw-semibold text-light small">Shift Notes / Remarks</label>
                        <input type="text" class="form-control rounded-3 py-2" @bind="shiftNotes" placeholder="Optional remarks..." />
                    </div>

                    <button class="btn btn-success rounded-3 py-3 fw-bold shadow-sm w-100" @onclick="OpenShift" disabled="@isSubmittingShift">
                        <i class="bi bi-unlock-fill me-1"></i> @(isSubmittingShift ? "Opening Shift..." : "Open Cash Drawer Shift")
                    </button>
                </div>
            </div>

            @if (lastClosedShift != null)
            {
                <div class="col-12 col-lg-7">
                    <div class="pos-panel-card rounded-4 p-4 h-100 d-flex flex-column justify-content-between">
                        <div>
                            <!-- Saved Cashier Declaration Acknowledgment (Cashier-Safe) -->
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <span class="badge bg-secondary mb-1">LAST CLOSED SHIFT #@lastClosedShift.ShiftId</span>
                                    <h5 class="fw-bold text-light mb-0">Cashier Declaration Acknowledgment</h5>
                                </div>
                                <span class="badge bg-primary">LOCKED &amp; SUBMITTED</span>
                            </div>

                            <div class="small text-secondary mb-3">
                                <div>Cashier: <strong class="text-light">@lastClosedShift.CashierId</strong></div>
                                <div>Opened: @lastClosedShift.OpenedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm") • Submitted: @(lastClosedShift.ClosedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "N/A")</div>
                            </div>

                            <div class="pos-subpanel rounded-3 p-3 mb-3 small">
                                <div class="d-flex justify-content-between py-1">
                                    <span class="text-secondary">Total Counted Cash (Drawer):</span>
                                    <span class="fw-bold text-success font-monospace">₱@((lastClosedShift.ActualCountedBalance ?? 0m).ToString("N2"))</span>
                                </div>
                                <div class="d-flex justify-content-between py-1">
                                    <span class="text-secondary">Total Non-Cash Declared:</span>
                                    <span class="fw-bold text-info font-monospace">₱@lastClosedShift.TotalNonCashDeclared.ToString("N2")</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(lastClosedShift.Notes))
                                {
                                    <div class="mt-2 pt-2 border-top border-secondary border-opacity-25 text-light">
                                        <strong>General Notes:</strong> @lastClosedShift.Notes
                                    </div>
                                }
                            </div>

                            <div class="d-flex flex-wrap gap-2 mb-4">
                                <button type="button" class="btn btn-primary rounded-3 py-2 px-3 fw-bold flex-grow-1" @onclick="ReprintSavedDeclarationAsync" disabled="@isPrintingDeclaration">
                                    <i class="bi bi-printer-fill me-1"></i> @(isPrintingDeclaration ? "Printing..." : "Reprint Declaration Acknowledgment")
                                </button>
                                <button type="button" class="btn btn-outline-light rounded-3 py-2 px-3 fw-semibold" @onclick="OpenLastClosedDeclarationModal">
                                    <i class="bi bi-eye me-1"></i> View Declaration
                                </button>
                            </div>

                            <!-- Supervisor / Admin Reconciliation & Recount Section -->
                            <div class="border-top border-secondary border-opacity-25 pt-3">
                                @if (!IsSupervisorUnlocked)
                                {
                                    <div class="pos-subpanel rounded-3 p-3">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="fw-bold text-warning small">
                                                <i class="bi bi-shield-lock-fill me-1"></i> Supervisor / Admin Reconciliation &amp; Recount
                                            </span>
                                            <span class="badge bg-dark text-secondary border border-secondary">Authorized Only</span>
                                        </div>
                                        <p class="small text-secondary mb-2">
                                            Expected totals, variances, X-Reading inquiry reports, and recount adjustments are restricted to authorized supervisors and managers.
                                        </p>
                                        <div class="input-group input-group-sm" style="max-width: 360px;">
                                            <input type="password" maxlength="10" class="form-control" @bind="supervisorUnlockPin" placeholder="Enter Supervisor / Manager PIN" />
                                            <button type="button" class="btn btn-warning fw-bold text-dark" @onclick="UnlockSupervisorReconciliationAsync" disabled="@isUnlockingSupervisor">
                                                <i class="bi bi-unlock-fill me-1"></i> @(isUnlockingSupervisor ? "Verifying..." : "Unlock Reconciliation")
                                            </button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="pos-subpanel rounded-3 p-3">
                                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                                            <span class="fw-bold text-info small text-uppercase">
                                                <i class="bi bi-shield-check me-1"></i> Supervisor Reconciliation &amp; Audit
                                            </span>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge @GetVarianceStatusBadgeClass(lastClosedShift.XReading?.OverallStatus ?? "BALANCED")">
                                                    @(lastClosedShift.XReading?.OverallStatus ?? "RECONCILED")
                                                </span>
                                                @if (!IsSupervisorRole(Session.Role))
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" @onclick="LockSupervisorReconciliation">
                                                        <i class="bi bi-lock-fill"></i> Lock
                                                    </button>
                                                }
                                            </div>
                                        </div>

                                        <div class="small mb-2">
                                            <div class="d-flex justify-content-between py-1">
                                                <span class="text-secondary">Expected Drawer Cash:</span>
                                                <span class="fw-bold text-light font-monospace">₱@lastClosedShift.ExpectedBalance.ToString("N2")</span>
                                            </div>
                                            <div class="d-flex justify-content-between py-1">
                                                <span class="text-secondary">Counted Drawer Cash:</span>
                                                <span class="fw-bold text-info font-monospace">₱@((lastClosedShift.ActualCountedBalance ?? 0m).ToString("N2"))</span>
                                            </div>
                                            <div class="d-flex justify-content-between py-1 border-bottom border-secondary border-opacity-25 pb-2">
                                                <span class="text-secondary">Cash Variance:</span>
                                                @{
                                                    decimal closedCashVar = lastClosedShift.Discrepancy ?? 0m;
                                                }
                                                <span class="fw-bold font-monospace @GetVarianceTextClass(closedCashVar)">
                                                    @FormatSignedCurrency(closedCashVar) (@PaymentMethodReconciliationDto.ComputeStatus(closedCashVar))
                                                </span>
                                            </div>
                                        </div>

                                        @if (lastClosedShift.PaymentReconciliations.Count > 0)
                                        {
                                            <div class="table-responsive mb-2">
                                                <table class="table table-sm table-dark align-middle mb-0" style="font-size: 0.78rem;">
                                                    <thead>
                                                        <tr class="text-secondary">
                                                            <th>Method</th>
                                                            <th class="text-end">Expected</th>
                                                            <th class="text-end">Counted/Declared</th>
                                                            <th class="text-end">Variance</th>
                                                            <th class="text-center">Status</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var pm in lastClosedShift.PaymentReconciliations)
                                                        {
                                                            <tr>
                                                                <td class="fw-semibold">@pm.PaymentMethodName</td>
                                                                <td class="text-end font-monospace">₱@pm.ExpectedAmount.ToString("N2")</td>
                                                                <td class="text-end font-monospace fw-bold">₱@pm.DeclaredAmount.ToString("N2")</td>
                                                                <td class="text-end font-monospace fw-bold @GetVarianceTextClass(pm.Variance)">@FormatSignedCurrency(pm.Variance)</td>
                                                                <td class="text-center">
                                                                    <span class="badge @GetVarianceStatusBadgeClass(pm.Status)">@pm.Status</span>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }

                                        @if (lastClosedShift.RecountHistory != null && lastClosedShift.RecountHistory.Count > 0)
                                        {
                                            <div class="border-top border-secondary border-opacity-25 pt-2 mt-2 small">
                                                <div class="fw-bold text-warning mb-1">
                                                    <i class="bi bi-clock-history me-1"></i> Recount / Correction Audit Trail (@lastClosedShift.RecountHistory.Count)
                                                </div>
                                                @if (lastClosedShift.OriginalDeclaration != null)
                                                {
                                                    <div class="text-secondary mb-1" style="font-size: 0.76rem;">
                                                        Original Cashier Declaration: Cash ₱@lastClosedShift.OriginalDeclaration.TotalCountedCash.ToString("N2") • Non-Cash ₱@lastClosedShift.OriginalDeclaration.TotalNonCashDeclared.ToString("N2")
                                                    </div>
                                                }
                                                @foreach (var rec in lastClosedShift.RecountHistory)
                                                {
                                                    <div class="p-2 rounded-2 bg-dark bg-opacity-50 mb-1" style="font-size: 0.76rem;">
                                                        <div class="d-flex justify-content-between fw-bold text-light">
                                                            <span>Recount #@rec.RecountNumber by @rec.CorrectedBy</span>
                                                            <span>@rec.CorrectedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                                                        </div>
                                                        <div class="text-secondary">
                                                            Cash: ₱@rec.OriginalCountedCash.ToString("N2") → ₱@rec.RevisedCountedCash.ToString("N2")
                                                            (Var: @FormatSignedCurrency(rec.OriginalCashVariance) → @FormatSignedCurrency(rec.RevisedCashVariance))
                                                        </div>
                                                        <div class="text-warning">Reason: @rec.Reason</div>
                                                    </div>
                                                }
                                            </div>
                                        }

                                        <div class="d-flex flex-wrap gap-2 mt-3">
                                            <button type="button" class="btn btn-sm btn-info fw-bold text-dark rounded-3 px-3 py-2" @onclick="ReprintSavedXReadingAsync" disabled="@isPrintingXReading">
                                                <i class="bi bi-printer-fill me-1"></i> @(isPrintingXReading ? "Printing..." : "Print X-Reading")
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-info rounded-3 px-3 py-2 fw-semibold" @onclick="OpenLastClosedXReadingModal">
                                                <i class="bi bi-eye me-1"></i> View X-Reading
                                            </button>
                                            <button type="button" class="btn btn-sm btn-warning fw-bold text-dark rounded-3 px-3 py-2" @onclick="OpenRecountModal">
                                                <i class="bi bi-pencil-square me-1"></i> Supervisor Recount / Correction
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Active Shift Summary Row (Blind Closing: Hides Expected Cash & System Sales Totals) -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="pos-kpi-card rounded-4 p-3 border-start border-primary border-4 h-100">
                    <span class="text-uppercase text-secondary fw-bold" style="font-size: 0.72rem;">Opening Float</span>
                    <h4 class="fw-bolder text-light mb-0 mt-1">₱@currentShift.OpeningFloat.ToString("N2")</h4>
                    <small class="text-secondary" style="font-size: 0.75rem;">Include remaining float in cash count</small>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="pos-kpi-card rounded-4 p-3 border-start border-warning border-4 h-100">
                    <span class="text-uppercase text-secondary fw-bold" style="font-size: 0.72rem;">Cash In / Paid-Out / Drops</span>
                    <h4 class="fw-bolder text-warning mb-0 mt-1">+₱@currentShift.TotalCashIn.ToString("N2") / -₱@((currentShift.TotalCashOut + currentShift.TotalCashDrops).ToString("N2"))</h4>
                    <small class="text-secondary" style="font-size: 0.75rem;">Recorded non-sales vouchers</small>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="pos-kpi-card rounded-4 p-3 border-start border-success border-4 h-100">
                    <span class="text-uppercase text-secondary fw-bold" style="font-size: 0.72rem;">Counted Drawer Cash</span>
                    <h4 class="fw-bolder text-success mb-0 mt-1">₱@TotalCountedCash.ToString("N2")</h4>
                    <small class="text-secondary" style="font-size: 0.75rem;">Coins ₱@CoinsSubtotal.ToString("N2") • Bills ₱@BillsSubtotal.ToString("N2")</small>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="pos-kpi-card rounded-4 p-3 border-start border-info border-4 h-100">
                    <span class="text-uppercase text-secondary fw-bold" style="font-size: 0.72rem;">Declared Non-Cash Total</span>
                    <h4 class="fw-bolder text-info mb-0 mt-1">₱@DeclaredNonCashTotal.ToString("N2")</h4>
                    <small class="text-secondary" style="font-size: 0.75rem;">Across @nonCashDeclarations.Count configured method(s)</small>
                </div>
            </div>
        </div>

        <!-- Tabbed Cash Drawer & Blind Closing Navigation Bar -->
        <div class="pos-tabs-wrapper mb-3">
            <div class="pos-tabs-nav" role="tablist" aria-label="Cash Drawer and Shift Closing Tabs" @onkeydown="OnTabBarKeyDown">
                <!-- Primary Closing Flow Tabs (Steps 1 - 3) -->
                <button type="button"
                        id="tab-cash-count"
                        role="tab"
                        aria-selected="@(activeTab == "CASH_COUNT")"
                        aria-controls="panel-cash-count"
                        class="pos-tab-btn @(activeTab == "CASH_COUNT" ? "active" : "")"
                        @onclick='() => SelectTab("CASH_COUNT")'>
                    <i class="bi bi-coin text-warning"></i>
                    <span>1. Cash Count</span>
                    <span class="badge rounded-pill @(activeTab == "CASH_COUNT" ? "bg-success text-white" : "bg-dark text-success border border-success border-opacity-50") font-monospace">
                        ₱@TotalCountedCash.ToString("N2")
                    </span>
                    @if (requiresRecountConfirmationAfterMovement)
                    {
                        <span class="badge bg-warning text-dark" title="Cash movement recorded after counting — reconfirm physical count">!</span>
                    }
                </button>

                <button type="button"
                        id="tab-other-payments"
                        role="tab"
                        aria-selected="@(activeTab == "OTHER_PAYMENTS")"
                        aria-controls="panel-other-payments"
                        class="pos-tab-btn @(activeTab == "OTHER_PAYMENTS" ? "active" : "")"
                        @onclick='() => SelectTab("OTHER_PAYMENTS")'>
                    <i class="bi bi-credit-card-2-front text-info"></i>
                    <span>2. Other Payments</span>
                    <span class="badge rounded-pill @(activeTab == "OTHER_PAYMENTS" ? "bg-info text-dark" : "bg-dark text-info border border-info border-opacity-50") font-monospace">
                        ₱@DeclaredNonCashTotal.ToString("N2")
                    </span>
                </button>

                <button type="button"
                        id="tab-review-close"
                        role="tab"
                        aria-selected="@(activeTab == "REVIEW_CLOSE")"
                        aria-controls="panel-review-close"
                        class="pos-tab-btn @(activeTab == "REVIEW_CLOSE" ? "active" : "")"
                        @onclick='() => SelectTab("REVIEW_CLOSE")'>
                    <i class="bi bi-clipboard2-check-fill text-primary"></i>
                    <span>3. Review &amp; Close</span>
                    @if (isDeclarationConfirmed && !requiresRecountConfirmationAfterMovement)
                    {
                        <span class="badge rounded-pill bg-success text-white">Confirmed</span>
                    }
                    else
                    {
                        <span class="badge rounded-pill bg-secondary bg-opacity-50 text-light">Final Step</span>
                    }
                </button>

                <div class="pos-tabs-divider" aria-hidden="true"></div>

                <!-- Supporting Drawer Tabs -->
                <button type="button"
                        id="tab-cash-movements"
                        role="tab"
                        aria-selected="@(activeTab == "CASH_MOVEMENTS")"
                        aria-controls="panel-cash-movements"
                        class="pos-tab-btn pos-tab-supporting @(activeTab == "CASH_MOVEMENTS" ? "active" : "")"
                        @onclick='() => SelectTab("CASH_MOVEMENTS")'>
                    <i class="bi bi-wallet2 text-warning"></i>
                    <span>Cash Movements</span>
                </button>

                <button type="button"
                        id="tab-movement-history"
                        role="tab"
                        aria-selected="@(activeTab == "MOVEMENT_HISTORY")"
                        aria-controls="panel-movement-history"
                        class="pos-tab-btn pos-tab-supporting @(activeTab == "MOVEMENT_HISTORY" ? "active" : "")"
                        @onclick='() => SelectTab("MOVEMENT_HISTORY")'>
                    <i class="bi bi-clock-history text-info"></i>
                    <span>Movement History</span>
                    <span class="badge rounded-pill bg-secondary bg-opacity-50 text-light">@(currentShift.Movements?.Count ?? 0)</span>
                    @if (currentShift.PendingApprovalsCount > 0)
                    {
                        <span class="badge rounded-pill bg-warning text-dark" title="Pending supervisor approvals">
                            @currentShift.PendingApprovalsCount Pending
                        </span>
                    }
                </button>
            </div>
        </div>

        <!-- Active Tab Content Panel (Only one tab displayed at a time) -->
        @if (activeTab == "CASH_COUNT")
        {
            <div id="panel-cash-count" role="tabpanel" aria-labelledby="tab-cash-count" class="pos-panel-card rounded-4 p-3 p-md-4 mb-4">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                    <div>
                        <h5 class="fw-bold text-light mb-1">
                            <i class="bi bi-coin me-2 text-warning"></i>1. Cash Count (Denomination Breakdown)
                        </h5>
                        <p class="small text-info mb-0">
                            <i class="bi bi-info-circle-fill me-1"></i>
                            Count <strong>all physical cash currently in the drawer</strong>, including the remaining opening float (₱@currentShift.OpeningFloat.ToString("N2")).
                        </p>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-3 px-3" @onclick="ResetDenominationCounts" disabled="@isSubmittingShift">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Reset Counts
                    </button>
                </div>

                @if (requiresRecountConfirmationAfterMovement)
                {
                    <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2 py-2 px-3 small mb-3">
                        <div>
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            <strong>Cash Movement Recorded After Counting:</strong> A cash movement was posted or updated after you started counting. Your entered quantities were preserved—please verify your physical drawer count and reconfirm below.
                        </div>
                        <button type="button" class="btn btn-sm btn-warning fw-bold text-dark rounded-3 px-3" @onclick="ConfirmPhysicalCountAfterMovement">
                            <i class="bi bi-check2-circle me-1"></i>Reconfirm Physical Count (₱@TotalCountedCash.ToString("N2"))
                        </button>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(denominationValidationError))
                {
                    <div class="alert alert-danger py-2 px-3 small mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> @denominationValidationError
                    </div>
                }

                <div class="row g-3">
                    <!-- Coins Column (Side-by-side on desktop, stacked on mobile) -->
                    <div class="col-12 col-md-6">
                        <div class="pos-subpanel rounded-3 p-3 h-100">
                            <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom border-secondary border-opacity-25">
                                <span class="fw-bold text-uppercase small text-warning">
                                    <i class="bi bi-circle-fill me-1" style="font-size: 0.55rem;"></i>Coins (₱0.01 – ₱20)
                                </span>
                                <span class="small fw-bold text-light font-monospace">Subtotal: ₱@CoinsSubtotal.ToString("N2")</span>
                            </div>

                            <div class="d-flex flex-column gap-2">
                                @foreach (var row in denominationRows.Where(r => r.Type == "COIN"))
                                {
                                    <div class="pos-denom-row d-flex align-items-center justify-content-between gap-2 py-1 px-2 rounded-2 @(row.HasError ? "border border-danger" : "")">
                                        <div class="fw-bold text-light" style="min-width: 76px; font-size: 0.92rem;">
                                            ₱@FormatDenomValue(row.Denomination)
                                            @if (row.Denomination == 20m)
                                            {
                                                <span class="badge bg-secondary ms-1" style="font-size: 0.62rem;">Coin</span>
                                            }
                                        </div>
                                        <div class="input-group input-group-sm" style="max-width: 144px;">
                                            <button type="button" class="btn btn-outline-secondary px-2"
                                                    disabled="@(isSubmittingShift || row.Quantity <= 0)"
                                                    @onclick="() => StepDenominationQuantity(row, -1)">−</button>
                                            <input type="text"
                                                   inputmode="numeric"
                                                   class="form-control text-center fw-bold pos-denom-input @(row.HasError ? "is-invalid" : "")"
                                                   value="@row.RawQuantity"
                                                   disabled="@isSubmittingShift"
                                                   @oninput="(e) => OnDenominationInputChanged(row, e.Value?.ToString())" />
                                            <button type="button" class="btn btn-outline-secondary px-2"
                                                    disabled="@isSubmittingShift"
                                                    @onclick="() => StepDenominationQuantity(row, 1)">+</button>
                                        </div>
                                        <div class="text-end fw-semibold text-info font-monospace" style="min-width: 92px; font-size: 0.9rem;">
                                            ₱@row.Subtotal.ToString("N2")
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Bills Column (Side-by-side on desktop, stacked on mobile) -->
                    <div class="col-12 col-md-6">
                        <div class="pos-subpanel rounded-3 p-3 h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom border-secondary border-opacity-25">
                                    <span class="fw-bold text-uppercase small text-success">
                                        <i class="bi bi-cash me-1"></i>Bills (₱20 – ₱1,000)
                                    </span>
                                    <span class="small fw-bold text-light font-monospace">Subtotal: ₱@BillsSubtotal.ToString("N2")</span>
                                </div>

                                <div class="d-flex flex-column gap-2">
                                    @foreach (var row in denominationRows.Where(r => r.Type == "BILL"))
                                    {
                                        <div class="pos-denom-row d-flex align-items-center justify-content-between gap-2 py-1 px-2 rounded-2 @(row.HasError ? "border border-danger" : "")">
                                            <div class="fw-bold text-light" style="min-width: 76px; font-size: 0.92rem;">
                                                ₱@FormatDenomValue(row.Denomination)
                                                @if (row.Denomination == 20m)
                                                {
                                                    <span class="badge bg-success bg-opacity-75 ms-1" style="font-size: 0.62rem;">Bill</span>
                                                }
                                            </div>
                                            <div class="input-group input-group-sm" style="max-width: 144px;">
                                                <button type="button" class="btn btn-outline-secondary px-2"
                                                        disabled="@(isSubmittingShift || row.Quantity <= 0)"
                                                        @onclick="() => StepDenominationQuantity(row, -1)">−</button>
                                                <input type="text"
                                                       inputmode="numeric"
                                                       class="form-control text-center fw-bold pos-denom-input @(row.HasError ? "is-invalid" : "")"
                                                       value="@row.RawQuantity"
                                                       disabled="@isSubmittingShift"
                                                       @oninput="(e) => OnDenominationInputChanged(row, e.Value?.ToString())" />
                                                <button type="button" class="btn btn-outline-secondary px-2"
                                                        disabled="@isSubmittingShift"
                                                        @onclick="() => StepDenominationQuantity(row, 1)">+</button>
                                            </div>
                                            <div class="text-end fw-semibold text-success font-monospace" style="min-width: 92px; font-size: 0.9rem;">
                                                ₱@row.Subtotal.ToString("N2")
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="mt-3 pt-3 border-top border-secondary border-opacity-25">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-uppercase small fw-bold text-secondary">Total Counted Cash</span>
                                    <span class="fs-4 fw-bolder text-success font-monospace">₱@TotalCountedCash.ToString("N2")</span>
                                </div>
                                <small class="text-secondary d-block text-end" style="font-size: 0.78rem;">
                                    Coins ₱@CoinsSubtotal.ToString("N2") + Bills ₱@BillsSubtotal.ToString("N2")
                                </small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Step 1 Footer Navigation -->
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-4 pt-3 border-top border-secondary border-opacity-25">
                    <div class="small text-secondary">
                        Step 1 of 3 • Enter physical drawer quantities, then proceed to non-cash payment declarations.
                    </div>
                    <button type="button" class="btn btn-primary rounded-3 px-4 py-2 fw-bold shadow-sm" @onclick="GoToOtherPaymentsTab" disabled="@isSubmittingShift">
                        Next: Other Payments <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </div>
            </div>
        }
        else if (activeTab == "OTHER_PAYMENTS")
        {
            <div id="panel-other-payments" role="tabpanel" aria-labelledby="tab-other-payments" class="pos-panel-card rounded-4 p-3 p-md-4 mb-4">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                    <div>
                        <h5 class="fw-bold text-light mb-1">
                            <i class="bi bi-credit-card-2-front me-2 text-info"></i>2. Other Payment Methods (Cashier-Declared Totals)
                        </h5>
                        <p class="small text-secondary mb-0">
                            Enter <strong>cashier-declared totals</strong> from payment history or supporting terminal slips (up to 2 decimal places). System-recorded totals and variances are hidden during blind closing.
                        </p>
                    </div>
                    <span class="badge bg-info-subtle text-info border border-info-subtle px-3 py-2 font-monospace">
                        Declared Non-Cash Total: ₱@DeclaredNonCashTotal.ToString("N2")
                    </span>
                </div>

                @if (!string.IsNullOrWhiteSpace(declarationValidationError))
                {
                    <div class="alert alert-danger py-2 px-3 small mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> @declarationValidationError
                    </div>
                }

                @if (nonCashDeclarations.Count == 0)
                {
                    <div class="pos-subpanel rounded-3 p-4 text-center text-secondary small">
                        No non-cash payment methods are configured or recorded for this shift. You may proceed directly to Review &amp; Close.
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var decl in nonCashDeclarations)
                        {
                            <div class="col-12 col-md-6 col-xl-4">
                                <div class="pos-subpanel rounded-3 p-3 h-100 @(decl.HasError ? "border border-danger" : "")">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <label class="fw-bold text-light small mb-0">
                                            @decl.PaymentMethodName
                                            <span class="text-secondary font-monospace ms-1">(@decl.PaymentMethodCode)</span>
                                        </label>
                                        @if (!decl.IsActive)
                                        {
                                            <span class="badge bg-warning text-dark" style="font-size: 0.68rem;">Inactive • Used in Shift</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-50 text-light" style="font-size: 0.68rem;">Cashier-Declared</span>
                                        }
                                    </div>
                                    <div class="input-group mt-2">
                                        <span class="input-group-text bg-dark text-light border-secondary">₱</span>
                                        <input type="text"
                                               inputmode="decimal"
                                               class="form-control fw-bold font-monospace pos-denom-input @(decl.HasError ? "is-invalid" : "")"
                                               value="@decl.RawAmount"
                                               disabled="@isSubmittingShift"
                                               placeholder="0.00"
                                               @oninput="(e) => OnDeclarationInputChanged(decl, e.Value?.ToString())" />
                                    </div>
                                    @if (decl.HasError)
                                    {
                                        <small class="text-danger d-block mt-1">Enter a non-negative amount with up to 2 decimal places.</small>
                                    }
                                    else
                                    {
                                        <small class="text-secondary d-block mt-1">Declared amount from terminal slips/payment records.</small>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- Step 2 Footer Navigation -->
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-4 pt-3 border-top border-secondary border-opacity-25">
                    <button type="button" class="btn btn-outline-light rounded-3 px-3 py-2 fw-semibold" @onclick='() => SelectTab("CASH_COUNT")' disabled="@isSubmittingShift">
                        <i class="bi bi-arrow-left me-1"></i> Back: Cash Count
                    </button>
                    <button type="button" class="btn btn-primary rounded-3 px-4 py-2 fw-bold shadow-sm" @onclick="GoToReviewCloseTab" disabled="@isSubmittingShift">
                        Next: Review &amp; Close <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </div>
            </div>
        }
        else if (activeTab == "REVIEW_CLOSE")
        {
            <div id="panel-review-close" role="tabpanel" aria-labelledby="tab-review-close" class="pos-panel-card rounded-4 p-3 p-md-4 mb-4">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                    <div>
                        <h5 class="fw-bold text-light mb-1">
                            <i class="bi bi-clipboard2-check-fill me-2 text-primary"></i>3. Review Declaration &amp; Submit Closing
                        </h5>
                        <p class="text-secondary small mb-0">
                            Verify your read-only denomination counts and declared non-cash payment totals below. Expected amounts and variances are restricted to supervisor reconciliation.
                        </p>
                    </div>
                    <span class="badge @(isDeclarationConfirmed ? "bg-success" : "bg-primary") px-3 py-2">
                        @(isDeclarationConfirmed ? "DECLARATION CONFIRMED" : "REVIEW & CONFIRM")
                    </span>
                </div>

                @if (requiresRecountConfirmationAfterMovement)
                {
                    <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2 py-2 px-3 small mb-3">
                        <div>
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            <strong>Physical Cash Recount Required:</strong> A cash movement was posted after you started counting. Please return to <strong>Cash Count</strong> to verify and reconfirm your physical drawer cash before closing.
                        </div>
                        <button type="button" class="btn btn-sm btn-warning fw-bold text-dark rounded-3 px-3" @onclick='() => SelectTab("CASH_COUNT")'>
                            <i class="bi bi-coin me-1"></i> Go to Cash Count to Reconfirm
                        </button>
                    </div>
                }

                @if (currentShift.PendingApprovalsCount > 0)
                {
                    <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2 py-2 px-3 small mb-3">
                        <div>
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            <strong>@currentShift.PendingApprovalsCount pending cash movement(s)</strong> must be approved or rejected by a supervisor before closing the shift.
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-dark fw-bold rounded-3 px-3" @onclick='() => SelectTab("MOVEMENT_HISTORY")'>
                            <i class="bi bi-clock-history me-1"></i> View Pending Movements
                        </button>
                    </div>
                }

                <div class="row g-3 mb-3">
                    <!-- A. Read-Only Entered Cash Denomination Summary -->
                    <div class="col-12 col-lg-6">
                        <div class="pos-subpanel rounded-3 p-3 h-100 d-flex flex-column justify-content-between small">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom border-secondary border-opacity-25">
                                    <span class="fw-bold text-uppercase text-warning" style="font-size: 0.76rem; letter-spacing: 0.04em;">
                                        Entered Cash Count Summary (Includes Float)
                                    </span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" @onclick="EditCashCountFromReview" disabled="@isSubmittingShift">
                                        <i class="bi bi-pencil-square me-1"></i>Edit Cash Count
                                    </button>
                                </div>
                                <div class="d-flex justify-content-between py-1">
                                    <span class="text-secondary">Coins Subtotal:</span>
                                    <span class="fw-semibold text-light font-monospace">₱@CoinsSubtotal.ToString("N2")</span>
                                </div>
                                <div class="d-flex justify-content-between py-1 border-bottom border-secondary border-opacity-25 pb-2">
                                    <span class="text-secondary">Bills Subtotal:</span>
                                    <span class="fw-semibold text-light font-monospace">₱@BillsSubtotal.ToString("N2")</span>
                                </div>
                                @if (denominationRows.Any(r => r.Quantity > 0))
                                {
                                    <div class="py-2 border-bottom border-secondary border-opacity-25" style="max-height: 210px; overflow-y: auto;">
                                        @foreach (var d in denominationRows.Where(r => r.Quantity > 0))
                                        {
                                            <div class="d-flex justify-content-between text-secondary py-1" style="font-size: 0.8rem;">
                                                <span>@d.Label × @d.Quantity</span>
                                                <span class="font-monospace text-light">₱@d.Subtotal.ToString("N2")</span>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="py-2 border-bottom border-secondary border-opacity-25 text-secondary fst-italic" style="font-size: 0.8rem;">
                                        All denomination quantities are currently 0 (₱0.00 counted cash).
                                    </div>
                                }
                            </div>
                            <div class="d-flex justify-content-between align-items-center pt-2 mt-2">
                                <span class="fw-bold text-light">Total Counted Cash:</span>
                                <span class="fw-bolder text-success fs-5 font-monospace">₱@TotalCountedCash.ToString("N2")</span>
                            </div>
                        </div>
                    </div>

                    <!-- B. Read-Only Entered Non-Cash Payment Declarations Summary -->
                    <div class="col-12 col-lg-6">
                        <div class="pos-subpanel rounded-3 p-3 h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom border-secondary border-opacity-25">
                                    <span class="fw-bold text-uppercase small text-info" style="font-size: 0.76rem; letter-spacing: 0.04em;">
                                        Cashier-Declared Non-Cash Totals
                                    </span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" @onclick="EditOtherPaymentsFromReview" disabled="@isSubmittingShift">
                                        <i class="bi bi-pencil-square me-1"></i>Edit Other Payments
                                    </button>
                                </div>

                                @if (nonCashDeclarations.Count == 0)
                                {
                                    <div class="small text-secondary py-3">No non-cash payment methods configured.</div>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="table table-sm table-dark align-middle mb-0" style="font-size: 0.82rem;">
                                            <thead>
                                                <tr class="text-secondary">
                                                    <th>Payment Method</th>
                                                    <th class="text-end">Cashier-Declared Total</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var decl in nonCashDeclarations)
                                                {
                                                    <tr>
                                                        <td>
                                                            <div class="fw-semibold">@decl.PaymentMethodName</div>
                                                            @if (!decl.IsActive)
                                                            {
                                                                <small class="text-warning" style="font-size: 0.68rem;">Inactive • Used in Shift</small>
                                                            }
                                                        </td>
                                                        <td class="text-end font-monospace fw-bold">₱@decl.DeclaredAmount.ToString("N2")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                            <div class="d-flex justify-content-between align-items-center pt-2 mt-2 border-top border-secondary border-opacity-25">
                                <span class="fw-bold text-light small">Total Non-Cash Declared:</span>
                                <span class="fw-bolder text-info fs-5 font-monospace">₱@DeclaredNonCashTotal.ToString("N2")</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- C. Optional General Notes -->
                <div class="mb-3">
                    <label class="form-label fw-semibold text-light small mb-1">
                        Optional General Notes
                    </label>
                    <textarea rows="2"
                              maxlength="255"
                              class="form-control rounded-3 pos-denom-input"
                              @bind="closingNotes"
                              @bind:event="oninput"
                              disabled="@isSubmittingShift"
                              placeholder="Optional general shift notes..."></textarea>
                </div>

                <!-- D. Explicit Confirmation & Final Submit Closing -->
                <div class="p-3 rounded-3 mb-3 border border-primary bg-primary bg-opacity-10 small text-light">
                    <div class="fw-bold mb-1">
                        <i class="bi bi-shield-check me-1 text-info"></i> Confirm Blind Closing Declaration
                    </div>
                    <div class="mb-2 text-secondary">
                        Submitting will permanently lock this declaration, close Shift #@currentShift.ShiftId, and print your Cashier Declaration Acknowledgment.
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="confirmBlindDeclarationCheck"
                               @bind="isDeclarationConfirmed"
                               disabled="@(isSubmittingShift || requiresRecountConfirmationAfterMovement)" />
                        <label class="form-check-label fw-semibold text-warning" for="confirmBlindDeclarationCheck">
                            I confirm that my cash denomination counts (₱@TotalCountedCash.ToString("N2")) and non-cash declarations (₱@DeclaredNonCashTotal.ToString("N2")), including any ₱0.00 amounts, are complete and accurate.
                        </label>
                    </div>
                </div>

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pt-2">
                    <button type="button"
                            class="btn btn-outline-light rounded-3 py-2 px-3 fw-semibold"
                            @onclick="EditOtherPaymentsFromReview"
                            disabled="@isSubmittingShift">
                        <i class="bi bi-arrow-left me-1"></i> Back: Other Payments
                    </button>
                    <button type="button"
                            class="btn btn-danger rounded-3 py-2 px-4 fw-bold shadow-sm"
                            @onclick="CloseShift"
                            disabled="@(isSubmittingShift || !isDeclarationConfirmed || requiresRecountConfirmationAfterMovement || currentShift.PendingApprovalsCount > 0)">
                        <i class="bi bi-lock-fill me-1"></i>
                        @(isSubmittingShift ? "Submitting & Printing..." : "Submit Closing & Print Acknowledgment")
                    </button>
                </div>
            </div>
        }
        else if (activeTab == "CASH_MOVEMENTS")
        {
            <div id="panel-cash-movements" role="tabpanel" aria-labelledby="tab-cash-movements" class="pos-panel-card rounded-4 p-3 p-md-4 mb-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div>
                        <h5 class="fw-bold text-light mb-1">
                            <i class="bi bi-wallet2 me-2 text-primary"></i>Record Cash Movement / Petty Cash
                        </h5>
                        <p class="small text-secondary mb-0">
                            Supporting drawer tab for non-sales cash inflows and outflows. Entered closing counts and notes are preserved while you record movements.
                        </p>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-dark text-secondary border border-secondary">Non-Sales Voucher</span>
                        <button type="button" class="btn btn-sm btn-outline-info rounded-3" @onclick='() => SelectTab("MOVEMENT_HISTORY")'>
                            <i class="bi bi-clock-history me-1"></i>View History (@(currentShift.Movements?.Count ?? 0))
                        </button>
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6 col-md-3">
                        <button type="button"
                                class="btn w-100 py-2 fw-bold rounded-3 @(movementType == "PETTY_CASH" ? "btn-danger shadow-sm" : "btn-outline-danger")"
                                @onclick='() => SelectMovementType("PETTY_CASH")'>
                            <i class="bi bi-receipt me-1"></i> Petty Cash Out
                        </button>
                    </div>
                    <div class="col-6 col-md-3">
                        <button type="button"
                                class="btn w-100 py-2 fw-bold rounded-3 @(movementType == "CASH_OUT" ? "btn-warning text-dark shadow-sm" : "btn-outline-warning")"
                                @onclick='() => SelectMovementType("CASH_OUT")'>
                            <i class="bi bi-box-arrow-up-right me-1"></i> Cash Paid-Out
                        </button>
                    </div>
                    <div class="col-6 col-md-3">
                        <button type="button"
                                class="btn w-100 py-2 fw-bold rounded-3 @(movementType == "CASH_IN" ? "btn-success shadow-sm" : "btn-outline-success")"
                                @onclick='() => SelectMovementType("CASH_IN")'>
                            <i class="bi bi-box-arrow-in-down-left me-1"></i> Cash Paid-In
                        </button>
                    </div>
                    <div class="col-6 col-md-3">
                        <button type="button"
                                class="btn w-100 py-2 fw-bold rounded-3 @(movementType == "CASH_DROP" ? "btn-secondary shadow-sm" : "btn-outline-secondary")"
                                @onclick='() => SelectMovementType("CASH_DROP")'>
                            <i class="bi bi-safe2 me-1"></i> Cash Drop
                        </button>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-light small mb-1">Movement Category</label>
                        <select class="form-select rounded-3 py-2 pos-denom-input" @bind="selectedCategoryId">
                            <option value="0">-- Select Category --</option>
                            @foreach (var cat in FilteredCategories)
                            {
                                <option value="@cat.CategoryId">@cat.Name @(cat.RequiresApproval ? "(Approval Req.)" : "")</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-light small mb-1">
                            Amount in PHP (₱)
                        </label>
                        <input type="number" step="0.01" min="0.01" class="form-control rounded-3 py-2 fw-bold fs-5 pos-denom-input" @bind="movementAmount" placeholder="0.00" />
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mb-3">
                    @foreach (var preset in new decimal[] { 50m, 100m, 200m, 500m, 1000m })
                    {
                        <button type="button" class="btn btn-outline-light btn-sm rounded-pill px-3 fw-semibold" @onclick="() => movementAmount += preset">
                            +₱@preset.ToString("N0")
                        </button>
                    }
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" @onclick="() => movementAmount = 0m">
                        Clear
                    </button>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold text-light small mb-1">Reason / Particulars / Payee &amp; Supplier Reference</label>
                    <input type="text" maxlength="255" class="form-control rounded-3 py-2 pos-denom-input" @bind="movementReason"
                           placeholder="e.g., 5 bags tube ice from ABC Ice Plant (OR #1042) / Change fund coins" />
                </div>

                @if (CurrentSelectionRequiresApproval)
                {
                    <div class="p-3 rounded-3 bg-warning bg-opacity-10 border border-warning mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold text-warning small">
                                <i class="bi bi-shield-lock-fill me-1"></i> Supervisor Approval Required
                            </span>
                            <span class="badge bg-warning text-dark">Manager / Senior Cashier</span>
                        </div>
                        <p class="small text-secondary mb-2">
                            Enter a Supervisor PIN below to post immediately, or leave blank to submit as <strong>PENDING_APPROVAL</strong>.
                        </p>
                        <input type="password" maxlength="10" class="form-control form-control-sm rounded-3 pos-denom-input" style="max-width: 240px;"
                               @bind="supervisorPin" placeholder="Supervisor PIN (optional for pending)" />
                    </div>
                }

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pt-2">
                    <button type="button" class="btn btn-outline-light rounded-3 px-3 py-2 fw-semibold" @onclick='() => SelectTab("CASH_COUNT")'>
                        <i class="bi bi-coin me-1"></i> Return to Cash Count
                    </button>
                    <button type="button"
                            class="btn btn-primary rounded-3 py-2 px-4 fw-bold shadow-sm"
                            @onclick="OpenConfirmMovementModal"
                            disabled="@isSubmittingMovement">
                        <i class="bi bi-check2-circle me-1"></i>
                        @(isSubmittingMovement ? "Processing..." : $"Review & Submit {FormatMovementTypeLabel(movementType)}")
                    </button>
                </div>
            </div>
        }
        else if (activeTab == "MOVEMENT_HISTORY")
        {
            <div id="panel-movement-history" role="tabpanel" aria-labelledby="tab-movement-history" class="pos-panel-card rounded-4 overflow-hidden mb-4">
                <div class="py-3 px-4 d-flex flex-wrap justify-content-between align-items-center gap-2 border-bottom border-secondary border-opacity-25">
                    <div>
                        <h5 class="fw-bold text-light mb-0">
                            <i class="bi bi-clock-history me-2 text-info"></i>Shift Cash Movement History
                        </h5>
                        <small class="text-secondary">Filter recorded vouchers, print receipts, or complete supervisor approvals.</small>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <select class="form-select form-select-sm rounded-3 pos-denom-input" style="width: 175px;" @bind="historyFilterStatus">
                            <option value="">All Statuses</option>
                            <option value="POSTED">Posted</option>
                            <option value="PENDING_APPROVAL">Pending Approval</option>
                            <option value="REJECTED">Rejected</option>
                            <option value="REVERSED">Reversed</option>
                        </select>
                        <button type="button" class="btn btn-sm btn-outline-primary rounded-3" @onclick='() => SelectTab("CASH_MOVEMENTS")'>
                            <i class="bi bi-plus-circle me-1"></i>New Movement
                        </button>
                    </div>
                </div>

                @if (!FilteredMovements.Any())
                {
                    <div class="text-center py-5 text-secondary">
                        <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                        <p class="mb-0 small">No cash movements recorded for this shift matching the selected filter.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-dark align-middle mb-0">
                            <thead class="text-uppercase text-secondary" style="font-size: 0.72rem;">
                                <tr>
                                    <th class="py-2 px-3">Voucher #</th>
                                    <th class="py-2">Type</th>
                                    <th class="py-2">Reason</th>
                                    <th class="py-2">Status</th>
                                    <th class="py-2 text-end">Amount</th>
                                    <th class="py-2 text-end px-3">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in FilteredMovements)
                                {
                                    <tr>
                                        <td class="px-3 fw-bold font-monospace text-info small">@m.ReferenceNumber</td>
                                        <td>
                                            <span class="badge @GetMovementTypeBadgeClass(m.MovementType)">
                                                @FormatMovementTypeLabel(m.MovementType)
                                            </span>
                                        </td>
                                        <td>
                                            <div class="small text-light">@m.Reason</div>
                                            <small class="text-secondary">By @m.CreatedBy • @m.CreatedAt.ToLocalTime().ToString("HH:mm")</small>
                                        </td>
                                        <td>
                                            <span class="badge @GetStatusBadgeClass(m.Status)">@m.Status</span>
                                        </td>
                                        <td class="text-end fw-bold font-monospace @(m.MovementType == "CASH_IN" ? "text-success" : "text-danger")">
                                            @(m.MovementType == "CASH_IN" ? "+" : "-")₱@m.Amount.ToString("N2")
                                        </td>
                                        <td class="text-end px-3">
                                            <div class="d-flex justify-content-end gap-1">
                                                <button class="btn btn-outline-info btn-sm rounded-3" title="Print Voucher" @onclick="() => OpenVoucherPreview(m)">
                                                    <i class="bi bi-printer"></i>
                                                </button>
                                                @if (m.Status == "PENDING_APPROVAL" && !isOffline && m.MovementId > 0)
                                                {
                                                    <button class="btn btn-success btn-sm rounded-3" @onclick='() => OpenSupervisorActionModal(m, "APPROVE")'>Approve</button>
                                                    <button class="btn btn-outline-danger btn-sm rounded-3" @onclick='() => OpenSupervisorActionModal(m, "REJECT")'>Reject</button>
                                                }
                                                @if (m.Status == "POSTED" && m.MovementType != "REVERSAL" && !isOffline && m.MovementId > 0)
                                                {
                                                    <button class="btn btn-outline-secondary btn-sm rounded-3" @onclick='() => OpenSupervisorActionModal(m, "REVERSE")'>Reverse</button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    }
</div>

<!-- Confirmation Modal Before Submitting Movement -->
@if (showConfirmModal && currentShift != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15, 23, 42, 0.75);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow-lg bg-dark text-light">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Confirm Cash Movement</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showConfirmModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="p-3 rounded-3 pos-subpanel mb-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-secondary small">Movement Type:</span>
                            <span class="fw-bold">@FormatMovementTypeLabel(movementType)</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-secondary small">Category:</span>
                            <span class="fw-semibold">@(SelectedCategory?.Name ?? "General")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-secondary small">Amount:</span>
                            <span class="fw-bolder fs-5 @(movementType == "CASH_IN" ? "text-success" : "text-danger")">₱@movementAmount.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-secondary small">Reason / Particulars:</span>
                            <span class="fw-medium text-end">@movementReason</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary rounded-3 px-4" @onclick="() => showConfirmModal = false" disabled="@isSubmittingMovement">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-primary rounded-3 px-4 fw-bold" @onclick="ConfirmAndSubmitMovementAsync" disabled="@isSubmittingMovement">
                        @(isSubmittingMovement ? "Saving..." : "Confirm & Record")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Supervisor Approve / Reject / Reverse Modal -->
@if (actionModalMovement != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15, 23, 42, 0.75);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow-lg bg-dark text-light">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">
                        @actionModalType Cash Movement (@actionModalMovement.ReferenceNumber)
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseSupervisorActionModal"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-secondary mb-3">
                        Amount: <strong>₱@actionModalMovement.Amount.ToString("N2")</strong> • @actionModalMovement.Reason
                    </p>
                    @if (actionModalType is "REJECT" or "REVERSE")
                    {
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Reason (Required)</label>
                            <input type="text" class="form-control rounded-3" @bind="actionModalReason" placeholder="Enter reason for audit log..." />
                        </div>
                    }
                    <div class="mb-2">
                        <label class="form-label fw-semibold small">Supervisor PIN</label>
                        <input type="password" maxlength="10" class="form-control rounded-3" @bind="actionModalSupervisorPin" placeholder="Enter Admin / Manager / Senior Cashier PIN" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary rounded-3" @onclick="CloseSupervisorActionModal">Cancel</button>
                    <button type="button" class="btn btn-primary rounded-3 fw-bold" @onclick="ExecuteSupervisorActionAsync" disabled="@isSubmittingAction">
                        @(isSubmittingAction ? "Processing..." : $"Confirm {actionModalType}")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Printable Cash Movement Voucher Modal -->
@if (selectedVoucher != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15, 23, 42, 0.75);">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
            <div class="modal-content border-0 rounded-4 shadow-lg">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark">Cash Movement Voucher</h5>
                    <button type="button" class="btn-close" @onclick="() => selectedVoucher = null"></button>
                </div>
                <div class="modal-body">
                    <div id="printable-cash-voucher" class="p-3 border rounded-3 bg-white text-dark font-monospace" style="font-size: 0.84rem; line-height: 1.45;">
                        <div class="text-center border-bottom pb-2 mb-2">
                            <div class="fw-bold fs-6">@(Session.Terminal?.BranchName ?? "POS F&B QUICK SERVICE")</div>
                            @if (!string.IsNullOrWhiteSpace(Session.Terminal?.BranchAddress))
                            {
                                <div class="small">@Session.Terminal.BranchAddress</div>
                            }
                            <div class="small">Terminal: @(Session.Terminal?.TerminalName ?? $"Terminal #{selectedVoucher.TerminalId}")</div>
                            <div class="fw-bold mt-1 text-uppercase border-top pt-1">
                                @FormatMovementTypeLabel(selectedVoucher.MovementType) VOUCHER
                            </div>
                            <div class="small text-muted">(INTERNAL NON-SALES CASH VOUCHER)</div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <span>Voucher No:</span>
                            <span class="fw-bold">@selectedVoucher.ReferenceNumber</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Shift ID:</span>
                            <span>#@selectedVoucher.ShiftId</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Date/Time:</span>
                            <span>@selectedVoucher.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Status:</span>
                            <span class="fw-bold">@selectedVoucher.Status</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Category:</span>
                            <span>@(selectedVoucher.CategoryName ?? "General")</span>
                        </div>

                        <div class="border-top border-bottom my-2 py-2">
                            <div class="small text-secondary">Particulars / Reason:</div>
                            <div class="fw-semibold">@selectedVoucher.Reason</div>
                            <div class="d-flex justify-content-between align-items-center mt-2 pt-1 border-top">
                                <span class="fw-bold">AMOUNT (PHP):</span>
                                <span class="fw-bolder fs-5">₱@selectedVoucher.Amount.ToString("N2")</span>
                            </div>
                        </div>

                        <div class="small mb-3">
                            <div>Prepared By: <strong>@selectedVoucher.CreatedBy</strong></div>
                            <div>Approved By: <strong>@(selectedVoucher.ApprovedBy ?? "Pending Supervisor")</strong></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary rounded-3" @onclick="() => selectedVoucher = null">Close</button>
                    <button type="button" class="btn btn-primary rounded-3 fw-bold" @onclick="PrintVoucherAsync">
                        <i class="bi bi-printer-fill me-1"></i> Print Voucher
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Cashier Declaration Acknowledgment Modal (Cashier-Safe View & Reprint) -->
@if (selectedDeclaration != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15, 23, 42, 0.78);">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width: 460px;">
            <div class="modal-content border-0 rounded-4 shadow-lg bg-dark text-light">
                <div class="modal-header border-secondary border-opacity-25">
                    <div>
                        <h5 class="modal-title fw-bold mb-0">Cashier Declaration Acknowledgment</h5>
                        <small class="text-secondary">Shift #@selectedDeclaration.ShiftId • Blind Closing Receipt</small>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => selectedDeclaration = null"></button>
                </div>
                <div class="modal-body">
                    <div class="p-3 border rounded-3 bg-white text-dark font-monospace" style="font-size: 0.8rem; line-height: 1.4;">
                        <div class="text-center border-bottom pb-2 mb-2">
                            <div class="fw-bold fs-6">@selectedDeclaration.BranchName</div>
                            @if (!string.IsNullOrWhiteSpace(selectedDeclaration.BranchAddress))
                            {
                                <div>@selectedDeclaration.BranchAddress</div>
                            }
                            <div>Terminal: @selectedDeclaration.TerminalName</div>
                            <div class="fw-bold mt-1">CASHIER DECLARATION ACKNOWLEDGMENT</div>
                            <div>(BLIND SHIFT CLOSING RECEIPT)</div>
                            @if (selectedDeclaration.IsReprint)
                            {
                                <div class="fw-bold mt-1">** REPRINT **</div>
                            }
                        </div>

                        <div class="d-flex justify-content-between"><span>Shift ID:</span><span>#@selectedDeclaration.ShiftId</span></div>
                        <div class="d-flex justify-content-between"><span>Cashier:</span><span>@selectedDeclaration.CashierId</span></div>
                        <div class="d-flex justify-content-between"><span>Opened:</span><span>@selectedDeclaration.OpenedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span></div>
                        <div class="d-flex justify-content-between"><span>Submitted:</span><span>@selectedDeclaration.SubmittedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span></div>

                        <div class="border-top mt-2 pt-2">
                            <div class="fw-bold">DECLARED CASH DENOMINATIONS</div>
                            @if (selectedDeclaration.Denominations.Any(d => d.Quantity > 0))
                            {
                                @foreach (var d in selectedDeclaration.Denominations.Where(x => x.Quantity > 0))
                                {
                                    <div class="d-flex justify-content-between">
                                        <span>@d.Label x @d.Quantity</span>
                                        <span>₱@d.Subtotal.ToString("N2")</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <div>No cash denominations declared (₱0.00)</div>
                            }
                            <div class="d-flex justify-content-between fw-bold border-top mt-1 pt-1">
                                <span>TOTAL COUNTED CASH:</span>
                                <span>₱@selectedDeclaration.TotalCountedCash.ToString("N2")</span>
                            </div>
                        </div>

                        <div class="border-top mt-2 pt-2">
                            <div class="fw-bold">DECLARED OTHER PAYMENTS</div>
                            @if (selectedDeclaration.PaymentDeclarations.Count > 0)
                            {
                                @foreach (var pm in selectedDeclaration.PaymentDeclarations)
                                {
                                    <div class="d-flex justify-content-between">
                                        <span>@pm.PaymentMethodName</span>
                                        <span>₱@pm.DeclaredAmount.ToString("N2")</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <div>No non-cash payment methods declared</div>
                            }
                            <div class="d-flex justify-content-between fw-bold border-top mt-1 pt-1">
                                <span>TOTAL NON-CASH DECLARED:</span>
                                <span>₱@selectedDeclaration.TotalNonCashDeclared.ToString("N2")</span>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(selectedDeclaration.Notes))
                        {
                            <div class="border-top mt-2 pt-2">
                                <strong>General Notes:</strong> @selectedDeclaration.Notes
                            </div>
                        }

                        <div class="border-top mt-3 pt-2 text-center small">
                            <div class="mt-3">_______________________________</div>
                            <div>Cashier Signature (@selectedDeclaration.CashierId)</div>
                            <div class="mt-3">_______________________________</div>
                            <div>Supervisor / Witness Signature</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary border-opacity-25">
                    <button type="button" class="btn btn-outline-light rounded-3" @onclick="() => selectedDeclaration = null">Close</button>
                    <button type="button" class="btn btn-primary rounded-3 fw-bold" @onclick="ReprintSavedDeclarationAsync" disabled="@isPrintingDeclaration">
                        <i class="bi bi-printer-fill me-1"></i> @(isPrintingDeclaration ? "Printing..." : "Print Acknowledgment")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- X-Reading & Shift Reconciliation Report Modal (Supervisor/Admin Only) -->
@if (selectedXReading != null && IsSupervisorUnlocked)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15, 23, 42, 0.78);">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width: 480px;">
            <div class="modal-content border-0 rounded-4 shadow-lg bg-dark text-light">
                <div class="modal-header border-secondary border-opacity-25">
                    <div>
                        <h5 class="modal-title fw-bold mb-0">X-Reading &amp; Shift Reconciliation</h5>
                        <small class="text-secondary">Shift #@selectedXReading.ShiftId • Non-Resetting Supervisor Inquiry Report</small>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => selectedXReading = null"></button>
                </div>
                <div class="modal-body">
                    <div class="p-3 border rounded-3 bg-white text-dark font-monospace" style="font-size: 0.8rem; line-height: 1.4;">
                        <div class="text-center border-bottom pb-2 mb-2">
                            <div class="fw-bold fs-6">@selectedXReading.BranchName</div>
                            @if (!string.IsNullOrWhiteSpace(selectedXReading.BranchAddress))
                            {
                                <div>@selectedXReading.BranchAddress</div>
                            }
                            <div>Terminal: @selectedXReading.TerminalName</div>
                            <div class="fw-bold mt-1">X-READING &amp; SHIFT RECONCILIATION</div>
                            <div>(NON-RESETTING INQUIRY REPORT)</div>
                            @if (selectedXReading.IsReprint)
                            {
                                <div class="fw-bold mt-1">** REPRINT **</div>
                            }
                        </div>

                        <div class="d-flex justify-content-between"><span>Shift ID:</span><span>#@selectedXReading.ShiftId</span></div>
                        <div class="d-flex justify-content-between"><span>Cashier:</span><span>@selectedXReading.CashierId</span></div>
                        <div class="d-flex justify-content-between"><span>Opened:</span><span>@selectedXReading.OpenedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span></div>
                        <div class="d-flex justify-content-between"><span>Closed:</span><span>@(selectedXReading.ClosedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "OPEN")</span></div>

                        @if (!selectedXReading.ReportingPeriodMatchesShift)
                        {
                            <div class="border-top mt-1 pt-1">
                                <div class="fw-bold">X-Reading Period (4AM Business Day)</div>
                                <div>@selectedXReading.ReportingPeriodStart.ToLocalTime().ToString("yyyy-MM-dd HH:mm") to @selectedXReading.ReportingPeriodEnd.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                            </div>
                        }

                        <div class="border-top mt-2 pt-2">
                            <div class="fw-bold">X-READING SALES COUNTERS</div>
                            <div class="d-flex justify-content-between"><span>Beg. Invoice:</span><span>@(selectedXReading.BeginningInvoiceNumber ?? "N/A")</span></div>
                            <div class="d-flex justify-content-between"><span>End. Invoice:</span><span>@(selectedXReading.EndingInvoiceNumber ?? "N/A")</span></div>
                            <div class="d-flex justify-content-between"><span>Gross Sales:</span><span>₱@selectedXReading.GrossSales.ToString("N2")</span></div>
                            <div class="d-flex justify-content-between"><span>Discounts:</span><span>-₱@selectedXReading.TotalDiscounts.ToString("N2")</span></div>
                            <div class="d-flex justify-content-between"><span>Refunds/Voids:</span><span>-₱@selectedXReading.TotalRefundsAndVoids.ToString("N2")</span></div>
                            <div class="d-flex justify-content-between fw-bold"><span>Net Sales (Period):</span><span>₱@selectedXReading.NetSales.ToString("N2")</span></div>
                        </div>

                        <div class="border-top mt-2 pt-2">
                            <div class="fw-bold">SHIFT SALES (EXCL. FLOAT)</div>
                            <div class="d-flex justify-content-between"><span>Cash Net Sales:</span><span>₱@selectedXReading.ShiftCashNetSales.ToString("N2")</span></div>
                            <div class="d-flex justify-content-between"><span>Non-Cash Net Sales:</span><span>₱@selectedXReading.ShiftNonCashNetSales.ToString("N2")</span></div>
                            <div class="d-flex justify-content-between fw-bold"><span>Total Shift Net Sales:</span><span>₱@selectedXReading.ShiftNetSales.ToString("N2")</span></div>
                        </div>

                        <div class="border-top mt-2 pt-2">
                            <div class="fw-bold">CASH DRAWER LEDGER</div>
                            <div class="d-flex justify-content-between"><span>Opening Float:</span><span>₱@selectedXReading.OpeningFloat.ToString("N2")</span></div>
                            <div class="d-flex justify-content-between"><span>(+) Cash Sales:</span><span>+₱@selectedXReading.CashSalesCollected.ToString("N2")</span></div>
                            <div class="d-flex justify-content-between"><span>(+) Cash In:</span><span>+₱@selectedXReading.TotalCashIn.ToString("N2")</span></div>
                            <div class="d-flex justify-content-between"><span>(−) Cash Refunds:</span><span>-₱@selectedXReading.CashRefunds.ToString("N2")</span></div>
                            <div class="d-flex justify-content-between"><span>(−) Cash Out/Drops:</span><span>-₱@((selectedXReading.TotalCashOut + selectedXReading.TotalCashDrops).ToString("N2"))</span></div>
                            <div class="d-flex justify-content-between fw-bold"><span>Expected Cash:</span><span>₱@selectedXReading.ExpectedCashInDrawer.ToString("N2")</span></div>
                            <div class="d-flex justify-content-between fw-bold"><span>Counted Cash:</span><span>₱@selectedXReading.CountedCashInDrawer.ToString("N2")</span></div>
                            <div class="d-flex justify-content-between fw-bold"><span>Cash Variance (@selectedXReading.CashReconciliationStatus):</span><span>@FormatSignedCurrency(selectedXReading.CashVariance)</span></div>
                        </div>

                        @if (selectedXReading.Denominations.Any(d => d.Quantity > 0))
                        {
                            <div class="border-top mt-2 pt-2">
                                <div class="fw-bold">DENOMINATION BREAKDOWN</div>
                                @foreach (var d in selectedXReading.Denominations.Where(x => x.Quantity > 0))
                                {
                                    <div class="d-flex justify-content-between">
                                        <span>@d.Label x @d.Quantity</span>
                                        <span>₱@d.Subtotal.ToString("N2")</span>
                                    </div>
                                }
                            </div>
                        }

                        <div class="border-top mt-2 pt-2">
                            <div class="fw-bold">PAYMENT RECONCILIATION</div>
                            @foreach (var pm in selectedXReading.PaymentReconciliations)
                            {
                                <div class="mb-1">
                                    <div class="d-flex justify-content-between fw-bold">
                                        <span>@pm.PaymentMethodName @(pm.IsCash ? "[Counted]" : "[Declared]")</span>
                                        <span>@pm.Status</span>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span>Exp: ₱@pm.ExpectedAmount.ToString("N2") | @(pm.IsCash ? "Cnt" : "Dec"): ₱@pm.DeclaredAmount.ToString("N2")</span>
                                        <span>Var: @FormatSignedCurrency(pm.Variance)</span>
                                    </div>
                                </div>
                            }
                        </div>

                        @if (selectedXReading.RecountHistory != null && selectedXReading.RecountHistory.Count > 0)
                        {
                            <div class="border-top mt-2 pt-2">
                                <div class="fw-bold">SUPERVISOR RECOUNT / CORRECTION AUDIT</div>
                                @if (selectedXReading.OriginalDeclaration != null)
                                {
                                    <div>Orig. Cash: ₱@selectedXReading.OriginalDeclaration.TotalCountedCash.ToString("N2") | Orig. Non-Cash: ₱@selectedXReading.OriginalDeclaration.TotalNonCashDeclared.ToString("N2")</div>
                                }
                                @foreach (var rec in selectedXReading.RecountHistory)
                                {
                                    <div class="mt-1">
                                        <div class="fw-bold">#@rec.RecountNumber by @rec.CorrectedBy (@rec.CorrectedAt.ToLocalTime().ToString("MM-dd HH:mm"))</div>
                                        <div>Cash: ₱@rec.OriginalCountedCash.ToString("N2") -> ₱@rec.RevisedCountedCash.ToString("N2")</div>
                                        <div>Reason: @rec.Reason</div>
                                    </div>
                                }
                            </div>
                        }

                        <div class="border-top border-bottom my-2 py-1 d-flex justify-content-between fw-bold">
                            <span>OVERALL STATUS:</span>
                            <span>@selectedXReading.OverallStatus</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(selectedXReading.Notes))
                        {
                            <div><strong>Remarks:</strong> @selectedXReading.Notes</div>
                        }
                    </div>
                </div>
                <div class="modal-footer border-secondary border-opacity-25">
                    <button type="button" class="btn btn-outline-light rounded-3" @onclick="() => selectedXReading = null">Close</button>
                    <button type="button" class="btn btn-primary rounded-3 fw-bold" @onclick="ReprintSavedXReadingAsync" disabled="@isPrintingXReading">
                        <i class="bi bi-printer-fill me-1"></i> @(isPrintingXReading ? "Printing..." : "Reprint X-Reading")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Supervisor Recount / Correction Modal -->
@if (showRecountModal && lastClosedShift != null && IsSupervisorUnlocked)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15, 23, 42, 0.82);">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 rounded-4 shadow-lg bg-dark text-light">
                <div class="modal-header border-secondary border-opacity-25">
                    <div>
                        <h5 class="modal-title fw-bold mb-0">
                            <i class="bi bi-shield-lock-fill text-warning me-2"></i>Supervisor Recount / Declaration Correction (Shift #@lastClosedShift.ShiftId)
                        </h5>
                        <small class="text-secondary">
                            Original cashier declaration is preserved in the immutable audit trail. Enter revised counts and a mandatory reason below.
                        </small>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showRecountModal = false"></button>
                </div>
                <div class="modal-body">
                    @if (lastClosedShift.OriginalDeclaration != null)
                    {
                        <div class="p-2 px-3 rounded-3 bg-secondary bg-opacity-25 border border-secondary mb-3 small d-flex flex-wrap justify-content-between gap-2">
                            <span><strong>Original Cashier Counted Cash:</strong> ₱@lastClosedShift.OriginalDeclaration.TotalCountedCash.ToString("N2")</span>
                            <span><strong>Original Non-Cash Declared:</strong> ₱@lastClosedShift.OriginalDeclaration.TotalNonCashDeclared.ToString("N2")</span>
                            <span><strong>Expected Cash:</strong> ₱@lastClosedShift.ExpectedBalance.ToString("N2")</span>
                        </div>
                    }

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <div class="pos-subpanel rounded-3 p-3 h-100">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-bold small text-warning text-uppercase">Revised Cash Denominations</span>
                                    <span class="fw-bold text-success font-monospace">₱@RecountTotalCash.ToString("N2")</span>
                                </div>
                                <div class="d-flex flex-column gap-1" style="max-height: 280px; overflow-y: auto;">
                                    @foreach (var row in recountDenominationRows)
                                    {
                                        <div class="d-flex align-items-center justify-content-between gap-2 py-1 px-2 rounded-2 pos-denom-row">
                                            <span class="small fw-semibold" style="min-width: 90px;">@row.Label</span>
                                            <input type="number" min="0" step="1" class="form-control form-control-sm text-center fw-bold pos-denom-input" style="max-width: 90px;"
                                                   @bind="row.Quantity" @bind:event="oninput" />
                                            <span class="small font-monospace text-info text-end" style="min-width: 78px;">₱@row.Subtotal.ToString("N2")</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="pos-subpanel rounded-3 p-3 h-100 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="fw-bold small text-info text-uppercase">Revised Non-Cash Declarations</span>
                                        <span class="fw-bold text-info font-monospace">₱@RecountNonCashDeclarations.Sum(x => x.DeclaredAmount).ToString("N2")</span>
                                    </div>
                                    @if (RecountNonCashDeclarations.Count == 0)
                                    {
                                        <div class="small text-secondary">No non-cash methods configured.</div>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-column gap-2">
                                            @foreach (var decl in RecountNonCashDeclarations)
                                            {
                                                <div>
                                                    <div class="d-flex justify-content-between small">
                                                        <span class="fw-semibold">@decl.PaymentMethodName</span>
                                                        <span class="text-secondary">Exp: ₱@decl.ExpectedAmount.ToString("N2")</span>
                                                    </div>
                                                    <div class="input-group input-group-sm mt-1">
                                                        <span class="input-group-text bg-dark text-light border-secondary">₱</span>
                                                        <input type="number" min="0" step="0.01" class="form-control fw-bold font-monospace"
                                                               @bind="decl.DeclaredAmount" @bind:event="oninput" />
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>

                                <div class="border-top border-secondary border-opacity-25 pt-2 mt-3 small">
                                    <div class="d-flex justify-content-between">
                                        <span class="text-secondary">Revised Cash Variance:</span>
                                        @{
                                            decimal revVar = Math.Round(RecountTotalCash - lastClosedShift.ExpectedBalance, 2, MidpointRounding.AwayFromZero);
                                        }
                                        <span class="fw-bold font-monospace @GetVarianceTextClass(revVar)">@FormatSignedCurrency(revVar)</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-8">
                            <label class="form-label fw-semibold small text-warning">Recount / Correction Reason (Required for Audit Log) *</label>
                            <input type="text" maxlength="255" class="form-control rounded-3" @bind="recountReason"
                                   placeholder="Explain physical recount or terminal slip correction..." />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold small">Supervisor PIN @(IsSupervisorRole(Session.Role) ? "(Optional)" : "*")</label>
                            <input type="password" maxlength="10" class="form-control rounded-3" @bind="recountSupervisorPin"
                                   placeholder="Supervisor PIN" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary border-opacity-25">
                    <button type="button" class="btn btn-outline-secondary rounded-3" @onclick="() => showRecountModal = false" disabled="@isSubmittingRecount">Cancel</button>
                    <button type="button" class="btn btn-warning fw-bold text-dark rounded-3 px-4" @onclick="SubmitRecountAsync" disabled="@isSubmittingRecount">
                        <i class="bi bi-check2-circle me-1"></i> @(isSubmittingRecount ? "Recording Recount..." : "Save Authorized Recount")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

