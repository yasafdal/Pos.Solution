    private async Task UnlockSupervisorReconciliationAsync()
    {
        if (isUnlockingSupervisor || lastClosedShift == null) return;
        string pin = (supervisorUnlockPin ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(pin))
        {
            ShowAlert("Enter a valid Supervisor or Manager PIN to unlock reconciliation.", isError: true);
            return;
        }

        isUnlockingSupervisor = true;
        try
        {
            var terminalId = Session.Terminal?.TerminalId ?? lastClosedShift.TerminalId;
            var state = await ConnectivityService.CheckConnectivityAsync();
            isOffline = state != TerminalConnectivityState.OnlineAndHealthy;

            if (isOffline)
            {
                string pinHash = Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(pin)));
                using var db = new LocalPosDbContext();
                db.InitializeDatabase();
                var sup = await db.Cashiers.AsNoTracking().FirstOrDefaultAsync(c => c.PinHash == pinHash);
                if (sup == null || !IsSupervisorRole(sup.Role))
                {
                    ShowAlert("Invalid Supervisor PIN or user does not have supervisor permissions.", isError: true);
                    return;
                }
            }

            var unlockedDto = await ShiftSession.LastClosedDtoAsync(Http, terminalId, isOffline, isSupervisor: true, supervisorPin: pin);
            if (unlockedDto == null || unlockedDto.IsBlindCloseRedacted)
            {
                ShowAlert("Invalid Supervisor PIN or unauthorized access.", isError: true);
                return;
            }

            lastClosedShift = unlockedDto;
            isSupervisorUnlockedByPin = true;
            unlockedSupervisorPin = pin;
            supervisorUnlockPin = string.Empty;
            ShowAlert($"Supervisor reconciliation unlocked for Shift #{unlockedDto.ShiftId}.", isError: false);
        }
        catch (Exception ex)
        {
            ShowAlert(ex.Message, isError: true);
        }
        finally
        {
            isUnlockingSupervisor = false;
        }
    }

