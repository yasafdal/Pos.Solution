        showConfirmModal = true;
    }

    private async Task ConfirmAndSubmitMovementAsync()
    {
        if (currentShift == null || isSubmittingMovement) return;
        isSubmittingMovement = true;

        try
        {
            var state = await ConnectivityService.CheckConnectivityAsync();
            isOffline = state != TerminalConnectivityState.OnlineAndHealthy;

            if (!isOffline)
            {
                var dto = new CashDrawerMovementDto
                {
                    ShiftId = currentShift.ShiftId,
                    BranchId = currentShift.BranchId,
                    TerminalId = currentShift.TerminalId,
                    MovementType = movementType,
                    CategoryId = selectedCategoryId > 0 ? selectedCategoryId : null,
                    CategoryName = SelectedCategory?.Name,
                    Amount = movementAmount,
                    Reason = movementReason.Trim(),
                    ClientMovementId = pendingClientMovementId,
                    SupervisorPin = string.IsNullOrWhiteSpace(supervisorPin) ? null : supervisorPin.Trim()
                };

                string endpoint = movementType == "CASH_IN" ? "api/cash-drawer/paid-in" : "api/cash-drawer/paid-out";
                var response = await Http.PostAsJsonAsync(endpoint, dto);
                if (response.IsSuccessStatusCode)
                {
                    var created = await response.Content.ReadFromJsonAsync<CashMovementResponseDto>();
                    showConfirmModal = false;
                    ResetMovementForm();
                    MarkCashMovementPostedDuringCounting();
                    await LoadShiftData();
                    if (created != null)
                    {
                        selectedVoucher = created;
                        ShowAlert($"Recorded {created.ReferenceNumber} ({created.Status}).", isError: false);
                    }
                }
                else
                {
                    var err = await response.Content.ReadAsStringAsync();
                    showConfirmModal = false;
                    ShowAlert(err, isError: true);
                }
            }
            else
            {
                await RecordOfflineMovementAsync();
            }
        }
        catch (Exception ex)
        {
            showConfirmModal = false;
            ShowAlert($"Error recording movement: {ex.Message}", isError: true);
        }
        finally
        {
            isSubmittingMovement = false;
        }
    }

    private async Task RecordOfflineMovementAsync()
    {
        if (currentShift == null) return;

        await LocalPosDbContext.WriteLock.WaitAsync();
        try
        {
            using var db = new LocalPosDbContext();
            db.InitializeDatabase();
            using var tx = await db.Database.BeginTransactionAsync();

            if (await db.CashDrawerMovements.AnyAsync(m => m.ClientMovementId == pendingClientMovementId))
            {
                showConfirmModal = false;
                ShowAlert("Duplicate movement submission prevented.", isError: false);
                return;
            }

            var localShift = await db.CashDrawerShifts.FirstOrDefaultAsync(s => s.ShiftId == currentShift.ShiftId && s.Status == "OPEN");
            if (localShift == null)
            {
                showConfirmModal = false;
                ShowAlert("No active open shift found in local database.", isError: true);
                return;
            }

            if (IsOutflow(movementType) && movementAmount > localShift.ExpectedBalance)
            {
                showConfirmModal = false;
                ShowAlert("Insufficient cash in drawer for the requested paid-out/drop amount.", isError: true);
                return;
            }

            string? verifiedApprover = null;
            string? verifiedPinHash = null;

            if (CurrentSelectionRequiresApproval)
            {
                if (!string.IsNullOrWhiteSpace(supervisorPin))
                {
                    string pinHash = Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(
                        System.Text.Encoding.UTF8.GetBytes(supervisorPin.Trim())));

                    var cachedSupervisor = await db.Cashiers
                        .AsNoTracking()
                        .FirstOrDefaultAsync(c => c.PinHash == pinHash);

                    if (cachedSupervisor == null || !IsSupervisorRole(cachedSupervisor.Role))
                    {
                        await tx.RollbackAsync();
                        showConfirmModal = false;
                        ShowAlert("Invalid offline supervisor PIN or cashier does not have supervisor privileges.", isError: true);
                        return;
                    }

                    verifiedApprover = cachedSupervisor.Username;
                    verifiedPinHash = pinHash;
                }
            }
            else
            {
                verifiedApprover = Session.Username ?? "offline_cashier";
            }

            string status = (CurrentSelectionRequiresApproval && verifiedApprover == null) ? "PENDING_APPROVAL" : "POSTED";
            var now = DateTime.UtcNow;

            string prefix = movementType switch
            {
                "PETTY_CASH" => "PCV",
                "CASH_OUT" => "COU",
                "CASH_IN" => "CIN",
                "CASH_DROP" => "CDP",
                _ => "CMV"
            };
            string refNumber = $"{prefix}-OFF-{now:yyMMdd}-{pendingClientMovementId[..4].ToUpperInvariant()}";

            var localMovement = new LocalCashDrawerMovement
            {
                ClientMovementId = pendingClientMovementId,
                ShiftId = localShift.ShiftId,
                BranchId = localShift.BranchId,
                TerminalId = localShift.TerminalId,
                MovementType = movementType,
                CategoryId = selectedCategoryId > 0 ? selectedCategoryId : null,
                CategoryName = SelectedCategory?.Name,
                Amount = movementAmount,
                Reason = movementReason.Trim(),
                ReferenceNumber = refNumber,
                Status = status,
                CreatedBy = Session.Username ?? localShift.CashierId,
                AuthorizedBy = verifiedApprover ?? (Session.Username ?? localShift.CashierId),
                ApprovedBy = verifiedApprover,
                SupervisorPinHash = verifiedPinHash,
                CreatedAt = now,
                ApprovedAt = verifiedApprover != null ? now : null,
                PostedAt = status == "POSTED" ? now : null,
                SyncStatus = "PENDING"
            };

            db.CashDrawerMovements.Add(localMovement);

            if (status == "POSTED")
            {
                if (movementType == "CASH_IN") localShift.TotalCashIn += movementAmount;
                else if (movementType is "CASH_OUT" or "PETTY_CASH") localShift.TotalCashOut += movementAmount;
                else if (movementType == "CASH_DROP") localShift.TotalCashDrops += movementAmount;

                localShift.ExpectedBalance = localShift.OpeningFloat
                    + localShift.TotalCashSales
                    - localShift.TotalCashRefunds
                    + localShift.TotalCashIn
                    - localShift.TotalCashOut
                    - localShift.TotalCashDrops;
            }

            db.SyncOutboxes.Add(new LocalSyncOutbox
            {
                EntityType = "CASH_MOVEMENT",
                EntityId = localMovement.ClientMovementId,
                PayloadJson = System.Text.Json.JsonSerializer.Serialize(localMovement),
                Status = "PENDING",
                RetryCount = 0,
                CreatedAt = now
            });

            await db.SaveChangesAsync();
            await tx.CommitAsync();

            showConfirmModal = false;
            ResetMovementForm();
            MarkCashMovementPostedDuringCounting();
            await LoadShiftData();

            selectedVoucher = currentShift?.Movements.FirstOrDefault(m => m.ClientMovementId == localMovement.ClientMovementId);
            ShowAlert($"Saved offline voucher {refNumber} ({status}). Will synchronize automatically on reconnection.", isError: false);
        }
        finally
        {
            LocalPosDbContext.WriteLock.Release();
        }
    }

    private static bool IsSupervisorRole(string? role)
    {
        if (string.IsNullOrWhiteSpace(role)) return false;
        var r = role.Trim();
        return r.Equals("Admin", StringComparison.OrdinalIgnoreCase) ||
               r.Equals("Manager", StringComparison.OrdinalIgnoreCase) ||
               r.Equals("Senior Cashier", StringComparison.OrdinalIgnoreCase) ||
               r.Equals("SeniorCashier", StringComparison.OrdinalIgnoreCase);
    }

    private void ResetMovementForm()
    {
        movementAmount = 0.00m;
        movementReason = string.Empty;
        supervisorPin = string.Empty;
        pendingClientMovementId = Guid.NewGuid().ToString("N");
    }

    private void OpenVoucherPreview(CashMovementResponseDto m)
    {
        selectedVoucher = m;
    }

    private async Task PrintVoucherAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("window.print");
        }
        catch { }
    }

    private void OpenSupervisorActionModal(CashMovementResponseDto m, string actionType)
    {
        actionModalMovement = m;
        actionModalType = actionType;
        actionModalReason = string.Empty;
        actionModalSupervisorPin = string.Empty;
    }

    private void CloseSupervisorActionModal()
    {
        actionModalMovement = null;
        actionModalReason = string.Empty;
        actionModalSupervisorPin = string.Empty;
    }

    private async Task ExecuteSupervisorActionAsync()
    {
        if (actionModalMovement == null || isSubmittingAction) return;

        if (actionModalType is "REJECT" or "REVERSE" && string.IsNullOrWhiteSpace(actionModalReason))
        {
            ShowAlert("Reason is required for rejection or reversal.", isError: true);
            return;
        }

        isSubmittingAction = true;
        try
        {
            HttpResponseMessage response;
            if (actionModalType == "APPROVE")
            {
                response = await Http.PostAsJsonAsync($"api/cash-drawer/movements/{actionModalMovement.MovementId}/approve", new CashMovementApproveRejectDto
                {
                    SupervisorPin = actionModalSupervisorPin
                });
            }
            else if (actionModalType == "REJECT")
            {
                response = await Http.PostAsJsonAsync($"api/cash-drawer/movements/{actionModalMovement.MovementId}/reject", new CashMovementApproveRejectDto
                {
                    SupervisorPin = actionModalSupervisorPin,
                    Reason = actionModalReason
                });
            }
            else
            {
                response = await Http.PostAsJsonAsync($"api/cash-drawer/movements/{actionModalMovement.MovementId}/reverse", new CashMovementReverseDto
                {
                    SupervisorPin = actionModalSupervisorPin,
                    Reason = actionModalReason
                });
            }

            if (response.IsSuccessStatusCode)
            {
                if (actionModalType is "APPROVE" or "REVERSE")
                {
                    MarkCashMovementPostedDuringCounting();
                }
                ShowAlert($"Movement {actionModalMovement.ReferenceNumber} {actionModalType.ToLowerInvariant()}d successfully.", isError: false);
                CloseSupervisorActionModal();
                await LoadShiftData();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                ShowAlert(err, isError: true);
            }
        }
        catch (Exception ex)
        {
            ShowAlert(ex.Message, isError: true);
        }
        finally
        {
            isSubmittingAction = false;
        }
    }

    private void ShowAlert(string message, bool isError)
    {
        statusAlertMessage = message;
        statusAlertIsError = isError;
    }
}
