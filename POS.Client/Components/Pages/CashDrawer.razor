@code {
    private static readonly string[] TabOrder =
    [
        "CASH_COUNT",
        "OTHER_PAYMENTS",
        "REVIEW_CLOSE",
        "CASH_MOVEMENTS",
        "MOVEMENT_HISTORY"
    ];

    private sealed class DenominationRowState
    {
        public string Type { get; init; } = "BILL";
        public decimal Denomination { get; init; }
        public string Label { get; init; } = string.Empty;
        public int Quantity { get; set; }
        public string RawQuantity { get; set; } = "0";
        public bool HasError { get; set; }
        public decimal Subtotal => Math.Round(Denomination * Quantity, 2, MidpointRounding.AwayFromZero);
    }

    private sealed class NonCashDeclarationRowState
    {
        public string PaymentMethodCode { get; init; } = string.Empty;
        public string PaymentMethodName { get; init; } = string.Empty;
        public bool IsActive { get; init; } = true;
        public int DisplayOrder { get; init; }
        public decimal ExpectedAmount { get; set; }
        public decimal DeclaredAmount { get; set; }
        public string RawAmount { get; set; } = "0.00";
        public bool HasError { get; set; }
        public decimal Variance => Math.Round(DeclaredAmount - ExpectedAmount, 2, MidpointRounding.AwayFromZero);
    }

    private string activeTab = "CASH_COUNT";
    private bool hasStartedCounting = false;
    private bool requiresRecountConfirmationAfterMovement = false;

    private bool isLoading = true;
    private bool isOffline = false;
    private bool isSubmittingShift = false;
    private bool isSubmittingMovement = false;
    private bool isPrintingXReading = false;
    private bool isPrintingDeclaration = false;
    private bool isReviewingClose = false;
    private bool isDeclarationConfirmed = false;
    private bool showConfirmModal = false;

    private bool isSupervisorUnlockedByPin = false;
    private bool isUnlockingSupervisor = false;
    private string supervisorUnlockPin = string.Empty;
    private string? unlockedSupervisorPin;

    private bool showRecountModal = false;
    private bool isSubmittingRecount = false;
    private string recountReason = string.Empty;
    private string recountSupervisorPin = string.Empty;
    private List<DenominationRowState> recountDenominationRows = new();
    private List<NonCashDeclarationRowState> RecountNonCashDeclarations = new();

    private string? statusAlertMessage;
    private bool statusAlertIsError;
    private string? printWarningMessage;
    private string? denominationValidationError;
    private string? declarationValidationError;

    private CashDrawerShiftDto? currentShift;
    private CashDrawerShiftDto? lastClosedShift;
    private CashierDeclarationReportDto? selectedDeclaration;
    private XReadingReportDto? selectedXReading;
    private List<CashMovementCategoryDto> categories = new();

    private decimal? openFloatInput = 1000.00m;
    private string shiftNotes = string.Empty;
    private string pendingOpenShiftId = Guid.NewGuid().ToString("N");
    private string pendingClientCloseId = Guid.NewGuid().ToString("N");

    private List<DenominationRowState> denominationRows = new();
    private List<NonCashDeclarationRowState> nonCashDeclarations = new();
    private string closingNotes = string.Empty;

    private string movementType = "PETTY_CASH";
    private int selectedCategoryId = 0;
    private decimal movementAmount = 0.00m;
    private string movementReason = string.Empty;
    private string supervisorPin = string.Empty;
    private string pendingClientMovementId = Guid.NewGuid().ToString("N");
    private string historyFilterStatus = string.Empty;

    private CashMovementResponseDto? selectedVoucher;
    private CashMovementResponseDto? actionModalMovement;
    private string actionModalType = "APPROVE";
    private string actionModalReason = string.Empty;
    private string actionModalSupervisorPin = string.Empty;
    private bool isSubmittingAction = false;

    private bool IsSupervisorUnlocked => IsSupervisorRole(Session.Role) || isSupervisorUnlockedByPin;

    private decimal CoinsSubtotal => denominationRows.Where(r => r.Type == "COIN").Sum(r => r.Subtotal);
    private decimal BillsSubtotal => denominationRows.Where(r => r.Type == "BILL").Sum(r => r.Subtotal);
    private decimal TotalCountedCash => Math.Round(CoinsSubtotal + BillsSubtotal, 2, MidpointRounding.AwayFromZero);
    private decimal DeclaredNonCashTotal => Math.Round(nonCashDeclarations.Sum(d => d.DeclaredAmount), 2, MidpointRounding.AwayFromZero);
    private decimal RecountTotalCash => Math.Round(recountDenominationRows.Sum(r => r.Subtotal), 2, MidpointRounding.AwayFromZero);

    private IEnumerable<CashMovementCategoryDto> FilteredCategories =>
        categories.Where(c => c.IsActive && string.Equals(c.MovementType, movementType, StringComparison.OrdinalIgnoreCase));

    private CashMovementCategoryDto? SelectedCategory =>
        categories.FirstOrDefault(c => c.CategoryId == selectedCategoryId);

    private bool CurrentSelectionRequiresApproval
    {
        get
        {
            if (SelectedCategory != null)
            {
                return SelectedCategory.RequiresApproval ||
                       (SelectedCategory.ApprovalThreshold > 0m && movementAmount >= SelectedCategory.ApprovalThreshold);
            }
            return IsOutflow(movementType);
        }
    }

    private IEnumerable<CashMovementResponseDto> FilteredMovements =>
        (currentShift?.Movements ?? Enumerable.Empty<CashMovementResponseDto>())
            .Where(m => string.IsNullOrWhiteSpace(historyFilterStatus) || string.Equals(m.Status, historyFilterStatus, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }
        InitializeDenominationRows();
        await LoadShiftData();
    }

    private void InitializeDenominationRows()
    {
        denominationRows = CashDenominationCatalog.CreateDefaultLines()
            .Select(d => new DenominationRowState
            {
                Type = d.Type,
                Denomination = d.Denomination,
                Label = d.Label,
                Quantity = 0,
                RawQuantity = "0",
                HasError = false
            })
            .ToList();
        denominationValidationError = null;
    }

    private void ResetDenominationCounts()
    {
        foreach (var row in denominationRows)
        {
            row.Quantity = 0;
            row.RawQuantity = "0";
            row.HasError = false;
        }
        denominationValidationError = null;
        isDeclarationConfirmed = false;
    }

    private void OnDenominationInputChanged(DenominationRowState row, string? rawValue)
    {
        string trimmed = (rawValue ?? string.Empty).Trim();
        row.RawQuantity = trimmed;

        if (string.IsNullOrEmpty(trimmed))
        {
            row.Quantity = 0;
            row.HasError = false;
        }
        else if (int.TryParse(trimmed, NumberStyles.None, CultureInfo.InvariantCulture, out int parsed) && parsed >= 0 && parsed <= 1_000_000)
        {
            row.Quantity = parsed;
            row.HasError = false;
        }
        else
        {
            row.HasError = true;
        }

        hasStartedCounting = true;
        isDeclarationConfirmed = false;
        denominationValidationError = denominationRows.Any(r => r.HasError)
            ? "All denomination quantities must be non-negative whole numbers (0 or greater)."
            : null;
    }

    private void StepDenominationQuantity(DenominationRowState row, int delta)
    {
        int next = Math.Max(0, row.Quantity + delta);
        row.Quantity = next;
        row.RawQuantity = next.ToString(CultureInfo.InvariantCulture);
        row.HasError = false;
        hasStartedCounting = true;
        isDeclarationConfirmed = false;
        denominationValidationError = denominationRows.Any(r => r.HasError)
            ? "All denomination quantities must be non-negative whole numbers (0 or greater)."
            : null;
    }

    private void OnDeclarationInputChanged(NonCashDeclarationRowState decl, string? rawValue)
    {
        string trimmed = (rawValue ?? string.Empty).Trim();
        decl.RawAmount = trimmed;

        if (string.IsNullOrEmpty(trimmed))
        {
            decl.DeclaredAmount = 0m;
            decl.HasError = false;
        }
        else if (TryParseCashAmount(trimmed, out decimal parsed))
        {
            decl.DeclaredAmount = parsed;
            decl.HasError = false;
        }
        else
        {
            decl.HasError = true;
        }

        isDeclarationConfirmed = false;
        declarationValidationError = nonCashDeclarations.Any(d => d.HasError)
            ? "All cashier-declared payment totals must be non-negative amounts with at most 2 decimal places."
            : null;
    }

    private static bool TryParseCashAmount(string? text, out decimal amount)
    {
        amount = 0m;
        if (string.IsNullOrWhiteSpace(text)) return false;
        var point = text.IndexOf('.');
        if (point >= 0 && text.Length - point - 1 > 2) return false;
        return decimal.TryParse(text, NumberStyles.AllowDecimalPoint,
            CultureInfo.InvariantCulture, out amount)
            && amount >= 0m && amount <= 9999999999999999.99m;
    }

    private void SyncNonCashDeclarationRows(CashDrawerShiftDto shiftDto)
    {
        var existingByCode = nonCashDeclarations.ToDictionary(d => d.PaymentMethodCode, StringComparer.OrdinalIgnoreCase);
        var nextList = new List<NonCashDeclarationRowState>();

        var configuredMethods = shiftDto.ConfiguredNonCashMethods.Count > 0
            ? shiftDto.ConfiguredNonCashMethods
            : shiftDto.PaymentReconciliations.Where(r => !r.IsCash).Select(r => new PaymentMethodDeclarationDto
            {
                PaymentMethodCode = r.PaymentMethodCode,
                PaymentMethodName = r.PaymentMethodName,
                IsActive = r.IsActive,
                DisplayOrder = r.DisplayOrder,
                DeclaredAmount = r.DeclaredAmount
            }).ToList();

        foreach (var method in configuredMethods)
        {
            if (existingByCode.TryGetValue(method.PaymentMethodCode, out var existing))
            {
                nextList.Add(existing);
            }
            else
            {
                nextList.Add(new NonCashDeclarationRowState
                {
                    PaymentMethodCode = method.PaymentMethodCode,
                    PaymentMethodName = method.PaymentMethodName,
                    IsActive = method.IsActive,
                    DisplayOrder = method.DisplayOrder,
                    ExpectedAmount = 0m,
                    DeclaredAmount = 0m,
                    RawAmount = "0.00",
                    HasError = false
                });
            }
        }

        nonCashDeclarations = nextList;
    }

    private void SelectTab(string targetTab)
    {
        if (currentShift == null) return;

        if (targetTab == "REVIEW_CLOSE")
        {
            GoToReviewCloseTab();
            return;
        }

        if (targetTab == "OTHER_PAYMENTS")
        {
            hasStartedCounting = true;
        }

        activeTab = targetTab;
    }

    private void GoToOtherPaymentsTab()
    {
        if (currentShift == null) return;
        if (!ValidateCashCountInputs())
        {
            activeTab = "CASH_COUNT";
            return;
        }

        hasStartedCounting = true;
        statusAlertMessage = null;
        activeTab = "OTHER_PAYMENTS";
    }

    private void GoToReviewCloseTab()
    {
        if (currentShift == null) return;
        if (!ValidateCashCountInputs())
        {
            activeTab = "CASH_COUNT";
            return;
        }
        if (!ValidateOtherPaymentInputs())
        {
            activeTab = "OTHER_PAYMENTS";
            return;
        }

        hasStartedCounting = true;
        isReviewingClose = true;
        statusAlertMessage = null;
        activeTab = "REVIEW_CLOSE";
    }

    private void EditCashCountFromReview()
    {
        isReviewingClose = false;
        isDeclarationConfirmed = false;
        activeTab = "CASH_COUNT";
    }

    private void EditOtherPaymentsFromReview()
    {
        isReviewingClose = false;
        isDeclarationConfirmed = false;
        activeTab = "OTHER_PAYMENTS";
    }

    private void ConfirmPhysicalCountAfterMovement()
    {
        if (!ValidateCashCountInputs()) return;
        requiresRecountConfirmationAfterMovement = false;
        isDeclarationConfirmed = false;
        ShowAlert($"Physical drawer cash count (₱{TotalCountedCash:N2}) reconfirmed after cash movement.", isError: false);
    }

    private void MarkCashMovementPostedDuringCounting()
    {
        isDeclarationConfirmed = false;
        if (hasStartedCounting || denominationRows.Any(r => r.Quantity > 0))
        {
            requiresRecountConfirmationAfterMovement = true;
        }
    }

    private void OnTabBarKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        int currentIndex = Array.IndexOf(TabOrder, activeTab);
        if (currentIndex < 0) currentIndex = 0;

        if (e.Key == "ArrowRight")
        {
            int nextIndex = (currentIndex + 1) % TabOrder.Length;
            SelectTab(TabOrder[nextIndex]);
        }
        else if (e.Key == "ArrowLeft")
        {
            int prevIndex = (currentIndex - 1 + TabOrder.Length) % TabOrder.Length;
            SelectTab(TabOrder[prevIndex]);
        }
        else if (e.Key == "Home")
        {
            SelectTab(TabOrder[0]);
        }
        else if (e.Key == "End")
        {
            SelectTab(TabOrder[^1]);
        }
    }

    private bool ValidateCashCountInputs()
    {
        foreach (var row in denominationRows)
        {
            if (string.IsNullOrWhiteSpace(row.RawQuantity))
            {
                row.RawQuantity = "0";
                row.Quantity = 0;
                row.HasError = false;
            }
            else if (!int.TryParse(row.RawQuantity, NumberStyles.None, CultureInfo.InvariantCulture, out int q) || q < 0 || q > 1_000_000)
            {
                row.HasError = true;
            }
            else
            {
                row.Quantity = q;
                row.HasError = false;
            }
        }

        if (denominationRows.Any(r => r.HasError))
        {
            denominationValidationError = "All denomination quantities must be non-negative whole numbers.";
            ShowAlert(denominationValidationError, isError: true);
            return false;
        }

        denominationValidationError = null;
        return true;
    }

    private bool ValidateOtherPaymentInputs()
    {
        foreach (var decl in nonCashDeclarations)
        {
            if (string.IsNullOrWhiteSpace(decl.RawAmount))
            {
                decl.RawAmount = "0.00";
                decl.DeclaredAmount = 0m;
                decl.HasError = false;
            }
            else if (!TryParseCashAmount(decl.RawAmount, out decimal amt))
            {
                decl.HasError = true;
            }
            else
            {
                decl.DeclaredAmount = amt;
                decl.HasError = false;
            }
        }

        if (nonCashDeclarations.Any(d => d.HasError))
        {
            declarationValidationError = "All cashier-declared payment totals must be non-negative amounts with up to two decimal places.";
            ShowAlert(declarationValidationError, isError: true);
            return false;
        }

        declarationValidationError = null;
        return true;
    }

    private bool ValidateClosingInputs()
    {
        if (!ValidateCashCountInputs())
        {
            activeTab = "CASH_COUNT";
            return false;
        }
        if (!ValidateOtherPaymentInputs())
        {
            activeTab = "OTHER_PAYMENTS";
            return false;
        }
        return true;
    }

    private async Task CloseShift()
    {
        if (currentShift == null || isSubmittingShift) return;
        if (!ValidateClosingInputs()) return;
        if (requiresRecountConfirmationAfterMovement)
        {
            activeTab = "CASH_COUNT";
            ShowAlert("A cash movement was recorded after counting. Please verify and reconfirm your physical drawer cash count before closing.", isError: true);
            return;
        }
        if (!isDeclarationConfirmed)
        {
            ShowAlert("Please explicitly confirm your blind closing declaration before submitting.", isError: true);
            return;
        }

        isSubmittingShift = true;
        printWarningMessage = null;
        try
        {
            var state = await ConnectivityService.CheckConnectivityAsync();
            isOffline = state != TerminalConnectivityState.OnlineAndHealthy;

            var closeDto = new CloseShiftDto
            {
                ShiftId = currentShift.ShiftId,
                ClientShiftId = currentShift.ClientShiftId,
                ClientCloseId = pendingClientCloseId,
                BranchId = currentShift.BranchId,
                TerminalId = currentShift.TerminalId,
                CashierId = Session.Username ?? currentShift.CashierId,
                ClosedAt = DateTime.UtcNow,
                ActualCountedBalance = TotalCountedCash,
                IsDeclarationConfirmed = isDeclarationConfirmed,
                Denominations = denominationRows.Select(r => new CashDenominationLineDto
                {
                    Type = r.Type,
                    Denomination = r.Denomination,
                    Quantity = r.Quantity,
                    Subtotal = r.Subtotal
                }).ToList(),
                PaymentDeclarations = nonCashDeclarations.Select(d => new PaymentMethodDeclarationDto
                {
                    PaymentMethodCode = d.PaymentMethodCode,
                    PaymentMethodName = d.PaymentMethodName,
                    DeclaredAmount = d.DeclaredAmount
                }).ToList(),
                Notes = string.IsNullOrWhiteSpace(closingNotes) ? null : closingNotes.Trim()
            };

            var closedShift = await ShiftSession.CloseAsync(Http, closeDto, Session.Username ?? currentShift.CashierId, isOffline);

            lastClosedShift = closedShift;
            currentShift = null;
            activeTab = "CASH_COUNT";
            hasStartedCounting = false;
            requiresRecountConfirmationAfterMovement = false;
            isReviewingClose = false;
            isDeclarationConfirmed = false;
            closingNotes = string.Empty;
            pendingClientCloseId = Guid.NewGuid().ToString("N");
            ResetDenominationCounts();
            nonCashDeclarations.Clear();

            if (IsSupervisorUnlocked)
            {
                var terminalId = Session.Terminal?.TerminalId ?? closedShift.TerminalId;
                var fullShift = await ShiftSession.LastClosedDtoAsync(Http, terminalId, isOffline, isSupervisor: true, supervisorPin: unlockedSupervisorPin);
                if (fullShift != null)
                {
                    lastClosedShift = fullShift;
                }
            }

            ShowAlert($"Shift #{closedShift.ShiftId} declaration submitted and shift closed.", isError: false);

            var declarationToPrint = lastClosedShift?.CashierDeclaration ?? closedShift.CashierDeclaration;
            if (declarationToPrint != null)
            {
                selectedDeclaration = declarationToPrint;
                try
                {
                    isPrintingDeclaration = true;
                    await ReceiptPrinter.PrintCashierDeclarationAsync(declarationToPrint, Session.Terminal?.ReceiptPrinterName);
                }
                catch (Exception printEx)
                {
                    printWarningMessage = $"Shift #{closedShift.ShiftId} is closed and saved, but automatic Cashier Declaration Acknowledgment printing failed ({printEx.Message}). You can reprint from the saved closing record at any time without creating another declaration.";
                }
                finally
                {
                    isPrintingDeclaration = false;
                }
            }
        }
        catch (Exception ex)
        {
            ShowAlert(ex.Message, isError: true);
        }
        finally
        {
            isSubmittingShift = false;
        }
    }

