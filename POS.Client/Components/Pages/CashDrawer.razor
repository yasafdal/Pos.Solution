@code {
    private bool isLoading = true;
    private bool isOffline = false;
    private bool isSubmittingShift = false;
    private bool isSubmittingMovement = false;
    private bool showConfirmModal = false;

    private string? statusAlertMessage;
    private bool statusAlertIsError;

    private CashDrawerShiftDto? currentShift;
    private List<CashMovementCategoryDto> categories = new();

    private decimal openingFloat = 1000.00m;
    private string shiftNotes = string.Empty;

    private string movementType = "PETTY_CASH";
    private int selectedCategoryId = 0;
    private decimal movementAmount = 0.00m;
    private string movementReason = string.Empty;
    private string supervisorPin = string.Empty;
    private string pendingClientMovementId = Guid.NewGuid().ToString("N");

    private decimal actualCounted = 0.00m;
    private string closingNotes = string.Empty;
    private string historyFilterStatus = string.Empty;

    private CashMovementResponseDto? selectedVoucher;
    private CashMovementResponseDto? actionModalMovement;
    private string actionModalType = "APPROVE";
    private string actionModalReason = string.Empty;
    private string actionModalSupervisorPin = string.Empty;
    private bool isSubmittingAction = false;

    private IEnumerable<CashMovementCategoryDto> FilteredCategories =>
        categories.Where(c => c.IsActive && string.Equals(c.MovementType, movementType, StringComparison.OrdinalIgnoreCase));

    private CashMovementCategoryDto? SelectedCategory =>
        categories.FirstOrDefault(c => c.CategoryId == selectedCategoryId);

    private bool CurrentSelectionRequiresApproval
    {
        get
        {
            if (SelectedCategory != null)
            {
                return SelectedCategory.RequiresApproval ||
                       (SelectedCategory.ApprovalThreshold > 0m && movementAmount >= SelectedCategory.ApprovalThreshold);
            }
            return IsOutflow(movementType);
        }
    }

    private IEnumerable<CashMovementResponseDto> FilteredMovements =>
        (currentShift?.Movements ?? Enumerable.Empty<CashMovementResponseDto>())
            .Where(m => string.IsNullOrWhiteSpace(historyFilterStatus) || string.Equals(m.Status, historyFilterStatus, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }
        await LoadShiftData();
    }

    private void SelectMovementType(string type)
    {
        movementType = type;
        var firstCat = FilteredCategories.FirstOrDefault();
        selectedCategoryId = firstCat?.CategoryId ?? 0;
    }

    private static bool IsOutflow(string type) =>
        type is "PETTY_CASH" or "CASH_OUT" or "CASH_DROP";

    private static string FormatMovementTypeLabel(string type) =>
        (type ?? string.Empty).ToUpperInvariant() switch
        {
            "PETTY_CASH" => "Petty Cash Out",
            "CASH_OUT" => "Cash Paid-Out",
            "CASH_IN" => "Cash Paid-In",
            "CASH_DROP" => "Safe Cash Drop",
            "REVERSAL" => "Reversal",
            _ => type ?? "Movement"
        };

    private static string GetMovementTypeBadgeClass(string type) =>
        (type ?? string.Empty).ToUpperInvariant() switch
        {
            "PETTY_CASH" => "bg-danger-subtle text-danger border border-danger-subtle",
            "CASH_OUT" => "bg-warning-subtle text-dark border border-warning-subtle",
            "CASH_IN" => "bg-success-subtle text-success border border-success-subtle",
            "CASH_DROP" => "bg-secondary-subtle text-secondary border border-secondary-subtle",
            "REVERSAL" => "bg-dark text-white",
            _ => "bg-light text-dark"
        };

    private static string GetStatusBadgeClass(string status) =>
        (status ?? string.Empty).ToUpperInvariant() switch
        {
            "POSTED" => "bg-success",
            "PENDING_APPROVAL" => "bg-warning text-dark",
            "REJECTED" => "bg-danger",
            "REVERSED" => "bg-secondary",
            _ => "bg-primary"
        };

    private async Task TriggerSyncAndReloadAsync()
    {
        try
        {
            await SyncManager.TriggerManualSyncAsync();
        }
        catch { }
        await LoadShiftData();
    }

    private async Task LoadShiftData()
    {
        isLoading = true;
        try
        {
            var outletId = Session.Outlet?.OutletId ?? 1;
            var state = await ConnectivityService.CheckConnectivityAsync();
            isOffline = state != TerminalConnectivityState.OnlineAndHealthy;

            if (!isOffline)
            {
                try
                {
                    var onlineCats = await Http.GetFromJsonAsync<List<CashMovementCategoryDto>>("api/cash-drawer/categories");
                    if (onlineCats != null && onlineCats.Count > 0)
                    {
                        categories = onlineCats;
                        await CacheCategoriesLocallyAsync(onlineCats);
                    }
                }
                catch { }

                try
                {
                    var shiftResp = await Http.GetAsync($"api/cash-drawer/current?outletId={outletId}");
                    if (shiftResp.IsSuccessStatusCode)
                    {
                        currentShift = await shiftResp.Content.ReadFromJsonAsync<CashDrawerShiftDto>();
                        if (currentShift != null)
                        {
                            await CacheShiftLocallyAsync(currentShift);
                            actualCounted = currentShift.ExpectedBalance;
                        }
                    }
                    else
                    {
                        currentShift = null;
                    }
                }
                catch
                {
                    isOffline = true;
                }
            }

            if (isOffline || categories.Count == 0)
            {
                await LoadOfflineShiftAndCategoriesAsync(outletId);
            }

            if (selectedCategoryId == 0 && FilteredCategories.Any())
            {
                selectedCategoryId = FilteredCategories.First().CategoryId;
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CacheCategoriesLocallyAsync(List<CashMovementCategoryDto> onlineCats)
    {
        await LocalPosDbContext.WriteLock.WaitAsync();
        try
        {
            using var db = new LocalPosDbContext();
            db.InitializeDatabase();
            await db.Database.ExecuteSqlRawAsync("DELETE FROM LocalCashMovementCategories;");
            db.ChangeTracker.Clear();
            foreach (var c in onlineCats)
            {
                db.CashMovementCategories.Add(new LocalCashMovementCategory
                {
                    CategoryId = c.CategoryId,
                    Name = c.Name,
                    Description = c.Description,
                    MovementType = c.MovementType,
                    RequiresApproval = c.RequiresApproval,
                    ApprovalThreshold = c.ApprovalThreshold,
                    IsActive = c.IsActive
                });
            }
            await db.SaveChangesAsync();
        }
        catch { }
        finally
        {
            LocalPosDbContext.WriteLock.Release();
        }
    }

    private async Task CacheShiftLocallyAsync(CashDrawerShiftDto shiftDto)
    {
        await LocalPosDbContext.WriteLock.WaitAsync();
        try
        {
            using var db = new LocalPosDbContext();
            db.InitializeDatabase();
            var localShift = await db.CashDrawerShifts.FirstOrDefaultAsync(s => s.ShiftId == shiftDto.ShiftId);
            if (localShift == null)
            {
                db.CashDrawerShifts.Add(new LocalCashDrawerShift
                {
                    ShiftId = shiftDto.ShiftId,
                    BranchId = shiftDto.BranchId,
                    OutletId = shiftDto.OutletId,
                    CashierId = shiftDto.CashierId,
                    OpeningFloat = shiftDto.OpeningFloat,
                    TotalCashSales = shiftDto.TotalCashSales,
                    TotalCashRefunds = shiftDto.TotalCashRefunds,
                    TotalCashIn = shiftDto.TotalCashIn,
                    TotalCashOut = shiftDto.TotalCashOut,
                    TotalCashDrops = shiftDto.TotalCashDrops,
                    ExpectedBalance = shiftDto.ExpectedBalance,
                    Status = shiftDto.Status,
                    OpenedAt = shiftDto.OpenedAt
                });
            }
            else
            {
                localShift.OpeningFloat = shiftDto.OpeningFloat;
                localShift.TotalCashSales = shiftDto.TotalCashSales;
                localShift.TotalCashRefunds = shiftDto.TotalCashRefunds;
                localShift.TotalCashIn = shiftDto.TotalCashIn;
                localShift.TotalCashOut = shiftDto.TotalCashOut;
                localShift.TotalCashDrops = shiftDto.TotalCashDrops;
                localShift.ExpectedBalance = shiftDto.ExpectedBalance;
                localShift.Status = shiftDto.Status;
            }
            await db.SaveChangesAsync();
        }
        catch { }
        finally
        {
            LocalPosDbContext.WriteLock.Release();
        }
    }

    private async Task LoadOfflineShiftAndCategoriesAsync(int outletId)
    {
        using var db = new LocalPosDbContext();
        db.InitializeDatabase();

        var localCats = await db.CashMovementCategories.AsNoTracking().Where(c => c.IsActive).ToListAsync();
        if (localCats.Count > 0)
        {
            categories = localCats.Select(c => new CashMovementCategoryDto
            {
                CategoryId = c.CategoryId,
                Name = c.Name,
                Description = c.Description,
                MovementType = c.MovementType,
                RequiresApproval = c.RequiresApproval,
                ApprovalThreshold = c.ApprovalThreshold,
                IsActive = c.IsActive
            }).ToList();
        }

        if (!isOffline) return;

        var localShift = await db.CashDrawerShifts
            .AsNoTracking()
            .Where(s => s.OutletId == outletId && s.Status == "OPEN")
            .OrderByDescending(s => s.OpenedAt)
            .FirstOrDefaultAsync();

        if (localShift == null)
        {
            currentShift = null;
            return;
        }

        var localMovements = await db.CashDrawerMovements
            .AsNoTracking()
            .Where(m => m.ShiftId == localShift.ShiftId)
            .OrderByDescending(m => m.CreatedAt)
            .ToListAsync();

        decimal pettyCash = localMovements
            .Where(m => m.Status == "POSTED" && m.MovementType == "PETTY_CASH")
            .Sum(m => m.Amount);

        currentShift = new CashDrawerShiftDto
        {
            ShiftId = localShift.ShiftId,
            BranchId = localShift.BranchId,
            OutletId = localShift.OutletId,
            CashierId = localShift.CashierId,
            OpeningFloat = localShift.OpeningFloat,
            TotalCashSales = localShift.TotalCashSales,
            TotalCashRefunds = localShift.TotalCashRefunds,
            TotalCashIn = localShift.TotalCashIn,
            TotalCashOut = localShift.TotalCashOut,
            TotalCashDrops = localShift.TotalCashDrops,
            TotalPettyCashOut = pettyCash,
            ExpectedBalance = localShift.ExpectedBalance,
            Status = localShift.Status,
            OpenedAt = localShift.OpenedAt,
            PendingApprovalsCount = localMovements.Count(m => m.Status == "PENDING_APPROVAL"),
            Movements = localMovements.Select(m => new CashMovementResponseDto
            {
                MovementId = m.MovementId,
                ShiftId = m.ShiftId,
                BranchId = m.BranchId,
                OutletId = m.OutletId,
                MovementType = m.MovementType,
                CategoryId = m.CategoryId,
                CategoryName = m.CategoryName,
                Amount = m.Amount,
                Reason = m.Reason,
                ReferenceNumber = m.ReferenceNumber,
                ClientMovementId = m.ClientMovementId,
                Status = m.Status,
                CreatedBy = m.CreatedBy,
                AuthorizedBy = m.AuthorizedBy,
                ApprovedBy = m.ApprovedBy,
                CreatedAt = m.CreatedAt,
                ApprovedAt = m.ApprovedAt,
                PostedAt = m.PostedAt,
                SyncStatus = m.SyncStatus
            }).ToList()
        };
        actualCounted = currentShift.ExpectedBalance;
    }

    private async Task OpenShift()
    {
        if (isSubmittingShift) return;
        if (openingFloat < 0)
        {
            ShowAlert("Opening float cannot be negative.", isError: true);
            return;
        }

        isSubmittingShift = true;
        try
        {
            var branchId = Session.Outlet?.BranchId ?? 1;
            var outletId = Session.Outlet?.OutletId ?? 1;
            var state = await ConnectivityService.CheckConnectivityAsync();
            isOffline = state != TerminalConnectivityState.OnlineAndHealthy;

            if (!isOffline)
            {
                var dto = new OpenShiftDto
                {
                    BranchId = branchId,
                    OutletId = outletId,
                    OpeningFloat = openingFloat,
                    Notes = shiftNotes
                };

                var response = await Http.PostAsJsonAsync("api/cash-drawer/open-shift", dto);
                if (response.IsSuccessStatusCode)
                {
                    ShowAlert("Cash drawer shift opened successfully!", isError: false);
                    await LoadShiftData();
                }
                else
                {
                    var err = await response.Content.ReadAsStringAsync();
                    ShowAlert(err, isError: true);
                }
            }
            else
            {
                await LocalPosDbContext.WriteLock.WaitAsync();
                try
                {
                    using var db = new LocalPosDbContext();
                    db.InitializeDatabase();
                    var existing = await db.CashDrawerShifts.FirstOrDefaultAsync(s => s.OutletId == outletId && s.Status == "OPEN");
                    if (existing != null)
                    {
                        ShowAlert("An open shift already exists locally for this outlet.", isError: true);
                        return;
                    }

                    long localShiftId = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
                    db.CashDrawerShifts.Add(new LocalCashDrawerShift
                    {
                        ShiftId = localShiftId,
                        BranchId = branchId,
                        OutletId = outletId,
                        CashierId = Session.Username ?? "offline_cashier",
                        OpeningFloat = Math.Round(openingFloat, 2),
                        ExpectedBalance = Math.Round(openingFloat, 2),
                        Status = "OPEN",
                        OpenedAt = DateTime.UtcNow,
                        Notes = shiftNotes
                    });
                    await db.SaveChangesAsync();
                }
                finally
                {
                    LocalPosDbContext.WriteLock.Release();
                }

                ShowAlert("Offline cash drawer shift opened locally.", isError: false);
                await LoadShiftData();
            }
        }
        catch (Exception ex)
        {
            ShowAlert(ex.Message, isError: true);
        }
        finally
        {
            isSubmittingShift = false;
        }
    }

    private void OpenConfirmMovementModal()
    {
        if (currentShift == null || isSubmittingMovement) return;

        decimal rounded = Math.Round(movementAmount, 2);
        if (rounded <= 0)
        {
            ShowAlert("Amount must be greater than zero.", isError: true);
            return;
        }
        if (string.IsNullOrWhiteSpace(movementReason))
        {
            ShowAlert("Reason / particulars is required for all cash movements.", isError: true);
            return;
        }
        if (IsOutflow(movementType) && rounded > currentShift.ExpectedBalance)
        {
            ShowAlert($"Insufficient cash in drawer! Available expected cash is ₱{currentShift.ExpectedBalance:N2}, requested is ₱{rounded:N2}.", isError: true);
            return;
        }

        movementAmount = rounded;
        showConfirmModal = true;
    }

    private async Task ConfirmAndSubmitMovementAsync()
    {
        if (currentShift == null || isSubmittingMovement) return;
        isSubmittingMovement = true;

        try
        {
            var state = await ConnectivityService.CheckConnectivityAsync();
            isOffline = state != TerminalConnectivityState.OnlineAndHealthy;

            if (!isOffline)
            {
                var dto = new CashDrawerMovementDto
                {
                    ShiftId = currentShift.ShiftId,
                    BranchId = currentShift.BranchId,
                    OutletId = currentShift.OutletId,
                    MovementType = movementType,
                    CategoryId = selectedCategoryId > 0 ? selectedCategoryId : null,
                    CategoryName = SelectedCategory?.Name,
                    Amount = movementAmount,
                    Reason = movementReason.Trim(),
                    ClientMovementId = pendingClientMovementId,
                    SupervisorPin = string.IsNullOrWhiteSpace(supervisorPin) ? null : supervisorPin.Trim()
                };

                string endpoint = movementType == "CASH_IN" ? "api/cash-drawer/paid-in" : "api/cash-drawer/paid-out";
                var response = await Http.PostAsJsonAsync(endpoint, dto);
                if (response.IsSuccessStatusCode)
                {
                    var created = await response.Content.ReadFromJsonAsync<CashMovementResponseDto>();
                    showConfirmModal = false;
                    ResetMovementForm();
                    await LoadShiftData();
                    if (created != null)
                    {
                        selectedVoucher = created;
                        ShowAlert($"Recorded {created.ReferenceNumber} ({created.Status}).", isError: false);
                    }
                }
                else
                {
                    var err = await response.Content.ReadAsStringAsync();
                    showConfirmModal = false;
                    ShowAlert(err, isError: true);
                }
            }
            else
            {
                await RecordOfflineMovementAsync();
            }
        }
        catch (Exception ex)
        {
            showConfirmModal = false;
            ShowAlert($"Error recording movement: {ex.Message}", isError: true);
        }
        finally
        {
            isSubmittingMovement = false;
        }
    }

    private async Task RecordOfflineMovementAsync()
    {
        if (currentShift == null) return;

        await LocalPosDbContext.WriteLock.WaitAsync();
        try
        {
            using var db = new LocalPosDbContext();
            db.InitializeDatabase();
            using var tx = await db.Database.BeginTransactionAsync();

            // Prevent duplicate local ClientMovementId
            if (await db.CashDrawerMovements.AnyAsync(m => m.ClientMovementId == pendingClientMovementId))
            {
                showConfirmModal = false;
                ShowAlert("Duplicate movement submission prevented.", isError: false);
                return;
            }

            var localShift = await db.CashDrawerShifts.FirstOrDefaultAsync(s => s.ShiftId == currentShift.ShiftId && s.Status == "OPEN");
            if (localShift == null)
            {
                showConfirmModal = false;
                ShowAlert("No active open shift found in local database.", isError: true);
                return;
            }

            if (IsOutflow(movementType) && movementAmount > localShift.ExpectedBalance)
            {
                showConfirmModal = false;
                ShowAlert($"Insufficient offline drawer balance (Available: ₱{localShift.ExpectedBalance:N2}).", isError: true);
                return;
            }

            string? verifiedApprover = null;
            string? verifiedPinHash = null;

            if (CurrentSelectionRequiresApproval)
            {
                if (!string.IsNullOrWhiteSpace(supervisorPin))
                {
                    string pinHash = Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(
                        System.Text.Encoding.UTF8.GetBytes(supervisorPin.Trim())));

                    var cachedSupervisor = await db.Cashiers
                        .AsNoTracking()
                        .FirstOrDefaultAsync(c => c.PinHash == pinHash);

                    if (cachedSupervisor == null || !IsSupervisorRole(cachedSupervisor.Role))
                    {
                        await tx.RollbackAsync();
                        showConfirmModal = false;
                        ShowAlert("Invalid offline supervisor PIN or cashier does not have supervisor privileges.", isError: true);
                        return;
                    }

                    verifiedApprover = cachedSupervisor.Username;
                    verifiedPinHash = pinHash;
                }
            }
            else
            {
                verifiedApprover = Session.Username ?? "offline_cashier";
            }

            // Critical Offline Rule: If approval is required and cannot be cryptographically verified against a supervisor PIN hash, keep PENDING_APPROVAL
            string status = (CurrentSelectionRequiresApproval && verifiedApprover == null) ? "PENDING_APPROVAL" : "POSTED";
            var now = DateTime.UtcNow;

            string prefix = movementType switch
            {
                "PETTY_CASH" => "PCV",
                "CASH_OUT" => "COU",
                "CASH_IN" => "CIN",
                "CASH_DROP" => "CDP",
                _ => "CMV"
            };
            string refNumber = $"{prefix}-OFF-{now:yyMMdd}-{pendingClientMovementId[..4].ToUpperInvariant()}";

            var localMovement = new LocalCashDrawerMovement
            {
                ClientMovementId = pendingClientMovementId,
                ShiftId = localShift.ShiftId,
                BranchId = localShift.BranchId,
                OutletId = localShift.OutletId,
                MovementType = movementType,
                CategoryId = selectedCategoryId > 0 ? selectedCategoryId : null,
                CategoryName = SelectedCategory?.Name,
                Amount = movementAmount,
                Reason = movementReason.Trim(),
                ReferenceNumber = refNumber,
                Status = status,
                CreatedBy = Session.Username ?? localShift.CashierId,
                AuthorizedBy = verifiedApprover ?? (Session.Username ?? localShift.CashierId),
                ApprovedBy = verifiedApprover,
                SupervisorPinHash = verifiedPinHash,
                CreatedAt = now,
                ApprovedAt = verifiedApprover != null ? now : null,
                PostedAt = status == "POSTED" ? now : null,
                SyncStatus = "PENDING"
            };

            db.CashDrawerMovements.Add(localMovement);

            if (status == "POSTED")
            {
                if (movementType == "CASH_IN") localShift.TotalCashIn += movementAmount;
                else if (movementType is "CASH_OUT" or "PETTY_CASH") localShift.TotalCashOut += movementAmount;
                else if (movementType == "CASH_DROP") localShift.TotalCashDrops += movementAmount;

                localShift.ExpectedBalance = localShift.OpeningFloat
                    + localShift.TotalCashSales
                    - localShift.TotalCashRefunds
                    + localShift.TotalCashIn
                    - localShift.TotalCashOut
                    - localShift.TotalCashDrops;
            }

            db.SyncOutboxes.Add(new LocalSyncOutbox
            {
                EntityType = "CASH_MOVEMENT",
                EntityId = localMovement.ClientMovementId,
                PayloadJson = System.Text.Json.JsonSerializer.Serialize(localMovement),
                Status = "PENDING",
                RetryCount = 0,
                CreatedAt = now
            });

            await db.SaveChangesAsync();
            await tx.CommitAsync();

            showConfirmModal = false;
            ResetMovementForm();
            await LoadShiftData();

            selectedVoucher = currentShift?.Movements.FirstOrDefault(m => m.ClientMovementId == localMovement.ClientMovementId);
            ShowAlert($"Saved offline voucher {refNumber} ({status}). Will synchronize automatically on reconnection.", isError: false);
        }
        finally
        {
            LocalPosDbContext.WriteLock.Release();
        }
    }

    private static bool IsSupervisorRole(string? role)
    {
        if (string.IsNullOrWhiteSpace(role)) return false;
        var r = role.Trim();
        return r.Equals("Admin", StringComparison.OrdinalIgnoreCase) ||
               r.Equals("Manager", StringComparison.OrdinalIgnoreCase) ||
               r.Equals("Senior Cashier", StringComparison.OrdinalIgnoreCase) ||
               r.Equals("SeniorCashier", StringComparison.OrdinalIgnoreCase);
    }

    private void ResetMovementForm()
    {
        movementAmount = 0.00m;
        movementReason = string.Empty;
        supervisorPin = string.Empty;
        pendingClientMovementId = Guid.NewGuid().ToString("N");
    }

    private void OpenVoucherPreview(CashMovementResponseDto m)
    {
        selectedVoucher = m;
    }

    private async Task PrintVoucherAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("window.print");
        }
        catch { }
    }

    private void OpenSupervisorActionModal(CashMovementResponseDto m, string actionType)
    {
        actionModalMovement = m;
        actionModalType = actionType;
        actionModalReason = string.Empty;
        actionModalSupervisorPin = string.Empty;
    }

    private void CloseSupervisorActionModal()
    {
        actionModalMovement = null;
        actionModalReason = string.Empty;
        actionModalSupervisorPin = string.Empty;
    }

    private async Task ExecuteSupervisorActionAsync()
    {
        if (actionModalMovement == null || isSubmittingAction) return;

        if (actionModalType is "REJECT" or "REVERSE" && string.IsNullOrWhiteSpace(actionModalReason))
        {
            ShowAlert("Reason is required for rejection or reversal.", isError: true);
            return;
        }

        isSubmittingAction = true;
        try
        {
            HttpResponseMessage response;
            if (actionModalType == "APPROVE")
            {
                response = await Http.PostAsJsonAsync($"api/cash-drawer/movements/{actionModalMovement.MovementId}/approve", new CashMovementApproveRejectDto
                {
                    SupervisorPin = actionModalSupervisorPin
                });
            }
            else if (actionModalType == "REJECT")
            {
                response = await Http.PostAsJsonAsync($"api/cash-drawer/movements/{actionModalMovement.MovementId}/reject", new CashMovementApproveRejectDto
                {
                    SupervisorPin = actionModalSupervisorPin,
                    Reason = actionModalReason
                });
            }
            else
            {
                response = await Http.PostAsJsonAsync($"api/cash-drawer/movements/{actionModalMovement.MovementId}/reverse", new CashMovementReverseDto
                {
                    SupervisorPin = actionModalSupervisorPin,
                    Reason = actionModalReason
                });
            }

            if (response.IsSuccessStatusCode)
            {
                ShowAlert($"Movement {actionModalMovement.ReferenceNumber} {actionModalType.ToLowerInvariant()}d successfully.", isError: false);
                CloseSupervisorActionModal();
                await LoadShiftData();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                ShowAlert(err, isError: true);
            }
        }
        catch (Exception ex)
        {
            ShowAlert(ex.Message, isError: true);
        }
        finally
        {
            isSubmittingAction = false;
        }
    }

    private async Task CloseShift()
    {
        if (currentShift == null || isSubmittingShift) return;

        decimal diff = Math.Round(actualCounted - currentShift.ExpectedBalance, 2);
        bool confirm = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Close Drawer Shift & Reconcile?",
            Text = $"Expected Cash: ₱{currentShift.ExpectedBalance:N2} | Counted Cash: ₱{actualCounted:N2} | Over/(Short): ₱{diff:N2}. Proceed?",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Yes, Close Shift"
        }).ContinueWith(t => t.Result.IsConfirmed);

        if (!confirm) return;

        isSubmittingShift = true;
        try
        {
            var dto = new CloseShiftDto
            {
                ShiftId = currentShift.ShiftId,
                ActualCountedBalance = actualCounted,
                Notes = closingNotes
            };

            var response = await Http.PostAsJsonAsync("api/cash-drawer/close-shift", dto);
            if (response.IsSuccessStatusCode)
            {
                ShowAlert($"Cash drawer shift closed! Over/(Short): ₱{diff:N2}", isError: false);
                actualCounted = 0.00m;
                closingNotes = string.Empty;
                await LoadShiftData();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                ShowAlert(err, isError: true);
            }
        }
        catch (Exception ex)
        {
            ShowAlert(ex.Message, isError: true);
        }
        finally
        {
            isSubmittingShift = false;
        }
    }

    private void ShowAlert(string message, bool isError)
    {
        statusAlertMessage = message;
        statusAlertIsError = isError;
    }
}
