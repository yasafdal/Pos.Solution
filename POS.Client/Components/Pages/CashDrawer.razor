        lastClosedShift = await ShiftSession.LastClosedDtoAsync(Http, terminalId, isOffline, isSupervisor: false);
    }

    private void OpenRecountModal()
    {
        if (lastClosedShift == null || !IsSupervisorUnlocked) return;

        var existingDenoms = lastClosedShift.Denominations.ToDictionary(
            d => $"{d.Type}:{d.Denomination:0.00}",
            d => d.Quantity,
            StringComparer.OrdinalIgnoreCase);

        recountDenominationRows = CashDenominationCatalog.CreateDefaultLines()
            .Select(d =>
            {
                string key = $"{d.Type}:{d.Denomination:0.00}";
                int qty = existingDenoms.TryGetValue(key, out int q) ? q : 0;
                return new DenominationRowState
                {
                    Type = d.Type,
                    Denomination = d.Denomination,
                    Label = d.Label,
                    Quantity = qty,
                    RawQuantity = qty.ToString(CultureInfo.InvariantCulture)
                };
            })
            .ToList();

        RecountNonCashDeclarations = lastClosedShift.PaymentReconciliations
            .Where(r => !r.IsCash)
            .Select(r => new NonCashDeclarationRowState
            {
                PaymentMethodCode = r.PaymentMethodCode,
                PaymentMethodName = r.PaymentMethodName,
                IsActive = r.IsActive,
                DisplayOrder = r.DisplayOrder,
                ExpectedAmount = r.ExpectedAmount,
                DeclaredAmount = r.DeclaredAmount,
                RawAmount = r.DeclaredAmount.ToString("0.00", CultureInfo.InvariantCulture)
            })
            .ToList();

        recountReason = string.Empty;
        recountSupervisorPin = unlockedSupervisorPin ?? string.Empty;
        showRecountModal = true;
    }

    private async Task SubmitRecountAsync()
    {
        if (lastClosedShift == null || isSubmittingRecount || !IsSupervisorUnlocked) return;
        if (string.IsNullOrWhiteSpace(recountReason))
        {
            ShowAlert("A recount/correction reason is required for the audit trail.", isError: true);
            return;
        }

        isSubmittingRecount = true;
        try
        {
            var state = await ConnectivityService.CheckConnectivityAsync();
            isOffline = state != TerminalConnectivityState.OnlineAndHealthy;

            var req = new ShiftRecountRequestDto
            {
                ShiftId = lastClosedShift.ShiftId,
                Reason = recountReason.Trim(),
                SupervisorPin = string.IsNullOrWhiteSpace(recountSupervisorPin) ? unlockedSupervisorPin : recountSupervisorPin.Trim(),
                Denominations = recountDenominationRows.Select(r => new CashDenominationLineDto
                {
                    Type = r.Type,
                    Denomination = r.Denomination,
                    Quantity = Math.Max(0, r.Quantity),
                    Subtotal = r.Subtotal
                }).ToList(),
                PaymentDeclarations = RecountNonCashDeclarations.Select(d => new PaymentMethodDeclarationDto
                {
                    PaymentMethodCode = d.PaymentMethodCode,
                    PaymentMethodName = d.PaymentMethodName,
                    DeclaredAmount = Math.Max(0m, Math.Round(d.DeclaredAmount, 2, MidpointRounding.AwayFromZero))
                }).ToList()
            };

            var updated = await ShiftSession.RecountAsync(
                Http,
                lastClosedShift.ShiftId,
                req,
                Session.Username ?? "supervisor",
                Session.Role,
                isOffline);

            lastClosedShift = updated;
            showRecountModal = false;
            ShowAlert($"Supervisor recount recorded for Shift #{updated.ShiftId}. Original declaration preserved in audit history.", isError: false);
        }
        catch (Exception ex)
        {
            ShowAlert(ex.Message, isError: true);
        }
        finally
        {
            isSubmittingRecount = false;
        }
    }

