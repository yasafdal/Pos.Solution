    private void OpenConfirmMovementModal()
    {
        if (currentShift == null || isSubmittingMovement) return;

        decimal rounded = Math.Round(movementAmount, 2);
        if (rounded <= 0)
        {
            ShowAlert("Amount must be greater than zero.", isError: true);
            return;
        }
