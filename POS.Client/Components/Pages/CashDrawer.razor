        denom < 1m
            ? denom.ToString("0.00", CultureInfo.InvariantCulture)
            : denom.ToString("N0", CultureInfo.InvariantCulture);

    private static string FormatSignedCurrency(decimal value) =>
        value >= 0m
            ? $"+₱{value:N2}"
            : $"-₱{Math.Abs(value):N2}";

    private static string GetVarianceTextClass(decimal variance) =>
        variance == 0m ? "text-success" : (variance > 0m ? "text-info" : "text-danger");

    private static string GetVarianceStatusBadgeClass(string status) =>
        (status ?? string.Empty).ToUpperInvariant() switch
        {
            "BALANCED" => "bg-success",
            "OVER" => "bg-info text-dark",
