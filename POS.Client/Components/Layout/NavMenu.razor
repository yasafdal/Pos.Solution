<div class="top-row ps-3 pe-3 navbar navbar-dark d-flex justify-content-between align-items-center">
    <a class="navbar-brand fw-bold" href="">POS.Client</a>
</div>

<div class="@NavMenuCssClass nav-scrollable">
    <nav class="nav flex-column">
        <!-- Dashboard -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <i class="bi bi-grid-fill nav-icon fs-5"></i>
                <span class="nav-text">Dashboard</span>
            </NavLink>
        </div>

        <!-- New Sale -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="new-sale">
                <i class="bi bi-cart-fill nav-icon fs-5"></i>
                <span class="nav-text">New Sale</span>
            </NavLink>
        </div>

        <!-- Transaction -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="transactions">
                <i class="bi bi-receipt nav-icon fs-5"></i>
                <span class="nav-text">Transaction</span>
            </NavLink>
        </div>

        <!-- Held Sales -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="held-sales">
                <i class="bi bi-pause-circle-fill nav-icon fs-5"></i>
                <span class="nav-text">Held Sales</span>
            </NavLink>
        </div>

        <!-- Cash Drawer -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="cash-drawer">
                <i class="bi bi-cash-stack nav-icon fs-5"></i>
                <span class="nav-text">Cash Drawer</span>
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = false;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
