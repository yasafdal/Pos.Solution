@inject PosSessionService Session

<div class="top-row ps-3 pe-3 navbar navbar-dark d-flex justify-content-between align-items-center">
    <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="" @onclick="HandleClose">
        <div class="nav-logo-icon">
            <i class="bi bi-display fs-6 text-white"></i>
        </div>
        <span>POS Terminal</span>
    </a>
    <button type="button" class="btn btn-link text-secondary p-1 sidebar-close-btn" @onclick="HandleClose" aria-label="Close navigation" title="Close Menu">
        <i class="bi bi-x-lg fs-5"></i>
    </button>
</div>

<div class="@NavMenuCssClass nav-scrollable">
    <nav class="nav flex-column py-2">
        <div class="px-3 py-2 mb-1">
            <div class="text-uppercase text-secondary fw-bold" style="font-size: 0.68rem; letter-spacing: 0.06em;">Cashier Workspace</div>
        </div>

        <!-- Primary Workspace Entry -->
        <div class="nav-item px-3 mb-1">
            <NavLink class="nav-link" href="new-sale" @onclick="HandleClose">
                <i class="bi bi-cart-fill nav-icon fs-5"></i>
                <span class="nav-text">New Sale Register</span>
            </NavLink>
        </div>

        <div class="nav-item px-3 mb-2">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="HandleClose">
                <i class="bi bi-grid-fill nav-icon fs-5"></i>
                <span class="nav-text">Dashboard Summary</span>
            </NavLink>
        </div>

        <div class="px-3 py-2 mt-1 mb-1 border-top" style="border-color: rgba(255,255,255,0.08) !important;">
            <div class="text-uppercase text-secondary fw-bold" style="font-size: 0.68rem; letter-spacing: 0.06em;">Administration &amp; Setup</div>
        </div>

        @if (ShiftSession.IsSupervisorRole(Session.Role))
        {
            <div class="nav-item px-3 mb-1">
                <NavLink class="nav-link" href="z-reading" @onclick="HandleClose">
                    <i class="bi bi-file-earmark-lock nav-icon fs-5"></i>
                    <span class="nav-text">End-of-Day Z-Reading</span>
                </NavLink>
            </div>
        }

        <!-- Terminal Setup Checklist -->
        <div class="nav-item px-3 mb-1">
            <NavLink class="nav-link" href="initialization" @onclick="HandleClose">
                <i class="bi bi-shield-check nav-icon fs-5"></i>
                <span class="nav-text">Terminal Setup</span>
            </NavLink>
        </div>

        <div class="nav-item px-3 mb-1">
            <NavLink class="nav-link" href="printer-settings" @onclick="HandleClose">
                <i class="bi bi-printer nav-icon fs-5"></i>
                <span class="nav-text">Printer &amp; Cash Drawer</span>
            </NavLink>
        </div>

        <!-- License Information Screen -->
        <div class="nav-item px-3 mb-1">
            <NavLink class="nav-link" href="license-info" @onclick="HandleClose">
                <i class="bi bi-shield-lock-fill nav-icon fs-5"></i>
                <span class="nav-text">License Information</span>
            </NavLink>
        </div>

        <div class="px-3 mt-3">
            <div class="p-2.5 rounded-3 small text-secondary" style="background: rgba(15, 23, 42, 0.55); border: 1px solid rgba(255,255,255,0.06); font-size: 0.75rem;">
                <i class="bi bi-Layout-sidebar-inset-reverse text-info me-1"></i>
                @if (Session.CanViewTransactionHistory)
                {
                    <span>Daily POS modules (<strong>Transactions</strong>, <strong>Held Sales</strong>, <strong>Cashier</strong>, and <strong>Readings</strong>) are pinned to the bottom workspace bar.</span>
                }
                else
                {
                    <span>Daily cashier modules (<strong>New Sale</strong>, <strong>Held Sales</strong>, <strong>Cashier</strong>, and <strong>Readings</strong>) are pinned to the bottom workspace bar.</span>
                }
            </div>
        </div>
    </nav>
</div>

@code {
    [Parameter]
    public EventCallback OnClose { get; set; }

    private bool collapseNavMenu = false;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private async Task HandleClose()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }
}
