@inherits LayoutComponentBase
@inject PosSessionService Session
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime Js
@inject IPosConnectivityService ConnectivityService
@inject POS.Shared.Interfaces.IUserService UserService
@inject POS.Client.Data.LocalPosDbContext LocalDb
@using Microsoft.EntityFrameworkCore
@implements IDisposable

<div class="page @(IsNewSalePage ? "page-new-sale" : "")">
    @if (Session.IsAuthenticated && !IsNewSalePage)
    {
        <header class="app-header-bar d-flex justify-content-between align-items-center px-4">
            <div class="d-flex align-items-center gap-3">
                <button type="button" class="hamburger-btn d-flex align-items-center justify-content-center" @onclick="ToggleNavMenu" aria-label="Toggle navigation" title="Toggle Menu">
                    <i class="bi bi-list fs-4"></i>
                </button>
                <span class="terminal-identity">@Session.Terminal!.BranchCode • @Session.Terminal.TerminalName</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="header-action-btn header-btn-switch" @onclick="SwitchCashier">
                    <i class="bi bi-arrow-left-right me-1"></i>Switch Cashier
                </button>
                <button type="button" class="header-action-btn header-btn-lock" @onclick="LockTerminal">
                    <i class="bi bi-lock me-1"></i>Lock Terminal
                </button>
            </div>
        </header>

        @if (_connectivityState != TerminalConnectivityState.OnlineAndHealthy)
        {
            <div class="alert alert-warning rounded-0 m-0 py-2 px-4 d-flex justify-content-between align-items-center shadow-sm" role="alert">
                <div class="d-flex align-items-center gap-2 small fw-medium">
                    <i class="bi bi-exclamation-triangle-fill text-warning fs-5"></i>
                    <span>Offline Mode — Cash sales are saved locally and will synchronize when the server is available. (@_pendingCount pending)</span>
                </div>
                <span class="badge bg-secondary">Offline Ready</span>
            </div>
        }
    }

    <div class="main-body @(IsNewSalePage ? "main-body-new-sale" : "")">
        @if (Session.IsAuthenticated && isNavVisible)
        {
            <div class="nav-backdrop" @onclick="ToggleNavMenu"></div>
            <div class="sidebar shadow-lg">
                <div><NavMenu OnClose="CloseNavMenu" /></div>
            </div>
        }

        <main class="content-area @(IsNewSalePage ? "content-area-new-sale" : "")">
            <article class="content @(IsNewSalePage ? "content-new-sale" : "px-4 py-3")">
                <CascadingValue Value="this">
                    @Body
                </CascadingValue>
            </article>
        </main>
    </div>
</div>

@code {
    private bool isNavVisible = false;
    private TerminalConnectivityState _connectivityState = TerminalConnectivityState.OnlineAndHealthy;
    private int _pendingCount = 0;
    private System.Threading.Timer? _statusTimer;

    public TerminalConnectivityState ConnectivityState => _connectivityState;
    public int PendingCount => _pendingCount;

    private bool IsNewSalePage => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("new-sale", StringComparison.OrdinalIgnoreCase);

    public void ToggleNavMenu()
    {
        isNavVisible = !isNavVisible;
        StateHasChanged();
    }

    public async Task SwitchCashierAsync()
    {
        await SwitchCashier();
    }

    public async Task LockTerminalAsync()
    {
        await LockTerminal();
    }

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        try
        {
            LocalDb.InitializeDatabase();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Auto DB Init Error: {ex.Message}");
        }

        await CheckStatusAsync();
        _statusTimer = new System.Threading.Timer(async _ => await InvokeAsync(CheckStatusAsync), null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(15));
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task CheckStatusAsync()
    {
        try
        {
            _connectivityState = await ConnectivityService.CheckConnectivityAsync();
            using var db = new POS.Client.Data.LocalPosDbContext();
            db.InitializeDatabase();
            _pendingCount = db.SyncOutboxes.Count(o => o.Status == "PENDING" || o.Status == "RETRY_PENDING");
            if (_connectivityState == TerminalConnectivityState.OnlineAndHealthy && db.Cashiers.Count() <= 1)
            {
                await EnsureCashiersCachedAsync();
            }
            StateHasChanged();
        }
        catch
        {
            // Suppress background poll errors
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        _statusTimer?.Dispose();
    }

    private void CloseNavMenu() => isNavVisible = false;

    private async Task EnsureCashiersCachedAsync()
    {
        try
        {
            var users = await UserService.GetUsersAsync();
            var validUsers = users?.Where(u => !string.IsNullOrWhiteSpace(u.PinCode)).ToList();
            if (validUsers == null || validUsers.Count == 0) return;

            await POS.Client.Data.LocalPosDbContext.WriteLock.WaitAsync();
            try
            {
                using var db = new POS.Client.Data.LocalPosDbContext();
                db.InitializeDatabase();
                await db.Database.ExecuteSqlRawAsync("DELETE FROM LocalCashiers;");
                db.ChangeTracker.Clear();
                foreach (var u in validUsers)
                {
                    var pinHash = Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(u.PinCode!.Trim())));
                    db.Cashiers.Add(new POS.Client.Data.LocalCashier
                    {
                        UserId = u.UserId,
                        Username = u.Username,
                        Role = u.Role ?? "Cashier",
                        PinHash = pinHash
                    });
                }
                await db.SaveChangesAsync();
            }
            finally
            {
                POS.Client.Data.LocalPosDbContext.WriteLock.Release();
            }
        }
        catch { }
    }

    private async Task CacheCurrentOutletAsync(POS.Shared.Models.TerminalConfigDto? outlet)
    {
        if (_connectivityState == TerminalConnectivityState.OnlineAndHealthy)
        {
            await EnsureCashiersCachedAsync();
        }
        if (outlet == null) return;
        try
        {
            await POS.Client.Data.LocalPosDbContext.WriteLock.WaitAsync();
            try
            {
                using var db = new POS.Client.Data.LocalPosDbContext();
                db.InitializeDatabase();
                var existing = db.TerminalConfigs.FirstOrDefault(o => o.TerminalId == outlet.TerminalId);
                if (existing == null)
                {
                    db.TerminalConfigs.Add(new POS.Client.Data.LocalTerminalConfig
                    {
                        TerminalId = outlet.TerminalId,
                        OutletId = outlet.OutletId, OutletName = outlet.OutletName, TerminalCode = outlet.TerminalCode,
                        IpAddress = outlet.IpAddress, PTUNumber = outlet.PTUNumber, MINNumber = outlet.MINNumber, SerialNumber = outlet.SerialNumber,
                        BranchId = outlet.BranchId,
                        BusinessTypeId = outlet.BusinessTypeId ?? 1,
                        BusinessType = outlet.BusinessType ?? "FNB",
                        BranchName = outlet.BranchName,
                        BranchCode = outlet.BranchCode,
                        BranchAddress = outlet.BranchAddress,
                        BranchPhone = outlet.BranchPhone,
                        TerminalName = outlet.TerminalName,
                        BranchTaxType = "VAT-Registered",
                        TerminalIdentifier = outlet.TerminalName
                    });
                    await db.SaveChangesAsync();
                }
            }
            finally
            {
                POS.Client.Data.LocalPosDbContext.WriteLock.Release();
            }
        }
        catch { }
    }

    private async Task LockTerminal()
    {
        await CacheCurrentOutletAsync(Session.Terminal);
        Session.ClearSession();
        Http.DefaultRequestHeaders.Authorization = null;
        Navigation.NavigateTo("/login");
    }

    private async Task SwitchCashier()
    {
        bool confirmed = await Js.InvokeAsync<bool>("confirm", "Switch cashier? The current user will be signed out of this terminal.");
        if (!confirmed) return;

        var currentOutlet = Session.Terminal;
        await CacheCurrentOutletAsync(currentOutlet);
        Session.ClearSession();
        Http.DefaultRequestHeaders.Authorization = null;
        if (currentOutlet != null)
        {
            Navigation.NavigateTo($"/login?terminalId={currentOutlet.TerminalId}");
        }
        else
        {
            Navigation.NavigateTo("/login");
        }
    }
}
