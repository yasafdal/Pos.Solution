@inherits LayoutComponentBase
@inject PosSessionService Session
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime Js
@inject IPosConnectivityService ConnectivityService
@inject POS.Shared.Interfaces.IUserService UserService
@inject POS.Client.Data.LocalPosDbContext LocalDb
@inject POS.Client.Workers.IOfflineBackgroundSyncService BackgroundSyncService
@inject POS.Client.Services.IOfflineTransactionSyncService TransactionSyncService
@inject POS.Client.Services.IReferenceDataSyncService ReferenceDataSync
@inject POS.Client.Services.IClientLicenseService LicenseService
@inject POS.Client.Services.CartService Cart
@inject POS.Shared.Interfaces.IHeldSaleService HeldSaleService
@using Microsoft.EntityFrameworkCore
@implements IDisposable

<div class="page @(IsNewSalePage ? "page-new-sale" : "") @(ShowWorkspaceBottomNav ? "has-bottom-nav" : "")">
    @if (Session.IsAuthenticated && !IsNewSalePage)
    {
        <header class="app-header-bar d-flex justify-content-between align-items-center px-4">
            <div class="d-flex align-items-center gap-3">
                <button type="button" class="hamburger-btn d-flex align-items-center justify-content-center" @onclick="ToggleNavMenu" aria-label="Toggle navigation" title="Toggle Menu">
                    <i class="bi bi-list fs-4"></i>
                </button>
                <span class="terminal-identity">@Session.Terminal!.BranchCode • @Session.Terminal.TerminalName</span>
            </div>

            <!-- Compact Sync Status Widget -->
            <div class="sync-status-widget d-flex align-items-center gap-2">
                @if (_connectivityState == TerminalConnectivityState.OnlineAndHealthy)
                {
                    <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 d-inline-flex align-items-center gap-1 py-1 px-2" title="Central API reachable">
                        <i class="bi bi-wifi"></i> <span class="d-none d-sm-inline">Online</span>
                    </span>
                }
                else
                {
                    <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50 d-inline-flex align-items-center gap-1 py-1 px-2" title="Offline mode active">
                        <i class="bi bi-wifi-off"></i> <span class="d-none d-sm-inline">Offline</span>
                    </span>
                }

                @if (_pendingCount > 0 || _uploadingCount > 0)
                {
                    <span class="badge bg-primary text-white d-inline-flex align-items-center gap-1 py-1 px-2" title="@(_pendingCount + _uploadingCount) transaction(s) pending sync">
                        <i class="bi bi-arrow-repeat @(_uploadingCount > 0 ? "spinner-border spinner-border-sm" : "")"></i> @(_pendingCount + _uploadingCount) pending
                    </span>
                }
                else if (_failedCount > 0)
                {
                    <span class="badge bg-danger text-white d-inline-flex align-items-center gap-1 py-1 px-2" title="@(_lastFailedError ?? $"{_failedCount} sync failure(s)")">
                        <i class="bi bi-exclamation-octagon"></i> @_failedCount failed
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary bg-opacity-25 text-secondary border d-inline-flex align-items-center gap-1 py-1 px-2" title="@(_lastSyncTime.HasValue ? $"All transactions synchronized • Last sync: {POS.Shared.Services.BusinessDayClock.FormatManila(_lastSyncTime.Value, "hh:mm tt")}" : "All transactions synchronized")">
                        <i class="bi bi-check2-all text-success"></i> <span class="d-none d-sm-inline">Synced</span>
                    </span>
                }
            </div>

            <div class="d-flex align-items-center gap-2">
                <button type="button" class="header-action-btn header-btn-switch" @onclick="SwitchCashier">
                    <i class="bi bi-arrow-left-right me-1"></i>Switch Cashier
                </button>
                <button type="button" class="header-action-btn header-btn-logout" @onclick="RequestLogout">
                    <i class="bi bi-box-arrow-right me-1"></i>Logout
                </button>
            </div>
        </header>

        @if (_connectivityState != TerminalConnectivityState.OnlineAndHealthy)
        {
            <div class="alert alert-warning rounded-0 m-0 py-2 px-4 d-flex justify-content-between align-items-center shadow-sm" role="alert">
                <div class="d-flex align-items-center gap-2 small fw-medium">
                    <i class="bi bi-exclamation-triangle-fill text-warning fs-5"></i>
                    <span>Offline Mode — Cash sales are saved locally and will synchronize when the server is available. (@_pendingCount pending)</span>
                </div>
                <span class="badge bg-secondary">Offline Ready</span>
            </div>
        }

        @if (_licenseEvaluation != null && !_licenseEvaluation.IsValidForNewSales && _licenseEvaluation.BlockReasonCode != "LICENSE_MISSING")
        {
            <div class="alert alert-danger rounded-0 m-0 py-2 px-4 d-flex justify-content-between align-items-center shadow-sm" role="alert">
                <div class="d-flex align-items-center gap-2 small fw-semibold">
                    <i class="bi bi-shield-exclamation fs-5"></i>
                    <span>License Status (@_licenseEvaluation.EffectiveStatus): @_licenseEvaluation.BlockMessage</span>
                </div>
                <button type="button" class="btn btn-sm btn-light fw-bold py-0 px-2" @onclick='() => NavigateWorkspace("/license-info")'>
                    License Details
                </button>
            </div>
        }
        else if (_licenseEvaluation != null && !string.IsNullOrWhiteSpace(_licenseEvaluation.WarningMessage))
        {
            <div class="alert alert-warning rounded-0 m-0 py-1 px-4 d-flex justify-content-between align-items-center shadow-sm" role="alert">
                <div class="d-flex align-items-center gap-2 small fw-medium">
                    <i class="bi bi-shield-lock-fill text-warning"></i>
                    <span>@_licenseEvaluation.WarningMessage</span>
                </div>
                <button type="button" class="btn btn-sm btn-outline-dark fw-semibold py-0 px-2" @onclick='() => NavigateWorkspace("/license-info")'>
                    License Info
                </button>
            </div>
        }
    }

    <div class="main-body @(IsNewSalePage ? "main-body-new-sale" : "")">
        @if (Session.IsAuthenticated && isNavVisible)
        {
            <div class="nav-backdrop" @onclick="ToggleNavMenu"></div>
            <div class="sidebar shadow-lg">
                <div><NavMenu OnClose="CloseNavMenu" /></div>
            </div>
        }

        <main class="content-area @(IsNewSalePage ? "content-area-new-sale" : "")">
            <article class="content @(IsNewSalePage ? "content-new-sale" : "px-4 py-3")">
                <CascadingValue Value="this">
                    @if (ShowWorkspaceBottomNav)
                    {
                        <div class="workspace-new-sale-host @(IsNewSalePage ? "workspace-panel-active" : "d-none")">
                            <POS.Client.Components.Pages.NewSale />
                        </div>
                    }
                    @if (!ShowWorkspaceBottomNav || !IsNewSalePage)
                    {
                        <div class="workspace-body-host @(IsNewSalePage && ShowWorkspaceBottomNav ? "d-none" : "workspace-panel-active")">
                            @Body
                        </div>
                    }
                </CascadingValue>
            </article>
        </main>
    </div>

    @if (ShowWorkspaceBottomNav)
    {
        <nav class="cashier-bottom-nav" aria-label="Cashier Workspace Navigation">
            <button type="button"
                    class="workspace-nav-btn @(IsDashboardActive ? "active" : "")"
                    @onclick='() => NavigateWorkspace("/")'
                    title="Operational Dashboard">
                <i class="bi bi-grid-fill workspace-nav-icon"></i>
                <span class="workspace-nav-label">Dashboard</span>
            </button>

            <button type="button"
                    class="workspace-nav-btn workspace-nav-btn-primary @(IsNewSalePage ? "active" : "")"
                    @onclick='() => NavigateWorkspace("/new-sale")'
                    title="New Sale Register">
                <div class="workspace-nav-icon-wrap">
                    <i class="bi bi-cart-fill workspace-nav-icon"></i>
                    @if (Cart.TotalItems > 0)
                    {
                        <span class="workspace-nav-badge badge-primary">@CartItem.FormatQuantity(Cart.TotalItems)</span>
                    }
                </div>
                <span class="workspace-nav-label">New Sale</span>
            </button>

            @if (Session.CanViewTransactionHistory)
            {
                <button type="button"
                        class="workspace-nav-btn @(IsTransactionsActive ? "active" : "")"
                        @onclick='() => NavigateWorkspace("/transactions")'
                        title="Transaction History">
                    <i class="bi bi-receipt workspace-nav-icon"></i>
                    <span class="workspace-nav-label">Transactions</span>
                </button>
            }

            <button type="button"
                    class="workspace-nav-btn @(IsHeldSalesActive ? "active" : "")"
                    @onclick='() => NavigateWorkspace("/held-sales")'
                    title="Held / Parked Sales">
                <div class="workspace-nav-icon-wrap">
                    <i class="bi bi-pause-circle-fill workspace-nav-icon"></i>
                    @if (_heldCount > 0)
                    {
                        <span class="workspace-nav-badge badge-warning">@_heldCount</span>
                    }
                </div>
                <span class="workspace-nav-label">Held Sales</span>
            </button>

            <button type="button"
                    class="workspace-nav-btn @(IsCashierActive ? "active" : "")"
                    @onclick='() => NavigateWorkspace("/cash-drawer")'
                    title="Cashier Session, Paid-In/Paid-Out & Blind Closing">
                <i class="bi bi-cash-stack workspace-nav-icon"></i>
                <span class="workspace-nav-label">Cashier</span>
            </button>

            <button type="button"
                    class="workspace-nav-btn @(IsReadingsActive ? "active" : "")"
                    @onclick='() => NavigateWorkspace("/z-reading")'
                    title="X-Reading & Z-Reading Reports">
                <i class="bi bi-file-earmark-bar-graph-fill workspace-nav-icon"></i>
                <span class="workspace-nav-label">Readings</span>
            </button>
        </nav>
    }

    @if (_showSessionExitModal)
    {
        bool isSwitch = string.Equals(_sessionExitMode, "switch", StringComparison.OrdinalIgnoreCase);
        bool hasUnheldCart = Cart.Items.Count > 0;
        bool canProceedWithoutHolding = !hasUnheldCart || _confirmDiscardCart;
        <div class="pos-confirm-backdrop"
             role="dialog"
             aria-modal="true"
             aria-labelledby="session-exit-modal-title"
             @onclick="HandleSessionExitBackdropClick">
            <div class="pos-confirm-modal" @onclick:stopPropagation="true">
                <div class="pos-confirm-header">
                    <div class="pos-confirm-icon-badge" aria-hidden="true">
                        <i class="bi @(isSwitch ? "bi-arrow-left-right" : "bi-box-arrow-right")"></i>
                    </div>
                    <div class="pos-confirm-heading">
                        <h5 id="session-exit-modal-title" class="pos-confirm-title">@(isSwitch ? "Switch Cashier?" : "Logout?")</h5>
                        @if (!string.IsNullOrWhiteSpace(Session.Username))
                        {
                            <span class="pos-confirm-user-pill">
                                <i class="bi bi-person-circle me-1"></i>@Session.Username
                            </span>
                        }
                    </div>
                    <button type="button"
                            class="pos-confirm-close"
                            @onclick="CancelSessionExit"
                            disabled="@_isExitingSession"
                            aria-label="Close">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

                <div class="pos-confirm-body">
                    <p class="pos-confirm-message">
                        @if (isSwitch)
                        {
                            <span>Are you sure you want to switch cashier? This ends your login session on this terminal, but does <strong>not</strong> close your cash drawer shift. If your shift is still open, you must log back in and complete Close Cashier before another cashier can sign in.</span>
                        }
                        else
                        {
                            <span>Are you sure you want to log out? Your login session will end, while your open cash drawer shift and sales records remain assigned to you until you complete Close Cashier.</span>
                        }
                    </p>

                    @if (hasUnheldCart)
                    {
                        <div class="mt-3 p-3 rounded-3 small" style="background: rgba(245, 158, 11, 0.14); border: 1px solid rgba(245, 158, 11, 0.4); color: #fde68a;">
                            <div class="fw-bold mb-1">
                                <i class="bi bi-cart-exclamation-fill me-1"></i>
                                Active Unheld Cart (@CartItem.FormatQuantity(Cart.TotalItems) item(s) — ₱@Cart.TotalAmount.ToString("N2"))
                            </div>
                            <div class="mb-2" style="color: #fef3c7;">
                                Hold this sale to preserve the customer's order, or explicitly confirm discarding it before signing out.
                            </div>
                            <label class="d-flex align-items-center gap-2 mb-0" style="cursor: pointer; color: #f8fafc;">
                                <input type="checkbox" @bind="_confirmDiscardCart" disabled="@_isExitingSession" />
                                <span>Discard unheld cart items and continue</span>
                            </label>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(_sessionExitError))
                    {
                        <div class="pos-confirm-error" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@_sessionExitError
                        </div>
                    }
                </div>

                <div class="pos-confirm-footer flex-wrap">
                    <button type="button"
                            class="pos-confirm-btn pos-confirm-btn-cancel"
                            @onclick="CancelSessionExit"
                            disabled="@_isExitingSession">
                        Cancel
                    </button>
                    @if (hasUnheldCart)
                    {
                        <button type="button"
                                class="pos-confirm-btn btn btn-info text-dark fw-bold border-0"
                                @onclick="HoldCartAndExitSessionAsync"
                                disabled="@_isExitingSession">
                            <i class="bi bi-pause-circle-fill me-1"></i>
                            <span>@(isSwitch ? "Hold Sale & Switch" : "Hold Sale & Logout")</span>
                        </button>
                    }
                    <button type="button"
                            class="pos-confirm-btn pos-confirm-btn-primary"
                            @onclick="ConfirmSessionExitAsync"
                            disabled="@(_isExitingSession || !canProceedWithoutHolding)">
                        @if (_isExitingSession)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>@(isSwitch ? "Switching..." : "Logging out...")</span>
                        }
                        else
                        {
                            <i class="bi @(isSwitch ? "bi-arrow-left-right" : "bi-box-arrow-right") me-2"></i>
                            <span>@(hasUnheldCart ? (isSwitch ? "Discard & Switch" : "Discard & Logout") : (isSwitch ? "Switch Cashier" : "Logout"))</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool isNavVisible = false;
    private bool _showSessionExitModal = false;
    private string _sessionExitMode = "logout"; // "logout" or "switch"
    private bool _isExitingSession = false;
    private bool _confirmDiscardCart = false;
    private string? _sessionExitError = null;
    private TerminalConnectivityState _connectivityState = TerminalConnectivityState.OnlineAndHealthy;
    private TerminalConnectivityState _previousConnectivityState = TerminalConnectivityState.Unknown;
    private int _pendingCount = 0;
    private int _uploadingCount = 0;
    private int _failedCount = 0;
    private string? _lastFailedError = null;
    private DateTime? _lastSyncTime;
    private POS.Shared.Models.LicenseEvaluationResultDto? _licenseEvaluation;
    private System.Threading.Timer? _statusTimer;

    public TerminalConnectivityState ConnectivityState => _connectivityState;
    public int PendingCount => _pendingCount;

    private int _heldCount = 0;

    private string CurrentRelativePath
    {
        get
        {
            var rel = Navigation.ToBaseRelativePath(Navigation.Uri);
            var qIdx = rel.IndexOfAny(new[] { '?', '#' });
            return (qIdx >= 0 ? rel[..qIdx] : rel).Trim('/');
        }
    }

    private bool IsNonWorkspacePage =>
        CurrentRelativePath.Equals("login", StringComparison.OrdinalIgnoreCase) ||
        CurrentRelativePath.Equals("activate", StringComparison.OrdinalIgnoreCase) ||
        CurrentRelativePath.Equals("initialization", StringComparison.OrdinalIgnoreCase) ||
        CurrentRelativePath.Equals("terminal-locked", StringComparison.OrdinalIgnoreCase);

    private bool ShowWorkspaceBottomNav => Session.IsAuthenticated && !IsNonWorkspacePage;

    private bool IsNewSalePage => CurrentRelativePath.Equals("new-sale", StringComparison.OrdinalIgnoreCase);
    private bool IsDashboardActive => string.IsNullOrEmpty(CurrentRelativePath) || CurrentRelativePath.Equals("dashboard", StringComparison.OrdinalIgnoreCase);
    private bool IsHeldSalesActive => CurrentRelativePath.Equals("held-sales", StringComparison.OrdinalIgnoreCase);
    private bool IsTransactionsActive => CurrentRelativePath.Equals("transactions", StringComparison.OrdinalIgnoreCase);
    private bool IsCashierActive => CurrentRelativePath.Equals("cash-drawer", StringComparison.OrdinalIgnoreCase) || CurrentRelativePath.Equals("my-shift", StringComparison.OrdinalIgnoreCase);
    private bool IsReadingsActive => CurrentRelativePath.Equals("z-reading", StringComparison.OrdinalIgnoreCase);

    private void NavigateWorkspace(string targetUrl)
    {
        isNavVisible = false;
        if (!Session.CanViewTransactionHistory &&
            targetUrl.TrimStart('/').StartsWith("transactions", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }
        Navigation.NavigateTo(targetUrl);
    }

    private void OnCartStateChanged() => InvokeAsync(StateHasChanged);

    private void OnSessionStateChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnReferenceSyncCompleted() => _ = InvokeAsync(async () =>
    {
        await Session.RefreshCachedMenuDisplayModeAsync();
        await CheckStatusAsync();
    });

    private void OnTransactionSyncStateChanged() => _ = InvokeAsync(CheckStatusAsync);

    public async Task RefreshHeldCountAsync()
    {
        if (!Session.IsAuthenticated || Session.Terminal == null)
            return;
        try
        {
            var held = await HeldSaleService.GetHeldSalesAsync(Session.Terminal.BranchId, Session.Terminal.TerminalId, Session.Terminal.OutletId);
            _heldCount = held?.Count ?? 0;
        }
        catch { }
    }

    public void ToggleNavMenu()
    {
        isNavVisible = !isNavVisible;
        StateHasChanged();
    }

    public async Task SwitchCashierAsync()
    {
        await SwitchCashier();
    }

    public async Task LogoutAsync()
    {
        await RequestLogout();
    }

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        Cart.OnChange += OnCartStateChanged;
        Session.OnChange += OnSessionStateChanged;
        ReferenceDataSync.OnSyncCompleted += OnReferenceSyncCompleted;
        TransactionSyncService.OnSyncStateChanged += OnTransactionSyncStateChanged;
        try
        {
            LocalDb.InitializeDatabase();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Auto DB Init Error: {ex.Message}");
        }

        await CheckStatusAsync();
        _statusTimer = new System.Threading.Timer(async _ => await InvokeAsync(CheckStatusAsync), null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(15));
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            await RefreshHeldCountAsync();
            StateHasChanged();
        });
    }

    private async Task CheckStatusAsync()
    {
        try
        {
            _connectivityState = await ConnectivityService.CheckConnectivityAsync();
            bool reconnected = _previousConnectivityState != TerminalConnectivityState.Unknown
                               && _previousConnectivityState != TerminalConnectivityState.OnlineAndHealthy
                               && _connectivityState == TerminalConnectivityState.OnlineAndHealthy;
            _previousConnectivityState = _connectivityState;

            if (_connectivityState == TerminalConnectivityState.OnlineAndHealthy && Session.IsAuthenticated)
            {
                await POS.Client.Services.DeviceActivationService.EnsureOnlineBearerTokenAsync(Http, Session);
            }
            if (Session.IsAuthenticated && Session.Terminal != null)
            {
                if (_connectivityState == TerminalConnectivityState.OnlineAndHealthy)
                {
                    await LicenseService.ValidateOnlineAsync(Http, Session.Terminal.TerminalId, force: reconnected);
                }
                else
                {
                    await LicenseService.EvaluateLocalLicenseAsync(Session.Terminal.TerminalId);
                }
                _licenseEvaluation = LicenseService.LastEvaluation;

                var lockState = await POS.Client.Services.ShiftSession.GetTerminalLockStatusAsync(
                    Http,
                    Session.Terminal.TerminalId,
                    Session.Username,
                    _connectivityState != TerminalConnectivityState.OnlineAndHealthy);
                if (lockState.IsTerminalLocked)
                {
                    // Allow supervisor on /z-reading to finish printing the just-finalized Z-Reading before locking out
                    if (!CurrentRelativePath.Equals("z-reading", StringComparison.OrdinalIgnoreCase))
                    {
                        Session.ClearSession();
                        Http.DefaultRequestHeaders.Authorization = null;
                        Navigation.NavigateTo("/terminal-locked", replace: true);
                        return;
                    }
                }
                else if (lockState.IsCashierRestricted || lockState.IsShiftOwnedByAnotherCashier)
                {
                    Session.ClearSession();
                    POS.Client.Services.DeviceActivationService.ActiveTerminalToken = null;
                    Http.DefaultRequestHeaders.Authorization = null;
                    Navigation.NavigateTo("/login", replace: true);
                    return;
                }
            }
            using var db = new POS.Client.Data.LocalPosDbContext();
            db.InitializeDatabase();
            _pendingCount = db.SyncOutboxes.Count(o => o.Status == "PENDING" || o.Status == "RETRY_PENDING");
            _uploadingCount = db.SyncOutboxes.Count(o => o.Status == "UPLOADING");
            _failedCount = db.SyncOutboxes.Count(o => o.Status == "FAILED" || o.Status == "NEEDS_ATTENTION");
            _lastFailedError = db.SyncOutboxes
                .Where(o => o.Status == "FAILED" || o.Status == "NEEDS_ATTENTION")
                .OrderByDescending(o => o.OutboxId)
                .Select(o => o.LastError)
                .FirstOrDefault();
            var lastOutboxSync = db.SyncOutboxes
                .Where(o => o.Status == "SYNCED")
                .OrderByDescending(o => o.SyncedAt ?? o.CreatedAt)
                .Select(o => o.SyncedAt ?? o.CreatedAt)
                .FirstOrDefault();
            var refSync = await ReferenceDataSync.GetLastSuccessfulSyncAsync();
            _lastSyncTime = lastOutboxSync != default && (!refSync.HasValue || lastOutboxSync > refSync.Value)
                ? lastOutboxSync
                : refSync;
            if (_connectivityState == TerminalConnectivityState.OnlineAndHealthy && db.Cashiers.Count() <= 1)
            {
                await EnsureCashiersCachedAsync();
            }
            await RefreshHeldCountAsync();
            StateHasChanged();
        }
        catch
        {
            // Suppress background poll errors
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        Cart.OnChange -= OnCartStateChanged;
        Session.OnChange -= OnSessionStateChanged;
        ReferenceDataSync.OnSyncCompleted -= OnReferenceSyncCompleted;
        TransactionSyncService.OnSyncStateChanged -= OnTransactionSyncStateChanged;
        _statusTimer?.Dispose();
    }

    private void CloseNavMenu() => isNavVisible = false;

    private async Task EnsureCashiersCachedAsync()
    {
        try
        {
            var users = await UserService.GetUsersAsync();
            var validUsers = users?.Where(u => !string.IsNullOrWhiteSpace(u.PinCode) && u.PinCode != "****").ToList();
            if (validUsers == null || validUsers.Count == 0) return;

            await POS.Client.Data.LocalPosDbContext.WriteLock.WaitAsync();
            try
            {
                using var db = new POS.Client.Data.LocalPosDbContext();
                db.InitializeDatabase();
                await db.Database.ExecuteSqlRawAsync("DELETE FROM LocalCashiers;");
                db.ChangeTracker.Clear();
                var syncedUtc = POS.Shared.Services.BusinessDayClock.UtcNow();
                foreach (var u in validUsers)
                {
                    var pinHash = Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(u.PinCode!.Trim())));
                    db.Cashiers.Add(new POS.Client.Data.LocalCashier
                    {
                        UserId = u.UserId,
                        Username = u.Username,
                        Role = u.Role ?? "Cashier",
                        PinHash = pinHash,
                        SyncedAtUtc = syncedUtc
                    });
                }
                await db.SaveChangesAsync();
            }
            finally
            {
                POS.Client.Data.LocalPosDbContext.WriteLock.Release();
            }
        }
        catch { }
    }

    private async Task CacheCurrentOutletAsync(POS.Shared.Models.TerminalConfigDto? outlet)
    {
        if (_connectivityState == TerminalConnectivityState.OnlineAndHealthy)
        {
            await EnsureCashiersCachedAsync();
        }
        if (outlet == null) return;
        try
        {
            await POS.Client.Data.LocalPosDbContext.WriteLock.WaitAsync();
            try
            {
                using var db = new POS.Client.Data.LocalPosDbContext();
                db.InitializeDatabase();
                var existing = db.TerminalConfigs.FirstOrDefault(o => o.TerminalId == outlet.TerminalId);
                if (existing == null)
                {
                    db.TerminalConfigs.Add(new POS.Client.Data.LocalTerminalConfig
                    {
                        TerminalId = outlet.TerminalId,
                        OutletId = outlet.OutletId, OutletName = outlet.OutletName, TerminalCode = outlet.TerminalCode,
                        IpAddress = outlet.IpAddress, PTUNumber = outlet.PTUNumber, MINNumber = outlet.MINNumber, SerialNumber = outlet.SerialNumber,
                        BranchId = outlet.BranchId,
                        BusinessTypeId = outlet.BusinessTypeId ?? 1,
                        BusinessType = outlet.BusinessType ?? "FNB",
                        MenuDisplayMode = outlet.MenuDisplayMode == POS.Shared.Models.MenuDisplayMode.ImageAndText
                            ? POS.Shared.Models.MenuDisplayMode.ImageAndText : POS.Shared.Models.MenuDisplayMode.TextOnly,
                        BranchName = outlet.BranchName,
                        BranchCode = outlet.BranchCode,
                        BranchAddress = outlet.BranchAddress,
                        BranchPhone = outlet.BranchPhone,
                        ReceiptLogoUrl = outlet.ReceiptLogoUrl,
                        ReceiptLogoDataUri = outlet.ReceiptLogoDataUri,
                        ReceiptLogoUpdatedAt = outlet.ReceiptLogoUpdatedAt,
                        VatDisplay = outlet.VatDisplay,
                        TerminalName = outlet.TerminalName,
                        BranchTaxType = string.IsNullOrWhiteSpace(outlet.BranchTaxType) ? "VAT-Registered" : outlet.BranchTaxType,
                        TerminalIdentifier = outlet.TerminalName
                    });
                    await db.SaveChangesAsync();
                }
            }
            finally
            {
                POS.Client.Data.LocalPosDbContext.WriteLock.Release();
            }
        }
        catch { }
    }

    private Task RequestLogout()
    {
        if (_isExitingSession) return Task.CompletedTask;
        _sessionExitMode = "logout";
        _sessionExitError = null;
        _confirmDiscardCart = false;
        _showSessionExitModal = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task SwitchCashier()
    {
        if (_isExitingSession) return Task.CompletedTask;
        _sessionExitMode = "switch";
        _sessionExitError = null;
        _confirmDiscardCart = false;
        _showSessionExitModal = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void CancelSessionExit()
    {
        if (_isExitingSession) return;
        _showSessionExitModal = false;
        _sessionExitError = null;
        _confirmDiscardCart = false;
    }

    private void HandleSessionExitBackdropClick()
    {
        if (!_isExitingSession)
        {
            CancelSessionExit();
        }
    }

    private async Task HoldCartAndExitSessionAsync()
    {
        if (_isExitingSession) return;
        _isExitingSession = true;
        _sessionExitError = null;

        try
        {
            if (Cart.Items.Count > 0 && Session.Terminal != null)
            {
                var createDto = new POS.Shared.Models.HeldSaleCreateDto
                {
                    BranchId = Session.Terminal.BranchId,
                    OutletId = Session.Terminal.OutletId,
                    TerminalId = Session.Terminal.TerminalId,
                    CashierId = Session.Username ?? "cashier",
                    CustomerName = "Walk-in",
                    Notes = $"Held before {(_sessionExitMode == "switch" ? "Switch Cashier" : "Logout")} at {POS.Shared.Services.BusinessDayClock.FormatManila(DateTime.UtcNow, "HH:mm")}",
                    Subtotal = Cart.Subtotal,
                    DiscountAmount = Cart.ActiveDiscountAmount,
                    DiscountCode = Cart.ActiveDiscountCode != "NONE" ? Cart.ActiveDiscountCode : null,
                    CustomerCardNumber = Cart.CustomerCardNumber,
                    TotalAmount = Cart.TotalAmount,
                    Items = Cart.Items.Select(ci => new POS.Shared.Models.HeldSaleItemDto
                    {
                        ProductId = ci.ProductId,
                        ProductName = ci.ProductName,
                        ProductShortCode = ci.ProductShortCode,
                        Quantity = ci.Quantity,
                        BasePrice = ci.BasePrice,
                        LineTotal = ci.LineTotal,
                        PricingMethod = ci.PricingMethod,
                        UnitOfMeasure = ci.UnitOfMeasure,
                        TargetAmount = ci.TargetAmount,
                        IsComplimentary = ci.IsComplimentary,
                        ParentProductId = ci.ParentProductId,
                        IsKitchenItem = ci.IsKitchenItem,
                        IsBarItem = ci.IsBarItem,
                        TaxName = ci.TaxName ?? "VATable",
                        SpecialInstructions = ci.SpecialInstructions,
                        Modifiers = ci.SelectedModifiers?.Select(m => new POS.Shared.Models.HeldSaleModifierDto
                        {
                            ModifierOptionId = m.ModifierOptionId,
                            ProductId = m.ProductId,
                            ProductName = m.ProductName,
                            ModifierName = m.Name,
                            AdditionalPrice = m.Price
                        }).ToList() ?? new()
                    }).ToList()
                };

                var held = await HeldSaleService.CreateHeldSaleAsync(createDto);
                if (held == null)
                {
                    _sessionExitError = "Failed to hold the current sale. Please try again or cancel.";
                    return;
                }

                Cart.Clear();
                await RefreshHeldCountAsync();
            }

            await PerformSignOutCoreAsync();
        }
        catch (Exception ex)
        {
            _sessionExitError = $"Unable to hold sale and sign out: {ex.Message}";
        }
        finally
        {
            _isExitingSession = false;
        }
    }

    private async Task ConfirmSessionExitAsync()
    {
        if (_isExitingSession) return;
        if (Cart.Items.Count > 0 && !_confirmDiscardCart)
        {
            _sessionExitError = "Hold the active cart or check the confirmation box to discard unheld items before signing out.";
            return;
        }

        _isExitingSession = true;
        _sessionExitError = null;

        try
        {
            await PerformSignOutCoreAsync();
        }
        catch (Exception ex)
        {
            _sessionExitError = $"Unable to sign out: {ex.Message}";
        }
        finally
        {
            _isExitingSession = false;
        }
    }

    /// <summary>
    /// Ends client authentication ONLY while preserving the cashier's open CashDrawerShift and terminal shift ownership.
    /// Does NOT close shifts, apply Close Cashier restrictions, or release terminal ownership.
    /// </summary>
    private async Task PerformSignOutCoreAsync()
    {
        var currentOutlet = Session.Terminal;
        await CacheCurrentOutletAsync(currentOutlet);
        Session.ClearSession();
        POS.Client.Services.DeviceActivationService.ActiveTerminalToken = null;
        Http.DefaultRequestHeaders.Authorization = null;
        _showSessionExitModal = false;
        _confirmDiscardCart = false;
        Navigation.NavigateTo("/login", replace: true);
    }
}
