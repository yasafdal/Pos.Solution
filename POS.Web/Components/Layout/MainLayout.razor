@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Components.Authorization

<AuthorizeView>
    <Authorized>
        <div class="app-wrapper @(isMobileSidebarOpen ? "mobile-sidebar-open" : "") @(isDesktopSidebarCollapsed ? "sidebar-collapse" : "")">
            <!-- Header Navbar -->
            <nav class="app-header navbar navbar-expand bg-white border-bottom shadow-sm">
                <div class="container-fluid">
                    <!-- Sidebar Toggle (Accessible on all screens) -->
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item">
                            <button type="button"
                                    class="nav-link text-dark btn btn-link p-1 border-0 shadow-none d-flex align-items-center sidebar-toggle-btn"
                                    @onclick="ToggleSidebar"
                                    aria-label="Toggle navigation"
                                    aria-expanded="@(isMobileSidebarOpen ? "true" : "false")">
                                <i class="bi bi-list fs-3"></i>
                            </button>
                        </li>
                    </ul>

                    <!-- Right Navbar Items (Auth / User) -->
                    <ul class="navbar-nav ms-auto align-items-center gap-2">
                        <li class="nav-item d-none d-md-flex align-items-center me-2">
                            <span class="nav-link text-secondary fw-medium px-2">
                                <i class="bi bi-person-circle me-1 text-primary"></i> @context.User.Identity?.Name
                            </span>
                        </li>
                        <li class="nav-item">
                            <button @onclick="Logout" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-medium">
                                <i class="bi bi-box-arrow-right me-1"></i> Logout
                            </button>
                        </li>
                    </ul>
                </div>
            </nav>

            <!-- Semi-transparent backdrop overlay on mobile and tablet -->
            @if (isMobileSidebarOpen)
            {
                <div class="sidebar-backdrop" @onclick="CloseMobileSidebar" aria-hidden="true"></div>
            }

            <!-- App Sidebar (Off-canvas on mobile/tablet, docked on desktop) -->
            <aside class="app-sidebar original-sidebar shadow @(isMobileSidebarOpen ? "show-mobile" : "")" data-bs-theme="dark">
                <div class="sidebar-brand border-bottom border-white border-opacity-10 d-flex align-items-center justify-content-between px-3">
                    <a href="" class="brand-link text-decoration-none d-flex align-items-center flex-grow-1" @onclick="CloseMobileSidebar">
                        <i class="bi bi-shop text-warning fs-4 brand-icon"></i>
                        <span class="brand-text fw-bold fs-5 text-white ms-2">POS System</span>
                    </a>
                    <!-- Close (X) button visible only on mobile/tablet -->
                    <button type="button"
                            class="btn btn-link text-white text-opacity-75 p-1 close-sidebar-btn"
                            @onclick="CloseMobileSidebar"
                            aria-label="Close sidebar">
                        <i class="bi bi-x-lg fs-5"></i>
                    </button>
                </div>
                <div class="sidebar-wrapper">
                    <NavMenu OnNavigate="CloseMobileSidebar" />
                </div>
            </aside>

            <!-- Main Content Area -->
            <main class="app-main bg-white">
                <div class="app-content py-3 px-4">
                    <div class="container-fluid px-0">
                        @Body
                    </div>
                </div>
            </main>

            <!-- Footer -->
            <footer class="app-footer text-secondary small py-2 px-4 border-top bg-white">
                <div class="float-end d-none d-sm-inline">
                    <b>Version</b> 1.0.0
                </div>
                <strong>&copy; 2026 POS System.</strong> All rights reserved.
            </footer>
        </div>
    </Authorized>
    <NotAuthorized>
        <!-- Automatically push unauthenticated users to the login page -->
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool isMobileSidebarOpen;
    private bool isDesktopSidebarCollapsed;
    private DotNetObjectReference<MainLayout>? dotNetHelper;

    protected override void OnInitialized()
    {
        NavManager.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                dotNetHelper = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("posSidebar.init", dotNetHelper);
            }
            catch { }
        }
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (isMobileSidebarOpen)
        {
            await CloseMobileSidebar();
        }
    }

    private async Task ToggleSidebar()
    {
        try
        {
            var isDesktop = await JS.InvokeAsync<bool>("posSidebar.isDesktop");
            if (isDesktop)
            {
                isDesktopSidebarCollapsed = !isDesktopSidebarCollapsed;
            }
            else
            {
                isMobileSidebarOpen = !isMobileSidebarOpen;
                await UpdateBodyScrollLock();
            }
        }
        catch
        {
            isMobileSidebarOpen = !isMobileSidebarOpen;
            await UpdateBodyScrollLock();
        }
    }

    private async Task CloseMobileSidebar()
    {
        if (isMobileSidebarOpen)
        {
            isMobileSidebarOpen = false;
            await UpdateBodyScrollLock();
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task CloseFromJs()
    {
        if (isMobileSidebarOpen)
        {
            isMobileSidebarOpen = false;
            await UpdateBodyScrollLock();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task UpdateBodyScrollLock()
    {
        try
        {
            await JS.InvokeVoidAsync("posSidebar.setBodyScrollLock", isMobileSidebarOpen);
        }
        catch { }
    }

    private async Task Logout()
    {
        var customAuthStateProvider = (POS.Web.Auth.CustomAuthStateProvider)AuthStateProvider;
        await customAuthStateProvider.LogOutAsync();
        NavManager.NavigateTo("/login", true);
    }

    public async ValueTask DisposeAsync()
    {
        NavManager.LocationChanged -= OnLocationChanged;
        try
        {
            await JS.InvokeVoidAsync("posSidebar.dispose");
        }
        catch { }
        dotNetHelper?.Dispose();
    }
}
