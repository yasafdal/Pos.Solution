@implements IDisposable

@inject NavigationManager NavigationManager

<nav class="mt-2" aria-label="Main navigation">
    <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="menu" data-accordion="false">
        <li class="nav-header text-uppercase text-secondary fw-bold small px-3 mb-1">Navigation</li>
        <li class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All" title="Home">
                <i class="nav-icon bi bi-house-door-fill"></i>
                <p>Home</p>
            </NavLink>
        </li>

        <li class="nav-header text-uppercase text-secondary fw-bold small px-3 mb-1 mt-2">Management</li>
        <li class="nav-item">
            <NavLink class="nav-link" href="manage-categories" Match="NavLinkMatch.Prefix" title="Categories">
                <i class="nav-icon bi bi-tags-fill"></i>
                <p>Categories</p>
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link" href="manage-products" Match="NavLinkMatch.Prefix" title="Products">
                <i class="nav-icon bi bi-box-seam-fill"></i>
                <p>Products</p>
            </NavLink>
        </li>

        <li class="nav-header text-uppercase text-secondary fw-bold small px-3 mb-1 mt-2">Security</li>
        <li class="nav-item">
            <NavLink class="nav-link" href="auth" title="Auth Required">
                <i class="nav-icon bi bi-shield-lock-fill"></i>
                <p>Auth Required</p>
            </NavLink>
        </li>

        <AuthorizeView>
            <Authorized>
                <li class="nav-header text-uppercase text-secondary fw-bold small px-3 mb-1 mt-2">Account</li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="Account/Manage" title="@context.User.Identity?.Name">
                        <i class="nav-icon bi bi-person-circle"></i>
                        <p>@context.User.Identity?.Name</p>
                    </NavLink>
                </li>
                <li class="nav-item">
                    <form action="Account/Logout" method="post" class="m-0">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link btn btn-link text-start w-100 border-0" title="Logout">
                            <i class="nav-icon bi bi-box-arrow-right text-danger"></i>
                            <p class="text-danger mb-0">Logout</p>
                        </button>
                    </form>
                </li>
            </Authorized>
            <NotAuthorized>
                <li class="nav-header text-uppercase text-secondary fw-bold small px-3 mb-1 mt-2">Account</li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="Account/Login" title="Login">
                        <i class="nav-icon bi bi-box-arrow-in-right"></i>
                        <p>Login</p>
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="Account/Register" title="Register">
                        <i class="nav-icon bi bi-person-plus-fill"></i>
                        <p>Register</p>
                    </NavLink>
                </li>
            </NotAuthorized>
        </AuthorizeView>
    </ul>
</nav>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

