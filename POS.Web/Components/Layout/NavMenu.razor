@implements IDisposable
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Components.Authorization

<nav class="mt-2" aria-label="Main navigation">
    <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="menu" data-accordion="false">
        
        <li class="nav-header text-uppercase text-secondary fw-bold small px-3 mb-1">Navigation</li>
        <li class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All" title="Dashboard">
                <i class="nav-icon bi bi-house-door-fill"></i>
                <p>Dashboard</p>
            </NavLink>
        </li>

        <li class="nav-header text-uppercase text-secondary fw-bold small px-3 mb-1 mt-2">Management</li>
        <li class="nav-item">
            <NavLink class="nav-link" href="manage-categories" Match="NavLinkMatch.Prefix" title="Categories">
                <i class="nav-icon bi bi-tags-fill"></i>
                <p>Categories</p>
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link" href="manage-products" Match="NavLinkMatch.Prefix" title="Products">
                <i class="nav-icon bi bi-box-seam-fill"></i>
                <p>Products</p>
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link" href="modifiers" Match="NavLinkMatch.Prefix" title="Product Modifiers"><i class="nav-icon bi bi-ui-checks-grid"></i><p>Product Modifiers</p></NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link" href="branches" Match="NavLinkMatch.Prefix" title="Branches">
                <i class="nav-icon bi bi-shop"></i>
                <p>Branches</p>
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link" href="inventory" Match="NavLinkMatch.Prefix" title="Inventory & Stock">
                <i class="nav-icon bi bi-box-seam"></i>
                <p>Inventory & Stock</p>
            </NavLink>
        </li>

        <li class="nav-header text-uppercase text-secondary fw-bold small px-3 mb-1 mt-2">Settings</li>
        <li class="nav-item">
            <NavLink class="nav-link" href="uom" Match="NavLinkMatch.Prefix" title="UOM">
                <i class="nav-icon bi bi-rulers"></i>
                <p>UOM</p>
            </NavLink>
        </li>

        <li class="nav-item">
            <NavLink class="nav-link" href="business-type" Match="NavLinkMatch.Prefix" title="Business Type">
                <i class="nav-icon bi bi-rulers"></i>
                <p>Business Type</p>
            </NavLink>
        </li>

        <li class="nav-item">
            <NavLink class="nav-link" href="business-mode" Match="NavLinkMatch.Prefix" title="Business Mode">
                <i class="nav-icon bi bi-rulers"></i>
                <p>Service Mode</p>
            </NavLink>
        </li>

        <AuthorizeView Roles="Admin, Manager">
            <Authorized>
                <li class="nav-header text-uppercase text-secondary fw-bold small px-3 mb-1 mt-2">Admin</li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="users" Match="NavLinkMatch.Prefix" title="Users">
                        <i class="nav-icon bi bi-people"></i>
                        <p>Users</p>
                    </NavLink>
                </li>
            </Authorized>
        </AuthorizeView>
    </ul>
</nav>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}