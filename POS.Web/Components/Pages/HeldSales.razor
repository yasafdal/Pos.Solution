@page "/held-sales"
@using System.Security.Claims
@using POS.Shared.Models
@using POS.Shared.Interfaces
@using CurrieTechnologies.Razor.SweetAlert2
@inject IHeldSaleService HeldSaleService
@inject IBranchService BranchService
@inject IOutletService OutletService
@inject ITerminalService TerminalService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject SweetAlertService Swal

<PageTitle>Held Sales Management - POS Admin</PageTitle>

<div class="w-100 py-2">
    <!-- Header Toolbar -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-3">
        <div>
            <h2 class="fw-bolder mb-1 text-dark" style="letter-spacing: -0.5px;">Held Sales Management</h2>
            <span class="text-secondary" style="font-size: 0.95rem;">Monitor suspended customer tickets and active parked orders across Branch → Outlet → Terminal</span>
        </div>
        <div>
            <button class="btn btn-primary rounded px-4 py-2 fw-bold shadow-sm text-nowrap" @onclick="LoadHeldSales">
                <i class="bi bi-arrow-repeat me-1"></i> Refresh List
            </button>
        </div>
    </div>

    <!-- Cascading Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-3 bg-white">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label text-dark fw-semibold small mb-1">Branch</label>
                <select class="form-select form-select-sm rounded-3" value="@(filterBranchId?.ToString() ?? "")" @onchange="OnBranchChanged" disabled="@(lockedBranchId.HasValue)">
                    @if (!lockedBranchId.HasValue)
                    {
                        <option value="">All Branches</option>
                    }
                    @foreach (var b in AuthorizedBranches)
                    {
                        <option value="@b.BranchId">@b.Name (@b.Code)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label text-dark fw-semibold small mb-1">Outlet</label>
                <select class="form-select form-select-sm rounded-3" value="@(filterOutletId?.ToString() ?? "")" @onchange="OnOutletChanged">
                    <option value="">All Outlets</option>
                    @foreach (var o in FilteredOutlets)
                    {
                        <option value="@o.OutletId">@o.Name (@o.OutletCode)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label text-dark fw-semibold small mb-1">Terminal</label>
                <select class="form-select form-select-sm rounded-3" value="@(filterTerminalId?.ToString() ?? "")" @onchange="OnTerminalChanged" disabled="@(lockedTerminalId.HasValue)">
                    @if (!lockedTerminalId.HasValue)
                    {
                        <option value="">All Terminals</option>
                    }
                    @foreach (var t in FilteredTerminals)
                    {
                        <option value="@t.TerminalId">@t.Name (@t.TerminalCode)</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button class="btn btn-dark btn-sm rounded-3 px-3 fw-bold w-100" @onclick="LoadHeldSales">
                    <i class="bi bi-funnel-fill me-1"></i> Filter
                </button>
                <button class="btn btn-outline-secondary btn-sm rounded-3 px-3 w-100" @onclick="ResetFilters">
                    Reset
                </button>
            </div>
        </div>
    </div>

    <!-- Main Grid -->
    <div class="w-100">
        @if (heldSales == null)
        {
            <div class="text-center py-5 text-muted">
                <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                Loading held sales...
            </div>
        }
        else if (!heldSales.Any())
        {
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
                <i class="bi bi-pause-circle fs-1 text-secondary mb-2"></i>
                <h5 class="fw-bold text-dark">No Active Held Sales</h5>
                <p class="text-secondary small mb-0">There are currently no suspended transactions parked on any matching terminal.</p>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light text-uppercase fs-7 text-secondary">
                            <tr>
                                <th class="py-3 px-4">Hold Reference</th>
                                <th class="py-3">Branch → Outlet → Terminal</th>
                                <th class="py-3">Customer / Notes</th>
                                <th class="py-3">Cashier</th>
                                <th class="py-3">Time Held</th>
                                <th class="py-3 text-center">Items</th>
                                <th class="py-3 text-end px-4">Total Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var h in heldSales)
                            {
                                <tr>
                                    <td class="px-4 fw-bold font-monospace text-primary">@h.HoldReference</td>
                                    <td class="small">
                                        <div class="fw-semibold text-dark">@h.BranchName → @h.OutletName</div>
                                        <span class="badge bg-light text-dark border">@h.TerminalName (@h.TerminalCode)</span>
                                    </td>
                                    <td>
                                        <strong>@(string.IsNullOrWhiteSpace(h.CustomerName) ? "Walk-in" : h.CustomerName)</strong>
                                        @if (!string.IsNullOrWhiteSpace(h.Notes))
                                        {
                                            <br /><small class="text-secondary">@h.Notes</small>
                                        }
                                    </td>
                                    <td>@h.CashierId</td>
                                    <td class="text-secondary small">@h.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="text-center"><span class="badge bg-secondary-subtle text-dark">@h.Items.Sum(i => i.Quantity)</span></td>
                                    <td class="text-end px-4 fw-bold text-dark">₱@h.TotalAmount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<HeldSaleDto>? heldSales;
    private List<BranchDto> allBranches = new();
    private List<OutletDto> allOutlets = new();
    private List<TerminalDto> allTerminals = new();

    private int? filterBranchId;
    private int? filterOutletId;
    private int? filterTerminalId;
    private int? lockedBranchId;
    private int? lockedTerminalId;

    private IEnumerable<BranchDto> AuthorizedBranches => lockedBranchId.HasValue
        ? allBranches.Where(b => b.BranchId == lockedBranchId.Value)
        : allBranches;

    private IEnumerable<OutletDto> FilteredOutlets => filterBranchId.HasValue
        ? allOutlets.Where(o => o.BranchId == filterBranchId.Value)
        : (lockedBranchId.HasValue ? allOutlets.Where(o => o.BranchId == lockedBranchId.Value) : allOutlets);

    private IEnumerable<TerminalDto> FilteredTerminals => allTerminals.Where(t =>
        (!filterBranchId.HasValue || t.BranchId == filterBranchId.Value) &&
        (!filterOutletId.HasValue || t.OutletId == filterOutletId.Value) &&
        (!lockedTerminalId.HasValue || t.TerminalId == lockedTerminalId.Value));

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            var role = user.FindFirst(ClaimTypes.Role)?.Value ?? user.FindFirst("role")?.Value ?? "";
            if (!role.Equals("Admin", StringComparison.OrdinalIgnoreCase) &&
                int.TryParse(user.FindFirst("branch_id")?.Value, out int bId))
            {
                lockedBranchId = bId;
                filterBranchId = bId;
            }
            if (!role.Equals("Admin", StringComparison.OrdinalIgnoreCase) &&
                !role.Equals("Manager", StringComparison.OrdinalIgnoreCase) &&
                int.TryParse(user.FindFirst("terminal_id")?.Value, out int tId))
            {
                lockedTerminalId = tId;
                filterTerminalId = tId;
            }
        }

        try
        {
            allBranches = await BranchService.GetBranchesAsync();
            allOutlets = await OutletService.GetOutletsAsync(lockedBranchId);
            allTerminals = await TerminalService.GetTerminalsAsync(outletId: null, branchId: lockedBranchId);
        }
        catch { }

        await LoadHeldSales();
    }

    private void OnBranchChanged(ChangeEventArgs e)
    {
        filterBranchId = int.TryParse(e.Value?.ToString(), out int id) ? id : lockedBranchId;
        filterOutletId = null;
        if (!lockedTerminalId.HasValue) filterTerminalId = null;
    }

    private void OnOutletChanged(ChangeEventArgs e)
    {
        filterOutletId = int.TryParse(e.Value?.ToString(), out int id) ? id : null;
        if (!lockedTerminalId.HasValue) filterTerminalId = null;
    }

    private void OnTerminalChanged(ChangeEventArgs e)
    {
        filterTerminalId = int.TryParse(e.Value?.ToString(), out int id) ? id : lockedTerminalId;
        if (filterTerminalId.HasValue)
        {
            var term = allTerminals.FirstOrDefault(t => t.TerminalId == filterTerminalId.Value);
            if (term != null)
            {
                filterBranchId = term.BranchId;
                filterOutletId = term.OutletId;
            }
        }
    }

    private async Task LoadHeldSales()
    {
        try
        {
            heldSales = await HeldSaleService.GetHeldSalesAsync(filterBranchId, filterTerminalId, filterOutletId);
        }
        catch (Exception ex)
        {
            await Swal.FireAsync("Error", "Failed to load held sales: " + ex.Message, SweetAlertIcon.Error);
        }
    }

    private async Task ResetFilters()
    {
        filterBranchId = lockedBranchId;
        filterOutletId = null;
        filterTerminalId = lockedTerminalId;
        await LoadHeldSales();
    }
}
