@page "/modifiers"
@using POS.Shared.Models
@using POS.Shared.Interfaces
@using Microsoft.AspNetCore.Components.QuickGrid
@using CurrieTechnologies.Razor.SweetAlert2
@using System.Linq
@inject IModifierService ModifierService
@inject SweetAlertService Swal

<PageTitle>Product Modifiers - POS</PageTitle>

<div class="w-100 py-2">
    <!-- Header Toolbar -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-3">
        <div>
            <h2 class="fw-bolder mb-1 text-dark" style="letter-spacing: -0.5px;">Product Modifiers</h2>
            <span class="text-secondary" style="font-size: 0.95rem;">Manage modifier groups (Size, Sugar Level, Add-ons) and their options</span>
        </div>
        
        <div>
            <button class="btn btn-primary rounded px-4 py-2 fw-bold shadow-sm text-nowrap" @onclick="OpenNewGroupModal">
                Add Modifier Group
            </button>
        </div>
    </div>

    <!-- Search Row (Right Aligned) -->
    <div class="d-flex justify-content-end mb-3">
        <div class="position-relative" style="width: 280px;">
            <i class="bi bi-search position-absolute text-muted" style="left: 12px; top: 50%; transform: translateY(-50%); pointer-events: none; font-size: 0.85rem;"></i>
            <input type="search" class="form-control form-control-sm rounded ps-4 bg-white shadow-none border"
                   placeholder="Search modifier groups..."
                   @bind="searchTerm"
                   @bind:event="oninput" />
        </div>
    </div>

    <!-- Main Grid -->
    <div class="w-100">
        @if (modifierGroups == null)
        {
            <div class="text-center py-5 text-muted">
                <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                Loading modifier groups...
            </div>
        }
        else
        {
            <div class="commercial-grid table-responsive w-100">
                <QuickGrid Items="@FilteredGroups" Pagination="@pagination" Theme="commercial">
                    <!-- Col 1: Name -->
                    <PropertyColumn Property="@(g => g.Name)" Title="Group Name" Sortable="true" Align="Align.Left" />

                    <!-- Col 2: Required / Optional -->
                    <TemplateColumn Context="group" Title="Requirement" Align="Align.Center">
                        @if (group.IsRequired)
                        {
                            <span class="requirement-badge required">
                                <i class="bi bi-asterisk me-1" style="font-size: 0.65rem;"></i>Required
                            </span>
                        }
                        else
                        {
                            <span class="requirement-badge optional">
                                Optional
                            </span>
                        }
                    </TemplateColumn>

                    <!-- Col 3: Options Summary -->
                    <TemplateColumn Context="group" Title="Options" Align="Align.Center">
                        @if (group.Options != null && group.Options.Any())
                        {
                            <div class="options-container d-flex flex-column align-items-center gap-1 py-1">
                                @foreach (var chunk in group.Options.Chunk(2))
                                {
                                    <div class="d-flex align-items-center justify-content-center gap-1 options-row">
                                        @foreach (var opt in chunk)
                                        {
                                            <span class="modifier-option-chip" title="@opt.Name (@(opt.Price > 0 ? $"+₱{opt.Price:N2}" : "Free"))">
                                                <span>@opt.Name</span>
                                                @if (opt.Price > 0)
                                                {
                                                    <span class="price-tag">+₱@opt.Price.ToString("N2")</span>
                                                }
                                                else
                                                {
                                                    <span class="free-tag">Free</span>
                                                }
                                            </span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="text-muted fst-italic small">No options configured</span>
                        }
                    </TemplateColumn>

                    <!-- Col 4: Status -->
                    <TemplateColumn Context="group" Title="Status" Align="Align.Center">
                        @if (group.IsActive)
                        {
                            <span class="status-badge active">Active</span>
                        }
                        else
                        {
                            <span class="status-badge inactive">Inactive</span>
                        }
                    </TemplateColumn>

                    <!-- Col 5: Actions -->
                    <TemplateColumn Context="group" Title="Actions" Align="Align.Right">
                        <HeaderTemplate>
                            <div class="actions-header-wrap">
                                <span class="actions-header-text">Actions</span>
                            </div>
                        </HeaderTemplate>
                        <ChildContent>
                            <div class="actions-cell-wrap d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-sm btn-primary text-white" @onclick="() => OpenOptionsModal(group)" title="Manage Options" aria-label="Manage Options">
                                    <i class="bi bi-sliders"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-warning text-dark" @onclick="() => OpenEditGroupModal(group)" title="Edit Group" aria-label="Edit Group">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-danger text-white" @onclick="() => DeleteGroup(group.ModifierGroupId)" title="Delete Group" aria-label="Delete Group">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </ChildContent>
                    </TemplateColumn>
                </QuickGrid>
            </div>

            <!-- Pagination Bar -->
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center pt-3 mt-1 border-top gap-3">
                <div class="text-secondary small fw-medium">
                    @GetShowingRangeText()
                </div>

                <nav aria-label="Modifier groups pagination">
                    <ul class="pagination mb-0">
                        <li class="page-item @(pagination.CurrentPageIndex == 0 ? "disabled" : "")">
                            <button type="button" class="page-link" @onclick="() => GoToPage(pagination.CurrentPageIndex - 1)" disabled="@(pagination.CurrentPageIndex == 0)" aria-label="Previous">
                                Previous
                            </button>
                        </li>

                        @for (int i = 0; i < TotalPages; i++)
                        {
                            var pageIndex = i;
                            var isActive = pagination.CurrentPageIndex == pageIndex;
                            <li class="page-item @(isActive ? "active" : "")" aria-current="@(isActive ? "page" : null)">
                                <button type="button" class="page-link" @onclick="() => GoToPage(pageIndex)">
                                    @(pageIndex + 1)
                                </button>
                            </li>
                        }

                        <li class="page-item @(pagination.CurrentPageIndex >= TotalPages - 1 ? "disabled" : "")">
                            <button type="button" class="page-link" @onclick="() => GoToPage(pagination.CurrentPageIndex + 1)" disabled="@(pagination.CurrentPageIndex >= TotalPages - 1)" aria-label="Next">
                                Next
                            </button>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- Modal: Add / Edit Modifier Group -->
@if (isGroupModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.5); backdrop-filter: blur(3px);" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <EditForm Model="@currentGroup" OnValidSubmit="SaveGroup">
                    <DataAnnotationsValidator />
                    
                    <div class="modal-header border-bottom px-4 py-3 d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="fw-bold text-dark mb-0">@(isEditingGroup ? "Edit Modifier Group" : "New Modifier Group")</h5>
                            <small class="text-secondary" style="font-size: 0.85rem;">
                                @(isEditingGroup ? "Update group rules and selection limits" : "Configure group rules like required selections and limits")
                            </small>
                        </div>
                        <button type="button" class="btn-close shadow-none" @onclick="CloseGroupModal" aria-label="Close"></button>
                    </div>
                    
                    <div class="modal-body px-4 py-3">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label text-dark fw-semibold small mb-1">Group Name <span class="text-danger">*</span></label>
                                <InputText @bind-Value="currentGroup.Name" class="form-control rounded-3" placeholder="e.g. Size, Sugar Level, Add-ons" />
                                <ValidationMessage For="@(() => currentGroup.Name)" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label text-dark fw-semibold small mb-1">Min Selections</label>
                                <InputNumber @bind-Value="currentGroup.MinSelections" class="form-control rounded-3" min="0" />
                                <div class="form-text text-muted" style="font-size: 0.75rem;">0 for optional</div>
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label text-dark fw-semibold small mb-1">Max Selections</label>
                                <InputNumber @bind-Value="currentGroup.MaxSelections" class="form-control rounded-3" min="1" />
                                <div class="form-text text-muted" style="font-size: 0.75rem;">Allowed picks</div>
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label text-dark fw-semibold small mb-1">Display Order</label>
                                <InputNumber @bind-Value="currentGroup.DisplayOrder" class="form-control rounded-3" min="0" />
                                <div class="form-text text-muted" style="font-size: 0.75rem;">POS view sort</div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="p-3 bg-light rounded-3 border d-flex align-items-center justify-content-between h-100">
                                    <div>
                                        <label class="form-check-label fw-semibold text-dark mb-0 d-block" for="groupRequired">Required Selection</label>
                                        <small class="text-secondary" style="font-size: 0.78rem;">Customer must choose an option</small>
                                    </div>
                                    <div class="form-check form-switch mb-0">
                                        <InputCheckbox class="form-check-input" id="groupRequired" @bind-Value="currentGroup.IsRequired" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="p-3 bg-light rounded-3 border d-flex align-items-center justify-content-between h-100">
                                    <div>
                                        <label class="form-check-label fw-semibold text-dark mb-0 d-block" for="groupActive">Active in POS</label>
                                        <small class="text-secondary" style="font-size: 0.78rem;">Visible during order taking</small>
                                    </div>
                                    <div class="form-check form-switch mb-0">
                                        <InputCheckbox class="form-check-input" id="groupActive" @bind-Value="currentGroup.IsActive" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="modal-footer border-top bg-light px-4 py-3 d-flex justify-content-end align-items-center gap-2">
                        <button type="button" class="btn btn-outline-secondary rounded px-4 fw-medium" @onclick="CloseGroupModal">
                            Cancel
                        </button>
                        <button type="submit" class="btn @(isEditingGroup ? "btn-warning text-dark" : "btn-primary") rounded px-4 fw-bold shadow-sm" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            @(isEditingGroup ? "Save Changes" : "Create Group")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- Modal: Manage Options for a Group -->
@if (isOptionsModalOpen && selectedGroup != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.5); backdrop-filter: blur(3px);" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <div class="modal-header border-bottom px-4 py-3 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <div class="d-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-3" style="width: 38px; height: 38px;">
                            <i class="bi bi-sliders fs-5"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold text-dark mb-0">Manage Options: @selectedGroup.Name</h5>
                            <small class="text-secondary" style="font-size: 0.85rem;">Configure selectable choices, prices, and status for this group</small>
                        </div>
                    </div>
                    <button type="button" class="btn-close shadow-none" @onclick="CloseOptionsModal" aria-label="Close"></button>
                </div>
                
                <div class="modal-body px-4 py-3">
                    <!-- Add / Edit Option Form Inline -->
                    <div class="card border rounded-3 mb-3 bg-white shadow-sm overflow-hidden">
                        <div class="card-header bg-light border-bottom py-2 px-3 d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-dark small">
                                <i class="bi @(isEditingOption ? "bi-pencil-square text-warning" : "bi-plus-circle text-primary") me-1"></i>
                                @(isEditingOption ? "Edit Option" : "Add New Option")
                            </span>
                            @if (isEditingOption)
                            {
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle" style="font-size: 0.72rem;">Editing Mode</span>
                            }
                        </div>
                        <div class="card-body p-3">
                            <EditForm Model="@currentOption" OnValidSubmit="SaveOption">
                                <DataAnnotationsValidator />
                                <div class="row g-2 align-items-end">
                                    <div class="col-12 col-md-4">
                                        <label class="form-label small fw-semibold text-dark mb-1 text-nowrap">Option Name <span class="text-danger">*</span></label>
                                        <InputText @bind-Value="currentOption.Name" class="form-control form-control-sm rounded" placeholder="e.g. Regular, Large, 50% Sugar" />
                                    </div>
                                    <div class="col-6 col-sm-3 col-md-2">
                                        <label class="form-label small fw-semibold text-dark mb-1 text-nowrap">Additional Price</label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text bg-light text-secondary border">₱</span>
                                            <InputNumber @bind-Value="currentOption.Price" class="form-control rounded-end" min="0" step="0.25" placeholder="0.00" />
                                        </div>
                                    </div>
                                    <div class="col-6 col-sm-3 col-md-2">
                                        <label class="form-label small fw-semibold text-dark mb-1 text-nowrap">Display Order</label>
                                        <InputNumber @bind-Value="currentOption.DisplayOrder" class="form-control form-control-sm rounded" min="0" />
                                    </div>
                                    <div class="col-6 col-sm-3 col-md-2">
                                        <label class="form-label small fw-semibold text-dark mb-1 text-nowrap">Status</label>
                                        <div class="form-check form-switch d-flex align-items-center ps-0 mb-0" style="height: 31px;">
                                            <InputCheckbox class="form-check-input ms-0 me-2 mt-0" id="optActive" @bind-Value="currentOption.IsActive" style="cursor: pointer;" />
                                            <label class="form-check-label small fw-semibold text-dark mb-0" for="optActive" style="cursor: pointer;">
                                                @(currentOption.IsActive ? "Active" : "Inactive")
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-6 col-sm-3 col-md-2">
                                        <div class="d-flex gap-1" style="height: 31px;">
                                            <button type="submit" class="btn btn-sm @(isEditingOption ? "btn-warning text-dark" : "btn-primary") fw-bold flex-grow-1" disabled="@isSavingOption">
                                                @if (isSavingOption)
                                                {
                                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                                }
                                                @(isEditingOption ? "Save" : "Add")
                                            </button>
                                            @if (isEditingOption)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelEditOption" title="Cancel Editing">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </EditForm>
                        </div>
                    </div>

                    <!-- Options List Table -->
                    <div class="card border rounded-3 overflow-hidden shadow-sm">
                        <div class="table-responsive mb-0">
                            <table class="table table-hover align-middle mb-0 options-sub-table">
                                <thead>
                                    <tr>
                                        <th style="padding-left: 1rem;">Option Name</th>
                                        <th class="text-center" style="width: 130px;">Price</th>
                                        <th class="text-center" style="width: 90px;">Order</th>
                                        <th class="text-center" style="width: 100px;">Status</th>
                                        <th class="text-end pe-3" style="width: 100px;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (groupOptions == null || !groupOptions.Any())
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center py-4 text-muted fst-italic">
                                                <i class="bi bi-inbox fs-4 d-block mb-1 text-secondary opacity-50"></i>
                                                No options found for this group yet. Add one above.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var opt in groupOptions)
                                        {
                                            <tr>
                                                <td style="padding-left: 1rem;">
                                                    <span class="fw-semibold text-dark">@opt.Name</span>
                                                </td>
                                                <td class="text-center">
                                                    @if (opt.Price > 0)
                                                    {
                                                        <span class="fw-bold text-dark">+₱@opt.Price.ToString("N2")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Free</span>
                                                    }
                                                </td>
                                                <td class="text-center text-secondary">
                                                    @opt.DisplayOrder
                                                </td>
                                                <td class="text-center">
                                                    @if (opt.IsActive)
                                                    {
                                                        <span class="status-badge active" style="font-size: 0.72rem; padding: 0.2rem 0.5rem;">Active</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="status-badge inactive" style="font-size: 0.72rem; padding: 0.2rem 0.5rem;">Inactive</span>
                                                    }
                                                </td>
                                                <td class="text-end pe-3">
                                                    <div class="d-inline-flex gap-1">
                                                        <button type="button" class="btn btn-sm btn-warning text-dark sub-action-btn" @onclick="() => EditOption(opt)" title="Edit Option" aria-label="Edit Option">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-sm btn-danger text-white sub-action-btn" @onclick="() => DeleteOption(opt.ModifierOptionId)" title="Delete Option" aria-label="Delete Option">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                
                <div class="modal-footer border-top bg-light px-4 py-3 d-flex justify-content-end">
                    <button type="button" class="btn btn-outline-secondary rounded px-4 fw-medium" @onclick="CloseOptionsModal">
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ModifierGroupDto>? modifierGroups;
    private string searchTerm = string.Empty;
    private PaginationState pagination = new PaginationState { ItemsPerPage = 10 };

    private bool isGroupModalOpen = false;
    private bool isEditingGroup = false;
    private bool isSaving = false;
    private ModifierGroupDto currentGroup = new();

    private bool isOptionsModalOpen = false;
    private ModifierGroupDto? selectedGroup;
    private List<ModifierOptionDto>? groupOptions;
    private ModifierOptionDto currentOption = new();
    private bool isEditingOption = false;
    private bool isSavingOption = false;

    private IQueryable<ModifierGroupDto>? FilteredGroups =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? modifierGroups?.AsQueryable()
            : modifierGroups?.Where(g => g.Name != null && g.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)).AsQueryable();

    private int TotalPages
    {
        get
        {
            var count = FilteredGroups?.Count() ?? 0;
            return Math.Max(1, (int)Math.Ceiling((double)count / pagination.ItemsPerPage));
        }
    }

    private string GetShowingRangeText()
    {
        var total = FilteredGroups?.Count() ?? 0;
        if (total == 0) return "Showing 0 items";
        int start = (pagination.CurrentPageIndex * pagination.ItemsPerPage) + 1;
        int end = Math.Min(start + pagination.ItemsPerPage - 1, total);
        return $"Showing {start}–{end} of {total} modifier groups";
    }

    private async Task GoToPage(int pageIndex)
    {
        if (pageIndex >= 0 && pageIndex < TotalPages)
        {
            await pagination.SetCurrentPageIndexAsync(pageIndex);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadGroups();
    }

    private async Task LoadGroups()
    {
        try
        {
            modifierGroups = await ModifierService.GetModifierGroupsAsync();
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error",
                Text = "Failed to load modifier groups: " + ex.Message,
                Icon = SweetAlertIcon.Error,
                ConfirmButtonText = "OK"
            });
        }
    }

    private void OpenNewGroupModal()
    {
        currentGroup = new ModifierGroupDto { IsActive = true, MinSelections = 0, MaxSelections = 1 };
        isEditingGroup = false;
        isGroupModalOpen = true;
    }

    private void OpenEditGroupModal(ModifierGroupDto group)
    {
        currentGroup = new ModifierGroupDto
        {
            ModifierGroupId = group.ModifierGroupId,
            Name = group.Name,
            IsRequired = group.IsRequired,
            MinSelections = group.MinSelections,
            MaxSelections = group.MaxSelections,
            DisplayOrder = group.DisplayOrder,
            IsActive = group.IsActive
        };
        isEditingGroup = true;
        isGroupModalOpen = true;
    }

    private void CloseGroupModal() => isGroupModalOpen = false;

    private async Task SaveGroup()
    {
        if (string.IsNullOrWhiteSpace(currentGroup.Name))
        {
            await Swal.FireAsync("Warning", "Group name is required.", SweetAlertIcon.Warning);
            return;
        }

        try
        {
            isSaving = true;
            bool success;
            if (isEditingGroup)
            {
                success = await ModifierService.UpdateModifierGroupAsync(currentGroup.ModifierGroupId, currentGroup);
            }
            else
            {
                success = await ModifierService.CreateModifierGroupAsync(currentGroup);
            }

            if (success)
            {
                isGroupModalOpen = false;
                await LoadGroups();
                await Swal.FireAsync("Success", isEditingGroup ? "Modifier group updated successfully." : "Modifier group created successfully.", SweetAlertIcon.Success);
            }
            else
            {
                await Swal.FireAsync("Error", "Could not save modifier group.", SweetAlertIcon.Error);
            }
        }
        catch (Exception ex)
        {
            await Swal.FireAsync("Error", "Failed to save: " + ex.Message, SweetAlertIcon.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteGroup(int id)
    {
        var result = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Are you sure?",
            Text = "You are about to delete this modifier group and all its options!",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonColor = "#d33",
            ConfirmButtonText = "Yes, delete it!"
        });

        if (result.IsConfirmed)
        {
            try
            {
                if (await ModifierService.DeleteModifierGroupAsync(id))
                {
                    await LoadGroups();
                    await Swal.FireAsync("Deleted!", "Modifier group removed.", SweetAlertIcon.Success);
                }
                else
                {
                    await Swal.FireAsync("Error", "Failed to delete modifier group.", SweetAlertIcon.Error);
                }
            }
            catch (Exception ex)
            {
                await Swal.FireAsync("Error", "Failed to delete: " + ex.Message, SweetAlertIcon.Error);
            }
        }
    }

    private async Task OpenOptionsModal(ModifierGroupDto group)
    {
        selectedGroup = group;
        currentOption = new ModifierOptionDto { ModifierGroupId = group.ModifierGroupId, IsActive = true };
        isEditingOption = false;
        await LoadGroupOptions(group.ModifierGroupId);
        isOptionsModalOpen = true;
    }

    private async Task LoadGroupOptions(int groupId)
    {
        groupOptions = await ModifierService.GetOptionsByGroupAsync(groupId);
    }

    private void CloseOptionsModal()
    {
        isOptionsModalOpen = false;
        selectedGroup = null;
        groupOptions = null;
    }

    private void EditOption(ModifierOptionDto opt)
    {
        currentOption = new ModifierOptionDto
        {
            ModifierOptionId = opt.ModifierOptionId,
            ModifierGroupId = opt.ModifierGroupId,
            Name = opt.Name,
            Price = opt.Price,
            DisplayOrder = opt.DisplayOrder,
            IsActive = opt.IsActive
        };
        isEditingOption = true;
    }

    private void CancelEditOption()
    {
        if (selectedGroup != null)
        {
            currentOption = new ModifierOptionDto { ModifierGroupId = selectedGroup.ModifierGroupId, IsActive = true };
        }
        isEditingOption = false;
    }

    private async Task SaveOption()
    {
        if (selectedGroup == null || string.IsNullOrWhiteSpace(currentOption.Name))
        {
            await Swal.FireAsync("Warning", "Option name is required.", SweetAlertIcon.Warning);
            return;
        }

        try
        {
            isSavingOption = true;
            bool success;
            if (isEditingOption)
            {
                success = await ModifierService.UpdateOptionAsync(currentOption.ModifierOptionId, currentOption);
            }
            else
            {
                currentOption.ModifierGroupId = selectedGroup.ModifierGroupId;
                success = await ModifierService.CreateOptionAsync(currentOption);
            }

            if (success)
            {
                await LoadGroupOptions(selectedGroup.ModifierGroupId);
                await LoadGroups(); // refresh groups summary
                CancelEditOption();
                await Swal.FireAsync("Success", isEditingOption ? "Option updated." : "Option added.", SweetAlertIcon.Success);
            }
            else
            {
                await Swal.FireAsync("Error", "Failed to save option.", SweetAlertIcon.Error);
            }
        }
        catch (Exception ex)
        {
            await Swal.FireAsync("Error", "Failed to save option: " + ex.Message, SweetAlertIcon.Error);
        }
        finally
        {
            isSavingOption = false;
        }
    }

    private async Task DeleteOption(int optionId)
    {
        var result = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Delete Option?",
            Text = "Are you sure you want to remove this option?",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonColor = "#d33",
            ConfirmButtonText = "Yes, delete"
        });

        if (result.IsConfirmed && selectedGroup != null)
        {
            try
            {
                if (await ModifierService.DeleteOptionAsync(optionId))
                {
                    await LoadGroupOptions(selectedGroup.ModifierGroupId);
                    await LoadGroups();
                    await Swal.FireAsync("Deleted!", "Option removed.", SweetAlertIcon.Success);
                }
                else
                {
                    await Swal.FireAsync("Error", "Failed to delete option.", SweetAlertIcon.Error);
                }
            }
            catch (Exception ex)
            {
                await Swal.FireAsync("Error", "Failed to delete: " + ex.Message, SweetAlertIcon.Error);
            }
        }
    }
}
