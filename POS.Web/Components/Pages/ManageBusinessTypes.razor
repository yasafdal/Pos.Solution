@page "/business-type"
@using POS.Shared.Models
@using POS.Shared.Interfaces
@using Microsoft.AspNetCore.Components.QuickGrid
@using CurrieTechnologies.Razor.SweetAlert2
@inject IBusinessTypeService BusinessTypeService
@inject SweetAlertService Swal

<PageTitle>Business Types - POS</PageTitle>

<div class="w-100 py-2">
    <!-- Header Toolbar -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-3">
        <div>
            <h2 class="fw-bolder mb-1 text-dark" style="letter-spacing: -0.5px;">Business Types</h2>
            <span class="text-secondary" style="font-size: 0.95rem;">Manage business classifications and operation categories for branches</span>
        </div>
        <div>
            <button class="btn btn-primary rounded px-4 py-2 fw-bold shadow-sm text-nowrap" disabled="@busy" @onclick="() => Edit(new())">
                Add Business Type
            </button>
        </div>
    </div>

    <!-- Error Banner -->
    @if (loadError != null)
    {
        <div class="alert alert-danger d-flex align-items-center justify-content-between rounded-3 py-2 px-3 mb-3" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span>@loadError</span>
            </div>
            <button class="btn btn-sm btn-outline-danger fw-semibold" @onclick="Load">
                <i class="bi bi-arrow-clockwise me-1"></i> Retry
            </button>
        </div>
    }

    <!-- Search Row (Right Aligned) -->
    <div class="d-flex justify-content-end mb-3">
        <div class="position-relative" style="width: 280px;">
            <i class="bi bi-search position-absolute text-muted" style="left: 12px; top: 50%; transform: translateY(-50%); pointer-events: none; font-size: 0.85rem;"></i>
            <input type="search" class="form-control form-control-sm rounded ps-4 bg-white shadow-none border"
                   placeholder="Search type or description..."
                   aria-label="Search business types"
                   @bind="search"
                   @bind:event="oninput"
                   @bind:after="ResetPage" />
        </div>
    </div>

    <!-- Main Grid -->
    <div class="w-100">
        @if (isLoading)
        {
            <div class="text-center py-5 text-muted">
                <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                Loading business types...
            </div>
        }
        else if (!Filtered.Any())
        {
            <div class="card border rounded-3 p-5 text-center bg-white shadow-sm">
                <div class="text-muted mb-3">
                    <i class="bi bi-briefcase fs-1 text-secondary"></i>
                </div>
                <h5 class="fw-bold text-dark mb-1">No Business Types Found</h5>
                <p class="text-secondary small mb-3">
                    @(string.IsNullOrWhiteSpace(search) ? "No business classifications have been added yet." : $"No business types match \"{search}\".")
                </p>
                <div>
                    @if (!string.IsNullOrWhiteSpace(search))
                    {
                        <button class="btn btn-outline-secondary btn-sm rounded px-3 me-2" @onclick="ClearSearch">
                            Clear Search
                        </button>
                    }
                    <button class="btn btn-primary btn-sm rounded px-3" disabled="@busy" @onclick="() => Edit(new())">
                        Add Business Type
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="commercial-grid table-responsive w-100">
                <QuickGrid Items="@Filtered" Pagination="@pagination" Theme="commercial">
                    <!-- Col 1: Type -->
                    <PropertyColumn Property="@(x => x.Type)" Title="Business Type" Sortable="true" Align="Align.Left" />

                    <!-- Col 2: Description -->
                    <PropertyColumn Property="@(x => x.Description)" Title="Description" Sortable="true" Align="Align.Left" />

                    <!-- Col 3: Actions -->
                    <TemplateColumn Title="Actions" Context="item" Align="Align.Right">
                        <HeaderTemplate>
                            <div class="actions-header-wrap">
                                <span class="actions-header-text">Actions</span>
                            </div>
                        </HeaderTemplate>
                        <ChildContent>
                            <div class="actions-cell-wrap d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-sm btn-warning text-dark" aria-label="Edit Business Type" title="Edit Business Type" disabled="@busy" @onclick="() => Edit(item)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-danger text-white" aria-label="Delete Business Type" title="Delete Business Type" disabled="@busy" @onclick="() => Delete(item.Id)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </ChildContent>
                    </TemplateColumn>
                </QuickGrid>
            </div>

            <!-- Bootstrap Pagination Bar -->
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center pt-3 mt-1 border-top gap-3">
                <div class="text-secondary small fw-medium">
                    @GetShowingRangeText()
                </div>

                <nav aria-label="Business types pagination">
                    <ul class="pagination mb-0">
                        <li class="page-item @(pagination.CurrentPageIndex == 0 ? "disabled" : "")">
                            <button type="button" class="page-link" @onclick="() => GoToPage(pagination.CurrentPageIndex - 1)" disabled="@(pagination.CurrentPageIndex == 0)" aria-label="Previous">
                                Previous
                            </button>
                        </li>

                        @for (int i = 0; i < TotalPages; i++)
                        {
                            var pageIndex = i;
                            var isActive = pagination.CurrentPageIndex == pageIndex;
                            <li class="page-item @(isActive ? "active" : "")" aria-current="@(isActive ? "page" : null)">
                                <button type="button" class="page-link" @onclick="() => GoToPage(pageIndex)">
                                    @(pageIndex + 1)
                                </button>
                            </li>
                        }

                        <li class="page-item @(pagination.CurrentPageIndex >= TotalPages - 1 ? "disabled" : "")">
                            <button type="button" class="page-link" @onclick="() => GoToPage(pagination.CurrentPageIndex + 1)" disabled="@(pagination.CurrentPageIndex >= TotalPages - 1)" aria-label="Next">
                                Next
                            </button>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- Modal: Add / Edit Business Type -->
@if (editing != null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="businessTypeTitle">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <EditForm Model="editing" OnValidSubmit="Save" class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <DataAnnotationsValidator />
                
                <div class="modal-header border-bottom px-4 py-3 d-flex justify-content-between align-items-center bg-white">
                    <div class="d-flex align-items-center gap-3">
                        <div class="d-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-3" style="width: 42px; height: 42px;">
                            <i class="bi bi-briefcase fs-4"></i>
                        </div>
                        <div>
                            <h5 id="businessTypeTitle" class="fw-bold text-dark mb-0">@(editing.Id == 0 ? "Add Business Type" : "Edit Business Type")</h5>
                            <small class="text-secondary" style="font-size: 0.85rem;">
                                @(editing.Id == 0 ? "Create a new business classification for branches" : $"Update classification details for {editing.Type}")
                            </small>
                        </div>
                    </div>
                    <button type="button" class="btn-close shadow-none" disabled="@busy" @onclick="() => editing = null" aria-label="Close"></button>
                </div>

                <div class="modal-body px-4 py-3">
                    <ValidationSummary class="text-danger small mb-3" />

                    <div class="mb-3">
                        <label for="businessTypeCode" class="form-label text-dark fw-semibold small mb-1">
                            Business Type <span class="text-danger">*</span>
                        </label>
                        <InputText id="businessTypeCode" class="form-control rounded bg-white shadow-none border" placeholder="e.g. Restaurant, Retail, Coffee Shop" @bind-Value="editing.Type" maxlength="50" />
                        <div class="form-text text-muted" style="font-size: 0.75rem;">Up to 50 characters, must be unique.</div>
                    </div>

                    <div class="mb-2">
                        <label for="businessTypeDescription" class="form-label text-dark fw-semibold small mb-1">
                            Description <span class="text-danger">*</span>
                        </label>
                        <InputTextArea id="businessTypeDescription" rows="3" class="form-control rounded bg-white shadow-none border" placeholder="Brief description of operations or branch focus" @bind-Value="editing.Description" maxlength="250" />
                        <div class="form-text text-muted" style="font-size: 0.75rem;">Up to 250 characters.</div>
                    </div>
                </div>

                <div class="modal-footer border-top bg-light px-4 py-3 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded px-4 fw-medium" disabled="@busy" @onclick="() => editing = null">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-primary rounded px-4 fw-bold shadow-sm" disabled="@busy">
                        @if (busy)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>Save</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private List<BusinessTypeDto>? items;
    private BusinessTypeDto? editing;
    private string search = "";
    private string? loadError;
    private bool busy;
    private bool isLoading = true;
    private readonly PaginationState pagination = new() { ItemsPerPage = 10 };

    private IQueryable<BusinessTypeDto> Filtered => (items ?? [])
        .Where(x => string.IsNullOrWhiteSpace(search) || 
                    x.Type.Contains(search, StringComparison.OrdinalIgnoreCase) || 
                    x.Description.Contains(search, StringComparison.OrdinalIgnoreCase))
        .AsQueryable();

    protected override Task OnInitializedAsync() => Load();

    private Task ResetPage() => pagination.SetCurrentPageIndexAsync(0);

    private async Task ClearSearch()
    {
        search = "";
        await ResetPage();
    }

    private async Task Load()
    {
        try
        {
            isLoading = true;
            items = await BusinessTypeService.GetBusinessTypesAsync();
            loadError = null;
            await ResetPage();
        }
        catch (HttpRequestException)
        {
            loadError = "Could not load business types. Please retry.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Edit(BusinessTypeDto item) => editing = new() { Id = item.Id, Type = item.Type, Description = item.Description };

    private Task Alert(string title, string text, SweetAlertIcon icon) => Swal.FireAsync(new SweetAlertOptions
    {
        Title = title,
        Text = text,
        Icon = icon,
        ConfirmButtonColor = "#2563eb"
    });

    private async Task Save()
    {
        if (busy || editing == null) return;
        busy = true;
        try
        {
            var success = editing.Id == 0 
                ? await BusinessTypeService.CreateBusinessTypeAsync(editing) 
                : await BusinessTypeService.UpdateBusinessTypeAsync(editing.Id, editing);

            if (!success)
            {
                await Alert("Save Failed", "Use a unique type (up to 50 characters) and a description (up to 250 characters). Both are required. The record may also have been removed; reload and retry.", SweetAlertIcon.Error);
                return;
            }

            editing = null;
            await Load();
            await Alert("Saved", "Business type saved successfully.", SweetAlertIcon.Success);
        }
        catch (HttpRequestException)
        {
            await Alert("Save Failed", "Unable to reach the API. Please retry.", SweetAlertIcon.Error);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Delete(int id)
    {
        if (busy) return;
        var confirm = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Delete business type?",
            Text = "This cannot be undone. Types assigned to branches cannot be deleted.",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonColor = "#dc2626",
            CancelButtonColor = "#64748b",
            ConfirmButtonText = "Delete"
        });

        if (!confirm.IsConfirmed) return;
        busy = true;
        try
        {
            if (!await BusinessTypeService.DeleteBusinessTypeAsync(id))
            {
                await Alert("Delete Failed", "The type may be assigned to a branch or already removed. Unassign it from branches before deleting.", SweetAlertIcon.Error);
                return;
            }

            await Load();
            await Alert("Deleted", "Business type deleted successfully.", SweetAlertIcon.Success);
        }
        catch (HttpRequestException)
        {
            await Alert("Delete Failed", "Unable to reach the API. Please retry.", SweetAlertIcon.Error);
        }
        finally
        {
            busy = false;
        }
    }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)Filtered.Count() / pagination.ItemsPerPage));

    private string GetShowingRangeText()
    {
        var total = Filtered.Count();
        if (total == 0) return "Showing 0 items";
        int start = (pagination.CurrentPageIndex * pagination.ItemsPerPage) + 1;
        int end = Math.Min(start + pagination.ItemsPerPage - 1, total);
        return $"Showing {start}–{end} of {total} items";
    }

    private async Task GoToPage(int pageIndex)
    {
        if (pageIndex >= 0 && pageIndex < TotalPages)
        {
            await pagination.SetCurrentPageIndexAsync(pageIndex);
        }
    }
}
