@page "/licensing"
@page "/manage-licenses"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = POS.Shared.Constants.PosPermissions.AgresSystemAdminPolicy)]
@using POS.Shared.Models
@using POS.Shared.Interfaces
@using POS.Shared.Services
@using CurrieTechnologies.Razor.SweetAlert2
@inject ILicensingApiService LicensingService
@inject IBranchService BranchService
@inject IOutletService OutletService
@inject SweetAlertService Swal

<PageTitle>Terminal Licensing &amp; Security - POS Admin</PageTitle>

<div class="w-100 py-2">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-3">
        <div>
            <h2 class="fw-bolder mb-1 text-dark" style="letter-spacing: -0.5px;">
                <i class="bi bi-shield-lock-fill text-primary me-2"></i>Terminal Licensing &amp; Security
            </h2>
            <span class="text-secondary" style="font-size: 0.95rem;">
                Manage configurable-duration cryptographically signed POS terminal licenses, hardware device bindings, renewals, and security audit logs
            </span>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary rounded px-3 py-2 fw-semibold shadow-sm" @onclick="OpenIssuePickerModal" disabled="@isLoading">
                <i class="bi bi-plus-circle me-1"></i> Issue License
            </button>
            <button class="btn btn-outline-secondary rounded px-3 py-2 fw-semibold shadow-sm" @onclick="LoadAllDataAsync" disabled="@isLoading">
                <i class="bi bi-arrow-clockwise me-1"></i> Refresh
            </button>
        </div>
    </div>

    <!-- Summary KPI Cards -->
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <div class="p-3 bg-white border rounded shadow-sm">
                <div class="text-secondary small fw-semibold">Total Registered Terminals</div>
                <div class="fs-4 fw-bold text-dark">@licenses.Count</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 bg-white border rounded shadow-sm">
                <div class="text-secondary small fw-semibold">Active &amp; Verified</div>
                <div class="fs-4 fw-bold text-success">@licenses.Count(l => l.EffectiveStatus == LicenseStatusConstants.Active && l.IsSignatureValid)</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 bg-white border rounded shadow-sm">
                <div class="text-secondary small fw-semibold">Expiring Soon (&le;90 Days)</div>
                <div class="fs-4 fw-bold text-warning">@licenses.Count(l => l.EffectiveStatus == LicenseStatusConstants.ExpiringSoon)</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 bg-white border rounded shadow-sm">
                <div class="text-secondary small fw-semibold">Restricted / Attention</div>
                <div class="fs-4 fw-bold text-danger">@licenses.Count(l => !l.IsSignatureValid || l.EffectiveStatus is LicenseStatusConstants.Expired or LicenseStatusConstants.Revoked or LicenseStatusConstants.Suspended or LicenseStatusConstants.ValidationRequired)</div>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button type="button" class="nav-link @(activeTab == "LICENSES" ? "active fw-bold" : "")" @onclick='() => SwitchTab("LICENSES")'>
                <i class="bi bi-key-fill me-1"></i> Terminal Licenses (@FilteredLicenses.Count())
            </button>
        </li>
        <li class="nav-item">
            <button type="button" class="nav-link @(activeTab == "RENEWALS" ? "active fw-bold" : "")" @onclick='() => SwitchTab("RENEWALS")'>
                <i class="bi bi-calendar-plus me-1"></i> Renewal History (@renewalHistory.Count)
            </button>
        </li>
        <li class="nav-item">
            <button type="button" class="nav-link @(activeTab == "DEVICES" ? "active fw-bold" : "")" @onclick='() => SwitchTab("DEVICES")'>
                <i class="bi bi-hdd-network me-1"></i> Device Binding History (@deviceHistory.Count)
            </button>
        </li>
        <li class="nav-item">
            <button type="button" class="nav-link @(activeTab == "AUDIT" ? "active fw-bold" : "")" @onclick='() => SwitchTab("AUDIT")'>
                <i class="bi bi-journal-code me-1"></i> Security Audit Logs (@auditLogs.Count)
            </button>
        </li>
    </ul>

    @if (activeTab == "LICENSES")
    {
        <!-- Filter Row -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 bg-white p-3 border rounded shadow-sm">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <select class="form-select form-select-sm" style="width: 180px;" value="@selectedBranchFilter" @onchange="OnBranchFilterChanged">
                    <option value="0">All Branches</option>
                    @foreach (var b in branches)
                    {
                        <option value="@b.BranchId">@b.Name (@b.Code)</option>
                    }
                </select>

                <select class="form-select form-select-sm" style="width: 180px;" @bind="selectedOutletFilter">
                    <option value="0">All Outlets</option>
                    @foreach (var o in FilteredOutlets)
                    {
                        <option value="@o.OutletId">@o.Name</option>
                    }
                </select>

                <select class="form-select form-select-sm" style="width: 190px;" @bind="selectedStatusFilter">
                    <option value="">All License Statuses</option>
                    <option value="@LicenseStatusConstants.Active">ACTIVE</option>
                    <option value="@LicenseStatusConstants.ExpiringSoon">EXPIRING_SOON (&le;90d)</option>
                    <option value="@LicenseStatusConstants.Expired">EXPIRED</option>
                    <option value="@LicenseStatusConstants.Suspended">SUSPENDED</option>
                    <option value="@LicenseStatusConstants.Revoked">REVOKED</option>
                    <option value="@LicenseStatusConstants.PendingActivation">PENDING_ACTIVATION</option>
                    <option value="@LicenseStatusConstants.ValidationRequired">VALIDATION_REQUIRED</option>
                </select>

                <input type="date" class="form-control form-control-sm" style="width: 160px;" title="Filter Expiring On or Before Date" @bind="expiresBeforeFilter" />
            </div>

            <div class="position-relative" style="width: 260px;">
                <input type="search" class="form-control form-control-sm"
                       placeholder="Search terminal, license key, device..."
                       @bind="searchQuery"
                       @bind:event="oninput" />
            </div>
        </div>

        <div class="table-responsive bg-white border rounded shadow-sm">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Terminal</th>
                        <th>Branch / Outlet</th>
                        <th>License Key &amp; Env</th>
                        <th>Bound Device ID</th>
                        <th>Activated</th>
                        <th>Duration &amp; Expires</th>
                        <th>Remaining</th>
                        <th>Status &amp; Signature</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!FilteredLicenses.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">No terminal licenses match the selected filters.</td>
                        </tr>
                    }
                    @foreach (var item in FilteredLicenses)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">@item.TerminalName</div>
                                <small class="font-monospace text-secondary">@item.TerminalCode (#@item.TerminalId)</small>
                            </td>
                            <td>
                                <div class="fw-semibold">@item.BranchName</div>
                                <small class="text-secondary">@item.OutletName</small>
                            </td>
                            <td>
                                <div class="font-monospace small fw-bold">@item.LicenseKey</div>
                                <span class="badge bg-light text-dark border">@item.EnvironmentType</span>
                                <span class="badge bg-secondary-subtle text-secondary">v@(item.LicenseVersion)</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.DeviceId))
                                {
                                    <span class="font-monospace small text-primary">@item.DeviceId</span>
                                }
                                else
                                {
                                    <span class="text-muted small">Unbound</span>
                                }
                            </td>
                            <td class="small">
                                @(item.ActivatedAtUtc.HasValue ? BusinessDayClock.FormatManila(item.ActivatedAtUtc.Value, "yyyy-MM-dd") : "—")
                            </td>
                            <td class="small">
                                @{
                                    var curDurVal = item.DurationValue > 0 ? item.DurationValue : (item.DurationYears > 0 ? item.DurationYears : 5);
                                    var curDurUnit = string.IsNullOrWhiteSpace(item.DurationUnit) ? LicenseDurationUnitConstants.Years : item.DurationUnit;
                                }
                                <div class="fw-semibold text-dark">
                                    @(item.ExpiresAtUtc.HasValue ? BusinessDayClock.FormatManila(item.ExpiresAtUtc.Value, "yyyy-MM-dd") : "—")
                                </div>
                                <div class="text-muted" style="font-size: 0.78rem;">
                                    @LicenseCryptoService.FormatDurationLabel(curDurVal, curDurUnit)
                                    @if (item.RenewalCount > 0)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle ms-1">@item.RenewalCount renewal@(item.RenewalCount == 1 ? "" : "s")</span>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (item.RemainingDays.HasValue)
                                {
                                    <span class="fw-bold @(item.RemainingDays <= 0 ? "text-danger" : item.RemainingDays <= 90 ? "text-warning" : "text-success")">
                                        @item.RemainingDays.Value d
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                <span class="badge @GetBadgeClass(item.EffectiveStatus)">@item.EffectiveStatus</span>
                                @if (!item.IsSignatureValid)
                                {
                                    <span class="badge bg-danger ms-1" title="Database record failed ECDSA P-256 signature verification">TAMPERED</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-primary" title="Issue / Configure License" @onclick="() => OpenIssueModal(item)">
                                        Issue
                                    </button>
                                    @if (item.LicenseKey != "UNISSUED")
                                    {
                                        <button type="button" class="btn btn-outline-secondary" title="View License Details & Renewal History" @onclick="() => OpenDetailsModal(item)">
                                            Details
                                        </button>
                                        <button type="button" class="btn btn-outline-success" title="Renew License" @onclick="() => OpenRenewModal(item)">
                                            Renew
                                        </button>
                                        <button type="button" class="btn btn-outline-info" title="Replace or Deactivate Hardware Device" @onclick="() => OpenReplaceDeviceModal(item)">
                                            Device
                                        </button>
                                        @if (item.LicenseStatus == LicenseStatusConstants.Suspended || item.LicenseStatus == LicenseStatusConstants.Revoked)
                                        {
                                            <button type="button" class="btn btn-outline-secondary" title="Reactivate License" @onclick="() => OpenStatusModal(item, LicenseStatusConstants.Active)">
                                                Reactivate
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-outline-warning" title="Suspend License" @onclick="() => OpenStatusModal(item, LicenseStatusConstants.Suspended)">
                                                Suspend
                                            </button>
                                        }
                                        <button type="button" class="btn btn-outline-danger" title="Revoke License" @onclick="() => OpenStatusModal(item, LicenseStatusConstants.Revoked)">
                                            Revoke
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (activeTab == "RENEWALS")
    {
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
            <div class="small text-secondary">
                Immutable audit log of all terminal license renewals and auditable adjustments.
            </div>
            <div class="d-flex align-items-center gap-2">
                <label class="small fw-semibold text-secondary mb-0">Filter Terminal:</label>
                <select class="form-select form-select-sm" style="width: 220px;" @bind="renewalFilterTerminalId">
                    <option value="">All Terminals</option>
                    @foreach (var term in renewalHistory.Select(x => (x.TerminalId, x.TerminalCode)).Distinct().OrderBy(x => x.TerminalCode))
                    {
                        <option value="@term.TerminalId">@term.TerminalCode (#@term.TerminalId)</option>
                    }
                </select>
            </div>
        </div>
        <div class="table-responsive bg-white border rounded shadow-sm">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Renewed At</th>
                        <th>Terminal</th>
                        <th>Previous Expiration</th>
                        <th>Renewal Duration</th>
                        <th>New Expiration</th>
                        <th>Version</th>
                        <th>Renewed By</th>
                        <th>Reason / Notes</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in FilteredRenewalHistory)
                    {
                        var rDurVal = r.RenewalDuration;
                        var rDurUnit = string.IsNullOrWhiteSpace(r.RenewalUnit) ? "YEARS" : r.RenewalUnit;
                        var rReason = !string.IsNullOrWhiteSpace(r.RenewalReason) ? r.RenewalReason : r.RenewalNotes;
                        var rStatus = string.IsNullOrWhiteSpace(r.RenewalStatus) ? "APPLIED" : r.RenewalStatus;
                        <tr>
                            <td class="small text-muted">#@r.RenewalId</td>
                            <td class="small">@BusinessDayClock.FormatManila(r.RenewedAtUtc, "yyyy-MM-dd hh:mm tt")</td>
                            <td class="fw-semibold">@r.TerminalCode (#@r.TerminalId)</td>
                            <td class="small">@(r.PreviousExpiresAtUtc.HasValue ? BusinessDayClock.FormatManila(r.PreviousExpiresAtUtc.Value, "yyyy-MM-dd") : "—")</td>
                            <td class="small fw-semibold">@(rDurVal > 0 ? LicenseCryptoService.FormatDurationLabel(rDurVal, rDurUnit) : "—")</td>
                            <td class="small fw-bold text-success">@BusinessDayClock.FormatManila(r.NewExpiresAtUtc, "yyyy-MM-dd")</td>
                            <td class="small">v@(r.PreviousLicenseVersion) &rarr; v@(r.NewLicenseVersion)</td>
                            <td class="small">@r.RenewedBy</td>
                            <td class="small">@rReason</td>
                            <td>
                                <span class="badge @(rStatus == "ADJUSTMENT" ? "bg-warning text-dark" : "bg-success-subtle text-success border border-success-subtle")">
                                    @rStatus
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (activeTab == "DEVICES")
    {
        <div class="table-responsive bg-white border rounded shadow-sm">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Occurred At</th>
                        <th>Terminal</th>
                        <th>Action</th>
                        <th>Previous Device ID</th>
                        <th>New Device ID</th>
                        <th>Authorized By</th>
                        <th>Reason</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in deviceHistory)
                    {
                        <tr>
                            <td class="small">@BusinessDayClock.FormatManila(d.OccurredAtUtc, "yyyy-MM-dd hh:mm tt")</td>
                            <td class="fw-semibold">@d.TerminalCode (#@d.TerminalId)</td>
                            <td><span class="badge bg-info text-dark">@d.ActionType</span></td>
                            <td class="font-monospace small">@(d.OldDeviceId ?? "—")</td>
                            <td class="font-monospace small text-primary">@(d.NewDeviceId ?? "UNBOUND")</td>
                            <td>@d.AuthorizedBy</td>
                            <td class="small">@d.Reason</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (activeTab == "AUDIT")
    {
        <div class="table-responsive bg-white border rounded shadow-sm">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Timestamp</th>
                        <th>Event Type</th>
                        <th>Status</th>
                        <th>Terminal</th>
                        <th>Device ID</th>
                        <th>Actor</th>
                        <th>Clock Skew (s)</th>
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in auditLogs)
                    {
                        <tr>
                            <td class="small">@BusinessDayClock.FormatManila(a.OccurredAtUtc, "yyyy-MM-dd hh:mm:ss tt")</td>
                            <td><span class="badge bg-secondary">@a.EventType</span></td>
                            <td>
                                <span class="badge @(a.EventStatus == "SUCCESS" ? "bg-success" : "bg-danger")">@a.EventStatus</span>
                            </td>
                            <td class="small fw-semibold">@(a.TerminalCode ?? (a.TerminalId.HasValue ? $"#{a.TerminalId}" : "—"))</td>
                            <td class="font-monospace small">@(a.DeviceId ?? "—")</td>
                            <td class="small">@(a.Actor ?? "—")</td>
                            <td class="small">@(a.ClockSkewSeconds?.ToString() ?? "0")</td>
                            <td class="small">@a.Message</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Modal Dialogs -->
@if (activeModal != null && selectedLicense != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered @(activeModal is "ISSUE" or "RENEW" or "DETAILS" ? "modal-lg" : "")">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">@modalTitle — @selectedLicense.TerminalCode</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(modalValidationError))
                    {
                        <div class="alert alert-danger py-2 small mb-3">@modalValidationError</div>
                    }
                    @if (activeModal == "ISSUE")
                    {
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Target Terminal</label>
                            <select class="form-select" value="@selectedIssueTerminalId" @onchange="OnIssueTerminalChanged">
                                @foreach (var t in licenses)
                                {
                                    <option value="@t.TerminalId">@t.TerminalCode (#@t.TerminalId) — @(t.LicenseKey == "UNISSUED" ? "Unissued" : "Configured")</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">License Duration</label>
                            <div class="btn-group w-100 mb-2" role="group">
                                <button type="button" class="btn btn-sm @(issuePreset == "1Y" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SetIssuePreset("1Y")'>1 Year</button>
                                <button type="button" class="btn btn-sm @(issuePreset == "2Y" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SetIssuePreset("2Y")'>2 Years</button>
                                <button type="button" class="btn btn-sm @(issuePreset == "3Y" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SetIssuePreset("3Y")'>3 Years</button>
                                <button type="button" class="btn btn-sm @(issuePreset == "5Y" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SetIssuePreset("5Y")'>5 Years</button>
                                <button type="button" class="btn btn-sm @(issuePreset == "CUSTOM" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SetIssuePreset("CUSTOM")'>Custom</button>
                            </div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label small text-muted mb-1">Duration Value</label>
                                    <input type="number" class="form-control" min="1" max="@GetMaxValueForUnit(issueDurationUnit)"
                                           @bind="issueDurationValue" @bind:after="SyncIssuePresetFromInputs" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small text-muted mb-1">Duration Unit</label>
                                    <select class="form-select" @bind="issueDurationUnit" @bind:after="SyncIssuePresetFromInputs">
                                        <option value="YEARS">Years</option>
                                        <option value="MONTHS">Months</option>
                                        <option value="DAYS">Days</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Offline Grace Period (Days)</label>
                                <input type="number" class="form-control" min="1" max="365" @bind="issueGraceDays" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Signing Environment</label>
                                <select class="form-select" @bind="issueEnvironment">
                                    <option value="Production">Production</option>
                                    <option value="UAT">UAT / Development</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="chkActivateNow" @bind="issueActivateImmediately" />
                            <label class="form-check-label" for="chkActivateNow">
                                Activate immediately if terminal already has a paired device
                            </label>
                        </div>

                        @if (issueActivateImmediately)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="chkCustomActDate" @bind="issueUseCustomActivationDate" />
                                <label class="form-check-label" for="chkCustomActDate">
                                    Specify custom official activation date
                                </label>
                            </div>
                            @if (issueUseCustomActivationDate)
                            {
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold">Official Activation Date (Manila)</label>
                                    <input type="date" class="form-control" @bind="issueActivationDate" />
                                </div>
                            }
                        }

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Issuance Notes / Reference (Optional)</label>
                            <input type="text" class="form-control" placeholder="e.g., Contract #POS-2026-01" @bind="actionReason" />
                        </div>

                        <div class="border rounded bg-light p-3 mb-3 small">
                            <div class="fw-bold text-dark mb-1">Calculated License Preview</div>
                            @if (TryPreviewDuration(issueDurationValue, issueDurationUnit, GetIssueStartPreviewUtc(), out var issuePreviewExp, out var issuePreviewErr))
                            {
                                <div><strong>Terminal:</strong> @selectedLicense.TerminalCode (#@selectedLicense.TerminalId)</div>
                                <div><strong>Configured Duration:</strong> @LicenseCryptoService.FormatDurationLabel(issueDurationValue, issueDurationUnit)</div>
                                <div><strong>Activation Base:</strong> @(issueActivateImmediately ? BusinessDayClock.FormatManila(GetIssueStartPreviewUtc(), "yyyy-MM-dd hh:mm tt") : "Starts when terminal hardware pairs (estimated from today)")</div>
                                <div><strong>Projected Expiration:</strong> <span class="fw-bold text-primary">@BusinessDayClock.FormatManila(issuePreviewExp, "yyyy-MM-dd hh:mm tt")</span></div>
                            }
                            else
                            {
                                <div class="text-danger fw-semibold">@issuePreviewErr</div>
                            }
                        </div>

                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="chkIssueConfirm" @bind="issueConfirmed" />
                            <label class="form-check-label fw-semibold" for="chkIssueConfirm">
                                I confirm issuing this license configuration for @selectedLicense.TerminalCode.
                            </label>
                        </div>
                    }
                    else if (activeModal == "RENEW")
                    {
                        var curVal = selectedLicense.DurationValue > 0 ? selectedLicense.DurationValue : (selectedLicense.DurationYears > 0 ? selectedLicense.DurationYears : 5);
                        var curUnit = string.IsNullOrWhiteSpace(selectedLicense.DurationUnit) ? "YEARS" : selectedLicense.DurationUnit;
                        var origVal = selectedLicense.OriginalDurationValue > 0 ? selectedLicense.OriginalDurationValue : curVal;
                        var origUnit = string.IsNullOrWhiteSpace(selectedLicense.OriginalDurationUnit) ? curUnit : selectedLicense.OriginalDurationUnit;
                        var isCurrentlyActive = selectedLicense.ExpiresAtUtc.HasValue && selectedLicense.ExpiresAtUtc.Value > BusinessDayClock.UtcNow();
                        var remDays = selectedLicense.ExpiresAtUtc.HasValue
                            ? (int)Math.Floor((selectedLicense.ExpiresAtUtc.Value - BusinessDayClock.UtcNow()).TotalDays)
                            : 0;

                        <div class="border rounded bg-light p-3 mb-3 small">
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <div><strong>Current Expiration:</strong> @(selectedLicense.ExpiresAtUtc.HasValue ? BusinessDayClock.FormatManila(selectedLicense.ExpiresAtUtc.Value, "yyyy-MM-dd hh:mm tt") : "Not set")</div>
                                    <div><strong>Remaining Validity:</strong> @(remDays > 0 ? $"{remDays} day(s)" : "Expired / 0 days")</div>
                                </div>
                                <div class="col-md-6">
                                    <div><strong>Original Granted:</strong> @LicenseCryptoService.FormatDurationLabel(origVal, origUnit)</div>
                                    <div><strong>Renewals Applied:</strong> @selectedLicense.RenewalCount</div>
                                </div>
                            </div>
                            <div class="mt-2 pt-2 border-top text-secondary">
                                @if (isCurrentlyActive)
                                {
                                    <span><strong>Active License Rule:</strong> Renewal extends from existing expiration so remaining validity is preserved.</span>
                                }
                                else
                                {
                                    <span><strong>Expired License Rule:</strong> Renewal starts from the authorized renewal effective date.</span>
                                }
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Renewal Duration</label>
                            <div class="btn-group w-100 mb-2" role="group">
                                <button type="button" class="btn btn-sm @(renewPreset == "1Y" ? "btn-success" : "btn-outline-success")" @onclick='() => SetRenewPreset("1Y")'>1 Year</button>
                                <button type="button" class="btn btn-sm @(renewPreset == "2Y" ? "btn-success" : "btn-outline-success")" @onclick='() => SetRenewPreset("2Y")'>2 Years</button>
                                <button type="button" class="btn btn-sm @(renewPreset == "3Y" ? "btn-success" : "btn-outline-success")" @onclick='() => SetRenewPreset("3Y")'>3 Years</button>
                                <button type="button" class="btn btn-sm @(renewPreset == "5Y" ? "btn-success" : "btn-outline-success")" @onclick='() => SetRenewPreset("5Y")'>5 Years</button>
                                <button type="button" class="btn btn-sm @(renewPreset == "CUSTOM" ? "btn-success" : "btn-outline-success")" @onclick='() => SetRenewPreset("CUSTOM")'>Custom</button>
                            </div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label small text-muted mb-1">Duration Value</label>
                                    <input type="number" class="form-control" min="1" max="@GetMaxValueForUnit(renewDurationUnit)"
                                           @bind="renewDurationValue" @bind:after="SyncRenewPresetFromInputs" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small text-muted mb-1">Duration Unit</label>
                                    <select class="form-select" @bind="renewDurationUnit" @bind:after="SyncRenewPresetFromInputs">
                                        <option value="YEARS">Years</option>
                                        <option value="MONTHS">Months</option>
                                        <option value="DAYS">Days</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="chkCustomRenewDate" @bind="renewUseCustomEffectiveDate" />
                            <label class="form-check-label" for="chkCustomRenewDate">
                                Specify custom renewal effective date (for expired licenses)
                            </label>
                        </div>
                        @if (renewUseCustomEffectiveDate)
                        {
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Renewal Effective Date (Manila)</label>
                                <input type="date" class="form-control" @bind="renewEffectiveDate" />
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Renewal Reason / Reference</label>
                            <input type="text" class="form-control" placeholder="e.g., Commercial License Renewal / Invoice #" @bind="actionReason" />
                        </div>

                        <div class="border rounded bg-success-subtle p-3 mb-3 small">
                            <div class="fw-bold text-success mb-1">New Expiration Preview</div>
                            @if (TryPreviewDuration(renewDurationValue, renewDurationUnit, GetRenewBaseStartUtc(), out var renewPreviewExp, out var renewPreviewErr))
                            {
                                <div><strong>Extension:</strong> +@LicenseCryptoService.FormatDurationLabel(renewDurationValue, renewDurationUnit)</div>
                                <div><strong>Starts From:</strong> @BusinessDayClock.FormatManila(GetRenewBaseStartUtc(), "yyyy-MM-dd hh:mm tt")</div>
                                <div><strong>Projected New Expiration:</strong> <span class="fw-bold text-success">@BusinessDayClock.FormatManila(renewPreviewExp, "yyyy-MM-dd hh:mm tt")</span></div>
                            }
                            else
                            {
                                <div class="text-danger fw-semibold">@renewPreviewErr</div>
                            }
                        </div>

                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="chkRenewConfirm" @bind="renewConfirmed" />
                            <label class="form-check-label fw-semibold" for="chkRenewConfirm">
                                I confirm renewing @selectedLicense.TerminalCode for @LicenseCryptoService.FormatDurationLabel(renewDurationValue, renewDurationUnit).
                            </label>
                        </div>

                        @if (selectedTerminalRenewals.Count > 0)
                        {
                            <div class="mt-2">
                                <div class="small fw-semibold text-secondary mb-1">Recent Renewals for @selectedLicense.TerminalCode</div>
                                <div class="table-responsive border rounded" style="max-height: 150px; overflow-y: auto;">
                                    <table class="table table-sm mb-0 small">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Date</th>
                                                <th>Duration</th>
                                                <th>Prev &rarr; New</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var hr in selectedTerminalRenewals.Take(5))
                                            {
                                                var hVal = hr.RenewalDuration;
                                                var hUnit = string.IsNullOrWhiteSpace(hr.RenewalUnit) ? "YEARS" : hr.RenewalUnit;
                                                <tr>
                                                    <td>@BusinessDayClock.FormatManila(hr.RenewedAtUtc, "yyyy-MM-dd")</td>
                                                    <td>@LicenseCryptoService.FormatDurationLabel(hVal, hUnit)</td>
                                                    <td>@(hr.PreviousExpiresAtUtc.HasValue ? BusinessDayClock.FormatManila(hr.PreviousExpiresAtUtc.Value, "yyyy-MM-dd") : "—") &rarr; @BusinessDayClock.FormatManila(hr.NewExpiresAtUtc, "yyyy-MM-dd")</td>
                                                    <td>@(string.IsNullOrWhiteSpace(hr.RenewalStatus) ? "APPLIED" : hr.RenewalStatus)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    }
                    else if (activeModal == "DETAILS")
                    {
                        var dCurVal = selectedLicense.DurationValue > 0 ? selectedLicense.DurationValue : (selectedLicense.DurationYears > 0 ? selectedLicense.DurationYears : 5);
                        var dCurUnit = string.IsNullOrWhiteSpace(selectedLicense.DurationUnit) ? "YEARS" : selectedLicense.DurationUnit;
                        var dOrigVal = selectedLicense.OriginalDurationValue > 0 ? selectedLicense.OriginalDurationValue : dCurVal;
                        var dOrigUnit = string.IsNullOrWhiteSpace(selectedLicense.OriginalDurationUnit) ? dCurUnit : selectedLicense.OriginalDurationUnit;
                        var dRemDays = selectedLicense.ExpiresAtUtc.HasValue
                            ? (int)Math.Floor((selectedLicense.ExpiresAtUtc.Value - BusinessDayClock.UtcNow()).TotalDays)
                            : 0;

                        <div class="row g-3 small mb-3">
                            <div class="col-md-6">
                                <div class="border rounded p-2 bg-light h-100">
                                    <div class="text-muted">License Key</div>
                                    <div class="fw-bold font-monospace mb-2">@selectedLicense.LicenseKey</div>
                                    <div class="text-muted">Signing Environment</div>
                                    <div class="fw-semibold mb-2">@selectedLicense.EnvironmentType (Grace: @selectedLicense.OfflineGracePeriodDays days)</div>
                                    <div class="text-muted">Original Activation Date</div>
                                    <div class="fw-semibold mb-2">@(selectedLicense.ActivatedAtUtc.HasValue ? BusinessDayClock.FormatManila(selectedLicense.ActivatedAtUtc.Value, "yyyy-MM-dd hh:mm tt") : "Pending hardware binding")</div>
                                    <div class="text-muted">Original Granted Duration</div>
                                    <div class="fw-semibold">@LicenseCryptoService.FormatDurationLabel(dOrigVal, dOrigUnit)</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="border rounded p-2 bg-light h-100">
                                    <div class="text-muted">Current Expiration Date</div>
                                    <div class="fw-bold text-primary mb-2">@(selectedLicense.ExpiresAtUtc.HasValue ? BusinessDayClock.FormatManila(selectedLicense.ExpiresAtUtc.Value, "yyyy-MM-dd hh:mm tt") : "—")</div>
                                    <div class="text-muted">Current Latest Duration &amp; Status</div>
                                    <div class="fw-semibold mb-2">@LicenseCryptoService.FormatDurationLabel(dCurVal, dCurUnit) · @(dRemDays > 0 ? $"{dRemDays} days remaining" : "Expired / Pending")</div>
                                    <div class="text-muted">Total Renewal Count</div>
                                    <div class="fw-semibold mb-2">@selectedLicense.RenewalCount</div>
                                    <div class="text-muted">Last Renewed At</div>
                                    <div class="fw-semibold">@(selectedLicense.LastRenewedAtUtc.HasValue ? BusinessDayClock.FormatManila(selectedLicense.LastRenewedAtUtc.Value, "yyyy-MM-dd hh:mm tt") : "Never renewed")</div>
                                </div>
                            </div>
                        </div>

                        <div class="fw-semibold small text-secondary mb-1">Previous Renewal Records (@selectedTerminalRenewals.Count)</div>
                        <div class="table-responsive border rounded mb-3" style="max-height: 200px; overflow-y: auto;">
                            <table class="table table-sm table-hover mb-0 small">
                                <thead class="table-light">
                                    <tr>
                                        <th>ID</th>
                                        <th>Renewed At</th>
                                        <th>Prev Exp</th>
                                        <th>Duration</th>
                                        <th>New Exp</th>
                                        <th>By</th>
                                        <th>Reason</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (selectedTerminalRenewals.Count == 0)
                                    {
                                        <tr><td colspan="8" class="text-center text-muted py-2">No renewals recorded for this terminal.</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var hr in selectedTerminalRenewals)
                                        {
                                            var hVal = hr.RenewalDuration;
                                            var hUnit = string.IsNullOrWhiteSpace(hr.RenewalUnit) ? "YEARS" : hr.RenewalUnit;
                                            <tr>
                                                <td class="text-muted">#@hr.RenewalId</td>
                                                <td>@BusinessDayClock.FormatManila(hr.RenewedAtUtc, "yyyy-MM-dd")</td>
                                                <td>@(hr.PreviousExpiresAtUtc.HasValue ? BusinessDayClock.FormatManila(hr.PreviousExpiresAtUtc.Value, "yyyy-MM-dd") : "—")</td>
                                                <td class="fw-semibold">@LicenseCryptoService.FormatDurationLabel(hVal, hUnit)</td>
                                                <td class="fw-semibold text-success">@BusinessDayClock.FormatManila(hr.NewExpiresAtUtc, "yyyy-MM-dd")</td>
                                                <td>@hr.RenewedBy</td>
                                                <td>@(string.IsNullOrWhiteSpace(hr.RenewalReason) ? hr.RenewalNotes : hr.RenewalReason)</td>
                                                <td>@(string.IsNullOrWhiteSpace(hr.RenewalStatus) ? "APPLIED" : hr.RenewalStatus)</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="border rounded p-2">
                            <button type="button" class="btn btn-sm btn-outline-warning fw-semibold" @onclick="() => showAdjustForm = !showAdjustForm">
                                @(showAdjustForm ? "Hide Auditable Adjustment" : "Create Auditable Correction / Adjustment")
                            </button>
                            @if (showAdjustForm)
                            {
                                <div class="mt-2 pt-2 border-top">
                                    <div class="small text-muted mb-2">
                                        Prior renewal records are immutable. Corrections create a new signed ADJUSTMENT record.
                                    </div>
                                    <div class="row g-2 mb-2">
                                        <div class="col-4">
                                            <label class="form-label small mb-1">Value</label>
                                            <input type="number" class="form-control form-control-sm" min="1" max="@GetMaxValueForUnit(adjustDurationUnit)" @bind="adjustDurationValue" />
                                        </div>
                                        <div class="col-4">
                                            <label class="form-label small mb-1">Unit</label>
                                            <select class="form-select form-select-sm" @bind="adjustDurationUnit">
                                                <option value="YEARS">Years</option>
                                                <option value="MONTHS">Months</option>
                                                <option value="DAYS">Days</option>
                                            </select>
                                        </div>
                                        <div class="col-4">
                                            <label class="form-label small mb-1">Reason (Required)</label>
                                            <input type="text" class="form-control form-control-sm" placeholder="Correction reason" @bind="adjustReason" />
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else if (activeModal == "DEVICE")
                    {
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Replacement Hardware Device ID (Optional)</label>
                            <input type="text" class="form-control font-monospace" placeholder="Leave blank to unbind current device and allow re-activation" @bind="replacementDeviceId" />
                            <small class="text-muted">Current Bound Device: <code>@(selectedLicense.DeviceId ?? "None")</code></small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Authorization Reason</label>
                            <input type="text" class="form-control" placeholder="e.g., POS hardware replacement authorized by Admin" @bind="actionReason" />
                        </div>
                    }
                    else if (activeModal == "STATUS")
                    {
                        <div class="alert alert-warning small">
                            Target Status: <strong>@targetStatusChange</strong>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Reason for @targetStatusChange</label>
                            <input type="text" class="form-control" placeholder="Enter administrative reason..." @bind="actionReason" />
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseModal">Cancel</button>
                    <button type="button" class="btn btn-primary fw-bold" @onclick="SubmitModalActionAsync" disabled="@isSubmitting">
                        @(isSubmitting ? "Processing..." : "Confirm & Sign License")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<BranchDto> branches = new();
    private List<OutletDto> outlets = new();
    private List<TerminalLicenseAdminDto> licenses = new();
    private List<LicenseRenewalHistoryDto> renewalHistory = new();
    private List<LicenseDeviceHistoryDto> deviceHistory = new();
    private List<LicenseAuditLogDto> auditLogs = new();

    private string activeTab = "LICENSES";
    private bool isLoading = true;
    private bool isSubmitting = false;

    private int selectedBranchFilter = 0;
    private int selectedOutletFilter = 0;
    private string selectedStatusFilter = string.Empty;
    private DateTime? expiresBeforeFilter = null;
    private string searchQuery = string.Empty;

    private string? activeModal;
    private string modalTitle = string.Empty;
    private TerminalLicenseAdminDto? selectedLicense;
    private int selectedIssueTerminalId;
    private string issuePreset = "5Y";
    private int issueDurationValue = 5;
    private string issueDurationUnit = "YEARS";
    private bool issueUseCustomActivationDate;
    private DateTime issueActivationDate = BusinessDayClock.UtcNow().AddHours(8).Date;
    private bool issueConfirmed;
    private int issueGraceDays = 30;
    private string issueEnvironment = "Production";
    private bool issueActivateImmediately = true;
    private string renewPreset = "1Y";
    private int renewDurationValue = 1;
    private string renewDurationUnit = "YEARS";
    private bool renewUseCustomEffectiveDate;
    private DateTime renewEffectiveDate = BusinessDayClock.UtcNow().AddHours(8).Date;
    private bool renewConfirmed;
    private string renewIdempotencyKey = string.Empty;
    private int? renewalFilterTerminalId;
    private List<LicenseRenewalHistoryDto> selectedTerminalRenewals = new();
    private bool showAdjustForm;
    private int adjustDurationValue = 1;
    private string adjustDurationUnit = "YEARS";
    private string adjustReason = string.Empty;
    private string? modalValidationError;
    private string replacementDeviceId = string.Empty;
    private string targetStatusChange = string.Empty;
    private string actionReason = string.Empty;

    private IEnumerable<LicenseRenewalHistoryDto> FilteredRenewalHistory =>
        renewalFilterTerminalId.HasValue
            ? renewalHistory.Where(r => r.TerminalId == renewalFilterTerminalId.Value)
            : renewalHistory;

    private IEnumerable<OutletDto> FilteredOutlets =>
        selectedBranchFilter > 0 ? outlets.Where(o => o.BranchId == selectedBranchFilter) : outlets;

    private IEnumerable<TerminalLicenseAdminDto> FilteredLicenses
    {
        get
        {
            var q = licenses.AsEnumerable();
            if (selectedBranchFilter > 0)
                q = q.Where(x => x.BranchId == selectedBranchFilter);
            if (selectedOutletFilter > 0)
                q = q.Where(x => x.OutletId == selectedOutletFilter);
            if (!string.IsNullOrWhiteSpace(selectedStatusFilter))
                q = q.Where(x => string.Equals(x.EffectiveStatus, selectedStatusFilter, StringComparison.OrdinalIgnoreCase) ||
                                 string.Equals(x.LicenseStatus, selectedStatusFilter, StringComparison.OrdinalIgnoreCase));
            if (expiresBeforeFilter.HasValue)
                q = q.Where(x => x.ExpiresAtUtc.HasValue && x.ExpiresAtUtc.Value.Date <= expiresBeforeFilter.Value.Date);
            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var s = searchQuery.Trim();
                q = q.Where(x =>
                    x.TerminalCode.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    x.TerminalName.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    x.LicenseKey.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    (x.DeviceId != null && x.DeviceId.Contains(s, StringComparison.OrdinalIgnoreCase)));
            }
            return q;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAllDataAsync();
    }

    private async Task LoadAllDataAsync()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            branches = await BranchService.GetBranchesAsync();
            outlets = await OutletService.GetOutletsAsync();
            licenses = await LicensingService.GetLicensesAsync();
            renewalHistory = await LicensingService.GetRenewalHistoryAsync();
            deviceHistory = await LicensingService.GetDeviceHistoryAsync();
            auditLogs = await LicensingService.GetAuditLogsAsync(limit: 150);
        }
        catch (Exception ex)
        {
            await Swal.FireAsync("Error", $"Failed to load licensing data: {ex.Message}", SweetAlertIcon.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void OnBranchFilterChanged(ChangeEventArgs e)
    {
        int.TryParse(e.Value?.ToString(), out selectedBranchFilter);
        selectedOutletFilter = 0;
    }

    private void SwitchTab(string tab) => activeTab = tab;

    private void OpenIssuePickerModal()
    {
        var first = licenses.FirstOrDefault(l => l.LicenseKey == "UNISSUED") ?? licenses.FirstOrDefault();
        if (first != null) OpenIssueModal(first);
    }

    private void OpenIssueModal(TerminalLicenseAdminDto item)
    {
        selectedLicense = item;
        selectedIssueTerminalId = item.TerminalId;
        issueDurationValue = item.DurationValue > 0 ? item.DurationValue : (item.DurationYears > 0 ? item.DurationYears : 5);
        issueDurationUnit = string.IsNullOrWhiteSpace(item.DurationUnit) ? "YEARS" : item.DurationUnit;
        SyncIssuePresetFromInputs();
        issueGraceDays = item.OfflineGracePeriodDays > 0 ? item.OfflineGracePeriodDays : 30;
        issueEnvironment = string.IsNullOrWhiteSpace(item.EnvironmentType) ? "Production" : item.EnvironmentType;
        issueActivateImmediately = true;
        issueUseCustomActivationDate = false;
        issueActivationDate = BusinessDayClock.UtcNow().AddHours(8).Date;
        issueConfirmed = false;
        actionReason = string.Empty;
        modalValidationError = null;
        modalTitle = "Issue / Configure License";
        activeModal = "ISSUE";
    }

    private void OnIssueTerminalChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var tid))
        {
            var found = licenses.FirstOrDefault(x => x.TerminalId == tid);
            if (found != null) OpenIssueModal(found);
        }
    }

    private async Task OpenRenewModal(TerminalLicenseAdminDto item)
    {
        selectedLicense = item;
        renewPreset = "1Y";
        renewDurationValue = 1;
        renewDurationUnit = "YEARS";
        renewUseCustomEffectiveDate = false;
        renewEffectiveDate = BusinessDayClock.UtcNow().AddHours(8).Date;
        renewConfirmed = false;
        renewIdempotencyKey = Guid.NewGuid().ToString("N");
        actionReason = string.Empty;
        modalValidationError = null;
        selectedTerminalRenewals = await LicensingService.GetRenewalHistoryAsync(item.TerminalId);
        modalTitle = "Renew Terminal License";
        activeModal = "RENEW";
    }

    private async Task OpenDetailsModal(TerminalLicenseAdminDto item)
    {
        selectedLicense = item;
        showAdjustForm = false;
        adjustDurationValue = 1;
        adjustDurationUnit = "YEARS";
        adjustReason = string.Empty;
        modalValidationError = null;
        selectedTerminalRenewals = await LicensingService.GetRenewalHistoryAsync(item.TerminalId);
        modalTitle = "License Details & Renewal History";
        activeModal = "DETAILS";
    }

    private void SetIssuePreset(string preset)
    {
        issuePreset = preset;
        switch (preset)
        {
            case "1Y": issueDurationValue = 1; issueDurationUnit = "YEARS"; break;
            case "2Y": issueDurationValue = 2; issueDurationUnit = "YEARS"; break;
            case "3Y": issueDurationValue = 3; issueDurationUnit = "YEARS"; break;
            case "5Y": issueDurationValue = 5; issueDurationUnit = "YEARS"; break;
        }
    }

    private void SyncIssuePresetFromInputs()
    {
        issuePreset = issueDurationUnit == "YEARS" && issueDurationValue is 1 or 2 or 3 or 5
            ? $"{issueDurationValue}Y"
            : "CUSTOM";
    }

    private void SetRenewPreset(string preset)
    {
        renewPreset = preset;
        switch (preset)
        {
            case "1Y": renewDurationValue = 1; renewDurationUnit = "YEARS"; break;
            case "2Y": renewDurationValue = 2; renewDurationUnit = "YEARS"; break;
            case "3Y": renewDurationValue = 3; renewDurationUnit = "YEARS"; break;
            case "5Y": renewDurationValue = 5; renewDurationUnit = "YEARS"; break;
        }
    }

    private void SyncRenewPresetFromInputs()
    {
        renewPreset = renewDurationUnit == "YEARS" && renewDurationValue is 1 or 2 or 3 or 5
            ? $"{renewDurationValue}Y"
            : "CUSTOM";
    }

    private static int GetMaxValueForUnit(string unit) => unit switch
    {
        "MONTHS" => 600,
        "DAYS" => 18250,
        _ => 50
    };

    private static bool TryPreviewDuration(int val, string unit, DateTime startUtc, out DateTime expiresUtc, out string error)
    {
        expiresUtc = startUtc;
        error = string.Empty;
        if (val <= 0)
        {
            error = "Duration must be greater than zero.";
            return false;
        }
        var max = GetMaxValueForUnit(unit);
        if (val > max)
        {
            error = $"Duration exceeds maximum allowed ({max} {unit}).";
            return false;
        }
        expiresUtc = LicenseCryptoService.CalculateExpirationUtc(startUtc, val, unit);
        return true;
    }

    private DateTime GetIssueStartPreviewUtc() =>
        issueUseCustomActivationDate
            ? DateTime.SpecifyKind(issueActivationDate.Date.AddHours(-8), DateTimeKind.Utc)
            : BusinessDayClock.UtcNow();

    private DateTime GetRenewBaseStartUtc()
    {
        var now = BusinessDayClock.UtcNow();
        if (selectedLicense?.ExpiresAtUtc.HasValue == true && selectedLicense.ExpiresAtUtc.Value > now)
            return selectedLicense.ExpiresAtUtc.Value;

        return renewUseCustomEffectiveDate
            ? DateTime.SpecifyKind(renewEffectiveDate.Date.AddHours(-8), DateTimeKind.Utc)
            : now;
    }

    private void OpenReplaceDeviceModal(TerminalLicenseAdminDto item)
    {
        selectedLicense = item;
        replacementDeviceId = string.Empty;
        actionReason = "Authorized POS terminal hardware replacement";
        modalTitle = "Replace / Deactivate Bound Device";
        activeModal = "DEVICE";
    }

    private void OpenStatusModal(TerminalLicenseAdminDto item, string targetStatus)
    {
        selectedLicense = item;
        targetStatusChange = targetStatus;
        actionReason = string.Empty;
        modalTitle = $"{targetStatus} License";
        activeModal = "STATUS";
    }

    private void CloseModal()
    {
        activeModal = null;
        selectedLicense = null;
    }

    private async Task SubmitModalActionAsync()
    {
        if (selectedLicense == null || isSubmitting) return;
        modalValidationError = null;
        if (activeModal == "ISSUE")
        {
            if (!TryPreviewDuration(issueDurationValue, issueDurationUnit, GetIssueStartPreviewUtc(), out _, out var err))
            {
                modalValidationError = err;
                return;
            }
            if (!issueConfirmed)
            {
                modalValidationError = "Please confirm the license issuance details before submitting.";
                return;
            }
        }
        else if (activeModal == "RENEW")
        {
            if (!TryPreviewDuration(renewDurationValue, renewDurationUnit, GetRenewBaseStartUtc(), out _, out var err))
            {
                modalValidationError = err;
                return;
            }
            if (!renewConfirmed)
            {
                modalValidationError = "Please confirm the renewal duration and calculated expiration before submitting.";
                return;
            }
        }
        else if (activeModal == "DETAILS" && !showAdjustForm)
        {
            CloseModal();
            return;
        }
        else if (activeModal == "DETAILS" && showAdjustForm)
        {
            if (!TryPreviewDuration(adjustDurationValue, adjustDurationUnit, BusinessDayClock.UtcNow(), out _, out var err))
            {
                modalValidationError = err;
                return;
            }
            if (string.IsNullOrWhiteSpace(adjustReason))
            {
                modalValidationError = "Adjustment reason is required.";
                return;
            }
        }

        isSubmitting = true;
        try
        {
            LicenseOperationResponseDto res;
            if (activeModal == "ISSUE")
            {
                res = await LicensingService.IssueLicenseAsync(new IssueTerminalLicenseRequestDto
                {
                    TerminalId = selectedLicense.TerminalId,
                    DurationValue = issueDurationValue,
                    DurationUnit = issueDurationUnit,
                    OfflineGracePeriodDays = issueGraceDays,
                    EnvironmentType = issueEnvironment,
                    ActivateImmediatelyIfBound = issueActivateImmediately,
                    ActivationEffectiveAtUtc = issueActivateImmediately && issueUseCustomActivationDate
                        ? GetIssueStartPreviewUtc()
                        : null,
                    Notes = string.IsNullOrWhiteSpace(actionReason) ? null : actionReason.Trim()
                });
            }
            else if (activeModal == "RENEW")
            {
                var rNotes = string.IsNullOrWhiteSpace(actionReason)
                    ? $"License Renewal ({LicenseCryptoService.FormatDurationLabel(renewDurationValue, renewDurationUnit)})"
                    : actionReason.Trim();
                res = await LicensingService.RenewLicenseAsync(new RenewTerminalLicenseRequestDto
                {
                    TerminalId = selectedLicense.TerminalId,
                    RenewalDuration = renewDurationValue,
                    RenewalUnit = renewDurationUnit,
                    EffectiveAtUtc = renewUseCustomEffectiveDate ? GetRenewBaseStartUtc() : null,
                    IdempotencyKey = renewIdempotencyKey,
                    RenewalReason = rNotes,
                    RenewalNotes = rNotes
                });
            }
            else if (activeModal == "DETAILS")
            {
                res = await LicensingService.AdjustLicenseAsync(new RenewTerminalLicenseRequestDto
                {
                    TerminalId = selectedLicense.TerminalId,
                    RenewalDuration = adjustDurationValue,
                    RenewalUnit = adjustDurationUnit,
                    IsAdjustment = true,
                    IdempotencyKey = Guid.NewGuid().ToString("N"),
                    RenewalReason = adjustReason.Trim(),
                    RenewalNotes = adjustReason.Trim()
                });
            }
            else if (activeModal == "DEVICE")
            {
                if (string.IsNullOrWhiteSpace(replacementDeviceId))
                {
                    res = await LicensingService.DeactivateDeviceAsync(new ChangeLicenseStatusRequestDto
                    {
                        TerminalId = selectedLicense.TerminalId,
                        Reason = string.IsNullOrWhiteSpace(actionReason) ? "Admin device unbinding" : actionReason.Trim()
                    });
                }
                else
                {
                    res = await LicensingService.ReplaceDeviceAsync(new ReplaceLicenseDeviceRequestDto
                    {
                        TerminalId = selectedLicense.TerminalId,
                        NewDeviceId = replacementDeviceId.Trim(),
                        Reason = string.IsNullOrWhiteSpace(actionReason) ? "Admin device replacement" : actionReason.Trim()
                    });
                }
            }
            else
            {
                var req = new ChangeLicenseStatusRequestDto
                {
                    TerminalId = selectedLicense.TerminalId,
                    Reason = string.IsNullOrWhiteSpace(actionReason) ? $"Status updated to {targetStatusChange}" : actionReason.Trim()
                };
                res = targetStatusChange switch
                {
                    LicenseStatusConstants.Suspended => await LicensingService.SuspendLicenseAsync(req),
                    LicenseStatusConstants.Revoked => await LicensingService.RevokeLicenseAsync(req),
                    _ => await LicensingService.ReactivateLicenseAsync(req)
                };
            }

            if (res.Success)
            {
                CloseModal();
                await LoadAllDataAsync();
                await Swal.FireAsync("Success", res.Message, SweetAlertIcon.Success);
            }
            else
            {
                await Swal.FireAsync("Error", res.Message, SweetAlertIcon.Error);
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private static string GetBadgeClass(string? status) =>
        (status ?? string.Empty).ToUpperInvariant() switch
        {
            LicenseStatusConstants.Active => "bg-success text-white",
            LicenseStatusConstants.ExpiringSoon => "bg-warning text-dark",
            LicenseStatusConstants.Expired => "bg-danger text-white",
            LicenseStatusConstants.Revoked => "bg-danger text-white",
            LicenseStatusConstants.Suspended => "bg-warning text-dark",
            LicenseStatusConstants.PendingActivation => "bg-info text-dark",
            _ => "bg-danger text-white"
        };
}
