@page "/manage-categories"
@using POS.Shared.Models
@using POS.Shared.Interfaces
@inject ICategoryService CategoryService

<PageTitle>Categories - POS</PageTitle>


<div class="w-100 py-2">
    <!-- Header Toolbar -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-3">
        <div>
            <h2 class="fw-bolder mb-1 text-dark" style="letter-spacing: -0.5px;">Categories</h2>
            <span class="text-secondary" style="font-size: 0.95rem;">Manage your product classifications</span>
        </div>
        
        <div>
            <!-- Add Category Button -->
            <button class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm text-nowrap" @onclick="OpenAddModal">
                Add New Category
            </button>
        </div>
    </div>

    <!-- Search Input (Right Aligned) -->
    <div class="d-flex justify-content-end mb-3">
        <div class="position-relative" style="width: 260px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" class="bi bi-search position-absolute text-muted" style="left: 12px; top: 50%; transform: translateY(-50%); pointer-events: none;" viewBox="0 0 16 16">
                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/>
            </svg>
            <input type="search" class="form-control form-control-sm rounded-pill ps-4 bg-white shadow-none border"
                   placeholder="Search categories..."
                   @bind="nameFilter"
                   @bind:event="oninput" />
        </div>
    </div>

    <!-- Main Grid -->
    <div class="w-100">
        @if (categories == null)
        {
            <div class="text-center py-5 text-muted">
                <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                Loading categories...
            </div>
        }
        else
        {
            <div class="commercial-grid table-responsive w-100">
                <QuickGrid Items="@FilteredCategories" Pagination="@pagination" Theme="commercial">

                    <!-- Name Column -->
                    <PropertyColumn Property="@(c => c.Name)" Title="Category Name" Sortable="true" />

                    <TemplateColumn Context="category" Title="Description" Sortable="false">
                        @if (!string.IsNullOrWhiteSpace(category.Description))
                        {
                            <span>@category.Description</span>
                        }
                        else
                        {
                            <span class="text-muted fst-italic" style="font-size: 0.85rem;">None</span>
                        }
                    </TemplateColumn>

                    <TemplateColumn Context="category" Title="Products Quantity" Align="Align.Center">
                        <span class="quantity-badge">0</span>
                    </TemplateColumn>

                    <TemplateColumn Context="category" Title="Status" Align="Align.Center">
                        @if (category.IsActive)
                        {
                            <span class="status-badge active">
                                <span class="status-dot"></span>
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="status-badge inactive">
                                <span class="status-dot"></span>
                                Inactive
                            </span>
                        }
                    </TemplateColumn>

                    <TemplateColumn Context="category" Title="Actions" Align="Align.Right">
                        <HeaderTemplate>
                            <div class="actions-header-wrap">
                                <span class="actions-header-text">Actions</span>
                            </div>
                        </HeaderTemplate>
                        <ChildContent>
                            <div class="actions-cell-wrap d-flex justify-content-end gap-2">
                                <a class="action-btn action-btn-products" href="/manage-products/@category.CategoryId" title="View Products" aria-label="View Products">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2"/>
                                    </svg>
                                </a>
                                <button class="action-btn action-btn-edit" @onclick="() => OpenEditModal(category)" title="Edit Category" aria-label="Edit Category">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325"/>
                                    </svg>
                                </button>
                                <button class="action-btn action-btn-delete" @onclick="() => DeleteCategory(category.CategoryId)" title="Delete Category" aria-label="Delete Category">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                        <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                                    </svg>
                                </button>
                            </div>
                        </ChildContent>
                    </TemplateColumn>
                </QuickGrid>
            </div>

            <!-- Bootstrap Pagination Bar -->
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center pt-3 mt-1 border-top gap-3">
                <div class="text-secondary small fw-medium">
                    @GetShowingRangeText()
                </div>

                <nav aria-label="Categories table pagination">
                    <ul class="pagination mb-0">
                        <li class="page-item @(pagination.CurrentPageIndex == 0 ? "disabled" : "")">
                            <button type="button" class="page-link" @onclick="() => GoToPage(pagination.CurrentPageIndex - 1)" disabled="@(pagination.CurrentPageIndex == 0)" aria-label="Previous">
                                Previous
                            </button>
                        </li>

                        @for (int i = 0; i < TotalPages; i++)
                        {
                            var pageIndex = i;
                            var isActive = pagination.CurrentPageIndex == pageIndex;
                            <li class="page-item @(isActive ? "active" : "")" aria-current="@(isActive ? "page" : null)">
                                <button type="button" class="page-link" @onclick="() => GoToPage(pageIndex)">
                                    @(pageIndex + 1)
                                </button>
                            </li>
                        }

                        <li class="page-item @(pagination.CurrentPageIndex >= TotalPages - 1 ? "disabled" : "")">
                            <button type="button" class="page-link" @onclick="() => GoToPage(pagination.CurrentPageIndex + 1)" disabled="@(pagination.CurrentPageIndex >= TotalPages - 1)" aria-label="Next">
                                Next
                            </button>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- Modal Dialog with Blazor EditForm and Validation -->
@if (isModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.5); backdrop-filter: blur(3px);" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <EditForm Model="@currentCategory" OnValidSubmit="SaveCategory">
                    <DataAnnotationsValidator />

                    <!-- Modal Header -->
                    <div class="modal-header border-bottom px-4 py-3 d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="fw-bold text-dark mb-0">@(isEditing ? "Edit Category" : "New Category")</h5>
                            <small class="text-secondary" style="font-size: 0.85rem;">
                                @(isEditing ? "Update category information" : "Enter the details to add a new category")
                            </small>
                        </div>
                        <button type="button" class="btn-close shadow-none" @onclick="CloseModal" aria-label="Close"></button>
                    </div>

                    <!-- Modal Body -->
                    <div class="modal-body px-4 py-3">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label text-dark fw-semibold small mb-1">Category Name <span class="text-danger">*</span></label>
                                <InputText @bind-Value="currentCategory.Name" class="form-control rounded-3" placeholder="e.g. Beverages" />
                            </div>

                            <div class="col-12">
                                <label class="form-label text-dark fw-semibold small mb-1">Description</label>
                                <InputTextArea @bind-Value="currentCategory.Description" class="form-control rounded-3" rows="3" placeholder="Optional details..." />
                            </div>

                            <div class="col-12">
                                <div class="p-3 bg-light rounded-3 border d-flex align-items-center justify-content-between">
                                    <label class="form-check-label fw-semibold text-dark mb-0" for="activeSwitch">Active in POS</label>
                                    <div class="form-check form-switch mb-0">
                                        <InputCheckbox @bind-Value="currentCategory.IsActive" class="form-check-input" id="activeSwitch" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Modal Footer -->
                    <div class="modal-footer border-top bg-light px-4 py-3 d-flex justify-content-end align-items-center gap-2">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4 fw-medium" @onclick="CloseModal">
                            Cancel
                        </button>
                        <button type="submit" class="btn @(isEditing ? "btn-warning text-dark" : "btn-primary") rounded-pill px-4 fw-bold shadow-sm" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            @(isEditing ? "Save Changes" : "Create Category")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<CategoryDto>? categories;
    private PaginationState pagination = new PaginationState { ItemsPerPage = 10 };
    private string nameFilter = string.Empty;

    // Modal State
    private bool isModalOpen = false;
    private bool isEditing = false;
    private bool isSaving = false;
    private CategoryDto currentCategory = new();

    private IQueryable<CategoryDto>? FilteredCategories =>
        categories?
            .Where(c => !c.IsDeleted)
            .Where(c => string.IsNullOrWhiteSpace(nameFilter) ||
                       (c.Name != null && c.Name.Contains(nameFilter, StringComparison.OrdinalIgnoreCase)))
            .AsQueryable();

    private int TotalPages
    {
        get
        {
            var count = FilteredCategories?.Count() ?? 0;
            return Math.Max(1, (int)Math.Ceiling((double)count / pagination.ItemsPerPage));
        }
    }

    private string GetShowingRangeText()
    {
        var total = FilteredCategories?.Count() ?? 0;
        if (total == 0) return "Showing 0 items";
        int start = (pagination.CurrentPageIndex * pagination.ItemsPerPage) + 1;
        int end = Math.Min(start + pagination.ItemsPerPage - 1, total);
        return $"Showing {start}–{end} of {total} categories";
    }

    private async Task GoToPage(int pageIndex)
    {
        if (pageIndex >= 0 && pageIndex < TotalPages)
        {
            await pagination.SetCurrentPageIndexAsync(pageIndex);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
    }

    private async Task LoadCategories()
    {
        try
        {
            var rawCategories = await CategoryService.GetCategoriesAsync();
            // Client-side sort by ID descending so newest categories appear at the top
            categories = rawCategories.OrderByDescending(c => c.CategoryId).ToList();
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error",
                Text = "Failed to load categories: " + ex.Message,
                Icon = SweetAlertIcon.Error
            });
        }
    }

    private void OpenAddModal()
    {
        isEditing = false;
        currentCategory = new CategoryDto { IsActive = true }; // Default to active
        isModalOpen = true;
    }

    private void OpenEditModal(CategoryDto category)
    {
        isEditing = true;
        // Map fields to avoid modifying the grid item directly until save
        currentCategory = new CategoryDto
        {
            CategoryId = category.CategoryId,
            Name = category.Name,
            Description = category.Description,
            IsActive = category.IsActive
        };
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
    }

    private async Task SaveCategory()
    {
        if (string.IsNullOrWhiteSpace(currentCategory.Name))
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Validation Error",
                Text = "Category name is required.",
                Icon = SweetAlertIcon.Warning
            });
            return;
        }

        try
        {
            isSaving = true;

            if (isEditing)
            {
                await CategoryService.UpdateCategoryAsync(currentCategory.CategoryId, currentCategory);
            }
            else
            {
                await CategoryService.CreateCategoryAsync(currentCategory);
            }

            await LoadCategories(); // Refresh the grid
            CloseModal();

            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Success!",
                Text = isEditing ? "Category updated successfully." : "Category created successfully.",
                Icon = SweetAlertIcon.Success,
                Timer = 2000,
                ShowConfirmButton = false
            });
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error",
                Text = "Failed to save category: " + ex.Message,
                Icon = SweetAlertIcon.Error
            });
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteCategory(int id)
    {
        var result = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Are you sure?",
            Text = "You are about to delete this category. This cannot be undone!",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonColor = "#d33",
            CancelButtonColor = "#3085d6",
            ConfirmButtonText = "Yes"
        });

        if (result.IsConfirmed)
        {
            try
            {
                await CategoryService.DeleteCategoryAsync(id);
                await LoadCategories();

                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "Deleted!",
                    Text = "The category has been removed.",
                    Icon = SweetAlertIcon.Success,
                    Timer = 2000,
                    ShowConfirmButton = false
                });
            }
            catch (Exception ex)
            {
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "Error",
                    Text = "Failed to delete category: " + ex.Message,
                    Icon = SweetAlertIcon.Error
                });
            }
        }
    }
}