@page "/manage-categories"
@using POS.Shared.Models
@using POS.Shared.Interfaces
@using Microsoft.AspNetCore.Components.QuickGrid
@inject ICategoryService CategoryService

<style>
    /* 1. ANNIHILATE BLAZOR'S FAKE PADDING ROWS */
    .commercial-grid table.quickgrid tbody tr:not([aria-rowindex]) {
        display: none !important;
    }

    /* 2. Fix the Table Layout */
    .commercial-grid table.quickgrid {
        width: 100% !important;
        border-collapse: collapse !important;
        margin-bottom: 0 !important;
    }

        /* 3. Style Headers */
        .commercial-grid table.quickgrid thead th {
            background-color: #f9fafb !important;
            color: #6b7280 !important;
            font-size: 0.75rem !important;
            font-weight: 600 !important;
            text-transform: uppercase !important;
            letter-spacing: 0.05em !important;
            padding: 1rem 1.25rem !important;
            border-bottom: 2px solid #e5e7eb !important;
            white-space: nowrap !important;
        }

        /* 4. Style Cells */
        .commercial-grid table.quickgrid tbody td {
            padding: 1rem 1.25rem !important;
            vertical-align: middle !important;
            border-bottom: 1px solid #f3f4f6 !important;
            color: #374151 !important;
            font-size: 0.9rem !important;
        }

        /* 5. Hover Effects */
        .commercial-grid table.quickgrid tbody tr {
            transition: background-color 0.2s ease !important;
        }

            .commercial-grid table.quickgrid tbody tr:hover {
                background-color: #f9fafb !important;
            }
</style>

<div class="container-fluid py-4" style="background-color: #f4f6f8; min-height: 100vh;">
    <!-- Header -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-end gap-3 mb-4 px-1">
        <div>
            <h2 class="fw-bolder mb-1 text-dark" style="letter-spacing: -0.5px;">Categories</h2>
            <span class="text-secondary" style="font-size: 0.95rem;">Manage your product classifications</span>
        </div>
        <button class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm" @onclick="OpenAddModal">
            Add New Category
        </button>
    </div>

    <!-- Data Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    
        <!-- Grid Body -->
        <div class="card-body p-0 overflow-x-auto">
            @if (categories == null)
            {
                <div class="text-center py-5 text-muted">
                    <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                    Loading categories...
                </div>
            }
            else
            {
                <div class="commercial-grid overflow-x-auto">
                    <QuickGrid Items="@FilteredCategories" Pagination="@pagination" Theme="commercial">
                        <PropertyColumn Property="@(c => c.CategoryId)" Title="ID" Sortable="true" />
                    
                        <!-- Updated Name Column with Built-in Filter -->
                        <PropertyColumn Property="@(c => c.Name)" Title="Category Name" Sortable="true">
                            <ColumnOptions>
                                <div class="p-2">
                                    <input type="search" class="form-control form-control-sm shadow-none"
                                           autofocus @bind="nameFilter" @bind:event="oninput"
                                           placeholder="Search name..." />
                                </div>
                            </ColumnOptions>
                        </PropertyColumn>
                    
                        <PropertyColumn Property="@(c => c.Description)" Title="Description" Sortable="false" />
                    
                        <TemplateColumn Context="category" Title="Status">
                            @if (category.IsActive)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3">Inactive</span>
                            }
                        </TemplateColumn>

                        <TemplateColumn Context="category" Title="Actions">
                            <div class="d-flex gap-2">
                                <a class="btn btn-sm btn-light text-info rounded-pill px-3 px-md-4 fw-semibold border-0" href="/manage-products/@category.CategoryId">
                                    Products
                                </a>
                                <button class="btn btn-sm btn-light text-primary rounded-pill px-3 px-md-4 fw-semibold border-0" @onclick="() => OpenEditModal(category)">
                                    Edit
                                </button>
                                <button class="btn btn-sm btn-light text-danger rounded-pill px-3 px-md-4 fw-semibold border-0" @onclick="() => DeleteCategory(category.CategoryId)">
                                    Delete
                                </button>
                            </div>
                        </TemplateColumn>
                    </QuickGrid>
                </div>
            
                <!-- Pagination moved slightly to have some padding like standard QuickGrid -->
                <div class="p-3">
                    <Paginator State="@pagination" />
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal -->
@if (isModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 rounded-4 shadow">
                
                <div class="modal-header border-0 px-4 pt-4 pb-0">
                    <h5 class="fw-bolder text-dark mb-0">@(isEditing ? "Edit Category" : "New Category")</h5>
                </div>
                
                <div class="modal-body px-4 py-4">
                    <div class="row g-3 g-md-4">
                        
                        <div class="col-12">
                            <label class="form-label text-secondary small fw-bold text-uppercase" style="letter-spacing: 0.5px;">Name</label>
                            <input @bind="currentCategory.Name" class="form-control bg-light border-0 shadow-none px-3 py-2" placeholder="e.g. Beverages" />
                        </div>

                        <div class="col-12">
                            <label class="form-label text-secondary small fw-bold text-uppercase" style="letter-spacing: 0.5px;">Description</label>
                            <textarea @bind="currentCategory.Description" class="form-control bg-light border-0 shadow-none px-3 py-2" rows="3" placeholder="Optional details..."></textarea>
                        </div>

                        <div class="col-12">
                            <div class="d-flex p-3 bg-light rounded-3 mt-2">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="activeSwitch" @bind="currentCategory.IsActive">
                                    <label class="form-check-label fw-semibold text-dark" for="activeSwitch">Active in POS</label>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="modal-footer border-0 px-4 pb-4 pt-0 d-flex flex-column flex-sm-row justify-content-sm-end gap-2">
                    <button class="btn btn-light text-secondary fw-bold rounded-pill px-4 border-0 w-100 w-sm-auto order-2 order-sm-1" @onclick="CloseModal">Cancel</button>
                    <button class="btn @(isEditing ? "btn-warning text-dark" : "btn-primary") fw-bold rounded-pill px-4 shadow-sm w-100 w-sm-auto order-1 order-sm-2" @onclick="SaveCategory">
                        @(isEditing ? "Save Changes" : "Create Category")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<CategoryDto>? categories;
    private PaginationState pagination = new PaginationState { ItemsPerPage = 10 };
    private string nameFilter = string.Empty;

    // Modal State
    private bool isModalOpen = false;
    private bool isEditing = false;
    private CategoryDto currentCategory = new();

    private IQueryable<CategoryDto>? FilteredCategories =>
        categories?
            .Where(c => !c.IsDeleted)
            .Where(c => string.IsNullOrWhiteSpace(nameFilter) ||
                       (c.Name != null && c.Name.Contains(nameFilter, StringComparison.OrdinalIgnoreCase)))
            .AsQueryable();

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
    }

    private async Task LoadCategories()
    {
        var rawCategories = await CategoryService.GetCategoriesAsync();
        // Client-side sort by ID descending so newest categories appear at the top
        categories = rawCategories.OrderByDescending(c => c.CategoryId).ToList();
    }

    private void OpenAddModal()
    {
        isEditing = false;
        currentCategory = new CategoryDto { IsActive = true }; // Default to active
        isModalOpen = true;
    }

    private void OpenEditModal(CategoryDto category)
    {
        isEditing = true;
        // Map fields to avoid modifying the grid item directly until save
        currentCategory = new CategoryDto
        {
            CategoryId = category.CategoryId,
            Name = category.Name,
            Description = category.Description,
            IsActive = category.IsActive
        };
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
    }

    private async Task SaveCategory()
    {
        if (isEditing)
        {
            await CategoryService.UpdateCategoryAsync(currentCategory.CategoryId, currentCategory);
        }
        else
        {
            await CategoryService.CreateCategoryAsync(currentCategory);
        }

        await LoadCategories(); // Refresh the grid
        CloseModal();

        await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Success!",
            Text = isEditing ? "Category updated successfully." : "Category created successfully.",
            Icon = SweetAlertIcon.Success,
            Timer = 2000,
            ShowConfirmButton = false
        });
    }

    private async Task DeleteCategory(int id)
    {
        var result = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Are you sure?",
            Text = "You are about to delete this category. This cannot be undone!",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonColor = "#d33",
            CancelButtonColor = "#3085d6",
            ConfirmButtonText = "Yes"
        });

        if (result.IsConfirmed)
        {
            await CategoryService.DeleteCategoryAsync(id);
            await LoadCategories();

            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Deleted!",
                Text = "The category has been removed.",
                Icon = SweetAlertIcon.Success,
                Timer = 2000,
                ShowConfirmButton = false
            });
        }
    }
}