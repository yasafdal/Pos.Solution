@page "/manage-categories"
@using POS.Shared.Models
@using POS.Shared.Helpers
@using POS.Shared.Interfaces
@inject ICategoryService CategoryService

<PageTitle>Categories - POS</PageTitle>


<div class="w-100 py-2">
    <!-- Header Toolbar -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-3">
        <div>
            <h2 class="fw-bolder mb-1 text-dark" style="letter-spacing: -0.5px;">Categories</h2>
            <span class="text-secondary" style="font-size: 0.95rem;">Manage your product classifications</span>
        </div>
        
        <div class="d-flex gap-2">
            <!-- Manage Display Order Button -->
            <button type="button" class="btn btn-outline-secondary rounded px-3 py-2 fw-semibold shadow-sm text-nowrap" @onclick="OpenReorderModal">
                <i class="bi bi-arrow-down-up me-1"></i> Manage Display Order
            </button>
            <!-- Add Category Button -->
            <button class="btn btn-primary rounded px-4 py-2 fw-bold shadow-sm text-nowrap" @onclick="OpenAddModal">
                Add New Category
            </button>
        </div>
    </div>

    <!-- Search Input (Right Aligned) -->
    <div class="d-flex justify-content-end mb-3">
        <div class="position-relative" style="width: 260px;">
            <i class="bi bi-search position-absolute text-muted" style="left: 12px; top: 50%; transform: translateY(-50%); pointer-events: none; font-size: 0.85rem;"></i>
            <input type="search" class="form-control form-control-sm rounded ps-4 bg-white shadow-none border"
                   placeholder="Search categories..."
                   @bind="nameFilter"
                   @bind:event="oninput" />
        </div>
    </div>

    <!-- Main Grid -->
    <div class="w-100">
        @if (categories == null)
        {
            <div class="text-center py-5 text-muted">
                <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                Loading categories...
            </div>
        }
        else
        {
            <div class="commercial-grid table-responsive w-100">
                <QuickGrid Items="@FilteredCategories" Pagination="@pagination" Theme="commercial">

                    <TemplateColumn Context="category" Title="Color">
                        <span class="category-color-swatch" style="--category-color: @CategoryColor.Normalize(category.ColorHex)" aria-hidden="true"></span>
                        <span>@CategoryColor.Normalize(category.ColorHex)</span>
                    </TemplateColumn>

                    <!-- Display Order Column -->
                    <PropertyColumn Property="@(c => c.DisplayOrder)" Title="Order" Sortable="true" Align="Align.Center" />

                    <!-- Name Column -->
                    <PropertyColumn Property="@(c => c.Name)" Title="Category Name" Sortable="true" />

                    <TemplateColumn Context="category" Title="Description" Sortable="false">
                        @if (!string.IsNullOrWhiteSpace(category.Description))
                        {
                            <span>@category.Description</span>
                        }
                        else
                        {
                            <span class="text-muted fst-italic" style="font-size: 0.85rem;">None</span>
                        }
                    </TemplateColumn>

                    <TemplateColumn Context="category" Title="Products Quantity" SortBy="@(GridSort<CategoryDto>.ByAscending(c => c.ProductCount))" Sortable="true" Align="Align.Center">
                        <span class="text-dark fw-medium">
                            @category.ProductCount
                        </span>
                    </TemplateColumn>

                    <TemplateColumn Context="category" Title="Status" Align="Align.Center">
                        @if (category.IsActive)
                        {
                            <span class="status-badge active">
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="status-badge inactive">
                                Inactive
                            </span>
                        }
                    </TemplateColumn>

                    <TemplateColumn Context="category" Title="Actions" Align="Align.Right">
                        <HeaderTemplate>
                            <div class="actions-header-wrap">
                                <span class="actions-header-text">Actions</span>
                            </div>
                        </HeaderTemplate>
                        <ChildContent>
                            <div class="actions-cell-wrap d-flex justify-content-end gap-2">
                                <a class="btn btn-sm btn-primary text-white" href="/manage-products/@category.CategoryId" title="View Products" aria-label="View Products">
                                    <i class="bi bi-plus-lg"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-warning text-dark" @onclick="() => OpenEditModal(category)" title="Edit Category" aria-label="Edit Category">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-danger text-white" @onclick="() => DeleteCategory(category.CategoryId)" title="Delete Category" aria-label="Delete Category">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </ChildContent>
                    </TemplateColumn>
                </QuickGrid>
            </div>

            <!-- Bootstrap Pagination Bar -->
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center pt-3 mt-1 border-top gap-3">
                <div class="text-secondary small fw-medium">
                    @GetShowingRangeText()
                </div>

                <nav aria-label="Categories table pagination">
                    <ul class="pagination mb-0">
                        <li class="page-item @(pagination.CurrentPageIndex == 0 ? "disabled" : "")">
                            <button type="button" class="page-link" @onclick="() => GoToPage(pagination.CurrentPageIndex - 1)" disabled="@(pagination.CurrentPageIndex == 0)" aria-label="Previous">
                                Previous
                            </button>
                        </li>

                        @for (int i = 0; i < TotalPages; i++)
                        {
                            var pageIndex = i;
                            var isActive = pagination.CurrentPageIndex == pageIndex;
                            <li class="page-item @(isActive ? "active" : "")" aria-current="@(isActive ? "page" : null)">
                                <button type="button" class="page-link" @onclick="() => GoToPage(pageIndex)">
                                    @(pageIndex + 1)
                                </button>
                            </li>
                        }

                        <li class="page-item @(pagination.CurrentPageIndex >= TotalPages - 1 ? "disabled" : "")">
                            <button type="button" class="page-link" @onclick="() => GoToPage(pagination.CurrentPageIndex + 1)" disabled="@(pagination.CurrentPageIndex >= TotalPages - 1)" aria-label="Next">
                                Next
                            </button>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- Modal Dialog with Blazor EditForm and Validation -->
@if (isModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.5); backdrop-filter: blur(3px);" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <EditForm Model="@currentCategory" OnValidSubmit="SaveCategory">
                    <DataAnnotationsValidator />

                    <!-- Modal Header -->
                    <div class="modal-header border-bottom px-4 py-3 d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="fw-bold text-dark mb-0">@(isEditing ? "Edit Category" : "New Category")</h5>
                            <small class="text-secondary" style="font-size: 0.85rem;">
                                @(isEditing ? "Update category information" : "Enter the details to add a new category")
                            </small>
                        </div>
                        <button type="button" class="btn-close shadow-none" @onclick="CloseModal" aria-label="Close"></button>
                    </div>

                    <!-- Modal Body -->
                    <div class="modal-body px-4 py-3">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label text-dark fw-semibold small mb-1">Category Name <span class="text-danger">*</span></label>
                                <InputText @bind-Value="currentCategory.Name" class="form-control rounded-3" placeholder="e.g. Beverages" />
                            </div>

                            <div class="col-12">
                                <label for="category-color" class="form-label fw-semibold">Category color</label>
                                <div class="d-flex align-items-center flex-wrap gap-3">
                                    <input id="category-color" type="color" class="form-control form-control-color category-color-picker" @bind="currentCategory.ColorHex" />
                                    <span class="category-color-preview" style="--category-color: @CategoryColor.Normalize(currentCategory.ColorHex)">@currentCategory.Name</span>
                                    <span>@currentCategory.ColorHex</span>
                                </div>
                                <div class="form-text">Used on category buttons and product accents in the POS.</div>
                                <ValidationMessage For="@(() => currentCategory.ColorHex)" />
                            </div>

                            <div class="col-12">
                                <label class="form-label text-dark fw-semibold small mb-1">Description</label>
                                <InputTextArea @bind-Value="currentCategory.Description" class="form-control rounded-3" rows="3" placeholder="Optional details..." />
                            </div>

                            <div class="col-12">
                                <div class="p-3 bg-light rounded-3 border d-flex align-items-center justify-content-between">
                                    <label class="form-check-label fw-semibold text-dark mb-0" for="activeSwitch">Active in POS</label>
                                    <div class="form-check form-switch mb-0">
                                        <InputCheckbox @bind-Value="currentCategory.IsActive" class="form-check-input" id="activeSwitch" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Modal Footer -->
                    <div class="modal-footer border-top bg-light px-4 py-3 d-flex justify-content-end align-items-center gap-2">
                        <button type="button" class="btn btn-outline-secondary rounded px-4 fw-medium" @onclick="CloseModal">
                            Cancel
                        </button>
                        <button type="submit" class="btn @(isEditing ? "btn-warning text-dark" : "btn-primary") rounded px-4 fw-bold shadow-sm" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            @(isEditing ? "Save Changes" : "Create Category")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- Reorder Categories Modal Dialog -->
@if (isReorderModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.5); backdrop-filter: blur(3px);" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <div class="modal-header border-bottom px-4 py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold text-dark mb-0">Manage Category Display Order</h5>
                        <small class="text-secondary" style="font-size: 0.85rem;">
                            Drag items or use the up/down arrows to change the display sequence in the POS.
                        </small>
                    </div>
                    <button type="button" class="btn-close shadow-none" @onclick="CloseReorderModal" aria-label="Close"></button>
                </div>

                <div class="modal-body px-4 py-3">
                    @if (reorderList == null || !reorderList.Any())
                    {
                        <div class="text-center py-4 text-muted">No categories available to reorder.</div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush gap-2">
                            @for (int i = 0; i < reorderList.Count; i++)
                            {
                                var index = i;
                                var cat = reorderList[index];
                                <div class="list-group-item d-flex align-items-center justify-content-between p-2 rounded-3 border bg-white @(draggedCategoryIndex == index ? "border-primary opacity-50" : "")"
                                     draggable="true"
                                     @ondragstart="() => OnCategoryDragStart(index)"
                                     @ondragover:preventDefault
                                     @ondrop="() => OnCategoryDrop(index)"
                                     style="cursor: grab;">
                                    <div class="d-flex align-items-center gap-3">
                                        <i class="bi bi-grip-vertical text-secondary fs-5" title="Drag to reorder"></i>
                                        <span class="badge bg-secondary text-white rounded-pill px-2 py-1" style="min-width: 28px;">
                                            @(index + 1)
                                        </span>
                                        <span class="category-color-swatch" style="--category-color: @CategoryColor.Normalize(cat.ColorHex); width: 18px; height: 18px; border-radius: 4px; display: inline-block;" aria-hidden="true"></span>
                                        <div>
                                            <span class="fw-semibold text-dark">@cat.Name</span>
                                            @if (!cat.IsActive)
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary border ms-2" style="font-size: 0.72rem;">Inactive</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-1">
                                        <button type="button" class="btn btn-sm btn-light border px-2 py-1"
                                                disabled="@(index == 0)"
                                                @onclick="() => MoveCategoryUp(index)"
                                                title="Move Up">
                                            <i class="bi bi-chevron-up"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-light border px-2 py-1"
                                                disabled="@(index == reorderList.Count - 1)"
                                                @onclick="() => MoveCategoryDown(index)"
                                                title="Move Down">
                                            <i class="bi bi-chevron-down"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="modal-footer border-top bg-light px-4 py-3 d-flex justify-content-between align-items-center">
                    <span class="small text-muted">
                        <i class="bi bi-info-circle me-1"></i> Order updates will synchronize to the POS New Sales category bar.
                    </span>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary rounded px-4 fw-medium" @onclick="CloseReorderModal">
                            Cancel
                        </button>
                        <button type="button" class="btn btn-primary rounded px-4 fw-bold shadow-sm" @onclick="SaveReorderedCategories" disabled="@isSavingReorder">
                            @if (isSavingReorder)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            Save Display Order
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<CategoryDto>? categories;
    private PaginationState pagination = new PaginationState { ItemsPerPage = 10 };
    private string nameFilter = string.Empty;

    // Modal State
    private bool isModalOpen = false;
    private bool isEditing = false;
    private bool isSaving = false;
    private CategoryDto currentCategory = new();

    // Reorder State
    private bool isReorderModalOpen = false;
    private bool isSavingReorder = false;
    private List<CategoryDto> reorderList = new();
    private int? draggedCategoryIndex = null;

    private IQueryable<CategoryDto>? FilteredCategories =>
        categories?
            .Where(c => !c.IsDeleted)
            .Where(c => string.IsNullOrWhiteSpace(nameFilter) ||
                       (c.Name != null && c.Name.Contains(nameFilter, StringComparison.OrdinalIgnoreCase)))
            .AsQueryable();

    private int TotalPages
    {
        get
        {
            var count = FilteredCategories?.Count() ?? 0;
            return Math.Max(1, (int)Math.Ceiling((double)count / pagination.ItemsPerPage));
        }
    }

    private string GetShowingRangeText()
    {
        var total = FilteredCategories?.Count() ?? 0;
        if (total == 0) return "Showing 0 items";
        int start = (pagination.CurrentPageIndex * pagination.ItemsPerPage) + 1;
        int end = Math.Min(start + pagination.ItemsPerPage - 1, total);
        return $"Showing {start}–{end} of {total} categories";
    }

    private async Task GoToPage(int pageIndex)
    {
        if (pageIndex >= 0 && pageIndex < TotalPages)
        {
            await pagination.SetCurrentPageIndexAsync(pageIndex);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
    }

    private async Task LoadCategories()
    {
        try
        {
            var rawCategories = await CategoryService.GetCategoriesAsync();
            // Sort by DisplayOrder ascending then CategoryId ascending
            categories = rawCategories.OrderBy(c => c.DisplayOrder).ThenBy(c => c.CategoryId).ToList();
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error",
                Text = "Failed to load categories: " + ex.Message,
                Icon = SweetAlertIcon.Error,
                ConfirmButtonText = "OK",
                ConfirmButtonColor = "#2563eb"
            });
        }
    }

    private void OpenReorderModal()
    {
        if (categories != null)
        {
            reorderList = categories
                .Where(c => !c.IsDeleted)
                .OrderBy(c => c.DisplayOrder)
                .ThenBy(c => c.CategoryId)
                .Select(c => new CategoryDto
                {
                    CategoryId = c.CategoryId,
                    Name = c.Name,
                    ColorHex = c.ColorHex,
                    IsActive = c.IsActive,
                    DisplayOrder = c.DisplayOrder
                })
                .ToList();
        }
        else
        {
            reorderList = new();
        }
        draggedCategoryIndex = null;
        isReorderModalOpen = true;
    }

    private void CloseReorderModal()
    {
        isReorderModalOpen = false;
        draggedCategoryIndex = null;
    }

    private void OnCategoryDragStart(int index)
    {
        draggedCategoryIndex = index;
    }

    private void OnCategoryDrop(int targetIndex)
    {
        if (!draggedCategoryIndex.HasValue || draggedCategoryIndex.Value == targetIndex)
            return;

        int sourceIndex = draggedCategoryIndex.Value;
        if (sourceIndex < 0 || sourceIndex >= reorderList.Count || targetIndex < 0 || targetIndex >= reorderList.Count)
            return;

        var item = reorderList[sourceIndex];
        reorderList.RemoveAt(sourceIndex);
        reorderList.Insert(targetIndex, item);
        draggedCategoryIndex = null;
    }

    private void MoveCategoryUp(int index)
    {
        if (index <= 0 || index >= reorderList.Count) return;
        var item = reorderList[index];
        reorderList.RemoveAt(index);
        reorderList.Insert(index - 1, item);
    }

    private void MoveCategoryDown(int index)
    {
        if (index < 0 || index >= reorderList.Count - 1) return;
        var item = reorderList[index];
        reorderList.RemoveAt(index);
        reorderList.Insert(index + 1, item);
    }

    private async Task SaveReorderedCategories()
    {
        try
        {
            isSavingReorder = true;
            var orderedIds = reorderList.Select(c => c.CategoryId).ToList();
            await CategoryService.ReorderCategoriesAsync(orderedIds);
            await LoadCategories();
            CloseReorderModal();
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Order Saved!",
                Text = "Category display order updated successfully.",
                Icon = SweetAlertIcon.Success,
                ConfirmButtonText = "OK",
                ConfirmButtonColor = "#2563eb"
            });
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error",
                Text = "Failed to save category order: " + ex.Message,
                Icon = SweetAlertIcon.Error,
                ConfirmButtonText = "OK",
                ConfirmButtonColor = "#2563eb"
            });
        }
        finally
        {
            isSavingReorder = false;
        }
    }

    private void OpenAddModal()
    {
        isEditing = false;
        currentCategory = new CategoryDto { IsActive = true }; // Default to active
        isModalOpen = true;
    }

    private void OpenEditModal(CategoryDto category)
    {
        isEditing = true;
        // Map fields to avoid modifying the grid item directly until save
        currentCategory = new CategoryDto
        {
            CategoryId = category.CategoryId,
            Name = category.Name,
            Description = category.Description,
            ColorHex = CategoryColor.Normalize(category.ColorHex),
            IsActive = category.IsActive
        };
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
    }

    private async Task SaveCategory()
    {
        if (string.IsNullOrWhiteSpace(currentCategory.Name))
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Missing Fields Required",
                Text = "Category name is required.",
                Icon = SweetAlertIcon.Warning,
                ConfirmButtonText = "OK",
                ConfirmButtonColor = "#2563eb"
            });
            return;
        }

        try
        {
            isSaving = true;

            if (isEditing)
            {
                await CategoryService.UpdateCategoryAsync(currentCategory.CategoryId, currentCategory);
            }
            else
            {
                await CategoryService.CreateCategoryAsync(currentCategory);
            }

            await LoadCategories(); // Refresh the grid
            CloseModal();

            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = isEditing ? "Category Updated!" : "Category Created!",
                Text = isEditing ? "Category updated successfully." : "Category created successfully.",
                Icon = SweetAlertIcon.Success,
                ConfirmButtonText = "OK",
                ConfirmButtonColor = "#2563eb"
            });
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error",
                Text = "Failed to save category: " + ex.Message,
                Icon = SweetAlertIcon.Error,
                ConfirmButtonText = "OK",
                ConfirmButtonColor = "#2563eb"
            });
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteCategory(int id)
    {
        var result = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Are you sure?",
            Text = "You are about to delete this category. This cannot be undone!",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonColor = "#d33",
            CancelButtonColor = "#64748b",
            ConfirmButtonText = "Yes, delete it!",
            CancelButtonText = "Cancel"
        });

        if (result.IsConfirmed)
        {
            try
            {
                await CategoryService.DeleteCategoryAsync(id);
                await LoadCategories();

                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "Deleted!",
                    Text = "The category has been removed.",
                    Icon = SweetAlertIcon.Success,
                    ConfirmButtonText = "OK",
                    ConfirmButtonColor = "#2563eb"
                });
            }
            catch (Exception ex)
            {
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "Error",
                    Text = "Failed to delete category: " + ex.Message,
                    Icon = SweetAlertIcon.Error,
                    ConfirmButtonText = "OK",
                    ConfirmButtonColor = "#2563eb"
                });
            }
        }
    }
}