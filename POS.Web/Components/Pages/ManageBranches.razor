@page "/branches"
@using POS.Shared.Models
@using POS.Shared.Interfaces
@using POS.Shared.Services
@using Microsoft.AspNetCore.Components.QuickGrid
@using CurrieTechnologies.Razor.SweetAlert2
@inject IBranchService BranchService
@inject SweetAlertService Swal

<PageTitle>Branches - POS</PageTitle>

<div class="w-100 py-2">
    <!-- Header Toolbar -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-3">
        <div>
            <h2 class="fw-bolder mb-1 text-dark" style="letter-spacing: -0.5px;">Branches</h2>
            <span class="text-secondary" style="font-size: 0.95rem;">Manage physical store locations and individual POS registers</span>
        </div>
        
        <div>
            <button class="btn btn-primary rounded px-4 py-2 fw-bold shadow-sm text-nowrap" @onclick="OpenNewBranchModal">
                Add New Branch
            </button>
        </div>
    </div>

    <!-- Search Row (Right Aligned) -->
    <div class="d-flex justify-content-end mb-3">
        <div class="position-relative" style="width: 280px;">
            <i class="bi bi-search position-absolute text-muted" style="left: 12px; top: 50%; transform: translateY(-50%); pointer-events: none; font-size: 0.85rem;"></i>
            <input type="search" class="form-control form-control-sm rounded ps-4 bg-white shadow-none border"
                   placeholder="Search name or code..."
                   @bind="searchTerm"
                   @bind:event="oninput" />
        </div>
    </div>

    <!-- Main Grid -->
    <div class="w-100">
        @if (branches == null)
        {
            <div class="text-center py-5 text-muted">
                <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                Loading branches...
            </div>
        }
        else
        {
            <div class="commercial-grid table-responsive w-100">
                <QuickGrid Items="@FilteredBranches" Pagination="@pagination" Theme="commercial">
                    <PropertyColumn Property="@(b => b.Code)" Title="Code" Sortable="true" Align="Align.Left" />
                    <PropertyColumn Property="@(b => b.Name)" Title="Branch Name" Sortable="true" Align="Align.Left" />
                    <PropertyColumn Property="@(b => b.Phone)" Title="Phone" Align="Align.Left" />
                    <PropertyColumn Property="@(b => b.Address)" Title="Address" Align="Align.Left" />
                    <PropertyColumn Property="@(b => b.TaxType)" Title="Tax Type" Align="Align.Left" />

                    <!-- Outlets Count -->
                    <TemplateColumn Context="branch" Title="Outlets" SortBy="@(GridSort<BranchDto>.ByAscending(b => b.OutletCount))" Sortable="true" Align="Align.Center">
                        <span class="text-dark fw-medium">
                            @branch.OutletCount
                        </span>
                    </TemplateColumn>

                    <!-- Status -->
                    <TemplateColumn Context="branch" Title="Status" Align="Align.Center">
                        @if (branch.IsActive)
                        {
                            <span class="status-badge active">
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="status-badge inactive">
                                Inactive
                            </span>
                        }
                    </TemplateColumn>

                    <!-- Actions -->
                    <TemplateColumn Context="branch" Title="Actions" Align="Align.Right">
                        <HeaderTemplate>
                            <div class="actions-header-wrap">
                                <span class="actions-header-text">Actions</span>
                            </div>
                        </HeaderTemplate>
                        <ChildContent>
                            <div class="actions-cell-wrap d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-sm btn-primary text-white" @onclick="() => OpenOutletsModal(branch)" title="Manage Outlets" aria-label="Manage Outlets">
                                    <i class="bi bi-shop"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-warning text-dark" @onclick="() => OpenEditBranchModal(branch)" title="Edit Branch" aria-label="Edit Branch">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-danger text-white" @onclick="() => DeleteBranch(branch.BranchId)" title="Delete Branch" aria-label="Delete Branch">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </ChildContent>
                    </TemplateColumn>
                </QuickGrid>
            </div>

            <!-- Bootstrap Pagination Bar -->
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center pt-3 mt-1 border-top gap-3">
                <div class="text-secondary small fw-medium">
                    @GetShowingRangeText()
                </div>

                <nav aria-label="Branches table pagination">
                    <ul class="pagination mb-0">
                        <li class="page-item @(pagination.CurrentPageIndex == 0 ? "disabled" : "")">
                            <button type="button" class="page-link" @onclick="() => GoToPage(pagination.CurrentPageIndex - 1)" disabled="@(pagination.CurrentPageIndex == 0)" aria-label="Previous">
                                Previous
                            </button>
                        </li>

                        @for (int i = 0; i < TotalPages; i++)
                        {
                            var pageIndex = i;
                            var isActive = pagination.CurrentPageIndex == pageIndex;
                            <li class="page-item @(isActive ? "active" : "")" aria-current="@(isActive ? "page" : null)">
                                <button type="button" class="page-link" @onclick="() => GoToPage(pageIndex)">
                                    @(pageIndex + 1)
                                </button>
                            </li>
                        }

                        <li class="page-item @(pagination.CurrentPageIndex >= TotalPages - 1 ? "disabled" : "")">
                            <button type="button" class="page-link" @onclick="() => GoToPage(pagination.CurrentPageIndex + 1)" disabled="@(pagination.CurrentPageIndex >= TotalPages - 1)" aria-label="Next">
                                Next
                            </button>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- Modal 1: Branch Add / Edit -->
@if (isBranchModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.5); backdrop-filter: blur(3px);" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <EditForm Model="@currentBranch" OnValidSubmit="SaveBranch" class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <DataAnnotationsValidator />
                
                <!-- Modal Header -->
                <div class="modal-header border-bottom px-4 py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold text-dark mb-0">@(isEditingBranch ? "Edit Branch" : "New Branch")</h5>
                        <small class="text-secondary" style="font-size: 0.85rem;">
                            @(isEditingBranch ? "Update physical store details and settings" : "Enter details to create a new branch location")
                        </small>
                    </div>
                    <button type="button" class="btn-close shadow-none" @onclick="CloseBranchModal" aria-label="Close"></button>
                </div>

                <!-- Modal Body -->
                <div class="modal-body px-4 py-3">
                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <label class="form-label text-dark fw-semibold small mb-1">Branch Code</label>
                            <InputText @bind-Value="currentBranch.Code" class="form-control rounded" placeholder="e.g. BR-01" />
                        </div>
                        <div class="col-12 col-md-8">
                            <label class="form-label text-dark fw-semibold small mb-1">Branch Name <span class="text-danger">*</span></label>
                            <InputText @bind-Value="currentBranch.Name" class="form-control rounded" placeholder="e.g. Main Branch" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label text-dark fw-semibold small mb-1">Phone Number</label>
                            <InputText @bind-Value="currentBranch.Phone"
                                       type="tel"
                                       inputmode="numeric"
                                       pattern="[0-9]*"
                                       class="form-control rounded"
                                       placeholder="e.g. 09123456789"
                                       onkeypress="return event.charCode >= 48 && event.charCode <= 57"
                                       oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label text-dark fw-semibold small mb-1">Tax Type (BIR)</label>
                            <InputSelect @bind-Value="currentBranch.TaxType" class="form-select rounded">
                                <option value="VAT-Registered">VAT-Registered</option>
                                <option value="Non-VAT">Non-VAT</option>
                            </InputSelect>
                        </div>
                        <div class="col-12">
                            <label class="form-label text-dark fw-semibold small mb-1">Address</label>
                            <InputTextArea @bind-Value="currentBranch.Address" class="form-control rounded" rows="2" placeholder="Street address..." />
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch p-3 bg-light rounded border d-flex align-items-center">
                                <InputCheckbox class="form-check-input ms-0 me-3" id="branchActive" @bind-Value="currentBranch.IsActive" />
                                <label class="form-check-label fw-semibold text-dark mb-0" for="branchActive">Active Branch</label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="modal-footer border-top bg-light px-4 py-3 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-light border px-4 py-2 fw-semibold text-secondary" @onclick="CloseBranchModal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 py-2 fw-bold shadow-sm" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>@(isEditingBranch ? "Save Changes" : "Save Branch")</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<!-- Modal 2: Outlets Management for Selected Branch -->
@if (isOutletsModalOpen && activeBranch != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.5); backdrop-filter: blur(3px);" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <!-- Modal Header -->
                <div class="modal-header border-bottom px-4 py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold text-dark mb-0">Outlets for @activeBranch.Name</h5>
                        <small class="text-secondary" style="font-size: 0.85rem;">Configure POS registers and sales terminals for this location</small>
                    </div>
                    <button type="button" class="btn-close shadow-none" @onclick="CloseOutletsModal" aria-label="Close"></button>
                </div>

                <!-- Modal Body -->
                <div class="modal-body px-4 py-3">
                    <!-- Inline Form for Add/Edit Outlet -->
                    <EditForm Model="@currentOutlet" OnValidSubmit="SaveOutlet" class="p-3 bg-light rounded border mb-4">
                        <div class="row g-3 align-items-end">
                            <div class="col-12 col-md-6">
                                <label class="form-label text-dark fw-semibold small mb-1">Outlet / POS Name <span class="text-danger">*</span></label>
                                <InputText @bind-Value="currentOutlet.Name" class="form-control rounded" placeholder="e.g. Main Register 1" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label text-dark fw-semibold small mb-1">Device ID / Terminal IP</label>
                                <InputText @bind-Value="currentOutlet.DeviceIdentifier" class="form-control rounded" placeholder="e.g. 192.168.1.101" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label text-dark fw-semibold small mb-1">PTU No. (BIR)</label>
                                <InputText @bind-Value="currentOutlet.PTUNumber" class="form-control rounded" placeholder="Permit To Use No." />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label text-dark fw-semibold small mb-1">MIN No. (BIR)</label>
                                <InputText @bind-Value="currentOutlet.MINNumber" class="form-control rounded" placeholder="Machine ID No." />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label text-dark fw-semibold small mb-1">Machine Serial No.</label>
                                <InputText @bind-Value="currentOutlet.SerialNumber" class="form-control rounded" placeholder="SN-XXXXX" />
                            </div>
                            <div class="col-12 d-flex justify-content-end gap-2 mt-2">
                                @if (isEditingOutlet)
                                {
                                    <button type="button" class="btn btn-light border rounded px-3 py-1 text-secondary fw-semibold small" @onclick="ResetOutletForm">Cancel</button>
                                }
                                <button type="submit" class="btn btn-primary rounded px-4 py-1 fw-bold small shadow-sm">
                                    @(isEditingOutlet ? "Update Register" : "Add Register")
                                </button>
                            </div>
                        </div>
                    </EditForm>

                    <!-- Outlet List Table -->
                    <div class="table-responsive border rounded">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Outlet Name</th>
                                    <th>Device ID</th>
                                    <th>PTU No.</th>
                                    <th>MIN No.</th>
                                    <th>Serial No.</th>
                                    <th class="text-center">Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (activeBranch.Outlets.Any())
                                {
                                    @foreach (var outlet in activeBranch.Outlets)
                                    {
                                        <tr>
                                            <td class="fw-semibold text-dark">@outlet.Name</td>
                                            <td class="text-secondary small">@(string.IsNullOrWhiteSpace(outlet.DeviceIdentifier) ? "—" : outlet.DeviceIdentifier)</td>
                                            <td class="text-secondary small">@(string.IsNullOrWhiteSpace(outlet.PTUNumber) ? "—" : outlet.PTUNumber)</td>
                                            <td class="text-secondary small">@(string.IsNullOrWhiteSpace(outlet.MINNumber) ? "—" : outlet.MINNumber)</td>
                                            <td class="text-secondary small">@(string.IsNullOrWhiteSpace(outlet.SerialNumber) ? "—" : outlet.SerialNumber)</td>
                                            <td class="text-center">
                                                @if (outlet.IsActive)
                                                {
                                                    <span class="status-badge active">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="status-badge inactive">Inactive</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <div class="d-flex justify-content-end gap-1">
                                                    <button type="button" class="btn btn-sm btn-warning text-dark" @onclick="() => EditOutlet(outlet)" title="Edit Outlet" aria-label="Edit Outlet">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-danger text-white" @onclick="() => DeleteOutlet(outlet.OutletId)" title="Delete Outlet" aria-label="Delete Outlet">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center py-4 text-muted">No registers added for this branch yet.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="modal-footer border-top bg-light px-4 py-3 d-flex justify-content-end">
                    <button type="button" class="btn btn-light border px-4 py-2 fw-semibold text-secondary" @onclick="CloseOutletsModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<BranchDto>? branches;
    private string searchTerm = string.Empty;
    private PaginationState pagination = new PaginationState { ItemsPerPage = 10 };

    private bool isBranchModalOpen = false;
    private bool isEditingBranch = false;
    private bool isSaving = false;
    private BranchDto currentBranch = new();

    private bool isOutletsModalOpen = false;
    private bool isEditingOutlet = false;
    private BranchDto? activeBranch;
    private OutletDto currentOutlet = new();

    private IQueryable<BranchDto>? FilteredBranches =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? branches?.AsQueryable()
            : branches?.Where(b =>
                (b.Name != null && b.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                (b.Code != null && b.Code.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                (b.Phone != null && b.Phone.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                (b.Address != null && b.Address.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
              ).AsQueryable();

    private int TotalPages
    {
        get
        {
            var count = FilteredBranches?.Count() ?? 0;
            return Math.Max(1, (int)Math.Ceiling((double)count / pagination.ItemsPerPage));
        }
    }

    private string GetShowingRangeText()
    {
        var total = FilteredBranches?.Count() ?? 0;
        if (total == 0) return "Showing 0 items";
        int start = (pagination.CurrentPageIndex * pagination.ItemsPerPage) + 1;
        int end = Math.Min(start + pagination.ItemsPerPage - 1, total);
        return $"Showing {start}–{end} of {total} branches";
    }

    private async Task GoToPage(int pageIndex)
    {
        if (pageIndex >= 0 && pageIndex < TotalPages)
        {
            await pagination.SetCurrentPageIndexAsync(pageIndex);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadBranches();
    }

    private async Task LoadBranches()
    {
        try
        {
            var rawBranches = await BranchService.GetBranchesAsync();
            branches = rawBranches.OrderByDescending(b => b.BranchId).ToList();
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error",
                Text = "Failed to load branches: " + ex.Message,
                Icon = SweetAlertIcon.Error,
                ConfirmButtonText = "OK",
                ConfirmButtonColor = "#2563eb"
            });
        }
    }

    private void OpenNewBranchModal()
    {
        currentBranch = new BranchDto { IsActive = true };
        isEditingBranch = false;
        isBranchModalOpen = true;
    }

    private void OpenEditBranchModal(BranchDto branch)
    {
        currentBranch = new BranchDto
        {
            BranchId = branch.BranchId,
            Name = branch.Name,
            Code = branch.Code,
            Address = branch.Address,
            Phone = !string.IsNullOrEmpty(branch.Phone) ? new string(branch.Phone.Where(char.IsDigit).ToArray()) : branch.Phone,
            TaxType = string.IsNullOrWhiteSpace(branch.TaxType) ? "VAT-Registered" : branch.TaxType,
            IsActive = branch.IsActive
        };
        isEditingBranch = true;
        isBranchModalOpen = true;
    }

    private void CloseBranchModal() => isBranchModalOpen = false;

    private async Task SaveBranch()
    {
        if (!string.IsNullOrEmpty(currentBranch.Phone))
        {
            currentBranch.Phone = new string(currentBranch.Phone.Where(char.IsDigit).ToArray());
        }

        if (string.IsNullOrWhiteSpace(currentBranch.Name))
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Missing Fields Required",
                Text = "Branch name is required.",
                Icon = SweetAlertIcon.Warning,
                ConfirmButtonText = "OK",
                ConfirmButtonColor = "#2563eb"
            });
            return;
        }

        try
        {
            isSaving = true;
            bool success;
            if (isEditingBranch)
            {
                success = await BranchService.UpdateBranchAsync(currentBranch.BranchId, currentBranch);
            }
            else
            {
                success = await BranchService.CreateBranchAsync(currentBranch);
            }

            if (success)
            {
                isBranchModalOpen = false;
                await LoadBranches();

                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = isEditingBranch ? "Branch Updated!" : "Branch Created!",
                    Text = isEditingBranch ? "Branch updated successfully." : "Branch created successfully.",
                    Icon = SweetAlertIcon.Success,
                    ConfirmButtonText = "OK",
                    ConfirmButtonColor = "#2563eb"
                });
            }
            else
            {
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "Save Failed",
                    Text = isEditingBranch ? "Could not update branch. Please try again." : "Could not create branch. Please try again.",
                    Icon = SweetAlertIcon.Error,
                    ConfirmButtonText = "OK",
                    ConfirmButtonColor = "#2563eb"
                });
            }
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error",
                Text = "Failed to save branch: " + ex.Message,
                Icon = SweetAlertIcon.Error,
                ConfirmButtonText = "OK",
                ConfirmButtonColor = "#2563eb"
            });
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteBranch(int id)
    {
        var result = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Are you sure?",
            Text = "You are about to delete this branch. This cannot be undone!",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonColor = "#d33",
            CancelButtonColor = "#64748b",
            ConfirmButtonText = "Yes, delete it!",
            CancelButtonText = "Cancel"
        });

        if (result.IsConfirmed)
        {
            try
            {
                if (await BranchService.DeleteBranchAsync(id))
                {
                    await LoadBranches();
                    await Swal.FireAsync(new SweetAlertOptions
                    {
                        Title = "Deleted!",
                        Text = "The branch has been removed.",
                        Icon = SweetAlertIcon.Success,
                        ConfirmButtonText = "OK",
                        ConfirmButtonColor = "#2563eb"
                    });
                }
                else
                {
                    await Swal.FireAsync(new SweetAlertOptions
                    {
                        Title = "Error",
                        Text = "Failed to delete branch. It may have associated registers or records.",
                        Icon = SweetAlertIcon.Error,
                        ConfirmButtonText = "OK",
                        ConfirmButtonColor = "#2563eb"
                    });
                }
            }
            catch (Exception ex)
            {
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "Error",
                    Text = "Failed to delete branch: " + ex.Message,
                    Icon = SweetAlertIcon.Error,
                    ConfirmButtonText = "OK",
                    ConfirmButtonColor = "#2563eb"
                });
            }
        }
    }

    private void OpenOutletsModal(BranchDto branch)
    {
        activeBranch = branch;
        ResetOutletForm();
        isOutletsModalOpen = true;
    }

    private void CloseOutletsModal() => isOutletsModalOpen = false;

    private void ResetOutletForm()
    {
        currentOutlet = new OutletDto
        {
            BranchId = activeBranch?.BranchId ?? 0,
            IsActive = true
        };
        isEditingOutlet = false;
    }

    private void EditOutlet(OutletDto outlet)
    {
        currentOutlet = new OutletDto
        {
            OutletId = outlet.OutletId,
            BranchId = outlet.BranchId,
            Name = outlet.Name,
            DeviceIdentifier = outlet.DeviceIdentifier,
            PTUNumber = outlet.PTUNumber,
            MINNumber = outlet.MINNumber,
            SerialNumber = outlet.SerialNumber,
            IsActive = outlet.IsActive
        };
        isEditingOutlet = true;
    }

    private async Task SaveOutlet()
    {
        if (activeBranch == null) return;

        if (string.IsNullOrWhiteSpace(currentOutlet.Name))
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Missing Fields Required",
                Text = "Outlet / Register name is required.",
                Icon = SweetAlertIcon.Warning,
                ConfirmButtonText = "OK",
                ConfirmButtonColor = "#2563eb"
            });
            return;
        }

        try
        {
            currentOutlet.BranchId = activeBranch.BranchId;
            bool success;

            if (isEditingOutlet)
            {
                success = await BranchService.UpdateOutletAsync(currentOutlet.OutletId, currentOutlet);
            }
            else
            {
                success = await BranchService.CreateOutletAsync(currentOutlet);
            }

            if (success)
            {
                var wasEditing = isEditingOutlet;
                ResetOutletForm();
                await LoadBranches();
                if (branches != null && activeBranch != null)
                {
                    activeBranch = branches.FirstOrDefault(b => b.BranchId == activeBranch.BranchId);
                }

                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = wasEditing ? "Register Updated!" : "Register Added!",
                    Text = wasEditing ? "Register updated successfully." : "Register added successfully.",
                    Icon = SweetAlertIcon.Success,
                    ConfirmButtonText = "OK",
                    ConfirmButtonColor = "#2563eb"
                });
            }
            else
            {
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "Save Failed",
                    Text = isEditingOutlet ? "Could not update register. Please try again." : "Could not add register. Please try again.",
                    Icon = SweetAlertIcon.Error,
                    ConfirmButtonText = "OK",
                    ConfirmButtonColor = "#2563eb"
                });
            }
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error",
                Text = "Failed to save outlet: " + ex.Message,
                Icon = SweetAlertIcon.Error,
                ConfirmButtonText = "OK",
                ConfirmButtonColor = "#2563eb"
            });
        }
    }

    private async Task DeleteOutlet(int outletId)
    {
        var result = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Are you sure?",
            Text = "Delete this POS register?",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonColor = "#d33",
            CancelButtonColor = "#64748b",
            ConfirmButtonText = "Yes, delete it!",
            CancelButtonText = "Cancel"
        });

        if (result.IsConfirmed)
        {
            try
            {
                if (await BranchService.DeleteOutletAsync(outletId))
                {
                    await LoadBranches();
                    if (branches != null && activeBranch != null)
                    {
                        activeBranch = branches.FirstOrDefault(b => b.BranchId == activeBranch.BranchId);
                    }

                    await Swal.FireAsync(new SweetAlertOptions
                    {
                        Title = "Deleted!",
                        Text = "The register has been removed.",
                        Icon = SweetAlertIcon.Success,
                        ConfirmButtonText = "OK",
                        ConfirmButtonColor = "#2563eb"
                    });
                }
                else
                {
                    await Swal.FireAsync(new SweetAlertOptions
                    {
                        Title = "Error",
                        Text = "Failed to delete register.",
                        Icon = SweetAlertIcon.Error,
                        ConfirmButtonText = "OK",
                        ConfirmButtonColor = "#2563eb"
                    });
                }
            }
            catch (Exception ex)
            {
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "Error",
                    Text = "Failed to delete outlet: " + ex.Message,
                    Icon = SweetAlertIcon.Error,
                    ConfirmButtonText = "OK",
                    ConfirmButtonColor = "#2563eb"
                });
            }
        }
    }
}