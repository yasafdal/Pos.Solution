                                </div>
                            }
                        </div>
                        <div class="col-md-6">
                            <h6 class="fw-bold">Bills</h6>
                            @foreach (var line in recountDenominations.Where(d => d.Type == "BILL"))
                            {
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <span class="fw-semibold" style="width: 70px;">@line.Label</span>
                                    <input type="number" min="0" class="form-control form-control-sm text-center" style="width: 95px;"
                                           value="@line.Quantity"
                                           @onchange="e => UpdateRecountDenom(line, e.Value?.ToString())" />
                                    <span class="text-end font-monospace" style="width: 100px;">₱@line.Subtotal.ToString("N2")</span>
                                </div>
                            }
                        </div>
                    </div>
