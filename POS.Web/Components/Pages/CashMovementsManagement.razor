                        <textarea class="form-control form-control-sm" rows="2" @bind="recountReason" placeholder="Explain why the recount or payment declaration adjustment was performed..."></textarea>
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-semibold">Supervisor PIN (optional if logged in as Supervisor/Admin)</label>
                        <input type="password" class="form-control form-control-sm" @bind="recountPin" placeholder="Supervisor PIN" />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button class="btn btn-light" @onclick="() => recountShift = null">Cancel</button>
                    <button class="btn btn-primary fw-bold" @onclick="SubmitRecountAsync" disabled="@isSubmitting">Save Recount & Audit Record</button>
                </div>
            </div>
        </div>
    </div>
}

