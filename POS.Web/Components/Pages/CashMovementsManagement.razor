@code {
    private string activeTab = "CLOSINGS";
    private bool isLoading;
    private bool isSubmitting;
    private bool isAuthorizedSupervisor = true;
    private int? lockedBranchId;
    private int? lockedTerminalId;

    private List<BranchDto> branches = new();
    private List<OutletDto> outlets = new();
    private List<TerminalDto> terminals = new();
    private List<CashMovementCategoryDto> categories = new();
    private List<CashMovementResponseDto> movements = new();
    private List<CashDrawerShiftDto> shifts = new();
    private CashMovementSummaryReportDto? summaryReport;

    // Filters
    private int? filterBranchId;
    private int? filterOutletId;
    private int? filterTerminalId;
    private string? filterCashierId;
    private string? filterMovementType;
    private string? filterStatus;
    private string? filterShiftStatus;
    private int? filterCategoryId;
    private DateTime? filterStartDate = DateTime.Today.AddDays(-30);
    private DateTime? filterEndDate = DateTime.Today;

    private IEnumerable<BranchDto> AuthorizedBranches => lockedBranchId.HasValue
        ? branches.Where(b => b.BranchId == lockedBranchId.Value)
        : branches;

    private IEnumerable<OutletDto> FilteredOutlets => filterBranchId.HasValue
        ? outlets.Where(o => o.BranchId == filterBranchId.Value)
        : (lockedBranchId.HasValue ? outlets.Where(o => o.BranchId == lockedBranchId.Value) : outlets);

    private IEnumerable<TerminalDto> FilteredTerminals => terminals.Where(t =>
        (!filterBranchId.HasValue || t.BranchId == filterBranchId.Value) &&
        (!filterOutletId.HasValue || t.OutletId == filterOutletId.Value) &&
        (!lockedTerminalId.HasValue || t.TerminalId == lockedTerminalId.Value));

    // Shift Detail & Recount Modal
    private CashDrawerShiftDto? selectedShift;
    private string shiftDetailMode = "RECONCILIATION";
    private CashDrawerShiftDto? recountShift;
    private List<CashDenominationLineDto> recountDenominations = new();
    private List<PaymentMethodDeclarationDto> recountPayments = new();
    private string recountReason = string.Empty;
    private string recountPin = string.Empty;

    // Category Modal
    private bool showCategoryModal;
    private int? editingCategoryId;
    private CashMovementCategoryDto categoryForm = new();

    // Action Modal
    private CashMovementResponseDto? actionMovement;
    private string actionMode = "APPROVE";
    private string actionReason = string.Empty;
    private string actionPin = string.Empty;

    // Voucher Modal
    private CashMovementResponseDto? selectedMovement;

    private IEnumerable<CashMovementResponseDto> PendingMovements =>
        movements.Where(m => m.Status == "PENDING_APPROVAL");

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            var role = user.FindFirst(ClaimTypes.Role)?.Value ?? user.FindFirst("role")?.Value ?? "";
            isAuthorizedSupervisor = role.Equals("Admin", StringComparison.OrdinalIgnoreCase)
                || role.Equals("Manager", StringComparison.OrdinalIgnoreCase)
                || role.Equals("Senior Cashier", StringComparison.OrdinalIgnoreCase)
                || role.Equals("SeniorCashier", StringComparison.OrdinalIgnoreCase);

            if (!role.Equals("Admin", StringComparison.OrdinalIgnoreCase) &&
                int.TryParse(user.FindFirst("branch_id")?.Value, out int bId))
            {
                lockedBranchId = bId;
                filterBranchId = bId;
            }
            if (!role.Equals("Admin", StringComparison.OrdinalIgnoreCase) &&
                !role.Equals("Manager", StringComparison.OrdinalIgnoreCase) &&
                int.TryParse(user.FindFirst("terminal_id")?.Value, out int tId))
            {
                lockedTerminalId = tId;
                filterTerminalId = tId;
            }
        }

        if (isAuthorizedSupervisor)
        {
            await LoadAllDataAsync();
        }
    }

    private void OnBranchFilterChanged(ChangeEventArgs e)
    {
        filterBranchId = int.TryParse(e.Value?.ToString(), out int id) ? id : lockedBranchId;
        filterOutletId = null;
        if (!lockedTerminalId.HasValue) filterTerminalId = null;
    }

    private void OnOutletFilterChanged(ChangeEventArgs e)
    {
        filterOutletId = int.TryParse(e.Value?.ToString(), out int id) ? id : null;
        if (!lockedTerminalId.HasValue) filterTerminalId = null;
    }

    private void OnTerminalFilterChanged(ChangeEventArgs e)
    {
        filterTerminalId = int.TryParse(e.Value?.ToString(), out int id) ? id : lockedTerminalId;
        if (filterTerminalId.HasValue)
        {
            var term = terminals.FirstOrDefault(t => t.TerminalId == filterTerminalId.Value);
            if (term != null)
            {
                filterBranchId = term.BranchId;
                filterOutletId = term.OutletId;
            }
        }
    }

    private async Task LoadAllDataAsync()
    {
        if (!isAuthorizedSupervisor) return;
        isLoading = true;
        try
        {
            branches = await BranchService.GetBranchesAsync();
            outlets = await OutletService.GetOutletsAsync(lockedBranchId);
            terminals = await TerminalService.GetTerminalsAsync(outletId: null, branchId: lockedBranchId);
            categories = await Http.GetFromJsonAsync<List<CashMovementCategoryDto>>("api/cash-drawer/categories?activeOnly=false") ?? new();
            await ApplyFiltersAsync();
        }
        catch (Exception ex)
        {
            await Swal.FireAsync("Error", "Failed to load cash drawer management data: " + ex.Message, SweetAlertIcon.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ApplyFiltersAsync()
    {
        if (!isAuthorizedSupervisor) return;
        isLoading = true;
        try
        {
            var query = new List<string>();
            if (filterBranchId.HasValue) query.Add($"branchId={filterBranchId.Value}");
            if (filterOutletId.HasValue) query.Add($"outletId={filterOutletId.Value}");
            if (filterTerminalId.HasValue) query.Add($"terminalId={filterTerminalId.Value}");
            if (!string.IsNullOrWhiteSpace(filterCashierId)) query.Add($"cashierId={Uri.EscapeDataString(filterCashierId)}");
            if (!string.IsNullOrWhiteSpace(filterMovementType)) query.Add($"movementType={Uri.EscapeDataString(filterMovementType)}");
            if (!string.IsNullOrWhiteSpace(filterStatus)) query.Add($"status={Uri.EscapeDataString(filterStatus)}");
            if (filterCategoryId.HasValue) query.Add($"categoryId={filterCategoryId.Value}");
            if (filterStartDate.HasValue) query.Add($"dateFrom={Uri.EscapeDataString(filterStartDate.Value.Date.ToString("o"))}");
            if (filterEndDate.HasValue) query.Add($"dateTo={Uri.EscapeDataString(filterEndDate.Value.Date.AddDays(1).AddTicks(-1).ToString("o"))}");

            string qs = query.Count > 0 ? "?" + string.Join("&", query) : string.Empty;
            movements = await Http.GetFromJsonAsync<List<CashMovementResponseDto>>($"api/cash-drawer/movements{qs}") ?? new();
            summaryReport = await Http.GetFromJsonAsync<CashMovementSummaryReportDto>($"api/cash-drawer/reports/summary{qs}");

            var shiftQuery = new List<string>();
            if (filterBranchId.HasValue) shiftQuery.Add($"branchId={filterBranchId.Value}");
            if (filterOutletId.HasValue) shiftQuery.Add($"outletId={filterOutletId.Value}");
            if (filterTerminalId.HasValue) shiftQuery.Add($"terminalId={filterTerminalId.Value}");
            if (!string.IsNullOrWhiteSpace(filterCashierId)) shiftQuery.Add($"cashierId={Uri.EscapeDataString(filterCashierId)}");
            if (!string.IsNullOrWhiteSpace(filterShiftStatus)) shiftQuery.Add($"status={Uri.EscapeDataString(filterShiftStatus)}");
            if (filterStartDate.HasValue) shiftQuery.Add($"dateFrom={Uri.EscapeDataString(filterStartDate.Value.Date.ToString("o"))}");
            if (filterEndDate.HasValue) shiftQuery.Add($"dateTo={Uri.EscapeDataString(filterEndDate.Value.Date.AddDays(1).AddTicks(-1).ToString("o"))}");
            string shiftQs = shiftQuery.Count > 0 ? "?" + string.Join("&", shiftQuery) : string.Empty;
            shifts = await Http.GetFromJsonAsync<List<CashDrawerShiftDto>>($"api/cash-drawer/shifts{shiftQs}") ?? new();
        }
        catch (Exception ex)
        {
            await Swal.FireAsync("Error", "Failed to filter drawer records: " + ex.Message, SweetAlertIcon.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ClearFiltersAsync()
    {
        filterBranchId = lockedBranchId;
        filterOutletId = null;
        filterTerminalId = lockedTerminalId;
        filterCashierId = null;
        filterMovementType = null;
        filterStatus = null;
        filterShiftStatus = null;
        filterCategoryId = null;
        filterStartDate = DateTime.Today.AddDays(-30);
        filterEndDate = DateTime.Today;
        await ApplyFiltersAsync();
    }

    private void OpenShiftDetailModal(CashDrawerShiftDto shift, string mode)
    {
        selectedShift = shift;
        shiftDetailMode = mode;
    }

    private void OpenRecountModal(CashDrawerShiftDto shift)
    {
        recountShift = shift;
        recountReason = string.Empty;
        recountPin = string.Empty;
        var defaults = CashDenominationCatalog.CreateDefaultLines();
        if (shift.HasRecordedDenominations && shift.Denominations.Count > 0)
        {
            foreach (var d in defaults)
            {
                var existing = shift.Denominations.FirstOrDefault(x => x.Type == d.Type && x.Denomination == d.Denomination);
                if (existing != null)
                {
                    d.Quantity = existing.Quantity;
                    d.Subtotal = existing.Subtotal;
                }
            }
        }
        recountDenominations = defaults;
        recountPayments = shift.ConfiguredNonCashMethods
            .Select(p => new PaymentMethodDeclarationDto
            {
                PaymentMethodCode = p.PaymentMethodCode,
                PaymentMethodName = p.PaymentMethodName,
                IsActive = p.IsActive,
                DisplayOrder = p.DisplayOrder,
                DeclaredAmount = p.DeclaredAmount
            })
            .ToList();
    }

    private void UpdateRecountDenom(CashDenominationLineDto line, string? rawVal)
    {
        int qty = int.TryParse(rawVal, out int q) && q >= 0 ? q : 0;
        line.Quantity = qty;
        line.Subtotal = Math.Round(line.Denomination * qty, 2, MidpointRounding.AwayFromZero);
    }

    private async Task SubmitRecountAsync()
    {
        if (recountShift == null) return;
        if (string.IsNullOrWhiteSpace(recountReason))
        {
            await Swal.FireAsync("Validation", "Mandatory recount reason is required.", SweetAlertIcon.Warning);
            return;
        }

        isSubmitting = true;
        try
        {
            decimal totalCash = recountDenominations.Sum(d => d.Subtotal);
            var req = new ShiftRecountRequestDto
            {
                ShiftId = recountShift.ShiftId,
                Reason = recountReason.Trim(),
                SupervisorPin = string.IsNullOrWhiteSpace(recountPin) ? null : recountPin.Trim(),
                ActualCountedBalance = totalCash,
                Denominations = recountDenominations,
                PaymentDeclarations = recountPayments
            };

            var resp = await Http.PostAsJsonAsync($"api/cash-drawer/shifts/{recountShift.ShiftId}/recount", req);
            if (resp.IsSuccessStatusCode)
            {
                var updated = await resp.Content.ReadFromJsonAsync<CashDrawerShiftDto>();
                recountShift = null;
                if (updated != null && selectedShift?.ShiftId == updated.ShiftId)
                {
                    selectedShift = updated;
                }
                await ApplyFiltersAsync();
                await Swal.FireAsync("Recount Saved", "Supervisor recount saved and original declaration preserved in audit history.", SweetAlertIcon.Success);
            }
            else
            {
                var err = await resp.Content.ReadAsStringAsync();
                await Swal.FireAsync("Recount Failed", err, SweetAlertIcon.Error);
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void OpenNewCategoryModal()
    {
        editingCategoryId = null;
        categoryForm = new CashMovementCategoryDto
        {
            MovementType = "PETTY_CASH",
            RequiresApproval = true,
            IsActive = true
        };
        showCategoryModal = true;
    }

    private void OpenEditCategoryModal(CashMovementCategoryDto cat)
    {
        editingCategoryId = cat.CategoryId;
        categoryForm = new CashMovementCategoryDto
        {
            CategoryId = cat.CategoryId,
            Name = cat.Name,
            Description = cat.Description,
            MovementType = cat.MovementType,
            RequiresApproval = cat.RequiresApproval,
            IsActive = cat.IsActive
        };
        showCategoryModal = true;
    }

    private async Task SaveCategoryAsync()
    {
        if (string.IsNullOrWhiteSpace(categoryForm.Name))
        {
            await Swal.FireAsync("Validation", "Category name is required.", SweetAlertIcon.Warning);
            return;
        }

        isSubmitting = true;
        try
        {
            HttpResponseMessage resp;
            if (editingCategoryId.HasValue)
            {
                resp = await Http.PutAsJsonAsync($"api/cash-drawer/categories/{editingCategoryId.Value}", categoryForm);
            }
            else
            {
                resp = await Http.PostAsJsonAsync("api/cash-drawer/categories", categoryForm);
            }

            if (resp.IsSuccessStatusCode)
            {
                showCategoryModal = false;
                await LoadAllDataAsync();
                await Swal.FireAsync("Saved", "Category saved successfully.", SweetAlertIcon.Success);
            }
            else
            {
                var err = await resp.Content.ReadAsStringAsync();
                await Swal.FireAsync("Error", err, SweetAlertIcon.Error);
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task DeactivateCategoryAsync(CashMovementCategoryDto cat)
    {
        var resp = await Http.DeleteAsync($"api/cash-drawer/categories/{cat.CategoryId}");
        if (resp.IsSuccessStatusCode)
        {
            await LoadAllDataAsync();
        }
    }

    private void OpenActionModal(CashMovementResponseDto movement, string mode)
    {
        actionMovement = movement;
        actionMode = mode;
        actionReason = string.Empty;
        actionPin = string.Empty;
    }

    private async Task SubmitActionAsync()
    {
        if (actionMovement == null) return;
        isSubmitting = true;
        try
        {
            HttpResponseMessage resp;
            if (actionMode == "APPROVE")
            {
                resp = await Http.PostAsJsonAsync($"api/cash-drawer/movements/{actionMovement.MovementId}/approve", new CashMovementApproveRejectDto
                {
                    SupervisorPin = actionPin
                });
            }
            else if (actionMode == "REJECT")
            {
                resp = await Http.PostAsJsonAsync($"api/cash-drawer/movements/{actionMovement.MovementId}/reject", new CashMovementApproveRejectDto
                {
                    Reason = actionReason,
                    SupervisorPin = actionPin
                });
            }
            else
            {
                resp = await Http.PostAsJsonAsync($"api/cash-drawer/movements/{actionMovement.MovementId}/reverse", new CashMovementReverseDto
                {
                    Reason = actionReason,
                    SupervisorPin = actionPin
                });
            }

            if (resp.IsSuccessStatusCode)
            {
                actionMovement = null;
                await ApplyFiltersAsync();
                await Swal.FireAsync("Success", $"Cash movement {actionMode.ToLowerInvariant()}d successfully.", SweetAlertIcon.Success);
            }
            else
            {
                var err = await resp.Content.ReadAsStringAsync();
                await Swal.FireAsync("Action Failed", err, SweetAlertIcon.Error);
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task ExportCsvAsync()
    {
        if (!isAuthorizedSupervisor) return;
        var sb = new StringBuilder();
        sb.AppendLine("\"POS Back-Office Shift Closings & Cash Drawer Reconciliation Export\"");
        sb.AppendLine("\"Shift ID\",\"Status\",\"Branch\",\"Outlet\",\"Terminal Name\",\"Terminal Code\",\"Cashier\",\"Opened At\",\"Closed At\",\"Opening Float\",\"Cash Sales\",\"Cash Refunds\",\"Paid-In\",\"Paid-Out\",\"Petty Cash\",\"Cash Drops\",\"Expected Cash\",\"Counted Cash\",\"Denominations Status\",\"Cash Variance\",\"Non-Cash Expected\",\"Non-Cash Cashier-Declared\",\"Overall Reconciliation Status\",\"Recount Count\",\"Notes\"");
        foreach (var s in shifts)
        {
            string denomsStatus = s.HasRecordedDenominations ? "Recorded" : "Not Recorded";
            sb.AppendLine($"{s.ShiftId},\"{s.Status}\",\"{s.BranchName.Replace("\"", "\"\"")}\",\"{s.OutletName.Replace("\"", "\"\"")}\",\"{s.TerminalName.Replace("\"", "\"\"")}\",\"{s.TerminalCode.Replace("\"", "\"\"")}\",\"{s.CashierId}\",\"{s.OpenedAt:yyyy-MM-dd HH:mm:ss}\",\"{(s.ClosedAt.HasValue ? s.ClosedAt.Value.ToString("yyyy-MM-dd HH:mm:ss") : "")}\",{s.OpeningFloat:0.00},{s.TotalCashSales:0.00},{s.TotalCashRefunds:0.00},{s.TotalCashIn:0.00},{s.TotalCashOut:0.00},{s.TotalPettyCashOut:0.00},{s.TotalCashDrops:0.00},{s.ExpectedBalance:0.00},{(s.ActualCountedBalance ?? 0m):0.00},\"{denomsStatus}\",{(s.Discrepancy ?? 0m):0.00},{s.TotalNonCashExpected:0.00},{s.TotalNonCashDeclared:0.00},\"{s.OverallReconciliationStatus}\",{s.RecountHistory.Count},\"{(s.Notes ?? "").Replace("\"", "\"\"")}\"");
        }
        var bytes = Encoding.UTF8.GetBytes(sb.ToString());
        var b64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("eval", $"{{ const a = document.createElement('a'); a.href = 'data:text/csv;base64,{b64}'; a.download = 'shift-closings-reconciliation-{DateTime.UtcNow:yyyyMMddHHmmss}.csv'; a.click(); }}");
    }

