@page "/"
@using POS.Shared.Interfaces
@using POS.Shared.Models
@using System.Security.Claims
@inject ISalesReportService SalesReportService
@inject ICategoryService CategoryService
@inject IProductService ProductService
@inject IBranchService BranchService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider

<PageTitle>Dashboard — POS Admin</PageTitle>

<!-- Content Header -->
<div class="app-content-header mb-3">
    <div class="container-fluid px-0">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
            <div>
                <h3 class="mb-0 fw-bold text-dark">
                    <i class="bi bi-speedometer2 text-primary me-2"></i>Executive POS Dashboard
                </h3>
                <small class="text-secondary">Commercial sales performance, trends, and category product rankings</small>
            </div>
            <div class="d-flex align-items-center gap-2">
                @if (branches.Count > 1 && !lockedBranchId.HasValue)
                {
                    <select class="form-select form-select-sm rounded-3 shadow-sm" value="@(selectedBranchId?.ToString() ?? "")" @onchange="OnBranchChanged">
                        <option value="">All Branches</option>
                        @foreach (var b in branches)
                        {
                            <option value="@b.BranchId">@b.Name</option>
                        }
                    </select>
                }
                <button class="btn btn-outline-primary btn-sm rounded-3 px-3 shadow-sm text-nowrap" @onclick="LoadDashboardDataAsync" disabled="@loading">
                    <i class="bi bi-arrow-repeat me-1 @(loading ? "spin" : "")"></i> Refresh
                </button>
            </div>
        </div>
    </div>
</div>

@if (loading && summary == null)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <div class="text-muted small mt-2">Loading executive dashboard metrics...</div>
    </div>
}
else if (summary != null)
{
    <!-- Stat Cards: Daily, Monthly, Yearly & Order Metrics -->
    <div class="row g-3 mb-4">
        <!-- Today's Sales Card -->
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white border-start border-4 border-primary">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-uppercase text-secondary fw-semibold fs-7 tracking-wide">Today's Sales</span>
                        <h3 class="fw-bolder text-dark mb-1 font-monospace mt-1">₱@summary.TodaySales.ToString("N2")</h3>
                        <span class="badge bg-primary-subtle text-primary border rounded-pill">
                            <i class="bi bi-cart-check me-1"></i>@summary.TodayOrdersCount Order(s)
                        </span>
                    </div>
                    <div class="p-3 bg-primary-subtle text-primary rounded-4">
                        <i class="bi bi-cash-stack fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- This Month's Sales Card -->
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white border-start border-4 border-success">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-uppercase text-secondary fw-semibold fs-7 tracking-wide">This Month's Sales</span>
                        <h3 class="fw-bolder text-success mb-1 font-monospace mt-1">₱@summary.ThisMonthSales.ToString("N2")</h3>
                        <span class="badge bg-success-subtle text-success border rounded-pill">
                            <i class="bi bi-calendar3 me-1"></i>@summary.ThisMonthOrdersCount Order(s)
                        </span>
                    </div>
                    <div class="p-3 bg-success-subtle text-success rounded-4">
                        <i class="bi bi-calendar-check-fill fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- This Year's Sales Card -->
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white border-start border-4 border-info">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-uppercase text-secondary fw-semibold fs-7 tracking-wide">This Year's Sales</span>
                        <h3 class="fw-bolder text-info mb-1 font-monospace mt-1">₱@summary.ThisYearSales.ToString("N2")</h3>
                        <span class="badge bg-info-subtle text-info border rounded-pill">
                            <i class="bi bi-graph-up me-1"></i>@summary.ThisYearOrdersCount Order(s)
                        </span>
                    </div>
                    <div class="p-3 bg-info-subtle text-info rounded-4">
                        <i class="bi bi-bar-chart-line-fill fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Average Ticket & Products Card -->
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white border-start border-4 border-warning">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-uppercase text-secondary fw-semibold fs-7 tracking-wide">Average Ticket</span>
                        <h3 class="fw-bolder text-warning mb-1 font-monospace mt-1">₱@summary.AverageOrderValue.ToString("N2")</h3>
                        <span class="text-muted small">
                            @summary.ActiveProductsCount Products in @summary.ActiveCategoriesCount Categories
                        </span>
                    </div>
                    <div class="p-3 bg-warning-subtle text-warning rounded-4">
                        <i class="bi bi-receipt-cutoff fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sales Trends (Daily, Monthly, Yearly) Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white overflow-hidden">
        <div class="card-header bg-white py-3 px-4 border-bottom d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
            <div>
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-graph-up-arrow text-primary me-2"></i>Sales Performance Trends
                </h5>
                <small class="text-muted">Periodic sales volume and completed order counts</small>
            </div>
            <!-- Trend Period Tabs -->
            <ul class="nav nav-pills gap-1" role="tablist">
                <li class="nav-item">
                    <button class="nav-link btn-sm py-1 px-3 rounded-pill @(trendPeriod == "DAILY" ? "active bg-dark text-white" : "bg-light text-dark")"
                            @onclick='() => trendPeriod = "DAILY"'>
                        Daily (Last 7 Days)
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link btn-sm py-1 px-3 rounded-pill @(trendPeriod == "MONTHLY" ? "active bg-dark text-white" : "bg-light text-dark")"
                            @onclick='() => trendPeriod = "MONTHLY"'>
                        Monthly (This Year)
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link btn-sm py-1 px-3 rounded-pill @(trendPeriod == "YEARLY" ? "active bg-dark text-white" : "bg-light text-dark")"
                            @onclick='() => trendPeriod = "YEARLY"'>
                        Yearly (Multi-Year)
                    </button>
                </li>
            </ul>
        </div>
        <div class="card-body p-4">
            @{
                var activeTrend = trendPeriod switch
                {
                    "MONTHLY" => summary.MonthlySalesTrend,
                    "YEARLY" => summary.YearlySalesTrend,
                    _ => summary.DailySalesTrend
                };
                decimal maxSales = activeTrend.Count > 0 ? Math.Max(1m, activeTrend.Max(x => x.NetSales)) : 1m;
            }

            @if (activeTrend.Count == 0)
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-calendar-x fs-2 d-block mb-2 text-muted"></i>
                    No sales recorded for this period.
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var point in activeTrend)
                    {
                        var pct = Math.Clamp((int)((point.NetSales / maxSales) * 100), 2, 100);
                        <div class="col-md-6 col-lg-4">
                            <div class="p-3 border rounded-3 bg-light">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="text-dark">@point.Label</strong>
                                    <span class="badge bg-white text-secondary border">@point.TransactionCount order(s)</span>
                                </div>
                                <div class="progress mb-2" style="height: 8px;">
                                    <div class="progress-bar bg-primary" role="progressbar" style="width: @(pct)%;" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                                <div class="d-flex justify-content-between small">
                                    <span class="text-muted">Net Revenue:</span>
                                    <span class="font-monospace fw-bold text-dark">₱@point.NetSales.ToString("N2")</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Top Selling Products Per Category Section -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white overflow-hidden">
        <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
            <div>
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-trophy-fill text-warning me-2"></i>Top Selling Products per Category
                </h5>
                <small class="text-muted">Fastest-moving items ranked by unit volume and gross revenue within each category</small>
            </div>
            <a href="sales-reports" class="btn btn-outline-dark btn-sm rounded-pill px-3 shadow-sm">
                Full Sales Reports <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="card-body p-4 bg-light">
            @if (summary.TopSellingProductsPerCategory.Count == 0)
            {
                <div class="text-center py-5 text-muted bg-white rounded-3">
                    <i class="bi bi-inbox fs-2 d-block mb-2 text-muted"></i>
                    No product sales recorded yet. Ring up sales on POS.Client to see live rankings.
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var cat in summary.TopSellingProductsPerCategory)
                    {
                        <div class="col-xl-6">
                            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white overflow-hidden">
                                <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="rounded-circle d-inline-block shadow-sm" style="width: 14px; height: 14px; background-color: @(string.IsNullOrEmpty(cat.CategoryColorHex) ? "#3b82f6" : cat.CategoryColorHex);"></span>
                                        <h6 class="fw-bold mb-0 text-dark">@cat.CategoryName</h6>
                                    </div>
                                    <span class="badge bg-light text-dark border">@cat.TopProducts.Count top items</span>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover align-middle mb-0">
                                        <thead class="table-light fs-7 text-uppercase text-secondary">
                                            <tr>
                                                <th class="ps-3" style="width: 50px;">Rank</th>
                                                <th>Product</th>
                                                <th class="text-center">Units Sold</th>
                                                <th class="text-end pe-3">Revenue</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{ int rank = 1; }
                                            @foreach (var prod in cat.TopProducts)
                                            {
                                                <tr>
                                                    <td class="ps-3">
                                                        <span class="badge @(rank == 1 ? "bg-warning text-dark" : rank == 2 ? "bg-secondary text-white" : rank == 3 ? "bg-dark text-white" : "bg-light text-muted border") rounded-pill">
                                                            #@rank
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <div class="fw-semibold text-dark">@prod.ProductName</div>
                                                        @if (!string.IsNullOrEmpty(prod.ProductShortCode))
                                                        {
                                                            <small class="text-muted font-monospace">@prod.ProductShortCode</small>
                                                        }
                                                    </td>
                                                    <td class="text-center font-monospace fw-bold">@prod.QuantitySold.ToString("0.###")</td>
                                                    <td class="text-end pe-3 font-monospace fw-bold text-success">₱@prod.TotalRevenue.ToString("N2")</td>
                                                </tr>
                                                rank++;
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

<!-- Quick Actions Toolbar -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-sm-6">
        <a href="manage-products" class="card border-0 shadow-sm rounded-4 p-3 bg-white text-decoration-none text-dark hover-lift d-flex flex-row align-items-center gap-3">
            <div class="p-3 bg-primary-subtle text-primary rounded-4">
                <i class="bi bi-box-seam-fill fs-4"></i>
            </div>
            <div>
                <h6 class="fw-bold mb-0">Manage Products</h6>
                <small class="text-muted">Menu pricing & routing</small>
            </div>
        </a>
    </div>
    <div class="col-md-3 col-sm-6">
        <a href="manage-categories" class="card border-0 shadow-sm rounded-4 p-3 bg-white text-decoration-none text-dark hover-lift d-flex flex-row align-items-center gap-3">
            <div class="p-3 bg-success-subtle text-success rounded-4">
                <i class="bi bi-tags-fill fs-4"></i>
            </div>
            <div>
                <h6 class="fw-bold mb-0">Manage Categories</h6>
                <small class="text-muted">Color badges & taxonomy</small>
            </div>
        </a>
    </div>
    <div class="col-md-3 col-sm-6">
        <a href="sales-reports" class="card border-0 shadow-sm rounded-4 p-3 bg-white text-decoration-none text-dark hover-lift d-flex flex-row align-items-center gap-3">
            <div class="p-3 bg-info-subtle text-info rounded-4">
                <i class="bi bi-bar-chart-fill fs-4"></i>
            </div>
            <div>
                <h6 class="fw-bold mb-0">Sales Reports</h6>
                <small class="text-muted">Reconciliation & taxes</small>
            </div>
        </a>
    </div>
    <div class="col-md-3 col-sm-6">
        <a href="z-reading-audit" class="card border-0 shadow-sm rounded-4 p-3 bg-white text-decoration-none text-dark hover-lift d-flex flex-row align-items-center gap-3">
            <div class="p-3 bg-warning-subtle text-warning rounded-4">
                <i class="bi bi-file-earmark-lock-fill fs-4"></i>
            </div>
            <div>
                <h6 class="fw-bold mb-0">Z-Reading Archive</h6>
                <small class="text-muted">Finalized BIR snapshots</small>
            </div>
        </a>
    </div>
</div>

<style>
    .tracking-wide { letter-spacing: 0.5px; }
    .fs-7 { font-size: 0.8rem; }
    .hover-lift { transition: transform 0.15s ease, box-shadow 0.15s ease; }
    .hover-lift:hover { transform: translateY(-3px); box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.1) !important; }
    .spin { animation: spin 1s linear infinite; }
    @@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
</style>

@code {
    private DashboardSalesSummaryDto? summary;
    private List<BranchDto> branches = [];
    private int? selectedBranchId;
    private int? lockedBranchId;
    private string trendPeriod = "DAILY";
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (!user.IsInRole("Admin") && int.TryParse(user.FindFirst("branch_id")?.Value, out var bId))
        {
            lockedBranchId = bId;
            selectedBranchId = bId;
        }

        try
        {
            branches = await BranchService.GetBranchesAsync();
            if (lockedBranchId.HasValue)
            {
                branches = branches.Where(b => b.BranchId == lockedBranchId.Value).ToList();
            }
        }
        catch { }

        await LoadDashboardDataAsync();
    }

    private async Task OnBranchChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var bId))
        {
            selectedBranchId = bId;
        }
        else
        {
            selectedBranchId = null;
        }
        await LoadDashboardDataAsync();
    }

    private async Task LoadDashboardDataAsync()
    {
        loading = true;
        try
        {
            summary = await SalesReportService.GetDashboardSummaryAsync(selectedBranchId);
        }
        catch (Exception ex)
        {
            Console.WriteLine("Failed to load dashboard summary: " + ex.Message);
        }
        finally
        {
            loading = false;
        }
    }
}
