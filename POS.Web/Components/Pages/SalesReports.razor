@page "/sales-reports"
@using POS.Shared.Models
@using POS.Shared.Interfaces
@using CurrieTechnologies.Razor.SweetAlert2
@inject ISalesReportService SalesReportService
@inject SweetAlertService SwalAlert

<PageTitle>Sales Reports & Summary - POS Admin</PageTitle>

<div class="w-100 py-2">
    <!-- Header Toolbar -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-3">
        <div>
            <h2 class="fw-bolder mb-1 text-dark" style="letter-spacing: -0.5px;">Sales Reports & Analytics</h2>
            <span class="text-secondary" style="font-size: 0.95rem;">Financial aggregation, gross/net sales, output VAT reconciliation, and performance grouping</span>
        </div>
        <div>
            <button class="btn btn-primary rounded px-4 py-2 fw-bold shadow-sm text-nowrap" @onclick="LoadReport">
                <i class="bi bi-arrow-repeat me-1"></i> Refresh Report
            </button>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label text-dark fw-semibold small mb-1">Date From</label>
                <input type="date" class="form-control form-control-sm rounded-3" @bind="request.DateFrom" />
            </div>
            <div class="col-md-3">
                <label class="form-label text-dark fw-semibold small mb-1">Date To</label>
                <input type="date" class="form-control form-control-sm rounded-3" @bind="request.DateTo" />
            </div>
            <div class="col-md-3">
                <label class="form-label text-dark fw-semibold small mb-1">Grouping Mode</label>
                <select class="form-select form-select-sm rounded-3" @bind="request.Grouping">
                    <option value="DAILY">Daily Breakdown</option>
                    <option value="WEEKLY">Weekly Breakdown</option>
                    <option value="MONTHLY">Monthly Breakdown</option>
                    <option value="CASHIER">By Cashier</option>
                    <option value="BRANCH">By Branch</option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="report-branch" class="form-label">Branch ID</label><input id="report-branch" type="number" min="1" class="form-control form-control-sm mb-2" @bind="request.BranchId" />
                <label for="report-outlet" class="form-label">Outlet ID</label><input id="report-outlet" type="number" min="1" class="form-control form-control-sm mb-2" @bind="request.OutletId" />
                <label for="report-terminal" class="form-label">Terminal ID</label><input id="report-terminal" type="number" min="1" class="form-control form-control-sm mb-2" @bind="request.TerminalId" />
                <button class="btn btn-dark btn-sm rounded-3 px-3 fw-bold shadow-sm w-100" @onclick="LoadReport">
                    <i class="bi bi-filter me-1"></i> Generate Report
                </button>
            </div>
        </div>
    </div>

    @if (report == null)
    {
        <div class="text-center py-5 text-muted">
            <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
            Generating sales report...
        </div>
    }
    else
    {
        <!-- KPI Metrics Grid -->
        <div class="row g-3 mb-4">
            <div class="col-xl-3 col-sm-6">
                <div class="card border rounded-3 p-3 bg-white shadow-sm h-100">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-secondary small fw-semibold text-uppercase d-block mb-1">Gross Sales</span>
                            <h4 class="fw-bold text-dark mb-0">₱@report.GrossSales.ToString("N2")</h4>
                        </div>
                        <div class="d-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-3" style="width: 44px; height: 44px;">
                            <i class="bi bi-wallet2 fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-sm-6">
                <div class="card border rounded-3 p-3 bg-white shadow-sm h-100">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-secondary small fw-semibold text-uppercase d-block mb-1">Net Sales</span>
                            <h4 class="fw-bold text-success mb-0">₱@report.NetSales.ToString("N2")</h4>
                        </div>
                        <div class="d-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success rounded-3" style="width: 44px; height: 44px;">
                            <i class="bi bi-graph-up-arrow fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-sm-6">
                <div class="card border rounded-3 p-3 bg-white shadow-sm h-100">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-secondary small fw-semibold text-uppercase d-block mb-1">Total Discounts</span>
                            <h4 class="fw-bold text-dark mb-0">₱@report.TotalDiscounts.ToString("N2")</h4>
                        </div>
                        <div class="d-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning rounded-3" style="width: 44px; height: 44px;">
                            <i class="bi bi-tag-fill fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-sm-6">
                <div class="card border rounded-3 p-3 bg-white shadow-sm h-100">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-secondary small fw-semibold text-uppercase d-block mb-1">Output VAT (12%)</span>
                            <h4 class="fw-bold text-dark mb-0">₱@report.OutputVat.ToString("N2")</h4>
                        </div>
                        <div class="d-flex align-items-center justify-content-center bg-info bg-opacity-10 text-info rounded-3" style="width: 44px; height: 44px;">
                            <i class="bi bi-receipt fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Secondary Summary Stats -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card border rounded-3 p-3 bg-white shadow-sm h-100">
                    <span class="text-secondary small fw-semibold d-block mb-1">Completed Transactions</span>
                    <h4 class="fw-bold text-dark mb-0">@report.CompletedTransactionsCount</h4>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border rounded-3 p-3 bg-white shadow-sm h-100">
                    <span class="text-secondary small fw-semibold d-block mb-1">Average Transaction Value</span>
                    <h4 class="fw-bold text-dark mb-0">₱@report.AverageTransactionValue.ToString("N2")</h4>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border rounded-3 p-3 bg-white shadow-sm h-100">
                    <span class="text-secondary small fw-semibold d-block mb-1">Total Payments Collected</span>
                    <h4 class="fw-bold text-dark mb-0">₱@report.TotalPaymentsCollected.ToString("N2")</h4>
                </div>
            </div>
        </div>

        <!-- Breakdown Table -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-white py-3 px-4 border-bottom">
                <h5 class="fw-bold mb-0 text-dark">Sales Breakdown (@request.Grouping)</h5>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light text-uppercase fs-7 text-secondary">
                        <tr>
                            <th class="py-3 px-4">Period / Group</th>
                            <th class="py-3 text-center">Transactions</th>
                            <th class="py-3 text-end">Gross Sales</th>
                            <th class="py-3 text-end">Discounts</th>
                            <th class="py-3 text-end">Output VAT</th>
                            <th class="py-3 text-end px-4">Net Sales</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (report.Breakdown == null || !report.Breakdown.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted fst-italic">No sales data found for the selected criteria.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in report.Breakdown)
                            {
                                <tr>
                                    <td class="px-4 fw-bold text-dark">@item.Label</td>
                                    <td class="text-center"><span class="badge bg-secondary-subtle text-dark">@item.TransactionCount</span></td>
                                    <td class="text-end">₱@item.GrossSales.ToString("N2")</td>
                                    <td class="text-end text-danger">-₱@item.TotalDiscounts.ToString("N2")</td>
                                    <td class="text-end">₱@item.OutputVat.ToString("N2")</td>
                                    <td class="text-end px-4 fw-bold text-success">₱@item.NetSales.ToString("N2")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private SalesReportRequestDto request = new() { Grouping = "DAILY" };
    private SalesReportResponseDto? report;

    protected override async Task OnInitializedAsync() => await LoadReport();

    private async Task LoadReport()
    {
        try
        {
            report = await SalesReportService.GenerateReportAsync(request);
        }
        catch (Exception ex)
        {
            await SwalAlert.FireAsync("Error", "Failed to generate sales report: " + ex.Message, SweetAlertIcon.Error);
        }
    }
}
