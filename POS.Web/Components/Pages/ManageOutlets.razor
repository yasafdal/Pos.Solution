@page "/outlets"
@page "/manage-outlets"
@using POS.Shared.Models
@using POS.Shared.Interfaces
@using Microsoft.AspNetCore.Components.QuickGrid
@using CurrieTechnologies.Razor.SweetAlert2
@inject IOutletService OutletService
@inject IBranchService BranchService
@inject SweetAlertService Swal
@inject NavigationManager Navigation

<PageTitle>Outlet Management - POS</PageTitle>

<div class="w-100 py-2">
    <!-- Header Toolbar -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-3">
        <div>
            <h2 class="fw-bolder mb-1 text-dark" style="letter-spacing: -0.5px;">Outlet Management</h2>
            <span class="text-secondary" style="font-size: 0.95rem;">Manage physical stores, booths, kiosks, and operational counters</span>
        </div>
        
        <div>
            <button class="btn btn-primary rounded px-4 py-2 fw-bold shadow-sm text-nowrap" @onclick="OpenNewOutletModal">
                <i class="bi bi-plus-lg me-1"></i> Add New Outlet
            </button>
        </div>
    </div>

    <!-- Filter and Search Row -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-3">
        <!-- Branch Filter -->
        <div class="d-flex align-items-center gap-2">
            <label class="form-label mb-0 text-secondary small fw-semibold text-nowrap">Filter Branch:</label>
            <select class="form-select form-select-sm rounded bg-white shadow-none border" style="min-width: 200px;" value="@selectedBranchFilter" @onchange="OnBranchFilterChanged">
                <option value="0">All Branches</option>
                @if (branches != null)
                {
                    @foreach (var b in branches)
                    {
                        <option value="@b.BranchId">@b.Name (@b.Code)</option>
                    }
                }
            </select>
        </div>

        <!-- Search Box -->
        <div class="position-relative" style="width: 280px;">
            <i class="bi bi-search position-absolute text-muted" style="left: 12px; top: 50%; transform: translateY(-50%); pointer-events: none; font-size: 0.85rem;"></i>
            <input type="search" class="form-control form-control-sm rounded ps-4 bg-white shadow-none border"
                   placeholder="Search outlet code, name..."
                   @bind="searchTerm"
                   @bind:event="oninput" />
        </div>
    </div>

    <!-- Main Grid -->
    <div class="w-100">
        @if (isLoading)
        {
            <div class="text-center py-5 text-muted">
                <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                Loading outlets...
            </div>
        }
        else if (outlets == null || !outlets.Any())
        {
            <div class="text-center py-5 border rounded bg-white">
                <i class="bi bi-shop text-muted display-4 mb-2 d-block"></i>
                <h5 class="fw-bold text-dark">No Outlets Found</h5>
                <p class="text-secondary small mb-3">Get started by creating your first outlet location for a branch.</p>
                <button class="btn btn-sm btn-primary rounded px-3" @onclick="OpenNewOutletModal">
                    Add New Outlet
                </button>
            </div>
        }
        else
        {
            <div class="commercial-grid table-responsive w-100">
                <QuickGrid Items="@FilteredOutlets" Pagination="@pagination" Theme="commercial">
                    <PropertyColumn Property="@(o => o.OutletCode)" Title="Outlet Code" Sortable="true" Align="Align.Left" />
                    <PropertyColumn Property="@(o => o.Name)" Title="Outlet Name" Sortable="true" Align="Align.Left" />
                    <TemplateColumn Title="Branch" Context="o" Align="Align.Left">
                        <span class="fw-medium text-dark">@(GetBranchName(o.BranchId))</span>
                    </TemplateColumn>
                    <TemplateColumn Title="Type" Context="o" Align="Align.Left">
                        <span class="badge bg-light text-dark border">@o.OutletType</span>
                    </TemplateColumn>
                    <PropertyColumn Property="@(o => o.LocationDescription)" Title="Location" Align="Align.Left" />
                    <TemplateColumn Title="Terminals" Context="o" Align="Align.Center">
                        <span class="badge bg-primary text-white rounded-pill px-2 py-1">
                            @o.TerminalCount
                        </span>
                    </TemplateColumn>
                    <TemplateColumn Title="Status" Context="o" Align="Align.Center">
                        @if (o.IsActive)
                        {
                            <span class="status-badge active">Active</span>
                        }
                        else
                        {
                            <span class="status-badge inactive">Inactive</span>
                        }
                    </TemplateColumn>
                    <TemplateColumn Title="Actions" Context="o" Align="Align.Right">
                        <HeaderTemplate>
                            <div class="actions-header-wrap">
                                <span class="actions-header-text">Actions</span>
                            </div>
                        </HeaderTemplate>
                        <ChildContent>
                            <div class="actions-cell-wrap d-flex justify-content-end gap-2">
                                <a href="terminals?branchId=@o.BranchId&outletId=@o.OutletId" class="btn btn-sm btn-primary text-white" title="Manage Terminals" aria-label="Manage Terminals">
                                    <i class="bi bi-display"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-warning text-dark" @onclick="() => OpenEditOutletModal(o)" title="Edit Outlet" aria-label="Edit Outlet">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-sm @(o.IsActive ? "btn-outline-secondary" : "btn-outline-success")" @onclick="() => ToggleOutletActive(o)" title="@(o.IsActive ? "Deactivate Outlet" : "Activate Outlet")" aria-label="Toggle Status">
                                    <i class="bi @(o.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-danger text-white" disabled="@(o.TerminalCount > 0)" @onclick="() => DeleteOutlet(o)" title="@(o.TerminalCount > 0 ? "Cannot delete outlet with registered terminals" : "Delete Outlet")" aria-label="Delete Outlet">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </ChildContent>
                    </TemplateColumn>
                </QuickGrid>
            </div>

            <!-- Pagination Bar -->
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center pt-3 mt-1 border-top gap-3">
                <div class="text-secondary small fw-medium">
                    @GetShowingRangeText()
                </div>

                <nav aria-label="Outlets table pagination">
                    <ul class="pagination mb-0">
                        <li class="page-item @(pagination.CurrentPageIndex == 0 ? "disabled" : "")">
                            <button type="button" class="page-link" @onclick="() => GoToPage(pagination.CurrentPageIndex - 1)" disabled="@(pagination.CurrentPageIndex == 0)" aria-label="Previous">
                                Previous
                            </button>
                        </li>
                        @for (int i = 0; i < TotalPages; i++)
                        {
                            var pageIndex = i;
                            <li class="page-item @(pagination.CurrentPageIndex == pageIndex ? "active" : "")">
                                <button type="button" class="page-link" @onclick="() => GoToPage(pageIndex)">
                                    @(pageIndex + 1)
                                </button>
                            </li>
                        }
                        <li class="page-item @(pagination.CurrentPageIndex >= TotalPages - 1 ? "disabled" : "")">
                            <button type="button" class="page-link" @onclick="() => GoToPage(pagination.CurrentPageIndex + 1)" disabled="@(pagination.CurrentPageIndex >= TotalPages - 1)" aria-label="Next">
                                Next
                            </button>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- Create / Edit Outlet Modal -->
@if (isOutletModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.5); backdrop-filter: blur(3px);" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <div class="modal-header border-bottom px-4 py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold text-dark mb-0">@(isEditingOutlet ? "Edit Outlet" : "Create New Outlet")</h5>
                        <small class="text-secondary" style="font-size: 0.85rem;">Configure physical store location or operational booth</small>
                    </div>
                    <button type="button" class="btn-close shadow-none" @onclick="CloseOutletModal" aria-label="Close"></button>
                </div>

                <EditForm Model="@currentOutlet" OnValidSubmit="SaveOutlet">
                    <DataAnnotationsValidator />
                    <div class="modal-body px-4 py-3">
                        @if (!string.IsNullOrEmpty(modalError))
                        {
                            <div class="alert alert-danger py-2 small" role="alert">@modalError</div>
                        }

                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label text-dark fw-semibold small mb-1">Branch *</label>
                                <InputSelect @bind-Value="currentOutlet.BranchId" class="form-select rounded" disabled="@isEditingOutlet">
                                    <option value="0">-- Select Branch --</option>
                                    @if (branches != null)
                                    {
                                        @foreach (var b in branches)
                                        {
                                            <option value="@b.BranchId">@b.Name (@b.Code)</option>
                                        }
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => currentOutlet.BranchId)" class="text-danger small" />
                                @if (isEditingOutlet)
                                {
                                    <small class="text-muted" style="font-size: 0.75rem;">Branch ownership cannot be reassigned once created.</small>
                                }
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label text-dark fw-semibold small mb-1">Outlet Code *</label>
                                <InputText @bind-Value="currentOutlet.OutletCode" class="form-control rounded text-uppercase" placeholder="e.g. MAIN, KIOSK-1" />
                                <ValidationMessage For="@(() => currentOutlet.OutletCode)" class="text-danger small" />
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label text-dark fw-semibold small mb-1">Outlet Type *</label>
                                <InputSelect @bind-Value="currentOutlet.OutletType" class="form-select rounded">
                                    @foreach (var type in new[] { "Main", "Booth", "Kiosk", "Counter", "Mobile" })
                                    {
                                        <option value="@type">@type</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => currentOutlet.OutletType)" class="text-danger small" />
                            </div>

                            <div class="col-12">
                                <label class="form-label text-dark fw-semibold small mb-1">Outlet Name *</label>
                                <InputText @bind-Value="currentOutlet.Name" class="form-control rounded" placeholder="e.g. Main Dining Counter" />
                                <ValidationMessage For="@(() => currentOutlet.Name)" class="text-danger small" />
                            </div>

                            <div class="col-12">
                                <label class="form-label text-dark fw-semibold small mb-1">Location Description</label>
                                <InputText @bind-Value="currentOutlet.LocationDescription" class="form-control rounded" placeholder="e.g. Ground Floor, Building A" />
                            </div>

                            <div class="col-12">
                                <label class="form-label text-dark fw-semibold small mb-1">Description</label>
                                <InputTextArea @bind-Value="currentOutlet.Description" class="form-control rounded" rows="2" placeholder="Optional notes about this location..." />
                            </div>

                            <div class="col-12">
                                <div class="form-check form-switch p-3 bg-light rounded border d-flex align-items-center">
                                    <InputCheckbox class="form-check-input ms-0 me-3" id="outletActive" @bind-Value="currentOutlet.IsActive" />
                                    <label class="form-check-label fw-semibold text-dark mb-0" for="outletActive">Active Outlet</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer border-top bg-light px-4 py-3 d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-light border px-4 py-2 fw-semibold text-secondary" @onclick="CloseOutletModal">Cancel</button>
                        <button type="submit" class="btn btn-primary px-4 py-2 fw-bold shadow-sm" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <span>@(isEditingOutlet ? "Save Changes" : "Create Outlet")</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    public int? BranchId { get; set; }

    private List<OutletDto>? outlets;
    private List<BranchDto>? branches;
    private int selectedBranchFilter = 0;
    private string searchTerm = string.Empty;
    private PaginationState pagination = new PaginationState { ItemsPerPage = 10 };
    private bool isLoading = true;

    private bool isOutletModalOpen = false;
    private bool isEditingOutlet = false;
    private bool isSaving = false;
    private string? modalError;
    private OutletDto currentOutlet = new();

    private IQueryable<OutletDto>? FilteredOutlets
    {
        get
        {
            if (outlets == null) return null;
            var query = outlets.AsQueryable();
            if (selectedBranchFilter > 0)
            {
                query = query.Where(o => o.BranchId == selectedBranchFilter);
            }
            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                query = query.Where(o =>
                    (o.OutletCode != null && o.OutletCode.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                    (o.Name != null && o.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                    (o.OutletType != null && o.OutletType.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                    (o.LocationDescription != null && o.LocationDescription.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                );
            }
            return query;
        }
    }

    private int TotalPages
    {
        get
        {
            var count = FilteredOutlets?.Count() ?? 0;
            return Math.Max(1, (int)Math.Ceiling((double)count / pagination.ItemsPerPage));
        }
    }

    private string GetShowingRangeText()
    {
        var total = FilteredOutlets?.Count() ?? 0;
        if (total == 0) return "Showing 0 items";
        int start = (pagination.CurrentPageIndex * pagination.ItemsPerPage) + 1;
        int end = Math.Min(start + pagination.ItemsPerPage - 1, total);
        return $"Showing {start}–{end} of {total} outlets";
    }

    private async Task GoToPage(int pageIndex)
    {
        if (pageIndex >= 0 && pageIndex < TotalPages)
        {
            await pagination.SetCurrentPageIndexAsync(pageIndex);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (BranchId.HasValue && BranchId.Value > 0)
        {
            selectedBranchFilter = BranchId.Value;
        }
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            branches = await BranchService.GetBranchesAsync();
            outlets = await OutletService.GetOutletsAsync(selectedBranchFilter > 0 ? selectedBranchFilter : null);
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error",
                Text = "Failed to load outlets: " + ex.Message,
                Icon = SweetAlertIcon.Error,
                ConfirmButtonText = "OK",
                ConfirmButtonColor = "#2563eb"
            });
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnBranchFilterChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var bId))
        {
            selectedBranchFilter = bId;
            await pagination.SetCurrentPageIndexAsync(0);
            await LoadData();
        }
    }

    private string GetBranchName(int branchId)
    {
        return branches?.FirstOrDefault(b => b.BranchId == branchId)?.Name ?? $"Branch #{branchId}";
    }

    private void OpenNewOutletModal()
    {
        modalError = null;
        currentOutlet = new OutletDto
        {
            BranchId = selectedBranchFilter > 0 ? selectedBranchFilter : (branches?.FirstOrDefault()?.BranchId ?? 0),
            OutletType = "Main",
            IsActive = true
        };
        isEditingOutlet = false;
        isOutletModalOpen = true;
    }

    private void OpenEditOutletModal(OutletDto outlet)
    {
        modalError = null;
        currentOutlet = new OutletDto
        {
            OutletId = outlet.OutletId,
            BranchId = outlet.BranchId,
            OutletCode = outlet.OutletCode,
            Name = outlet.Name,
            OutletType = outlet.OutletType,
            LocationDescription = outlet.LocationDescription,
            Description = outlet.Description,
            IsActive = outlet.IsActive,
            TerminalCount = outlet.TerminalCount
        };
        isEditingOutlet = true;
        isOutletModalOpen = true;
    }

    private void CloseOutletModal() => isOutletModalOpen = false;

    private async Task SaveOutlet()
    {
        if (currentOutlet.BranchId <= 0)
        {
            modalError = "Please select a branch.";
            return;
        }
        if (string.IsNullOrWhiteSpace(currentOutlet.OutletCode))
        {
            modalError = "Outlet code is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(currentOutlet.Name))
        {
            modalError = "Outlet name is required.";
            return;
        }

        try
        {
            isSaving = true;
            modalError = null;
            currentOutlet.OutletCode = currentOutlet.OutletCode.Trim().ToUpperInvariant();
            currentOutlet.Name = currentOutlet.Name.Trim();

            bool success;
            if (isEditingOutlet)
            {
                success = await OutletService.UpdateOutletAsync(currentOutlet.OutletId, currentOutlet);
            }
            else
            {
                success = await OutletService.CreateOutletAsync(currentOutlet);
            }

            if (success)
            {
                isOutletModalOpen = false;
                await LoadData();
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = isEditingOutlet ? "Outlet Updated!" : "Outlet Created!",
                    Text = isEditingOutlet ? "Outlet location updated successfully." : "Outlet location created successfully.",
                    Icon = SweetAlertIcon.Success,
                    ConfirmButtonText = "OK",
                    ConfirmButtonColor = "#2563eb"
                });
            }
            else
            {
                modalError = "Failed to save outlet. Please ensure the code is unique within the branch.";
            }
        }
        catch (Exception ex)
        {
            modalError = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ToggleOutletActive(OutletDto outlet)
    {
        var action = outlet.IsActive ? "deactivate" : "activate";
        var result = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = $"{(outlet.IsActive ? "Deactivate" : "Activate")} Outlet?",
            Text = outlet.IsActive
                ? "Deactivating an outlet prevents new terminal operations at this location. All assigned terminals must be deactivated first."
                : "Reactivate this outlet location for terminal assignments?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            ConfirmButtonText = $"Yes, {action}",
            ConfirmButtonColor = outlet.IsActive ? "#ef4444" : "#22c55e",
            CancelButtonText = "Cancel"
        });

        if (!result.IsConfirmed) return;

        try
        {
            var updateDto = new OutletDto
            {
                OutletId = outlet.OutletId,
                BranchId = outlet.BranchId,
                OutletCode = outlet.OutletCode,
                Name = outlet.Name,
                OutletType = outlet.OutletType,
                LocationDescription = outlet.LocationDescription,
                Description = outlet.Description,
                IsActive = !outlet.IsActive
            };

            var success = await OutletService.UpdateOutletAsync(outlet.OutletId, updateDto);
            if (success)
            {
                await LoadData();
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "Updated!",
                    Text = $"Outlet {action}d successfully.",
                    Icon = SweetAlertIcon.Success,
                    ConfirmButtonText = "OK",
                    ConfirmButtonColor = "#2563eb"
                });
            }
            else
            {
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "Action Blocked",
                    Text = "Could not update outlet. Ensure all terminals assigned to this outlet are deactivated before deactivating the outlet.",
                    Icon = SweetAlertIcon.Warning,
                    ConfirmButtonText = "OK",
                    ConfirmButtonColor = "#2563eb"
                });
            }
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error",
                Text = ex.Message,
                Icon = SweetAlertIcon.Error,
                ConfirmButtonText = "OK",
                ConfirmButtonColor = "#2563eb"
            });
        }
    }

    private async Task DeleteOutlet(OutletDto outlet)
    {
        if (outlet.TerminalCount > 0)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Cannot Delete",
                Text = "This outlet has registered terminals. Deactivate the outlet instead of deleting it.",
                Icon = SweetAlertIcon.Warning,
                ConfirmButtonText = "OK",
                ConfirmButtonColor = "#2563eb"
            });
            return;
        }

        var result = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Delete Outlet?",
            Text = $"Are you sure you want to delete outlet '{outlet.Name}'? This action cannot be undone.",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Yes, delete",
            ConfirmButtonColor = "#ef4444",
            CancelButtonText = "Cancel"
        });

        if (!result.IsConfirmed) return;

        try
        {
            var success = await OutletService.DeleteOutletAsync(outlet.OutletId);
            if (success)
            {
                await LoadData();
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "Deleted!",
                    Text = "Outlet deleted successfully.",
                    Icon = SweetAlertIcon.Success,
                    ConfirmButtonText = "OK",
                    ConfirmButtonColor = "#2563eb"
                });
            }
            else
            {
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "Deletion Failed",
                    Text = "Could not delete outlet. It may have linked historical data.",
                    Icon = SweetAlertIcon.Error,
                    ConfirmButtonText = "OK",
                    ConfirmButtonColor = "#2563eb"
                });
            }
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error",
                Text = ex.Message,
                Icon = SweetAlertIcon.Error,
                ConfirmButtonText = "OK",
                ConfirmButtonColor = "#2563eb"
            });
        }
    }
}
