@page "/uom"
@using POS.Shared.Models
@using POS.Shared.Interfaces
@using Microsoft.AspNetCore.Components.QuickGrid
@inject IUomService UomService

<div class="container-fluid p-4">
    <!-- Header Section -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold text-dark mb-1">Unit of Measure (UOM)</h3>
            <p class="text-secondary mb-0 small">Manage measurement units for catalog products and ingredients</p>
        </div>
        <button class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm d-flex align-items-center gap-2" @onclick="OpenNewModal">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4" />
            </svg>
            Add UOM
        </button>
    </div>

    <!-- Search Input -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 rounded-start-3 text-secondary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                            </svg>
                        </span>
                        <input type="text" class="form-control border-start-0 rounded-end-3" placeholder="Search UOM name or abbreviation..." @bind="searchTerm" @bind:event="oninput" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- QuickGrid Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <QuickGrid Items="@FilteredUoms" Pagination="@pagination" Theme="commercial">
                    <PropertyColumn Property="@(u => u.Name)" Title="Unit Name" Sortable="true" Align="Align.Left" />
                    <PropertyColumn Property="@(u => u.Abbreviation)" Title="Abbreviation" Sortable="true" Align="Align.Center" />

                    <!-- Status Column -->
                    <TemplateColumn Context="uom" Title="Status" Align="Align.Center">
                        @if (uom.IsActive)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1">Inactive</span>
                        }
                    </TemplateColumn>

                    <!-- Actions Column -->
                    <TemplateColumn Context="uom" Title="Actions" Align="Align.Right">
                        <div class="d-flex justify-content-end gap-2 me-2">
                            <button class="btn btn-sm btn-outline-warning text-dark rounded-circle p-2 d-flex align-items-center" @onclick="() => OpenEditModal(uom)" title="Edit UOM">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325" />
                                </svg>
                            </button>
                            <button class="btn btn-sm btn-outline-danger rounded-circle p-2 d-flex align-items-center" @onclick="() => DeleteUom(uom.UomId)" title="Delete UOM">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
                                    <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                                </svg>
                            </button>
                        </div>
                    </TemplateColumn>
                </QuickGrid>
            </div>
        </div>
        <div class="card-footer bg-white border-top-0 p-3">
            <Paginator State="@pagination" />
        </div>
    </div>
</div>

<!-- Modal: Add / Edit UOM -->
@if (isModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.5); backdrop-filter: blur(3px);" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <EditForm Model="@currentUom" OnValidSubmit="SaveUom" class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <DataAnnotationsValidator />
                <div class="modal-header border-bottom px-4 py-3">
                    <h5 class="fw-bold mb-0">@(isEditing ? "Edit UOM" : "New UOM")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body px-4 py-3">
                    <div class="row g-3">
                        <div class="col-12 col-md-8">
                            <label class="form-label fw-semibold small">Unit Name <span class="text-danger">*</span></label>
                            <InputText @bind-Value="currentUom.Name" class="form-control rounded-3" placeholder="e.g. Kilogram, Piece, Liter" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold small">Abbreviation <span class="text-danger">*</span></label>
                            <InputText @bind-Value="currentUom.Abbreviation" class="form-control rounded-3" placeholder="e.g. kg, pc, L" />
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch p-3 bg-light rounded-3 border">
                                <InputCheckbox class="form-check-input ms-0 me-2" id="uomActive" @bind-Value="currentUom.IsActive" />
                                <label class="form-check-label fw-semibold text-dark" for="uomActive">Active UOM</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top bg-light px-4 py-3">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" @onclick="CloseModal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold" disabled="@isSaving">Save UOM</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private List<UomDto> uoms = new();
    private string searchTerm = string.Empty;
    private PaginationState pagination = new PaginationState { ItemsPerPage = 10 };

    private bool isModalOpen = false;
    private bool isEditing = false;
    private bool isSaving = false;
    private UomDto currentUom = new();

    private IQueryable<UomDto> FilteredUoms
    {
        get
        {
            var query = uoms.AsQueryable();
            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                query = query.Where(u => u.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                                         u.Abbreviation.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
            }
            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadUoms();
    }

    private async Task LoadUoms()
    {
        uoms = await UomService.GetUomsAsync();
    }

    private void OpenNewModal()
    {
        currentUom = new UomDto { IsActive = true };
        isEditing = false;
        isModalOpen = true;
    }

    private void OpenEditModal(UomDto uom)
    {
        currentUom = new UomDto
        {
            UomId = uom.UomId,
            Name = uom.Name,
            Abbreviation = uom.Abbreviation,
            IsActive = uom.IsActive
        };
        isEditing = true;
        isModalOpen = true;
    }

    private void CloseModal() => isModalOpen = false;

    private async Task SaveUom()
    {
        if (string.IsNullOrWhiteSpace(currentUom.Name) || string.IsNullOrWhiteSpace(currentUom.Abbreviation)) return;

        isSaving = true;
        if (isEditing)
        {
            await UomService.UpdateUomAsync(currentUom.UomId, currentUom);
        }
        else
        {
            await UomService.CreateUomAsync(currentUom);
        }
        isSaving = false;
        isModalOpen = false;
        await LoadUoms();
    }

    private async Task DeleteUom(int id)
    {
        if (await UomService.DeleteUomAsync(id))
        {
            await LoadUoms();
        }
    }
}