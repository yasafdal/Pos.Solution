@page "/uom"
@using POS.Shared.Models
@using POS.Shared.Interfaces
@using Microsoft.AspNetCore.Components.QuickGrid
@using CurrieTechnologies.Razor.SweetAlert2
@inject IUomService UomService
@inject SweetAlertService Swal

<PageTitle>Units of Measure - POS</PageTitle>

<div class="w-100 py-2">
    <!-- Header Toolbar -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-3">
        <div>
            <h2 class="fw-bolder mb-1 text-dark" style="letter-spacing: -0.5px;">Units of Measure</h2>
            <span class="text-secondary" style="font-size: 0.95rem;">Manage measurement units for catalog products and ingredients</span>
        </div>
        
        <div>
            <button class="btn btn-primary rounded px-4 py-2 fw-bold shadow-sm text-nowrap" @onclick="OpenNewModal">
                Add New UOM
            </button>
        </div>
    </div>

    <!-- Search Row (Right Aligned) -->
    <div class="d-flex justify-content-end mb-3">
        <div class="position-relative" style="width: 280px;">
            <i class="bi bi-search position-absolute text-muted" style="left: 12px; top: 50%; transform: translateY(-50%); pointer-events: none; font-size: 0.85rem;"></i>
            <input type="search" class="form-control form-control-sm rounded ps-4 bg-white shadow-none border"
                   placeholder="Search name or abbreviation..."
                   @bind="searchTerm"
                   @bind:event="oninput" />
        </div>
    </div>

    <!-- Main Grid -->
    <div class="w-100">
        @if (uoms == null)
        {
            <div class="text-center py-5 text-muted">
                <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                Loading units of measure...
            </div>
        }
        else
        {
            <div class="commercial-grid table-responsive w-100">
                <QuickGrid Items="@FilteredUoms" Pagination="@pagination" Theme="commercial">
                    <!-- Col 1: Unit Name -->
                    <PropertyColumn Property="@(u => u.Name)" Title="Unit Name" Sortable="true" Align="Align.Left" />

                    <!-- Col 2: Abbreviation -->
                    <PropertyColumn Property="@(u => u.Abbreviation)" Title="Abbreviation" Sortable="true" Align="Align.Center" />

                    <!-- Col 3: Status -->
                    <TemplateColumn Context="uom" Title="Status" Align="Align.Center">
                        @if (uom.IsActive)
                        {
                            <span class="status-badge active">Active</span>
                        }
                        else
                        {
                            <span class="status-badge inactive">Inactive</span>
                        }
                    </TemplateColumn>

                    <!-- Col 4: Actions -->
                    <TemplateColumn Context="uom" Title="Actions" Align="Align.Right">
                        <HeaderTemplate>
                            <div class="actions-header-wrap">
                                <span class="actions-header-text">Actions</span>
                            </div>
                        </HeaderTemplate>
                        <ChildContent>
                            <div class="actions-cell-wrap d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-sm btn-warning text-dark" @onclick="() => OpenEditModal(uom)" title="Edit UOM" aria-label="Edit UOM">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-danger text-white" @onclick="() => DeleteUom(uom.UomId)" title="Delete UOM" aria-label="Delete UOM">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </ChildContent>
                    </TemplateColumn>
                </QuickGrid>
            </div>

            <!-- Bootstrap Pagination Bar -->
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center pt-3 mt-1 border-top gap-3">
                <div class="text-secondary small fw-medium">
                    @GetShowingRangeText()
                </div>

                <nav aria-label="UOM table pagination">
                    <ul class="pagination mb-0">
                        <li class="page-item @(pagination.CurrentPageIndex == 0 ? "disabled" : "")">
                            <button type="button" class="page-link" @onclick="() => GoToPage(pagination.CurrentPageIndex - 1)" disabled="@(pagination.CurrentPageIndex == 0)" aria-label="Previous">
                                Previous
                            </button>
                        </li>

                        @for (int i = 0; i < TotalPages; i++)
                        {
                            var pageIndex = i;
                            var isActive = pagination.CurrentPageIndex == pageIndex;
                            <li class="page-item @(isActive ? "active" : "")" aria-current="@(isActive ? "page" : null)">
                                <button type="button" class="page-link" @onclick="() => GoToPage(pageIndex)">
                                    @(pageIndex + 1)
                                </button>
                            </li>
                        }

                        <li class="page-item @(pagination.CurrentPageIndex >= TotalPages - 1 ? "disabled" : "")">
                            <button type="button" class="page-link" @onclick="() => GoToPage(pagination.CurrentPageIndex + 1)" disabled="@(pagination.CurrentPageIndex >= TotalPages - 1)" aria-label="Next">
                                Next
                            </button>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- Modal: Add / Edit UOM -->
@if (isModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.5); backdrop-filter: blur(3px);" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <EditForm Model="@currentUom" OnValidSubmit="SaveUom" class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <DataAnnotationsValidator />
                
                <div class="modal-header border-bottom px-4 py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold text-dark mb-0">@(isEditing ? "Edit UOM" : "New UOM")</h5>
                        <small class="text-secondary" style="font-size: 0.85rem;">
                            @(isEditing ? "Update measurement unit details and settings" : "Create a new measurement unit for products and recipes")
                        </small>
                    </div>
                    <button type="button" class="btn-close shadow-none" @onclick="CloseModal" aria-label="Close"></button>
                </div>
                
                <div class="modal-body px-4 py-3">
                    <div class="row g-3">
                        <div class="col-12 col-md-8">
                            <label class="form-label text-dark fw-semibold small mb-1">Unit Name <span class="text-danger">*</span></label>
                            <InputText @bind-Value="currentUom.Name" class="form-control rounded" placeholder="e.g. Kilogram, Piece, Liter" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label text-dark fw-semibold small mb-1">Abbreviation <span class="text-danger">*</span></label>
                            <InputText @bind-Value="currentUom.Abbreviation" class="form-control rounded" placeholder="e.g. kg, pc, L" />
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch p-3 bg-light rounded border d-flex align-items-center">
                                <InputCheckbox class="form-check-input ms-0 me-3" id="uomActive" @bind-Value="currentUom.IsActive" />
                                <label class="form-check-label fw-semibold text-dark mb-0" for="uomActive">Active UOM</label>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="modal-footer border-top bg-light px-4 py-3 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-light border px-4 py-2 fw-semibold text-secondary" @onclick="CloseModal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 py-2 fw-bold shadow-sm" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>@(isEditing ? "Save Changes" : "Save UOM")</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private List<UomDto>? uoms;
    private string searchTerm = string.Empty;
    private PaginationState pagination = new PaginationState { ItemsPerPage = 10 };

    private bool isModalOpen = false;
    private bool isEditing = false;
    private bool isSaving = false;
    private UomDto currentUom = new();

    private IQueryable<UomDto>? FilteredUoms =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? uoms?.AsQueryable()
            : uoms?.Where(u =>
                (u.Name != null && u.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                (u.Abbreviation != null && u.Abbreviation.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
              ).AsQueryable();

    private int TotalPages
    {
        get
        {
            var count = FilteredUoms?.Count() ?? 0;
            return Math.Max(1, (int)Math.Ceiling((double)count / pagination.ItemsPerPage));
        }
    }

    private string GetShowingRangeText()
    {
        var total = FilteredUoms?.Count() ?? 0;
        if (total == 0) return "Showing 0 items";
        int start = (pagination.CurrentPageIndex * pagination.ItemsPerPage) + 1;
        int end = Math.Min(start + pagination.ItemsPerPage - 1, total);
        return $"Showing {start}–{end} of {total} units";
    }

    private async Task GoToPage(int pageIndex)
    {
        if (pageIndex >= 0 && pageIndex < TotalPages)
        {
            await pagination.SetCurrentPageIndexAsync(pageIndex);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadUoms();
    }

    private async Task LoadUoms()
    {
        try
        {
            var rawUoms = await UomService.GetUomsAsync();
            uoms = rawUoms.OrderByDescending(u => u.UomId).ToList();
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error",
                Text = "Failed to load units of measure: " + ex.Message,
                Icon = SweetAlertIcon.Error,
                ConfirmButtonText = "OK",
                ConfirmButtonColor = "#2563eb"
            });
        }
    }

    private void OpenNewModal()
    {
        currentUom = new UomDto { IsActive = true };
        isEditing = false;
        isModalOpen = true;
    }

    private void OpenEditModal(UomDto uom)
    {
        currentUom = new UomDto
        {
            UomId = uom.UomId,
            Name = uom.Name,
            Abbreviation = uom.Abbreviation,
            IsActive = uom.IsActive
        };
        isEditing = true;
        isModalOpen = true;
    }

    private void CloseModal() => isModalOpen = false;

    private async Task SaveUom()
    {
        if (string.IsNullOrWhiteSpace(currentUom.Name) || string.IsNullOrWhiteSpace(currentUom.Abbreviation))
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Missing Fields Required",
                Text = "Unit name and abbreviation are required.",
                Icon = SweetAlertIcon.Warning,
                ConfirmButtonText = "OK",
                ConfirmButtonColor = "#2563eb"
            });
            return;
        }

        try
        {
            isSaving = true;
            bool success;
            if (isEditing)
            {
                success = await UomService.UpdateUomAsync(currentUom.UomId, currentUom);
            }
            else
            {
                success = await UomService.CreateUomAsync(currentUom);
            }

            if (success)
            {
                isModalOpen = false;
                await LoadUoms();

                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = isEditing ? "UOM Updated!" : "UOM Created!",
                    Text = isEditing ? "Unit of measure updated successfully." : "Unit of measure created successfully.",
                    Icon = SweetAlertIcon.Success,
                    ConfirmButtonText = "OK",
                    ConfirmButtonColor = "#2563eb"
                });
            }
            else
            {
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "Save Failed",
                    Text = isEditing ? "Could not update UOM. Please try again." : "Could not create UOM. Please try again.",
                    Icon = SweetAlertIcon.Error,
                    ConfirmButtonText = "OK",
                    ConfirmButtonColor = "#2563eb"
                });
            }
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error",
                Text = "Failed to save UOM: " + ex.Message,
                Icon = SweetAlertIcon.Error,
                ConfirmButtonText = "OK",
                ConfirmButtonColor = "#2563eb"
            });
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteUom(int id)
    {
        var result = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Are you sure?",
            Text = "You are about to delete this unit of measure. This cannot be undone!",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonColor = "#d33",
            CancelButtonColor = "#64748b",
            ConfirmButtonText = "Yes, delete it!",
            CancelButtonText = "Cancel"
        });

        if (result.IsConfirmed)
        {
            try
            {
                if (await UomService.DeleteUomAsync(id))
                {
                    await LoadUoms();
                    await Swal.FireAsync(new SweetAlertOptions
                    {
                        Title = "Deleted!",
                        Text = "The unit of measure has been removed.",
                        Icon = SweetAlertIcon.Success,
                        ConfirmButtonText = "OK",
                        ConfirmButtonColor = "#2563eb"
                    });
                }
                else
                {
                    await Swal.FireAsync(new SweetAlertOptions
                    {
                        Title = "Error",
                        Text = "Failed to delete UOM. It may be assigned to catalog products or recipe items.",
                        Icon = SweetAlertIcon.Error,
                        ConfirmButtonText = "OK",
                        ConfirmButtonColor = "#2563eb"
                    });
                }
            }
            catch (Exception ex)
            {
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "Error",
                    Text = "Failed to delete UOM: " + ex.Message,
                    Icon = SweetAlertIcon.Error,
                    ConfirmButtonText = "OK",
                    ConfirmButtonColor = "#2563eb"
                });
            }
        }
    }
}