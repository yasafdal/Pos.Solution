@page "/users"
@inject IUserService UserService
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin, Manager")]

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0">User Management</h3>
            <p class="text-muted small">Manage cashier and admin accounts for your POS system</p>
        </div>
        <button class="btn btn-primary rounded-pill px-4" @onclick="OpenModal">
            + Add New User
        </button>
    </div>

    <!-- Users Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">User ID</th>
                            <th>Username</th>
                            <th>Role</th>
                            <th>PIN Code</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (users.Any())
                        {
                            @foreach (var user in users)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">#@user.UserId</td>
                                    <td>@user.Username</td>
                                    <td>
                                        <span class="badge @(user.Role == "Admin" ? "bg-danger-subtle text-danger" : "bg-primary-subtle text-primary") border px-3 py-1">
                                            @user.Role
                                        </span>
                                    </td>
                                    <td><code>@(user.PinCode ?? "N/A")</code></td>
                                    <td class="text-end pe-4">
                                        <button class="btn btn-sm btn-danger square-rectangle p-2" @onclick="() => DeleteUser(user.UserId)">
                                           <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">No users found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
@if (isModalOpen)
{
    <div class="modal fade show d-block" style="background-color: rgba(15, 23, 42, 0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow-lg">
                <div class="modal-header border-bottom px-4">
                    <h5 class="fw-bold mb-0">Create New User</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <EditForm Model="@newUser" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <div class="modal-body px-4 py-3">
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger py-2 mb-3">@errorMessage</div>
                        }

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Username <span class="text-danger">*</span></label>
                            <InputText @bind-Value="newUser.Username" class="form-control rounded-3" placeholder="e.g. john_cashier" />
                            <ValidationMessage For="@(() => newUser.Username)" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Password <span class="text-danger">*</span></label>
                            <InputText @bind-Value="newUser.Password" type="password" class="form-control rounded-3" placeholder="At least 6 characters" />
                            <ValidationMessage For="@(() => newUser.Password)" class="text-danger small" />
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="form-label small fw-semibold">Role</label>
                                <InputSelect @bind-Value="newUser.Role" class="form-select rounded-3">
                                    <option value="Cashier">Cashier</option>
                                    <option value="Senior Cashier">Senior_Cashier</option>
                                    <option value="Manager">Manager</option>
                                    <option value="Admin">Admin</option>
                                </InputSelect>
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-semibold">Quick PIN (Optional)</label>
                                <InputText @bind-Value="newUser.PinCode" class="form-control rounded-3" placeholder="e.g. 1234" maxlength="10" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-top px-4">
                        <button type="button" class="btn btn-light rounded-pill px-4" @onclick="CloseModal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4" disabled="@isSaving">
                            @(isSaving ? "Saving..." : "Create Account")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<UserDto> users = new();
    private CreateUserDto newUser = new();
    private bool isModalOpen = false;
    private bool isSaving = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        users = await UserService.GetUsersAsync();
    }

    private void OpenModal()
    {
        newUser = new CreateUserDto();
        errorMessage = null;
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
    }

    private async Task HandleSubmit()
    {
        isSaving = true;
        errorMessage = null;

        var (success, error) = await UserService.CreateUserAsync(newUser);
        isSaving = false;

        if (success)
        {
            CloseModal();
            await LoadUsers();
        }
        else
        {
            errorMessage = error;
        }
    }

    private async Task DeleteUser(int userId)
    {
        if (await UserService.DeleteUserAsync(userId))
        {
            await LoadUsers();
        }
    }
}