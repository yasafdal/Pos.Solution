@page "/manage-products"
@page "/manage-products/{FilterCategoryId:int}"
@using POS.Shared.Models
@using POS.Shared.Interfaces
@using Microsoft.AspNetCore.Components.QuickGrid
@using CurrieTechnologies.Razor.SweetAlert2
@inject IProductService ProductService
@inject ICategoryService CategoryService
@inject ITaxService TaxService
@inject IUomService UomService
@inject IProductRecipeService ProductRecipeService
@inject SweetAlertService Swal
@inject HttpClient Http

<PageTitle>@(FilterCategoryId.HasValue && CurrentCategory != null ? $"{CurrentCategory.Name} - POS" : "Products - POS")</PageTitle>

<div class="w-100 py-2">
    <!-- Header Toolbar -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-3">
        <div>
            <h2 class="fw-bolder mb-1 text-dark" style="letter-spacing: -0.5px;">
                @(FilterCategoryId.HasValue && CurrentCategory != null ? CurrentCategory.Name : "Products")
            </h2>
            <span class="text-secondary" style="font-size: 0.95rem;">
                @(FilterCategoryId.HasValue && CurrentCategory != null
                    ? $"Manage inventory, pricing, and configurations for {CurrentCategory.Name}"
                    : "Manage your inventory, pricing, and configurations")
            </span>
        </div>
        
        <div>
            <button class="btn btn-primary rounded px-4 py-2 fw-bold shadow-sm text-nowrap" @onclick="OpenAddModal">
                Add New Product
            </button>
        </div>
    </div>

    <!-- Breadcrumbs & Search Row -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-3">
        <!-- Breadcrumb Navigation (Left) -->
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb custom-breadcrumb mb-0" style="--bs-breadcrumb-divider: '›';">
                <li class="breadcrumb-item">
                    <a href="/manage-categories">Categories</a>
                </li>
                @if (FilterCategoryId.HasValue)
                {
                    <li class="breadcrumb-item">
                        <a href="/manage-products">Products</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        @(CurrentCategory?.Name ?? $"Category #{FilterCategoryId.Value}")
                    </li>
                }
                else
                {
                    <li class="breadcrumb-item active" aria-current="page">Products</li>
                }
            </ol>
        </nav>

        <!-- Search Input (Right) -->
        <div class="position-relative" style="width: 280px;">
            <i class="bi bi-search position-absolute text-muted" style="left: 12px; top: 50%; transform: translateY(-50%); pointer-events: none; font-size: 0.85rem;"></i>
            <input type="search" class="form-control form-control-sm rounded ps-4 bg-white shadow-none border"
                   placeholder="Search name, SKU, barcode..."
                   @bind="nameFilter"
                   @bind:event="oninput" />
        </div>
    </div>

    <!-- Main Grid -->
    <div class="w-100">
        @if (products == null)
        {
            <div class="text-center py-5 text-muted">
                <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                Loading products...
            </div>
        }
        else
        {

            <div class="commercial-grid table-responsive w-100">
                <QuickGrid Items="@FilteredProducts" Pagination="@pagination" Theme="commercial">
        
                    <!-- Product Image Thumbnail Column -->
                    <TemplateColumn Context="product" Title="Image" Align="Align.Center">
                        <div class="d-flex align-items-center justify-content-center py-1">
                            @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                            {
                                <img src="@GetFullImageUrl(product.ImageUrl)"
                                     alt="@product.Name"
                                     class="rounded-3 border object-fit-cover shadow-sm"
                                     style="width: 60px; height: 60px;" />
                            }
                            else
                            {
                                <div class="bg-light border rounded-3 d-flex align-items-center justify-content-center text-secondary"
                                     style="width: 60px; height: 60px; background-color: #f8f9fa;">
                                    <i class="bi bi-image text-muted fs-4"></i>
                                </div>
                            }
                        </div>
                    </TemplateColumn>

                    <!-- Product Name Column -->
                    <TemplateColumn Context="product" Title="Product Name" SortBy="@(GridSort<ProductDto>.ByAscending(p => p.Name))" Sortable="true" Align="Align.Left">
                        <div>
                            <span class="d-block fw-semibold text-dark text-truncate" title="@product.Name">@(string.IsNullOrWhiteSpace(product.Name) ? "—" : product.Name)</span>
                        </div>
                    </TemplateColumn>

                    <!-- Unit Value Column -->
                    <TemplateColumn Context="product" Title="Unit Value" SortBy="@(GridSort<ProductDto>.ByAscending(p => p.UnitValue))" Sortable="true" Align="Align.Left">
                        @if (product.UnitValue.HasValue && product.UnitValue.Value > 0)
                        {
                            <span class="text-secondary fw-medium">@product.UnitValue.Value.ToString("0.00")</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </TemplateColumn>

                    <!-- UOM Column -->
                    <TemplateColumn Context="product" Title="UOM" SortBy="@(GridSort<ProductDto>.ByAscending(p => p.UnitOfMeasure))" Sortable="true" Align="Align.Left">
                        @if (!string.IsNullOrWhiteSpace(product.UnitOfMeasure))
                        {
                            <span class="text-secondary fw-medium">
                                @product.UnitOfMeasure
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </TemplateColumn>

                    <PropertyColumn Property="@(p => p.CategoryName)" Title="Category" Sortable="true" Align="Align.Left" />
                    <PropertyColumn Property="@(p => p.CostPrice)" Title="Cost Price" Format="C2" Sortable="true" Align="Align.Left" />
                    <PropertyColumn Property="@(p => p.Price)" Title="Price" Format="C2" Sortable="true" Align="Align.Left" />
                    
                    <TemplateColumn Context="product" Title="Status" Align="Align.Center">
                        @if (product.IsActive)
                        {
                            <span class="status-badge active">
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="status-badge inactive">
                                Inactive
                            </span>
                        }
                    </TemplateColumn>

                    <TemplateColumn Context="product" Title="Actions" Align="Align.Right">
                        <HeaderTemplate>
                            <div class="actions-header-wrap">
                                <span class="actions-header-text">Actions</span>
                            </div>
                        </HeaderTemplate>
                        <ChildContent>
                            <div class="actions-cell-wrap d-flex justify-content-end gap-2">
                                @if (product.ProductType == "MadeToOrder")
                                {
                                    <button class="btn btn-sm btn-outline-info rounded-circle p-2 me-1" @onclick="() => OpenRecipeModal(product)" title="Manage Recipe / Ingredients" aria-label="Manage Recipe / Ingredients">
                                        <i class="bi-journal-text"></i>
                                    </button>
                                }
                                <button type="button" class="btn btn-sm btn-warning text-dark" @onclick="() => OpenEditModal(product)" title="Edit Product" aria-label="Edit Product">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-danger text-white" @onclick="() => DeleteProduct(product.ProductId)" title="Delete Product" aria-label="Delete Product">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </ChildContent>
                    </TemplateColumn>
                </QuickGrid>
            </div>

            <!-- Bootstrap Pagination Bar -->
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center pt-3 mt-1 border-top gap-3">
                <div class="text-secondary small fw-medium">
                    @GetShowingRangeText()
                </div>

                <nav aria-label="Products table pagination">
                    <ul class="pagination mb-0">
                        <li class="page-item @(pagination.CurrentPageIndex == 0 ? "disabled" : "")">
                            <button type="button" class="page-link" @onclick="() => GoToPage(pagination.CurrentPageIndex - 1)" disabled="@(pagination.CurrentPageIndex == 0)" aria-label="Previous">
                                Previous
                            </button>
                        </li>

                        @for (int i = 0; i < TotalPages; i++)
                        {
                            var pageIndex = i;
                            var isActive = pagination.CurrentPageIndex == pageIndex;
                            <li class="page-item @(isActive ? "active" : "")" aria-current="@(isActive ? "page" : null)">
                                <button type="button" class="page-link" @onclick="() => GoToPage(pageIndex)">
                                    @(pageIndex + 1)
                                </button>
                            </li>
                        }

                        <li class="page-item @(pagination.CurrentPageIndex >= TotalPages - 1 ? "disabled" : "")">
                            <button type="button" class="page-link" @onclick="() => GoToPage(pagination.CurrentPageIndex + 1)" disabled="@(pagination.CurrentPageIndex >= TotalPages - 1)" aria-label="Next">
                                Next
                            </button>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- Modal Dialog with Blazor EditForm and Validation -->
@if (isModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.5); backdrop-filter: blur(3px);" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            
            <!-- EditForm acts directly as the modal-content container -->
            <EditForm Model="@currentProduct" OnValidSubmit="SaveProduct" class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <DataAnnotationsValidator />

                <!-- Modal Header -->
                <div class="modal-header border-bottom px-4 py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold text-dark mb-0">@(isEditing ? "Edit Product" : "New Product")</h5>
                        <small class="text-secondary" style="font-size: 0.85rem;">
                            @(isEditing ? "Update product details and pricing" : "Enter the details to add a new product")
                        </small>
                    </div>
                    <button type="button" class="btn-close shadow-none" @onclick="CloseModal" aria-label="Close"></button>
                </div>

                <!-- Modal Body (Scrollable) -->
                <div class="modal-body px-4 py-3">
                    
                    <!-- 1. Basic Information -->
                    <div class="mb-4">
                        <div class="d-flex align-items-center gap-2 pb-2 mb-3 border-bottom">
                            <div class="d-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded" style="width: 28px; height: 28px;">
                                <i class="bi bi-tag-fill" style="font-size: 0.85rem;"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold text-dark mb-0" style="font-size: 0.95rem;">Basic Information</h6>
                                <span class="text-secondary small" style="font-size: 0.78rem;">Product identity, category, and unit details</span>
                            </div>
                        </div>
                        <div class="row g-3">
                            <!-- Row 1: Primary Information (6 / 6) -->
                            <div class="col-12 col-md-6">
                                <label class="form-label text-dark fw-semibold small mb-1">Product Name <span class="text-danger">*</span></label>
                                <InputText @bind-Value="currentProduct.Name" class="form-control rounded" placeholder="e.g. Espresso, Chocolate Donut" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label text-dark fw-semibold small mb-1">Category <span class="text-danger">*</span></label>
                                <InputSelect @bind-Value="currentProduct.CategoryId" class="form-select rounded">
                                    <option value="0">Select Category...</option>
                                    @foreach (var cat in categories)
                                    {
                                        <option value="@cat.CategoryId">@cat.Name</option>
                                    }
                                </InputSelect>
                            </div>

                            <!-- Row 2: Specifications & Measurement (4 / 4 / 4) -->
                            <div class="col-12 col-md-4">
                                <label class="form-label text-dark fw-semibold small mb-1">Product Type</label>
                                <InputSelect @bind-Value="currentProduct.ProductType" class="form-select rounded">
                                    <option value="Standard">Standard (Stock Item)</option>
                                    <option value="MadeToOrder">Made To Order (Kitchen)</option>
                                    <option value="RawMaterial">Raw Material</option>
                                </InputSelect>
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label text-dark fw-semibold small mb-1">Unit Value</label>
                                <InputNumber @bind-Value="currentProduct.UnitValue" class="form-control rounded" placeholder="1" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label text-dark fw-semibold small mb-1">Unit of Measurement</label>
                                <InputSelect @bind-Value="currentProduct.UnitOfMeasure" class="form-select rounded">
                                    <option value="">-- None --</option>
                                    @if (availableUoms != null)
                                    {
                                        @foreach (var uom in availableUoms.Where(u => u.IsActive))
                                        {
                                            <option value="@uom.Abbreviation">@uom.Name (@uom.Abbreviation)</option>
                                        }
                                    }
                                </InputSelect>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Pricing & Taxation -->
                    <div class="mb-4">
                        <div class="d-flex align-items-center gap-2 pb-2 mb-3 border-bottom">
                            <div class="d-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success rounded" style="width: 28px; height: 28px;">
                                <i class="bi bi-cash-stack" style="font-size: 0.85rem;"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold text-dark mb-0" style="font-size: 0.95rem;">Pricing & Tax</h6>
                                <span class="text-secondary small" style="font-size: 0.78rem;">Cost price, selling price, and BIR tax classification</span>
                            </div>
                        </div>
                        <div class="row g-3">
                            <div class="col-12 col-md-4">
                                <label class="form-label text-dark fw-semibold small mb-1">Cost Price</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0">₱</span>
                                    <InputNumber @bind-Value="currentProduct.CostPrice" class="form-control rounded-end" placeholder="0.00" />
                                </div>
                                <small class="text-secondary" style="font-size: 0.72rem;">Acquisition / Supplier cost</small>
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label text-dark fw-semibold small mb-1">Selling Price <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0">₱</span>
                                    <InputNumber @bind-Value="currentProduct.Price" class="form-control rounded-end" placeholder="0.00" />
                                </div>
                                <small class="text-secondary" style="font-size: 0.72rem;">Retail price charged to customer</small>
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label text-dark fw-semibold small mb-1">Tax Class</label>
                                <InputSelect @bind-Value="currentProduct.TaxId" class="form-select rounded">
                                    <option value="">Exempt / No Tax</option>
                                    @foreach (var tax in taxes)
                                    {
                                        <option value="@tax.TaxId">@tax.Name</option>
                                    }
                                </InputSelect>
                                <small class="text-secondary" style="font-size: 0.72rem;">BIR compliance category</small>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Inventory & Identification -->
                    <div class="mb-4">
                        <div class="d-flex align-items-center gap-2 pb-2 mb-3 border-bottom">
                            <div class="d-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning-emphasis rounded" style="width: 28px; height: 28px;">
                                <i class="bi bi-box-seam" style="font-size: 0.85rem;"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold text-dark mb-0" style="font-size: 0.95rem;">Inventory & Tracking</h6>
                                <span class="text-secondary small" style="font-size: 0.78rem;">Stock counts, low stock reorder alert, and item identifiers</span>
                            </div>
                        </div>
                        <div class="row g-3">
                            <div class="col-6 col-md-6">
                                <label class="form-label text-dark fw-semibold small mb-1">SKU</label>
                                <InputText @bind-Value="currentProduct.SKU" class="form-control rounded" placeholder="e.g. SKU-101" />
                                <small class="text-secondary" style="font-size: 0.72rem;">Internal item code</small>
                            </div>
                            <div class="col-6 col-md-6">
                                <label class="form-label text-dark fw-semibold small mb-1">Barcode</label>
                                <InputText @bind-Value="currentProduct.Barcode" class="form-control rounded" placeholder="Scan or type..." />
                                <small class="text-secondary" style="font-size: 0.72rem;">UPC / EAN scanner code</small>
                            </div>
                        </div>
                    </div>

                    <!-- 4. Product Image -->
                    <div class="mb-4">
                        <div class="d-flex align-items-center gap-2 pb-2 mb-3 border-bottom">
                            <div class="d-flex align-items-center justify-content-center bg-info bg-opacity-10 text-info-emphasis rounded" style="width: 28px; height: 28px;">
                                <i class="bi bi-image" style="font-size: 0.85rem;"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold text-dark mb-0" style="font-size: 0.95rem;">Product Image</h6>
                                <span class="text-secondary small" style="font-size: 0.78rem;">Thumbnail photo displayed on POS catalog and registers</span>
                            </div>
                        </div>
                        <div class="p-3 bg-light rounded border d-flex align-items-center gap-3">
                            @if (!string.IsNullOrWhiteSpace(currentProduct.ImageUrl))
                            {
                                <div class="position-relative flex-shrink-0">
                                    <img src="@GetFullImageUrl(currentProduct.ImageUrl)" alt="Product Preview" class="rounded border object-fit-cover shadow-sm" style="width: 72px; height: 72px;" />
                                    <button type="button" class="btn btn-sm btn-danger rounded-circle position-absolute top-0 start-100 translate-middle p-0 d-flex align-items-center justify-content-center shadow" style="width: 22px; height: 22px;" @onclick="RemoveImage" title="Remove Image">
                                        &times;
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="bg-white border rounded d-flex flex-column align-items-center justify-content-center text-muted flex-shrink-0 shadow-sm" style="width: 72px; height: 72px;">
                                    <i class="bi bi-image text-secondary" style="font-size: 1.25rem;"></i>
                                    <span style="font-size: 0.65rem;" class="fw-semibold text-secondary">No Image</span>
                                </div>
                            }

                            <div class="flex-grow-1">
                                <label class="form-label text-dark fw-semibold small mb-1">Choose Photo</label>
                                <InputFile OnChange="HandleImageSelected" class="form-control rounded" accept=".jpg,.jpeg,.png,.webp" />
                                <small class="text-secondary d-block mt-1" style="font-size: 0.75rem;">Supported formats: JPG, PNG, WEBP (Max 5MB)</small>
                            </div>
                        </div>
                    </div>

                    <!-- 5. POS & Kitchen Routing Settings -->
                    <div>
                        <div class="d-flex align-items-center gap-2 pb-2 mb-3 border-bottom">
                            <div class="d-flex align-items-center justify-content-center bg-secondary bg-opacity-10 text-secondary rounded" style="width: 28px; height: 28px;">
                                <i class="bi bi-sliders" style="font-size: 0.85rem;"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold text-dark mb-0" style="font-size: 0.95rem;">POS & Kitchen Settings</h6>
                                <span class="text-secondary small" style="font-size: 0.78rem;">Configure register visibility and kitchen order routing</span>
                            </div>
                        </div>
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <div class="p-3 bg-light rounded border h-100 d-flex align-items-center justify-content-between">
                                    <div>
                                        <label class="form-check-label fw-bold text-dark mb-0 d-block" for="activeSwitch">Active in POS</label>
                                        <small class="text-secondary" style="font-size: 0.78rem;">Enable product for cashier ring-up and orders</small>
                                    </div>
                                    <div class="form-check form-switch mb-0 fs-5 ms-3">
                                        <InputCheckbox class="form-check-input" id="activeSwitch" @bind-Value="currentProduct.IsActive" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="p-3 bg-light rounded border h-100 d-flex align-items-center justify-content-between">
                                    <div>
                                        <label class="form-check-label fw-bold text-dark mb-0 d-block" for="kitchenSwitch">Route to Kitchen</label>
                                        <small class="text-secondary" style="font-size: 0.78rem;">Auto-print preparation ticket to kitchen printer</small>
                                    </div>
                                    <div class="form-check form-switch mb-0 fs-5 ms-3">
                                        <InputCheckbox class="form-check-input" id="kitchenSwitch" @bind-Value="currentProduct.IsKitchenItem" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Modal Footer -->
                <div class="modal-footer border-top bg-light px-4 py-3 d-flex justify-content-end align-items-center gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded px-4 fw-medium" @onclick="CloseModal">
                        Cancel
                    </button>
                    <button type="submit" class="btn @(isEditing ? "btn-warning text-dark" : "btn-primary") rounded px-4 fw-bold shadow-sm" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        @(isEditing ? "Save Changes" : "Create Product")
                    </button>
                </div>
            </EditForm>

        </div>
    </div>
}


<!-- Recipe / BOM Management Modal -->
@if (isRecipeModalOpen && selectedProductForRecipe != null)

{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.5); backdrop-filter: blur(3px);" role="dialog">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <div class="modal-header border-bottom px-4 py-3">
                    <div>
                        <h5 class="fw-bold mb-0">Recipe / BOM — @selectedProductForRecipe.Name</h5>
                        <small class="text-muted">Define raw material quantities required to prepare 1 serving</small>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseRecipeModal"></button>
                </div>
                <div class="modal-body px-4 py-3">
                    <!-- Inline Form to Add Raw Material -->
                    <EditForm Model="@newRecipeItem" OnValidSubmit="AddIngredientToRecipe" class="p-3 bg-light rounded-3 border mb-4">
                        <div class="row g-3 align-items-end">
                            <div class="col-12 col-md-5">
                                <label class="form-label fw-semibold small mb-1">Raw Material <span class="text-danger">*</span></label>
                                <InputSelect @bind-Value="newRecipeItem.RawMaterialProductId" class="form-select rounded-3">
                                    <option value="0">Select Ingredient...</option>
                                    @foreach (var rm in products.Where(p => p.ProductType == "RawMaterial"))
                                    {
                                        <option value="@rm.ProductId">@rm.Name (@rm.UnitOfMeasure)</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label fw-semibold small mb-1">Qty Required <span class="text-danger">*</span></label>
                                <InputNumber @bind-Value="newRecipeItem.QuantityRequired" class="form-control rounded-3" step="0.01" />
                            </div>
                            <div class="col-12 col-md-2">
                                <label class="form-label fw-semibold small mb-1">UOM</label>
                                <InputSelect @bind-Value="newRecipeItem.Uom" class="form-select rounded-3">
                                    <option value="">Unit...</option>
                                    @if (availableUoms != null)
                                    {
                                        @foreach (var uom in availableUoms.Where(u => u.IsActive))
                                        {
                                            <option value="@uom.Abbreviation">@uom.Abbreviation</option>
                                        }
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-12 col-md-2 d-grid">
                                <button type="submit" class="btn btn-primary rounded-3 fw-bold" disabled="@isRecipeSaving">
                                    Add Item
                                </button>
                            </div>
                        </div>
                    </EditForm>

                    <!-- Assigned Recipe Items Table -->
                    <div class="table-responsive border rounded-3">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Ingredient / Raw Material</th>
                                    <th class="text-center">Qty Required</th>
                                    <th class="text-center">UOM</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (recipeList.Any())
                                {
                                    @foreach (var item in recipeList)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@item.RawMaterialName</td>
                                            <td class="text-center fw-bold text-primary">@item.QuantityRequired</td>
                                            <td class="text-center">
                                                <span class="badge bg-light text-dark border">@item.Uom</span>
                                            </td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-link text-danger p-0" @onclick="() => RemoveIngredient(item.RecipeId)">Remove</button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted">No raw materials assigned to this recipe yet.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer border-top bg-light px-4 py-3">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" @onclick="CloseRecipeModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int? FilterCategoryId { get; set; }

    private List<ProductDto>? products;
    private List<CategoryDto> categories = new();
    private CategoryDto? CurrentCategory => FilterCategoryId.HasValue ? categories.FirstOrDefault(c => c.CategoryId == FilterCategoryId.Value) : null;
    private List<TaxDto> taxes = new();
    
    private PaginationState pagination = new PaginationState { ItemsPerPage = 10 };
    private string nameFilter = string.Empty;
    private List<UomDto> availableUoms = new();

    private bool isRecipeModalOpen = false;
    private bool isRecipeSaving = false;
    private ProductDto? selectedProductForRecipe;
    private List<ProductRecipeDto> recipeList = new();
    private ProductRecipeDto newRecipeItem = new();

    // Modal State
    private bool isModalOpen = false;
    private bool isEditing = false;
    private bool isSaving = false;
    private ProductDto currentProduct = new();
    private bool isUploadingImage = false;

    private IQueryable<ProductDto>? FilteredProducts =>
       string.IsNullOrWhiteSpace(nameFilter)
           ? products?.AsQueryable()
           : products?.Where(p =>
               (p.Name != null && p.Name.Contains(nameFilter, StringComparison.OrdinalIgnoreCase)) ||
               (p.SKU != null && p.SKU.Contains(nameFilter, StringComparison.OrdinalIgnoreCase)) ||
               (p.Barcode != null && p.Barcode.Contains(nameFilter, StringComparison.OrdinalIgnoreCase)) ||
               (p.UnitOfMeasure != null && p.UnitOfMeasure.Contains(nameFilter, StringComparison.OrdinalIgnoreCase))
             ).AsQueryable();

    private int TotalPages
    {
        get
        {
            var count = FilteredProducts?.Count() ?? 0;
            return Math.Max(1, (int)Math.Ceiling((double)count / pagination.ItemsPerPage));
        }
    }

    private string GetShowingRangeText()
    {
        var total = FilteredProducts?.Count() ?? 0;
        if (total == 0) return "Showing 0 items";
        int start = (pagination.CurrentPageIndex * pagination.ItemsPerPage) + 1;
        int end = Math.Min(start + pagination.ItemsPerPage - 1, total);
        return $"Showing {start}–{end} of {total} products";
    }

    private async Task GoToPage(int pageIndex)
    {
        if (pageIndex >= 0 && pageIndex < TotalPages)
        {
            await pagination.SetCurrentPageIndexAsync(pageIndex);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            categories = await CategoryService.GetCategoriesAsync();
            taxes = await TaxService.GetTaxesAsync();
            await LoadProducts();
            availableUoms = await UomService.GetUomsAsync();
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error",
                Text = "Failed to load dependencies: " + ex.Message,
                Icon = SweetAlertIcon.Error,
                ConfirmButtonText = "OK",
                ConfirmButtonColor = "#2563eb"
            });
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        try
        {
            var rawProducts = await ProductService.GetProductsAsync();
            
            if (FilterCategoryId.HasValue)
            {
                rawProducts = rawProducts.Where(p => p.CategoryId == FilterCategoryId.Value).ToList();
            }

            products = rawProducts.OrderByDescending(p => p.ProductId).ToList();
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error",
                Text = "Failed to load products: " + ex.Message,
                Icon = SweetAlertIcon.Error,
                ConfirmButtonText = "OK",
                ConfirmButtonColor = "#2563eb"
            });
        }
    }

    private void OpenAddModal()
    {
        isEditing = false;
        currentProduct = new ProductDto
        {
            IsActive = true,
            ProductType = "Standard",
            UnitValue = 1,
            UnitOfMeasure = "pc",
            CategoryId = FilterCategoryId ?? 0
        };
        isModalOpen = true;
    }

    private void OpenEditModal(ProductDto product)
    {
        isEditing = true;
        currentProduct = new ProductDto
        {
            ProductId = product.ProductId,
            CategoryId = product.CategoryId,
            Name = product.Name,
            UnitValue = product.UnitValue,
            UnitOfMeasure = product.UnitOfMeasure,
            Barcode = product.Barcode,
            SKU = product.SKU,
            ImageUrl = product.ImageUrl,
            Price = product.Price,
            CostPrice = product.CostPrice,
            TaxId = product.TaxId,
            ProductType = string.IsNullOrWhiteSpace(product.ProductType) ? "Standard" : product.ProductType,
            IsActive = product.IsActive,
            IsKitchenItem = product.IsKitchenItem
        };
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
    }

    private async Task SaveProduct()
    {
        if (isSaving) return;

        if (string.IsNullOrWhiteSpace(currentProduct.Name))
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Validation Error",
                Text = "Product name is required.",
                Icon = SweetAlertIcon.Warning,
                ConfirmButtonText = "OK",
                ConfirmButtonColor = "#2563eb"
            });
            return;
        }

        if (currentProduct.CategoryId <= 0)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Validation Error",
                Text = "Please select a category.",
                Icon = SweetAlertIcon.Warning,
                ConfirmButtonText = "OK",
                ConfirmButtonColor = "#2563eb"
            });
            return;
        }

        if (currentProduct.Price < 0)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Validation Error",
                Text = "Selling price cannot be negative.",
                Icon = SweetAlertIcon.Warning,
                ConfirmButtonText = "OK",
                ConfirmButtonColor = "#2563eb"
            });
            return;
        }

        isSaving = true;

        try
        {
            if (isEditing)
            {
                await ProductService.UpdateProductAsync(currentProduct.ProductId, currentProduct);
            }
            else
            {
                await ProductService.CreateProductAsync(currentProduct);
            }

            await LoadProducts();
            CloseModal();

            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = isEditing ? "Product Updated!" : "Product Created!",
                Text = isEditing ? "Product updated successfully." : "Product created successfully.",
                Icon = SweetAlertIcon.Success,
                ConfirmButtonText = "OK",
                ConfirmButtonColor = "#2563eb"
            });
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error",
                Text = "Failed to save product: " + ex.Message,
                Icon = SweetAlertIcon.Error,
                ConfirmButtonText = "OK",
                ConfirmButtonColor = "#2563eb"
            });
        }
        finally
        {
            isSaving = false;
        }
    }

    private string GetFullImageUrl(string? relativeUrl)
    {
        if (string.IsNullOrWhiteSpace(relativeUrl))
            return string.Empty;

        // If it's already a full web URL (e.g. external link), return as-is
        if (relativeUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            relativeUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return relativeUrl;
        }

        // Combine API Base Address with the relative path (/uploads/products/...)
        var apiBaseAddress = Http.BaseAddress?.ToString().TrimEnd('/');
        return $"{apiBaseAddress}{relativeUrl}";
    }

    private async Task HandleImageSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        // Limit size to 5MB
        if (file.Size > 5 * 1024 * 1024)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error",
                Text = "File size exceeds the 5MB limit.",
                Icon = SweetAlertIcon.Error,
                ConfirmButtonText = "OK",
                ConfirmButtonColor = "#2563eb"
            });
            return;
        }

        try
        {
            isUploadingImage = true;

            using var content = new MultipartFormDataContent();
            var streamContent = new StreamContent(file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024));
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            
            content.Add(streamContent, "file", file.Name);

            var response = await Http.PostAsync("api/Products/upload-image", content);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<UploadResult>();
                if (result != null)
                {
                    currentProduct.ImageUrl = result.ImageUrl;
                }
            }
            else
            {
                var errorMsg = await response.Content.ReadAsStringAsync();
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "Upload Failed",
                    Text = errorMsg,
                    Icon = SweetAlertIcon.Error,
                    ConfirmButtonText = "OK",
                    ConfirmButtonColor = "#2563eb"
                });
            }
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error",
                Text = $"Image upload failed: {ex.Message}",
                Icon = SweetAlertIcon.Error,
                ConfirmButtonText = "OK",
                ConfirmButtonColor = "#2563eb"
            });
        }
        finally
        {
            isUploadingImage = false;
        }
    }

    private async Task RemoveImage()
    {
        var result = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Remove Image?",
            Text = "Are you sure you want to remove the product image?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            ConfirmButtonColor = "#d33",
            CancelButtonColor = "#64748b",
            ConfirmButtonText = "Yes, remove it",
            CancelButtonText = "Cancel"
        });

        if (result.IsConfirmed)
        {
            currentProduct.ImageUrl = string.Empty;
        }
    }

    private class UploadResult
    {
        public string ImageUrl { get; set; } = string.Empty;
    }

    private async Task DeleteProduct(int id)
    {
        var result = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Are you sure?",
            Text = "You are about to delete this product. This cannot be undone!",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonColor = "#d33",
            CancelButtonColor = "#64748b",
            ConfirmButtonText = "Yes, delete it!",
            CancelButtonText = "Cancel"
        });

        if (result.IsConfirmed)
        {
            try
            {
                await ProductService.DeleteProductAsync(id);
                await LoadProducts();

                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "Deleted!",
                    Text = "The product has been removed.",
                    Icon = SweetAlertIcon.Success,
                    ConfirmButtonText = "OK",
                    ConfirmButtonColor = "#2563eb"
                });
            }
            catch (Exception ex)
            {
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "Error",
                    Text = "Failed to delete product: " + ex.Message,
                    Icon = SweetAlertIcon.Error,
                    ConfirmButtonText = "OK",
                    ConfirmButtonColor = "#2563eb"
                });
            }
        }
    }

    private async Task OpenRecipeModal(ProductDto product)
    {
        selectedProductForRecipe = product;
        newRecipeItem = new ProductRecipeDto
        {
            ProductId = product.ProductId,
            QuantityRequired = 1,
            Uom = product.UnitOfMeasure
        };
        await LoadRecipe();
        isRecipeModalOpen = true;
    }

    private async Task LoadRecipe()
    {
        if (selectedProductForRecipe != null)
        {
            recipeList = await ProductRecipeService.GetRecipeForProductAsync(selectedProductForRecipe.ProductId);
        }
    }

    private void CloseRecipeModal()
    {
        isRecipeModalOpen = false;
        selectedProductForRecipe = null;
    }

    private async Task AddIngredientToRecipe()
    {
        if (selectedProductForRecipe == null || newRecipeItem.RawMaterialProductId <= 0 || newRecipeItem.QuantityRequired <= 0) return;

        isRecipeSaving = true;
        newRecipeItem.ProductId = selectedProductForRecipe.ProductId;

        // Default UOM from raw material if left empty
        if (string.IsNullOrWhiteSpace(newRecipeItem.Uom))
        {
            var rawMat = products.FirstOrDefault(p => p.ProductId == newRecipeItem.RawMaterialProductId);
            newRecipeItem.Uom = rawMat?.UnitOfMeasure ?? "pc";
        }

        var success = await ProductRecipeService.AddIngredientAsync(newRecipeItem);
        isRecipeSaving = false;

        if (success)
        {
            newRecipeItem = new ProductRecipeDto
            {
                ProductId = selectedProductForRecipe.ProductId,
                QuantityRequired = 1
            };
            await LoadRecipe();
        }
    }

    private async Task RemoveIngredient(int recipeId)
    {
        if (await ProductRecipeService.RemoveIngredientAsync(recipeId))
        {
            await LoadRecipe();
        }
    }
}