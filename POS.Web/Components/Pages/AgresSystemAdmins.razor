@page "/agres/admins"
@using Microsoft.AspNetCore.Authorization
@using CurrieTechnologies.Razor.SweetAlert2
@using POS.Shared.Constants
@using POS.Shared.Interfaces
@using POS.Shared.Models
@inject IAgresPlatformService AgresService
@inject SweetAlertService Swal
@attribute [Authorize(Policy = PosPermissions.AgresSystemAdminPolicy)]

<PageTitle>AGRES System Admins - Platform</PageTitle>

<div class="w-100 py-2">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-3">
        <div>
            <h2 class="fw-bolder mb-1 text-dark" style="letter-spacing: -0.5px;">AGRES System Administrators</h2>
            <span class="text-secondary" style="font-size: 0.95rem;">Platform-level administrator accounts isolated from all client Users tables</span>
        </div>
        <button class="btn btn-primary rounded px-4 py-2 fw-bold shadow-sm text-nowrap" disabled="@busy" @onclick="OpenAdd">
            Add System Admin
        </button>
    </div>

    @if (loadError != null) { <div class="alert alert-danger py-2 px-3 mb-3">@loadError</div> }

    <div class="card border rounded-3 shadow-sm bg-white overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Username</th>
                        <th>Display Name</th>
                        <th>Created By</th>
                        <th>Last Login (UTC)</th>
                        <th class="text-center">Status</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr><td colspan="6" class="text-center py-4 text-muted">Loading system administrators...</td></tr>
                    }
                    else
                    {
                        @foreach (var a in admins)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold">@a.Username</td>
                                <td>@a.DisplayName</td>
                                <td class="text-secondary small">@(a.CreatedBy ?? "—")</td>
                                <td class="text-secondary small">@(a.LastLoginAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "Never")</td>
                                <td class="text-center">
                                    <span class="badge @(a.IsActive ? "bg-success" : "bg-secondary")">@(a.IsActive ? "Active" : "Inactive")</span>
                                </td>
                                <td class="text-end pe-3">
                                    <button type="button" class="btn btn-sm btn-warning text-dark" disabled="@busy" @onclick="() => OpenEdit(a)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (isAddOpen)
{
    <div class="modal fade show d-block" style="background-color: rgba(15, 23, 42, 0.5); backdrop-filter: blur(3px);" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered">
            <EditForm Model="createModel" OnValidSubmit="CreateAdmin" class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <DataAnnotationsValidator />
                <div class="modal-header border-bottom px-4 py-3 bg-white">
                    <h5 class="fw-bold mb-0">Add AGRES System Admin</h5>
                    <button type="button" class="btn-close shadow-none" disabled="@busy" @onclick="() => isAddOpen = false"></button>
                </div>
                <div class="modal-body px-4 py-3">
                    @if (modalError != null) { <div class="alert alert-danger py-2 small">@modalError</div> }
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Username <span class="text-danger">*</span></label>
                        <InputText @bind-Value="createModel.Username" class="form-control rounded bg-white border" />
                        <ValidationMessage For="@(() => createModel.Username)" class="text-danger small" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Display Name <span class="text-danger">*</span></label>
                        <InputText @bind-Value="createModel.DisplayName" class="form-control rounded bg-white border" />
                        <ValidationMessage For="@(() => createModel.DisplayName)" class="text-danger small" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-semibold small">Password (min 8 chars) <span class="text-danger">*</span></label>
                        <InputText @bind-Value="createModel.Password" type="password" class="form-control rounded bg-white border" />
                        <ValidationMessage For="@(() => createModel.Password)" class="text-danger small" />
                    </div>
                </div>
                <div class="modal-footer border-top bg-light px-4 py-3">
                    <button type="button" class="btn btn-outline-secondary rounded px-4" disabled="@busy" @onclick="() => isAddOpen = false">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded px-4 fw-bold" disabled="@busy">@(busy ? "Saving..." : "Create")</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (editingAdminId.HasValue)
{
    <div class="modal fade show d-block" style="background-color: rgba(15, 23, 42, 0.5); backdrop-filter: blur(3px);" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered">
            <EditForm Model="editModel" OnValidSubmit="UpdateAdmin" class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <DataAnnotationsValidator />
                <div class="modal-header border-bottom px-4 py-3 bg-white">
                    <h5 class="fw-bold mb-0">Edit AGRES System Admin (@editingUsername)</h5>
                    <button type="button" class="btn-close shadow-none" disabled="@busy" @onclick="() => editingAdminId = null"></button>
                </div>
                <div class="modal-body px-4 py-3">
                    @if (modalError != null) { <div class="alert alert-danger py-2 small">@modalError</div> }
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Display Name <span class="text-danger">*</span></label>
                        <InputText @bind-Value="editModel.DisplayName" class="form-control rounded bg-white border" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">New Password (Optional)</label>
                        <InputText @bind-Value="editModel.Password" type="password" class="form-control rounded bg-white border" placeholder="Leave blank to keep existing password" />
                    </div>
                    <div class="p-3 bg-light rounded-3 border d-flex justify-content-between align-items-center">
                        <span class="fw-semibold small">Active</span>
                        <div class="form-check form-switch mb-0">
                            <InputCheckbox @bind-Value="editModel.IsActive" class="form-check-input" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top bg-light px-4 py-3">
                    <button type="button" class="btn btn-outline-secondary rounded px-4" disabled="@busy" @onclick="() => editingAdminId = null">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded px-4 fw-bold" disabled="@busy">@(busy ? "Saving..." : "Save")</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private List<AgresSystemAdminDto> admins = new();
    private bool isLoading = true;
    private bool busy;
    private string? loadError;
    private bool isAddOpen;
    private int? editingAdminId;
    private string editingUsername = "";
    private CreateAgresSystemAdminDto createModel = new();
    private UpdateAgresSystemAdminDto editModel = new();
    private string? modalError;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        try { isLoading = true; admins = await AgresService.GetSystemAdminsAsync(); loadError = null; }
        catch (Exception ex) { loadError = ex.Message; }
        finally { isLoading = false; }
    }

    private void OpenAdd() { createModel = new(); modalError = null; isAddOpen = true; }
    private void OpenEdit(AgresSystemAdminDto a)
    {
        editingAdminId = a.SystemAdminId;
        editingUsername = a.Username;
        editModel = new() { DisplayName = a.DisplayName, IsActive = a.IsActive };
        modalError = null;
    }

    private async Task CreateAdmin()
    {
        if (busy) return;
        busy = true; modalError = null;
        try
        {
            var res = await AgresService.CreateSystemAdminAsync(createModel);
            if (!res.Success) { modalError = res.ErrorMessage; return; }
            isAddOpen = false;
            await Load();
            await Swal.FireAsync("Created", "AGRES System Admin created.", SweetAlertIcon.Success);
        }
        finally { busy = false; }
    }

    private async Task UpdateAdmin()
    {
        if (busy || !editingAdminId.HasValue) return;
        busy = true; modalError = null;
        try
        {
            var res = await AgresService.UpdateSystemAdminAsync(editingAdminId.Value, editModel);
            if (!res.Success) { modalError = res.ErrorMessage; return; }
            editingAdminId = null;
            await Load();
            await Swal.FireAsync("Saved", "AGRES System Admin updated.", SweetAlertIcon.Success);
        }
        finally { busy = false; }
    }
}
