@page "/inventory"
@using POS.Shared.Models
@using POS.Shared.Services
@using POS.Shared.Interfaces
@using Microsoft.AspNetCore.Components.QuickGrid
@inject IInventoryService InventoryService
@inject IBranchService BranchService
@inject HttpClient Http

<div class="container-fluid p-4">
    <!-- Header Section -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold text-dark mb-1">Branch Inventory & Stock Control</h3>
            <p class="text-secondary mb-0 small">Monitor and manage branch-specific stock levels and reorder thresholds</p>
        </div>
        
        <!-- Branch Selector Dropdown -->
        <div class="d-flex align-items-center gap-2 bg-white p-2 rounded-3 shadow-sm border">
            <span class="fw-semibold text-secondary small ms-2">Select Branch:</span>
            <select class="form-select border-0 fw-bold text-primary pe-4" style="width: auto; cursor: pointer;" value="@selectedBranchId" @onchange="OnBranchChanged">
                @foreach (var branch in branches)
                {
                    <option value="@branch.BranchId">@branch.Name (@(branch.Code ?? "No Code"))</option>
                }
            </select>
        </div>
    </div>

    <!-- Summary Statistics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-secondary small fw-semibold d-block">Total Catalog Items</span>
                        <h4 class="fw-bold text-dark mb-0">@inventoryList.Count</h4>
                    </div>
                    <div class="p-3 bg-primary-subtle text-primary rounded-circle">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8.186 1.113a.5.5 0 0 0-.372 0L1.846 3.5l2.404.961L10.404 2zm3.564 1.428L5.596 5l7.154 2.861 2.404-.961zM16 5.662l-3.996 1.599L8 4.722l-8 3.2v5.578a.5.5 0 0 0 .309.463l7 3a.5.5 0 0 0 .382 0l7-3A.5.5 0 0 0 16 13.5V5.662z" />
                        </svg>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-secondary small fw-semibold d-block">Low Stock Alerts</span>
                        <h4 class="fw-bold text-warning mb-0">@inventoryList.Count(i => i.IsLowStock && i.StockQuantity > 0)</h4>
                    </div>
                    <div class="p-3 bg-warning-subtle text-warning rounded-circle">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
                        </svg>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-secondary small fw-semibold d-block">Out of Stock Items</span>
                        <h4 class="fw-bold text-danger mb-0">@inventoryList.Count(i => i.StockQuantity == 0)</h4>
                    </div>
                    <div class="p-3 bg-danger-subtle text-danger rounded-circle">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z" />
                            <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                        </svg>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search Input -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 rounded-start-3 text-secondary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                            </svg>
                        </span>
                        <input type="text" class="form-control border-start-0 rounded-end-3" placeholder="Search product name or category..." @bind="searchTerm" @bind:event="oninput" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Inventory QuickGrid -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-secondary small mt-2">Loading inventory data...</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <QuickGrid Items="@FilteredInventory" Pagination="@pagination" Theme="commercial">
                        <!-- Thumbnail Column -->
                        <TemplateColumn Context="item" Title="Image" Align="Align.Center">
                            <div class="d-flex align-items-center justify-content-center py-1">
                                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                {
                                    <img src="@GetFullImageUrl(item.ImageUrl)" alt="@item.ProductName" class="rounded-3 border object-fit-cover shadow-sm" style="width: 42px; height: 42px;" />
                                }
                                else
                                {
                                    <div class="bg-light border rounded-3 d-flex align-items-center justify-content-center text-secondary" style="width: 42px; height: 42px;">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="text-muted" viewBox="0 0 16 16">
                                            <path d="M6.002 5.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0" />
                                            <path d="M2.002 1a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2zm12 1a1 1 0 0 1 1 1v6.5l-3.777-1.947a.5.5 0 0 0-.577.093l-3.71 3.71-2.66-1.772a.5.5 0 0 0-.63.062L1.002 12V3a1 1 0 0 1 1-1z" />
                                        </svg>
                                    </div>
                                }
                            </div>
                        </TemplateColumn>

                        <PropertyColumn Property="@(i => i.ProductName)" Title="Product Name" Sortable="true" Align="Align.Left" />
                        <PropertyColumn Property="@(i => i.CategoryName)" Title="Category" Sortable="true" Align="Align.Left" />
                        <PropertyColumn Property="@(i => i.Price)" Title="Price" Format="C2" Sortable="true" Align="Align.Left" />

                        <!-- Stock Level Column -->
                        <TemplateColumn Context="item" Title="Available Stock" SortBy="@(GridSort<BranchInventoryDto>.ByAscending(i => i.StockQuantity))" Sortable="true" Align="Align.Center">
                            <span class="badge rounded-pill px-3 py-2 fs-6 @(item.StockQuantity == 0 ? "bg-danger" : item.IsLowStock ? "bg-warning text-dark" : "bg-success")">
                                @item.StockQuantity
                            </span>
                        </TemplateColumn>

                        <!-- Reorder Threshold -->
                        <PropertyColumn Property="@(i => i.ReorderLevel)" Title="Reorder Level" Sortable="true" Align="Align.Center" />

                        <!-- Actions Column -->
                        <TemplateColumn Context="item" Title="Stock Actions" Align="Align.Right">
                            <button class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold me-2" @onclick="() => OpenAdjustModal(item)">
                                Adjust Stock / Restock
                            </button>
                        </TemplateColumn>
                    </QuickGrid>
                </div>
            }
        </div>
        <div class="card-footer bg-white border-top-0 p-3">
            <Paginator State="@pagination" />
        </div>
    </div>
</div>

<!-- Restock / Adjust Stock Modal -->
@if (isAdjustModalOpen && activeItem != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.5); backdrop-filter: blur(3px);" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <EditForm Model="@adjustmentModel" OnValidSubmit="SaveStockAdjustment" class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <div class="modal-header border-bottom px-4 py-3">
                    <h5 class="fw-bold mb-0">Adjust Stock — @activeItem.ProductName</h5>
                    <button type="button" class="btn-close" @onclick="CloseAdjustModal"></button>
                </div>
                <div class="modal-body px-4 py-3">
                    <div class="mb-3 p-3 bg-light rounded-3 border">
                        <div class="row">
                            <div class="col-6">
                                <small class="text-secondary d-block">Current Available Stock</small>
                                <span class="fw-bold fs-5 text-dark">@activeItem.StockQuantity</span>
                            </div>
                            <div class="col-6">
                                <small class="text-secondary d-block">Category</small>
                                <span class="fw-semibold text-dark">@activeItem.CategoryName</span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Adjustment Action</label>
                        <InputSelect @bind-Value="adjustmentModel.AdjustmentType" class="form-select rounded-3">
                            <option value="Add">Add Stock / Restock (+)</option>
                            <option value="Deduct">Deduct / Wastage (-)</option>
                            <option value="Set">Set Exact Quantity (=)</option>
                        </InputSelect>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Quantity</label>
                        <InputNumber @bind-Value="adjustmentModel.Quantity" class="form-control rounded-3" min="1" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Reorder Threshold Level</label>
                        <InputNumber @bind-Value="adjustmentModel.ReorderLevel" class="form-control rounded-3" min="0" />
                        <small class="text-muted">Trigger low stock alert when quantity drops to this value.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Notes / Reason</label>
                        <InputText @bind-Value="adjustmentModel.Reason" class="form-control rounded-3" placeholder="e.g. Supplier Restock, Stock Count Audit, Damaged Goods" />
                    </div>
                </div>
                <div class="modal-footer border-top bg-light px-4 py-3">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" @onclick="CloseAdjustModal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold" disabled="@isSaving">Save Stock</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private List<BranchDto> branches = new();
    private List<BranchInventoryDto> inventoryList = new();
    private int selectedBranchId = 0;
    private string searchTerm = string.Empty;
    private bool isLoading = true;
    private bool isSaving = false;

    private PaginationState pagination = new PaginationState { ItemsPerPage = 10 };

    private bool isAdjustModalOpen = false;
    private BranchInventoryDto? activeItem;
    private StockAdjustmentDto adjustmentModel = new();

    private IQueryable<BranchInventoryDto> FilteredInventory
    {
        get
        {
            var query = inventoryList.AsQueryable();
            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                query = query.Where(i => i.ProductName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                                         (i.CategoryName != null && i.CategoryName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)));
            }
            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        branches = await BranchService.GetBranchesAsync();
        if (branches.Any())
        {
            selectedBranchId = branches.First().BranchId;
            await LoadInventory();
        }
        else
        {
            isLoading = false;
        }
    }

    private async Task OnBranchChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int branchId))
        {
            selectedBranchId = branchId;
            await LoadInventory();
        }
    }

    private async Task LoadInventory()
    {
        isLoading = true;
        inventoryList = await InventoryService.GetBranchInventoryAsync(selectedBranchId);
        isLoading = false;
    }

    private void OpenAdjustModal(BranchInventoryDto item)
    {
        activeItem = item;
        adjustmentModel = new StockAdjustmentDto
        {
            BranchId = selectedBranchId,
            ProductId = item.ProductId,
            AdjustmentType = "Add",
            Quantity = 10,
            ReorderLevel = item.ReorderLevel
        };
        isAdjustModalOpen = true;
    }

    private void CloseAdjustModal() => isAdjustModalOpen = false;

    private async Task SaveStockAdjustment()
    {
        isSaving = true;
        var success = await InventoryService.AdjustStockAsync(adjustmentModel);
        isSaving = false;
        if (success)
        {
            isAdjustModalOpen = false;
            await LoadInventory();
        }
    }

    private string GetFullImageUrl(string? relativeUrl)
    {
        if (string.IsNullOrWhiteSpace(relativeUrl)) return string.Empty;
        if (relativeUrl.StartsWith("http://") || relativeUrl.StartsWith("https://")) return relativeUrl;
        var apiBaseAddress = Http.BaseAddress?.ToString().TrimEnd('/');
        return $"{apiBaseAddress}{relativeUrl}";
    }
}