@page "/terminals"
@page "/manage-terminals"
@using POS.Shared.Models
@using POS.Shared.Interfaces
@using Microsoft.AspNetCore.Components.QuickGrid
@using CurrieTechnologies.Razor.SweetAlert2
@inject ITerminalService TerminalService
@inject IOutletService OutletService
@inject IBranchService BranchService
@inject SweetAlertService Swal
@inject NavigationManager Navigation
@inject HttpClient Http

<PageTitle>Terminal Management - POS</PageTitle>

<div class="w-100 py-2">
    <!-- Header Toolbar -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-3">
        <div>
            <h2 class="fw-bolder mb-1 text-dark" style="letter-spacing: -0.5px;">Terminals</h2>
            <span class="text-secondary" style="font-size: 0.95rem;">Configure POS cashier registers, device identifiers, hardware serials, and invoice series</span>
        </div>
        
        <div>
            <button class="btn btn-primary rounded px-4 py-2 fw-bold shadow-sm text-nowrap" @onclick="OpenNewTerminalModal">
                Add New Terminal
            </button>
        </div>
    </div>

    <!-- Filter and Search Row -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-3">
        <!-- Branch & Outlet Filter -->
        <div class="d-flex flex-wrap align-items-center gap-2">
            <label class="form-label mb-0 text-secondary small fw-semibold text-nowrap">Filter:</label>
            <select class="form-select form-select-sm rounded bg-white shadow-none border" style="min-width: 180px;" value="@selectedBranchFilter" @onchange="OnBranchFilterChanged">
                <option value="0">All Branches</option>
                @if (branches != null)
                {
                    @foreach (var b in branches)
                    {
                        <option value="@b.BranchId">@b.Name (@b.Code)</option>
                    }
                }
            </select>

            <select class="form-select form-select-sm rounded bg-white shadow-none border" style="min-width: 180px;" value="@selectedOutletFilter" @onchange="OnOutletFilterChanged">
                <option value="0">All Outlets</option>
                @if (filterOutlets != null)
                {
                    @foreach (var o in filterOutlets)
                    {
                        <option value="@o.OutletId">@o.Name (@o.OutletCode)</option>
                    }
                }
            </select>
        </div>

        <!-- Search Box -->
        <div class="position-relative" style="width: 280px;">
            <i class="bi bi-search position-absolute text-muted" style="left: 12px; top: 50%; transform: translateY(-50%); pointer-events: none; font-size: 0.85rem;"></i>
            <input type="search" class="form-control form-control-sm rounded ps-4 bg-white shadow-none border"
                   placeholder="Search code, name, IP..."
                   @bind="searchTerm"
                   @bind:event="oninput" />
        </div>
    </div>

    <!-- Main Grid -->
    <div class="w-100">
        @if (isLoading)
        {
            <div class="text-center py-5 text-muted">
                <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                Loading terminals...
            </div>
        }
        else if (terminals == null || !terminals.Any())
        {
            <div class="text-center py-5 border rounded bg-white">
                <i class="bi bi-display text-muted display-4 mb-2 d-block"></i>
                <h5 class="fw-bold text-dark">No Terminals Found</h5>
                <p class="text-secondary small mb-3">Add a POS machine register assigned to an outlet location.</p>
                <button class="btn btn-sm btn-primary rounded px-3" @onclick="OpenNewTerminalModal">
                    Add New Terminal
                </button>
            </div>
        }
        else
        {
            <div class="commercial-grid table-responsive w-100">
                <QuickGrid Items="@FilteredTerminals" Pagination="@pagination" Theme="commercial">
                    <PropertyColumn Property="@(t => t.TerminalCode)" Title="Code" Sortable="true" Align="Align.Left" />
                    <PropertyColumn Property="@(t => t.Name)" Title="Terminal Name" Sortable="true" Align="Align.Left" />
                    <PropertyColumn Property="@(t => t.BranchName)" Title="Branch" Sortable="true" Align="Align.Left" />
                    <PropertyColumn Property="@(t => t.OutletName)" Title="Outlet" Sortable="true" Align="Align.Left" />
                    <TemplateColumn Title="Initial Cash Fund" Context="t" Align="Align.Right">
                        @if (t.EffectiveOpeningFund.HasValue)
                        {
                            <div class="d-flex flex-column align-items-end lh-sm">
                                <span class="fw-bold text-dark">₱@t.EffectiveOpeningFund.Value.ToString("N2")</span>
                                @if (t.OpeningFundSource == "TERMINAL_OVERRIDE")
                                {
                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle mt-1" style="font-size: 0.68rem;" title="@(string.IsNullOrEmpty(t.CashFundUpdatedBy) ? "Terminal Override" : $"Updated by {t.CashFundUpdatedBy}")">
                                        Terminal Override
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-secondary border mt-1" style="font-size: 0.68rem;">
                                        Outlet Default
                                    </span>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="badge bg-warning-subtle text-dark border border-warning-subtle" style="font-size: 0.72rem;">Not Configured</span>
                        }
                    </TemplateColumn>
                    <TemplateColumn Title="IP / Device" Context="t" Align="Align.Left">
                        @if (!string.IsNullOrEmpty(t.IpAddress))
                        {
                            <span class="font-monospace text-dark">@t.IpAddress</span>
                        }
                        else if (!string.IsNullOrEmpty(t.DeviceIdentifier))
                        {
                            <span class="font-monospace text-muted small">@t.DeviceIdentifier</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </TemplateColumn>
                    <TemplateColumn Title="BIR Series" Context="t" Align="Align.Left">
                        @if (!string.IsNullOrEmpty(t.PTUNumber) || !string.IsNullOrEmpty(t.MINNumber))
                        {
                            <div class="small lh-sm">
                                @if (!string.IsNullOrEmpty(t.PTUNumber))
                                {
                                    <div><span class="text-muted">PTU:</span> @t.PTUNumber</div>
                                }
                                @if (!string.IsNullOrEmpty(t.MINNumber))
                                {
                                    <div><span class="text-muted">MIN:</span> @t.MINNumber</div>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </TemplateColumn>
                    <TemplateColumn Title="Sync & Pairing" Context="t" Align="Align.Center">
                        <div class="d-flex flex-column gap-1 align-items-center">
                            @if (t.AllowSync)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 0.75rem;">Sync On</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle" style="font-size: 0.75rem;">Sync Off</span>
                            }
                            @if (t.IsActivationCodeUsed)
                            {
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 0.72rem;" title="Paired to Device">
                                    <i class="bi bi-phone me-1"></i>Paired
                                </span>
                            }
                            else if (!string.IsNullOrEmpty(t.ActivationCode))
                            {
                                <span class="badge bg-warning-subtle text-dark border border-warning-subtle font-monospace" style="font-size: 0.72rem;" title="One-time Activation Code">
                                    <i class="bi bi-key me-1"></i>@t.ActivationCode
                                </span>
                            }
                        </div>
                    </TemplateColumn>
                    <TemplateColumn Title="Status" Context="t" Align="Align.Center">
                        @if (t.IsActive)
                        {
                            <span class="status-badge active">Active</span>
                        }
                        else
                        {
                            <span class="status-badge inactive">Inactive</span>
                        }
                    </TemplateColumn>
                    <TemplateColumn Title="Actions" Context="t" Align="Align.Right">
                        <HeaderTemplate>
                            <div class="actions-header-wrap">
                                <span class="actions-header-text">Actions</span>
                            </div>
                        </HeaderTemplate>
                        <ChildContent>
                            <div class="actions-cell-wrap d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-sm btn-outline-info text-dark" @onclick="() => ShowActivationCodeModal(t)" title="Device Pairing & Activation Code" aria-label="Activation Code">
                                    <i class="bi bi-key-fill"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-primary text-white" @onclick="() => OpenInvoiceSequencesModal(t)" title="Invoice Sequences" aria-label="Invoice Sequences">
                                    <i class="bi bi-receipt"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-warning text-dark" @onclick="() => OpenEditTerminalModal(t)" title="Edit Terminal" aria-label="Edit Terminal">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-sm @(t.IsActive ? "btn-secondary text-white" : "btn-success text-white")" @onclick="() => ToggleTerminalActive(t)" title="@(t.IsActive ? "Deactivate Terminal" : "Activate Terminal")" aria-label="Toggle Status">
                                    <i class="bi @(t.IsActive ? "bi-pause" : "bi-play")"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-danger text-white" @onclick="() => DeleteTerminal(t)" title="Delete Terminal" aria-label="Delete Terminal">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </ChildContent>
                    </TemplateColumn>
                </QuickGrid>
            </div>

            <!-- Pagination Bar -->
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center pt-3 mt-1 border-top gap-3">
                <div class="text-secondary small fw-medium">
                    @GetShowingRangeText()
                </div>

                <nav aria-label="Terminals table pagination">
                    <ul class="pagination mb-0">
                        <li class="page-item @(pagination.CurrentPageIndex == 0 ? "disabled" : "")">
                            <button type="button" class="page-link" @onclick="() => GoToPage(pagination.CurrentPageIndex - 1)" disabled="@(pagination.CurrentPageIndex == 0)" aria-label="Previous">
                                Previous
                            </button>
                        </li>
                        @for (int i = 0; i < TotalPages; i++)
                        {
                            var pageIndex = i;
                            <li class="page-item @(pagination.CurrentPageIndex == pageIndex ? "active" : "")">
                                <button type="button" class="page-link" @onclick="() => GoToPage(pageIndex)">
                                    @(pageIndex + 1)
                                </button>
                            </li>
                        }
                        <li class="page-item @(pagination.CurrentPageIndex >= TotalPages - 1 ? "disabled" : "")">
                            <button type="button" class="page-link" @onclick="() => GoToPage(pagination.CurrentPageIndex + 1)" disabled="@(pagination.CurrentPageIndex >= TotalPages - 1)" aria-label="Next">
                                Next
                            </button>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- Create / Edit Terminal Modal -->
@if (isTerminalModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.5); backdrop-filter: blur(3px);" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <div class="modal-header border-bottom px-4 py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                            <i class="bi @(isEditingTerminal ? "bi-pencil-square text-warning" : "bi-plus-circle-fill text-primary")"></i>
                            @(isEditingTerminal ? "Edit Terminal" : "Register New Terminal")
                        </h5>
                        <small class="text-secondary" style="font-size: 0.85rem;">Configure POS register details and device identification</small>
                    </div>
                    <button type="button" class="btn-close shadow-none" @onclick="CloseTerminalModal" aria-label="Close"></button>
                </div>

                <EditForm Model="@currentTerminal" OnValidSubmit="SaveTerminal">
                    <DataAnnotationsValidator />
                    <div class="modal-body px-4 py-3">
                        @if (!string.IsNullOrEmpty(modalError))
                        {
                            <div class="alert alert-danger py-2 small rounded-3" role="alert">@modalError</div>
                        }

                        <div class="row g-3">
                            <!-- Step 1: Branch Selection -->
                            <div class="col-12 col-md-6">
                                <label class="form-label text-dark fw-semibold small mb-1">1. Select Branch *</label>
                                <select class="form-select rounded-3" value="@modalSelectedBranchId" @onchange="OnModalBranchChanged" disabled="@isEditingTerminal">
                                    <option value="0">-- Select Branch --</option>
                                    @if (branches != null)
                                    {
                                        @foreach (var b in branches)
                                        {
                                            <option value="@b.BranchId">@b.Name (@b.Code)</option>
                                        }
                                    }
                                </select>
                            </div>

                            <!-- Step 2 & 3: Outlet Selection -->
                            <div class="col-12 col-md-6">
                                <label class="form-label text-dark fw-semibold small mb-1">2. Select Outlet *</label>
                                <InputSelect @bind-Value="currentTerminal.OutletId" class="form-select rounded-3" disabled="@(modalOutlets == null || !modalOutlets.Any() || isEditingTerminal)">
                                    <option value="0">-- Select Outlet --</option>
                                    @if (modalOutlets != null)
                                    {
                                        @foreach (var o in modalOutlets)
                                        {
                                            <option value="@o.OutletId">@o.Name (@o.OutletCode)</option>
                                        }
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => currentTerminal.OutletId)" class="text-danger small" />
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label text-dark fw-semibold small mb-1">Terminal Code *</label>
                                <InputText @bind-Value="currentTerminal.TerminalCode" class="form-control rounded-3 text-uppercase" placeholder="e.g. POS-01" />
                                <ValidationMessage For="@(() => currentTerminal.TerminalCode)" class="text-danger small" />
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label text-dark fw-semibold small mb-1">Terminal Name *</label>
                                <InputText @bind-Value="currentTerminal.Name" class="form-control rounded-3" placeholder="e.g. Cashier Station 1" />
                                <ValidationMessage For="@(() => currentTerminal.Name)" class="text-danger small" />
                            </div>

                            @if (isEditingTerminal)
                            {
                                <div class="col-12">
                                    <div class="p-3 bg-light rounded-3 border">
                                        <span class="fw-bold text-dark small d-flex align-items-center gap-1.5 mb-2">
                                            <i class="bi bi-cpu text-primary"></i> Local-First Device Pairing Info
                                        </span>
                                        <div class="row g-2">
                                            <div class="col-12 col-md-6">
                                                <label class="form-label text-muted small mb-1">Client Device UUID</label>
                                                <input type="text" class="form-control form-control-sm font-monospace bg-white" readonly value="@(string.IsNullOrEmpty(currentTerminal.Uuid) ? "(Bound upon client activation)" : currentTerminal.Uuid)" />
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <label class="form-label text-muted small mb-1">Activation Code</label>
                                                <div class="d-flex gap-2">
                                                    <input type="text" class="form-control form-control-sm font-monospace fw-bold bg-white" readonly value="@currentTerminal.ActivationCode" />
                                                    <span class="badge @(currentTerminal.IsActivationCodeUsed ? "bg-success" : "bg-warning text-dark") align-self-center px-2 py-2">
                                                        @(currentTerminal.IsActivationCodeUsed ? "Paired" : "Pending")
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            <div class="col-12 col-md-6">
                                <label class="form-label text-dark fw-semibold small mb-1">Device Identifier <span class="text-muted fw-normal">(Optional)</span></label>
                                <InputText @bind-Value="currentTerminal.DeviceIdentifier" class="form-control rounded-3 font-monospace" placeholder="Unique machine ID or MAC" />
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label text-dark fw-semibold small mb-1">IP Address <span class="text-muted fw-normal">(Optional)</span></label>
                                <InputText @bind-Value="currentTerminal.IpAddress" class="form-control rounded-3 font-monospace" placeholder="e.g. 192.168.1.100" />
                            </div>

                            <div class="col-12">
                                <div class="p-3 bg-light rounded-3 border">
                                    <h6 class="fw-bold text-dark small mb-2">POS Display Settings</h6>
                                    <label for="menuDisplayMode" class="form-label text-dark fw-semibold small">Product Menu Display Mode</label>
                                    <InputSelect id="menuDisplayMode" @bind-Value="currentTerminal.MenuDisplayMode" class="form-select rounded-3" aria-describedby="menuDisplayModeHelp">
                                        <option value="@MenuDisplayMode.TextOnly">Text Only — Recommended for cashier terminals.</option>
                                        <option value="@MenuDisplayMode.ImageAndText">Image &amp; Text — Recommended for visual ordering and self-service terminals.</option>
                                    </InputSelect>
                                    <ValidationMessage For="@(() => currentTerminal.MenuDisplayMode)" class="text-danger small" />
                                    <div id="menuDisplayModeHelp" class="form-text">Applies to this terminal after its next online sign-in and reference-data refresh. Saved locally for offline use.</div>
                                </div>
                            </div>

                            <!-- Initial Cash Fund Configuration -->
                            <div class="col-12">
                                <div class="p-3 bg-light rounded-3 border">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                                        <span class="fw-bold text-dark small d-flex align-items-center gap-1.5">
                                            <i class="bi bi-cash-coin text-success"></i> Initial Cash Fund Configuration
                                        </span>
                                        @{
                                            var outletDefaultFund = GetSelectedModalOutletDefaultFund();
                                            var effectiveModalFund = useTerminalCashFundOverride ? currentTerminal.OpeningFundOverride : outletDefaultFund;
                                        }
                                        @if (effectiveModalFund.HasValue)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                Effective Fund: ₱@effectiveModalFund.Value.ToString("N2") (@(useTerminalCashFundOverride ? "Terminal Override" : "Inherited from Outlet"))
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-dark border border-warning-subtle">
                                                Effective Fund: Not Configured
                                            </span>
                                        }
                                    </div>

                                    <div class="small text-secondary mb-2">
                                        Outlet Default Fund:
                                        @if (outletDefaultFund.HasValue)
                                        {
                                            <strong class="text-dark">₱@outletDefaultFund.Value.ToString("N2")</strong>
                                        }
                                        else
                                        {
                                            <span class="text-warning-emphasis fw-semibold">Not configured on selected outlet</span>
                                        }
                                    </div>

                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" id="terminalCashFundOverrideSwitch" checked="@useTerminalCashFundOverride" @onchange="OnTerminalOverrideToggled" />
                                        <label class="form-check-label fw-semibold text-dark small" for="terminalCashFundOverrideSwitch">
                                            Enable Custom Terminal Cash Fund Override
                                        </label>
                                    </div>

                                    @if (useTerminalCashFundOverride)
                                    {
                                        <div class="mt-2">
                                            <label class="form-label text-dark fw-semibold small mb-1">Terminal Opening Cash Fund Override (₱) *</label>
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text bg-white fw-bold text-secondary">₱</span>
                                                <InputNumber @bind-Value="currentTerminal.OpeningFundOverride" class="form-control" step="0.01" min="0" placeholder="e.g. 3000.00" />
                                            </div>
                                            <ValidationMessage For="@(() => currentTerminal.OpeningFundOverride)" class="text-danger small" />
                                        </div>
                                    }

                                    @if (isEditingTerminal && !string.IsNullOrEmpty(currentTerminal.CashFundUpdatedBy))
                                    {
                                        <div class="small text-muted mt-2" style="font-size: 0.72rem;">
                                            Last cash fund update by <strong>@currentTerminal.CashFundUpdatedBy</strong>
                                            @(currentTerminal.CashFundUpdatedAt.HasValue ? $"on {currentTerminal.CashFundUpdatedAt.Value.ToLocalTime():MMM d, yyyy HH:mm}" : "")
                                        </div>
                                    }
                                    <div class="form-text" style="font-size: 0.74rem;">
                                        Changes apply to future cashier sessions only and never modify an already-open cashier shift.
                                    </div>
                                </div>
                            </div>

                            <!-- BIR Fields Section -->
                            <div class="col-12">
                                <div class="p-3 bg-light rounded-3 border">
                                    <span class="fw-bold text-dark small d-flex align-items-center gap-1.5 mb-2">
                                        <i class="bi bi-shield-check text-primary"></i> BIR Machine Registration Details
                                    </span>
                                    <div class="row g-2">
                                        <div class="col-12 col-md-4">
                                            <label class="form-label text-muted small mb-1">PTU Number</label>
                                            <InputText @bind-Value="currentTerminal.PTUNumber" class="form-control form-control-sm rounded-3" placeholder="Permit to Use #" />
                                        </div>
                                        <div class="col-12 col-md-4">
                                            <label class="form-label text-muted small mb-1">MIN Number</label>
                                            <InputText @bind-Value="currentTerminal.MINNumber" class="form-control form-control-sm rounded-3" placeholder="Machine ID #" />
                                        </div>
                                        <div class="col-12 col-md-4">
                                            <label class="form-label text-muted small mb-1">Serial Number</label>
                                            <InputText @bind-Value="currentTerminal.SerialNumber" class="form-control form-control-sm rounded-3" placeholder="Hardware Serial #" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="form-check form-switch p-3 bg-light rounded-3 border d-flex align-items-center h-100">
                                    <InputCheckbox class="form-check-input ms-0 me-3" id="terminalAllowSync" @bind-Value="currentTerminal.AllowSync" />
                                    <div>
                                        <label class="form-check-label fw-semibold text-dark mb-0 d-block" for="terminalAllowSync">Allow Online Sync</label>
                                        <small class="text-muted" style="font-size: 0.75rem;">Enable cloud &amp; back-office synchronization</small>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="form-check form-switch p-3 bg-light rounded-3 border d-flex align-items-center h-100">
                                    <InputCheckbox class="form-check-input ms-0 me-3" id="terminalActive" @bind-Value="currentTerminal.IsActive" />
                                    <div>
                                        <label class="form-check-label fw-semibold text-dark mb-0 d-block" for="terminalActive">Active Terminal</label>
                                        <small class="text-muted" style="font-size: 0.75rem;">Enable terminal for cashier sessions</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer border-top bg-light px-4 py-3 d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-light border rounded-3 px-4 py-2 fw-semibold text-secondary" @onclick="CloseTerminalModal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-3 px-4 py-2 fw-bold shadow-sm" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <span>@(isEditingTerminal ? "Save Changes" : "Register Terminal")</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- Invoice Sequences Management Modal -->
@if (isInvoiceSequencesModalOpen && activeSequenceTerminal != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.5); backdrop-filter: blur(3px);" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <div class="modal-header border-bottom px-4 py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-receipt text-primary"></i>
                            Invoice Series: @activeSequenceTerminal.Name (@activeSequenceTerminal.TerminalCode)
                        </h5>
                        <small class="text-secondary" style="font-size: 0.85rem;">Manage official invoice numbering sequences for this register</small>
                    </div>
                    <button type="button" class="btn-close shadow-none" @onclick="CloseInvoiceSequencesModal" aria-label="Close"></button>
                </div>

                <div class="modal-body px-4 py-3">
                    <!-- New Sequence Form Container -->
                    <div class="card border rounded-3 mb-4 shadow-none">
                        <div class="card-header bg-light py-2 px-3 border-bottom">
                            <span class="fw-bold small text-dark d-flex align-items-center gap-1.5">
                                <i class="bi bi-plus-circle text-primary"></i> Add New Invoice Series
                            </span>
                        </div>
                        <div class="card-body p-3">
                            <EditForm Model="@newInvoiceSequence" OnValidSubmit="SaveInvoiceSequence">
                                <DataAnnotationsValidator />
                                <div class="row g-2">
                                    <div class="col-12 col-md-6">
                                        <label class="form-label text-dark fw-semibold small mb-1">Series Code *</label>
                                        <InputText @bind-Value="newInvoiceSequence.SeriesCode" class="form-control rounded-3" placeholder="e.g. 2026-SERIES-A" />
                                        <ValidationMessage For="@(() => newInvoiceSequence.SeriesCode)" class="text-danger small" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label text-dark fw-semibold small mb-1">Prefix</label>
                                        <InputText @bind-Value="newInvoiceSequence.Prefix" class="form-control rounded-3" placeholder="e.g. INV-" />
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label class="form-label text-dark fw-semibold small mb-1">Starting Number *</label>
                                        <InputNumber @bind-Value="newInvoiceSequence.StartingNumber" class="form-control rounded-3" />
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label class="form-label text-dark fw-semibold small mb-1">Ending Number (Optional)</label>
                                        <InputNumber @bind-Value="newInvoiceSequence.EndingNumber" class="form-control rounded-3" placeholder="e.g. 100000" />
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label class="form-label text-dark fw-semibold small mb-1">Padding Length</label>
                                        <InputNumber @bind-Value="newInvoiceSequence.PaddingLength" class="form-control rounded-3" />
                                    </div>
                                    <div class="col-12 d-flex justify-content-end mt-3">
                                        <button type="submit" class="btn btn-primary rounded-3 px-4 py-2 fw-bold shadow-sm" disabled="@isSavingInvoiceSequence">
                                            @if (isSavingInvoiceSequence)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                                <span>Saving...</span>
                                            }
                                            else
                                            {
                                                <span>Save & Activate Series</span>
                                            }
                                        </button>
                                    </div>
                                </div>
                            </EditForm>
                        </div>
                    </div>

                    <!-- Historical Sequences Table -->
                    <h6 class="fw-bold text-dark mb-2">Invoice Series History</h6>
                    <div class="table-responsive border rounded bg-white">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Series Code</th>
                                    <th>Prefix</th>
                                    <th>Range</th>
                                    <th>Last Issued</th>
                                    <th>Padding</th>
                                    <th class="text-center">Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (invoiceSequences.Any())
                                {
                                    @foreach (var seq in invoiceSequences)
                                    {
                                        <tr>
                                            <td class="fw-semibold text-dark">@seq.SeriesCode</td>
                                            <td class="text-secondary small">@(string.IsNullOrWhiteSpace(seq.Prefix) ? "—" : seq.Prefix)</td>
                                            <td class="text-secondary small">@seq.StartingNumber — @(seq.EndingNumber.HasValue ? seq.EndingNumber.Value.ToString() : "Unlimited")</td>
                                            <td class="text-secondary small">@seq.LastIssuedNumber</td>
                                            <td class="text-secondary small">@seq.PaddingLength</td>
                                            <td class="text-center">
                                                @if (seq.IsActive)
                                                {
                                                    <span class="status-badge active"><i class="bi bi-check-circle-fill"></i> Active</span>
                                                }
                                                else
                                                {
                                                    <span class="status-badge inactive"><i class="bi bi-pause-circle"></i> Inactive</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                @if (!seq.IsActive)
                                                {
                                                    <button type="button" class="btn btn-sm btn-primary rounded-3 px-3 py-1 fw-semibold shadow-sm" @onclick="() => ActivateInvoiceSequence(seq.InvoiceSequenceId)">
                                                        Activate
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="text-success small fw-semibold"><i class="bi bi-check-circle-fill me-1"></i>Current</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted py-3">No invoice sequences configured for this terminal.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="modal-footer border-top bg-light px-4 py-3 d-flex justify-content-end">
                    <button type="button" class="btn btn-light border rounded-3 px-4 py-2 fw-semibold text-secondary" @onclick="CloseInvoiceSequencesModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    public int? BranchId { get; set; }

    [SupplyParameterFromQuery]
    public int? OutletId { get; set; }

    private List<TerminalDto>? terminals;
    private List<BranchDto>? branches;
    private List<OutletDto>? filterOutlets;
    private List<OutletDto>? modalOutlets;

    private int selectedBranchFilter = 0;
    private int selectedOutletFilter = 0;
    private int modalSelectedBranchId = 0;

    private string searchTerm = string.Empty;
    private bool HasActiveFilters => selectedBranchFilter > 0 || selectedOutletFilter > 0 || !string.IsNullOrWhiteSpace(searchTerm);
    private PaginationState pagination = new PaginationState { ItemsPerPage = 10 };
    private bool isLoading = true;

    private bool isTerminalModalOpen = false;
    private bool isEditingTerminal = false;
    private bool isSaving = false;
    private string? modalError;
    private TerminalDto currentTerminal = new();
    private bool useTerminalCashFundOverride = false;

    private decimal? GetSelectedModalOutletDefaultFund()
    {
        if (currentTerminal.OutletId > 0 && modalOutlets != null)
        {
            var found = modalOutlets.FirstOrDefault(o => o.OutletId == currentTerminal.OutletId);
            if (found != null) return found.DefaultOpeningFund;
        }
        return currentTerminal.OutletDefaultOpeningFund;
    }

    private void OnTerminalOverrideToggled(ChangeEventArgs e)
    {
        useTerminalCashFundOverride = e.Value is bool b && b;
        if (!useTerminalCashFundOverride)
        {
            currentTerminal.OpeningFundOverride = null;
        }
        else if (!currentTerminal.OpeningFundOverride.HasValue)
        {
            currentTerminal.OpeningFundOverride = GetSelectedModalOutletDefaultFund() ?? 0m;
        }
    }

    private bool isInvoiceSequencesModalOpen = false;
    private TerminalDto? activeSequenceTerminal;
    private List<InvoiceSequenceDto> invoiceSequences = new();
    private InvoiceSequenceDto newInvoiceSequence = new() { StartingNumber = 1, PaddingLength = 7 };
    private bool isSavingInvoiceSequence = false;

    private IQueryable<TerminalDto>? FilteredTerminals
    {
        get
        {
            if (terminals == null) return null;
            var query = terminals.AsQueryable();
            if (selectedBranchFilter > 0)
            {
                query = query.Where(t => t.BranchId == selectedBranchFilter);
            }
            if (selectedOutletFilter > 0)
            {
                query = query.Where(t => t.OutletId == selectedOutletFilter);
            }
            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                query = query.Where(t =>
                    (t.TerminalCode != null && t.TerminalCode.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                    (t.Name != null && t.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                    (t.OutletName != null && t.OutletName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                    (t.BranchName != null && t.BranchName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                    (t.IpAddress != null && t.IpAddress.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                    (t.DeviceIdentifier != null && t.DeviceIdentifier.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                );
            }
            return query;
        }
    }

    private int TotalPages
    {
        get
        {
            var count = FilteredTerminals?.Count() ?? 0;
            return Math.Max(1, (int)Math.Ceiling((double)count / pagination.ItemsPerPage));
        }
    }

    private string GetShowingRangeText()
    {
        var total = FilteredTerminals?.Count() ?? 0;
        if (total == 0) return "Showing 0 items";
        int start = (pagination.CurrentPageIndex * pagination.ItemsPerPage) + 1;
        int end = Math.Min(start + pagination.ItemsPerPage - 1, total);
        return $"Showing {start}–{end} of {total} terminals";
    }

    private async Task GoToPage(int pageIndex)
    {
        if (pageIndex >= 0 && pageIndex < TotalPages)
        {
            await pagination.SetCurrentPageIndexAsync(pageIndex);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (BranchId.HasValue && BranchId.Value > 0)
        {
            selectedBranchFilter = BranchId.Value;
        }
        if (OutletId.HasValue && OutletId.Value > 0)
        {
            selectedOutletFilter = OutletId.Value;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            branches = await BranchService.GetBranchesAsync();
            if (selectedBranchFilter > 0)
            {
                filterOutlets = await OutletService.GetOutletsAsync(selectedBranchFilter);
            }
            else
            {
                filterOutlets = await OutletService.GetOutletsAsync();
            }

            terminals = await TerminalService.GetTerminalsAsync(
                selectedOutletFilter > 0 ? selectedOutletFilter : null,
                selectedBranchFilter > 0 ? selectedBranchFilter : null);
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error",
                Text = "Failed to load terminals: " + ex.Message,
                Icon = SweetAlertIcon.Error,
                ConfirmButtonText = "OK",
                ConfirmButtonColor = "#2563eb"
            });
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnBranchFilterChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var bId))
        {
            selectedBranchFilter = bId;
            selectedOutletFilter = 0; // Reset child outlet filter
            if (bId > 0)
            {
                filterOutlets = await OutletService.GetOutletsAsync(bId);
            }
            else
            {
                filterOutlets = await OutletService.GetOutletsAsync();
            }
            await pagination.SetCurrentPageIndexAsync(0);
            await LoadData();
        }
    }

    private async Task OnOutletFilterChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var oId))
        {
            selectedOutletFilter = oId;
            await pagination.SetCurrentPageIndexAsync(0);
            await LoadData();
        }
    }

    private async Task ResetFilters()
    {
        selectedBranchFilter = 0;
        selectedOutletFilter = 0;
        searchTerm = string.Empty;
        filterOutlets = await OutletService.GetOutletsAsync();
        await pagination.SetCurrentPageIndexAsync(0);
        await LoadData();
    }

    private async Task OnModalBranchChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var bId))
        {
            modalSelectedBranchId = bId;
            currentTerminal.BranchId = bId;
            currentTerminal.OutletId = 0;
            if (bId > 0)
            {
                modalOutlets = await OutletService.GetOutletsAsync(bId);
            }
            else
            {
                modalOutlets = new();
            }
        }
    }

    private async Task OpenNewTerminalModal()
    {
        modalError = null;
        modalSelectedBranchId = selectedBranchFilter > 0 ? selectedBranchFilter : (branches?.FirstOrDefault()?.BranchId ?? 0);
        
        currentTerminal = new TerminalDto
        {
            BranchId = modalSelectedBranchId,
            OutletId = selectedOutletFilter > 0 ? selectedOutletFilter : 0,
            IsActive = true,
            AllowSync = true
        };

        if (modalSelectedBranchId > 0)
        {
            modalOutlets = await OutletService.GetOutletsAsync(modalSelectedBranchId);
        }
        else
        {
            modalOutlets = new();
        }

        isEditingTerminal = false;
        useTerminalCashFundOverride = false;
        isTerminalModalOpen = true;
    }

    private async Task OpenEditTerminalModal(TerminalDto terminal)
    {
        modalError = null;
        modalSelectedBranchId = terminal.BranchId;
        modalOutlets = await OutletService.GetOutletsAsync(terminal.BranchId);

        currentTerminal = new TerminalDto
        {
            TerminalId = terminal.TerminalId,
            BranchId = terminal.BranchId,
            OutletId = terminal.OutletId,
            TerminalCode = terminal.TerminalCode,
            Name = terminal.Name,
            DeviceIdentifier = terminal.DeviceIdentifier,
            IpAddress = terminal.IpAddress,
            PTUNumber = terminal.PTUNumber,
            MINNumber = terminal.MINNumber,
            SerialNumber = terminal.SerialNumber,
            MenuDisplayMode = terminal.MenuDisplayMode,
            IsActive = terminal.IsActive,
            Uuid = terminal.Uuid,
            ActivationCode = terminal.ActivationCode,
            IsActivationCodeUsed = terminal.IsActivationCodeUsed,
            AllowSync = terminal.AllowSync,
            OpeningFundOverride = terminal.OpeningFundOverride,
            OutletDefaultOpeningFund = terminal.OutletDefaultOpeningFund,
            CashFundUpdatedBy = terminal.CashFundUpdatedBy,
            CashFundUpdatedAt = terminal.CashFundUpdatedAt
        };
        useTerminalCashFundOverride = terminal.OpeningFundOverride.HasValue;
        isEditingTerminal = true;
        isTerminalModalOpen = true;
    }

    private void CloseTerminalModal() => isTerminalModalOpen = false;

    private async Task SaveTerminal()
    {
        if (modalSelectedBranchId <= 0)
        {
            modalError = "Please select a branch.";
            return;
        }
        if (currentTerminal.OutletId <= 0)
        {
            modalError = "Please select an outlet location.";
            return;
        }
        if (string.IsNullOrWhiteSpace(currentTerminal.TerminalCode))
        {
            modalError = "Terminal code is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(currentTerminal.Name))
        {
            modalError = "Terminal name is required.";
            return;
        }
        if (!useTerminalCashFundOverride)
        {
            currentTerminal.OpeningFundOverride = null;
        }
        else if (!currentTerminal.OpeningFundOverride.HasValue || currentTerminal.OpeningFundOverride.Value < 0m)
        {
            modalError = "Please enter a valid non-negative terminal cash fund override amount.";
            return;
        }

        try
        {
            isSaving = true;
            modalError = null;
            currentTerminal.BranchId = modalSelectedBranchId;
            currentTerminal.TerminalCode = currentTerminal.TerminalCode.Trim().ToUpperInvariant();
            currentTerminal.Name = currentTerminal.Name.Trim();

            if (isEditingTerminal)
            {
                var success = await TerminalService.UpdateTerminalAsync(currentTerminal.TerminalId, currentTerminal);
                if (success)
                {
                    isTerminalModalOpen = false;
                    await LoadData();
                    await Swal.FireAsync(new SweetAlertOptions
                    {
                        Title = "Terminal Updated!",
                        Text = "Terminal register updated successfully.",
                        Icon = SweetAlertIcon.Success,
                        ConfirmButtonText = "OK",
                        ConfirmButtonColor = "#2563eb"
                    });
                }
                else
                {
                    modalError = "Failed to update terminal. Ensure terminal code is unique.";
                }
            }
            else
            {
                var created = await TerminalService.CreateTerminalAsync(currentTerminal);
                if (created != null)
                {
                    isTerminalModalOpen = false;
                    await LoadData();
                    var code = created.ActivationCode ?? "(none)";
                    await Swal.FireAsync(new SweetAlertOptions
                    {
                        Title = "Terminal Registered!",
                        Html = $@"<div class=""text-start"">
                                    <p class=""text-secondary mb-2"">Terminal registered successfully.</p>
                                    <div class=""p-3 bg-light rounded-3 border text-center my-3"">
                                        <div class=""text-muted small mb-1"">6-Digit One-Time Activation Code</div>
                                        <div class=""display-6 fw-bold font-monospace text-primary"">{code}</div>
                                    </div>
                                    <div class=""small text-muted"">Enter this 6-digit code on the POS client during one-time device activation to bind its hardware UUID.</div>
                                  </div>",
                        Icon = SweetAlertIcon.Success,
                        ConfirmButtonText = "Done",
                        ConfirmButtonColor = "#2563eb"
                    });
                }
                else
                {
                    modalError = "Failed to register terminal. Ensure terminal code is unique.";
                }
            }
        }
        catch (Exception ex)
        {
            modalError = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ToggleTerminalActive(TerminalDto terminal)
    {
        var action = terminal.IsActive ? "deactivate" : "activate";
        var result = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = $"{(terminal.IsActive ? "Deactivate" : "Activate")} Terminal?",
            Text = terminal.IsActive
                ? "Deactivating this terminal prevents cashiers from logging into this POS register."
                : "Reactivate this terminal register for cashier transactions?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            ConfirmButtonText = $"Yes, {action}",
            ConfirmButtonColor = terminal.IsActive ? "#ef4444" : "#22c55e",
            CancelButtonText = "Cancel"
        });

        if (!result.IsConfirmed) return;

        try
        {
            var updateDto = new TerminalDto
            {
                TerminalId = terminal.TerminalId,
                BranchId = terminal.BranchId,
                OutletId = terminal.OutletId,
                TerminalCode = terminal.TerminalCode,
                Name = terminal.Name,
                DeviceIdentifier = terminal.DeviceIdentifier,
                IpAddress = terminal.IpAddress,
                PTUNumber = terminal.PTUNumber,
                MINNumber = terminal.MINNumber,
                SerialNumber = terminal.SerialNumber,
                MenuDisplayMode = terminal.MenuDisplayMode,
                IsActive = !terminal.IsActive,
                Uuid = terminal.Uuid,
                ActivationCode = terminal.ActivationCode,
                IsActivationCodeUsed = terminal.IsActivationCodeUsed,
                AllowSync = terminal.AllowSync,
                OpeningFundOverride = terminal.OpeningFundOverride
            };

            var success = await TerminalService.UpdateTerminalAsync(terminal.TerminalId, updateDto);
            if (success)
            {
                await LoadData();
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "Updated!",
                    Text = $"Terminal {action}d successfully.",
                    Icon = SweetAlertIcon.Success,
                    ConfirmButtonText = "OK",
                    ConfirmButtonColor = "#2563eb"
                });
            }
            else
            {
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "Action Failed",
                    Text = "Could not update terminal status.",
                    Icon = SweetAlertIcon.Error,
                    ConfirmButtonText = "OK",
                    ConfirmButtonColor = "#2563eb"
                });
            }
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error",
                Text = ex.Message,
                Icon = SweetAlertIcon.Error,
                ConfirmButtonText = "OK",
                ConfirmButtonColor = "#2563eb"
            });
        }
    }

    private async Task DeleteTerminal(TerminalDto terminal)
    {
        var result = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Delete Terminal?",
            Text = $"Are you sure you want to delete terminal '{terminal.Name}'? Terminals with transactional history cannot be deleted and must be deactivated instead.",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Yes, delete",
            ConfirmButtonColor = "#ef4444",
            CancelButtonText = "Cancel"
        });

        if (!result.IsConfirmed) return;

        try
        {
            var success = await TerminalService.DeleteTerminalAsync(terminal.TerminalId);
            if (success)
            {
                await LoadData();
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "Deleted!",
                    Text = "Terminal deleted successfully.",
                    Icon = SweetAlertIcon.Success,
                    ConfirmButtonText = "OK",
                    ConfirmButtonColor = "#2563eb"
                });
            }
            else
            {
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "Cannot Delete",
                    Text = "This terminal has historical transactions or invoice series. Please deactivate it instead.",
                    Icon = SweetAlertIcon.Warning,
                    ConfirmButtonText = "OK",
                    ConfirmButtonColor = "#2563eb"
                });
            }
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error",
                Text = ex.Message,
                Icon = SweetAlertIcon.Error,
                ConfirmButtonText = "OK",
                ConfirmButtonColor = "#2563eb"
            });
        }
    }

    private async Task OpenInvoiceSequencesModal(TerminalDto terminal)
    {
        activeSequenceTerminal = terminal;
        newInvoiceSequence = new InvoiceSequenceDto
        {
            TerminalId = terminal.TerminalId,
            StartingNumber = 1,
            PaddingLength = 7,
            IsActive = true
        };
        await LoadInvoiceSequences(terminal.TerminalId);
        isInvoiceSequencesModalOpen = true;
    }

    private void CloseInvoiceSequencesModal()
    {
        isInvoiceSequencesModalOpen = false;
        activeSequenceTerminal = null;
    }

    private async Task LoadInvoiceSequences(int terminalId)
    {
        try
        {
            invoiceSequences = await TerminalService.GetInvoiceSequencesAsync(terminalId);
        }
        catch
        {
            invoiceSequences = new();
        }
    }

    private async Task SaveInvoiceSequence()
    {
        if (activeSequenceTerminal == null || isSavingInvoiceSequence) return;
        if (string.IsNullOrWhiteSpace(newInvoiceSequence.SeriesCode))
        {
            await Swal.FireAsync(new SweetAlertOptions { Title = "Required", Text = "Series code is required.", Icon = SweetAlertIcon.Warning });
            return;
        }

        try
        {
            isSavingInvoiceSequence = true;
            newInvoiceSequence.TerminalId = activeSequenceTerminal.TerminalId;
            var success = await TerminalService.CreateInvoiceSequenceAsync(activeSequenceTerminal.TerminalId, newInvoiceSequence);
            if (success)
            {
                await LoadInvoiceSequences(activeSequenceTerminal.TerminalId);
                newInvoiceSequence = new InvoiceSequenceDto { TerminalId = activeSequenceTerminal.TerminalId, StartingNumber = 1, PaddingLength = 7 };
                await Swal.FireAsync(new SweetAlertOptions { Title = "Saved!", Text = "Invoice sequence created.", Icon = SweetAlertIcon.Success });
            }
            else
            {
                await Swal.FireAsync(new SweetAlertOptions { Title = "Failed", Text = "Could not create sequence. Ensure series code is unique.", Icon = SweetAlertIcon.Error });
            }
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions { Title = "Error", Text = ex.Message, Icon = SweetAlertIcon.Error });
        }
        finally
        {
            isSavingInvoiceSequence = false;
        }
    }

    private async Task ActivateInvoiceSequence(int sequenceId)
    {
        if (activeSequenceTerminal == null) return;
        try
        {
            var success = await TerminalService.ActivateInvoiceSequenceAsync(activeSequenceTerminal.TerminalId, sequenceId);
            if (success)
            {
                await LoadInvoiceSequences(activeSequenceTerminal.TerminalId);
                await Swal.FireAsync(new SweetAlertOptions { Title = "Activated!", Text = "Invoice series activated.", Icon = SweetAlertIcon.Success });
            }
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions { Title = "Error", Text = ex.Message, Icon = SweetAlertIcon.Error });
        }
    }

    private async Task ShowActivationCodeModal(TerminalDto terminal)
    {
        var statusBadge = terminal.IsActivationCodeUsed
            ? "<span class='badge bg-success'>Paired / In Use</span>"
            : "<span class='badge bg-warning text-dark'>Pending Pairing</span>";
        var devText = string.IsNullOrEmpty(terminal.DeviceIdentifier) ? "<em>Not yet bound</em>" : $"<code>{terminal.DeviceIdentifier}</code>";
        var uuidText = string.IsNullOrEmpty(terminal.Uuid) ? "<em>Not yet bound (awaiting client activation)</em>" : $"<code class='text-dark'>{terminal.Uuid}</code>";

        var actionResult = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = $"Pairing: {terminal.Name}",
            Html = $@"<div class=""text-start"">
                        <div class=""mb-2""><strong>Pairing Status:</strong> {statusBadge}</div>
                        <div class=""p-3 bg-light rounded-3 border text-center my-3"">
                            <span class=""text-secondary small d-block mb-1"">6-Digit Activation Code</span>
                            <span class=""display-6 fw-bold font-monospace text-primary tracking-widest"">{(terminal.ActivationCode ?? "------")}</span>
                        </div>
                        <div class=""small text-muted mb-1""><strong>Client Device UUID:</strong> {uuidText}</div>
                        <div class=""small text-muted mb-1""><strong>Bound Device:</strong> {devText}</div>
                        <div class=""small text-muted""><strong>Online Sync:</strong> {(terminal.AllowSync ? "Enabled" : "Disabled")}</div>
                      </div>",
            Icon = SweetAlertIcon.Info,
            ShowCancelButton = true,
            CancelButtonText = "Close",
            ConfirmButtonText = "Regenerate Code",
            ConfirmButtonColor = "#f59e0b"
        });

        if (actionResult.IsConfirmed)
        {
            await RegenerateActivationCode(terminal);
        }
    }

    private async Task RegenerateActivationCode(TerminalDto terminal)
    {
        var confirm = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Regenerate Activation Code?",
            Text = $"This will generate a new 6-digit code for '{terminal.Name}' and reset device pairing. Proceed?",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Yes, Regenerate",
            ConfirmButtonColor = "#f59e0b",
            CancelButtonText = "Cancel"
        });

        if (!confirm.IsConfirmed) return;

        try
        {
            var updated = await TerminalService.RegenerateActivationCodeAsync(terminal.TerminalId);
            if (updated != null)
            {
                await LoadData();
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "Code Regenerated!",
                    Html = $@"<div class=""text-center"">
                                <p class=""text-secondary mb-2"">New 6-Digit One-Time Activation Code:</p>
                                <div class=""display-6 fw-bold font-monospace text-primary tracking-widest my-2"">{updated.ActivationCode}</div>
                                <small class=""text-muted"">Enter this code on the register to complete device pairing.</small>
                              </div>",
                    Icon = SweetAlertIcon.Success,
                    ConfirmButtonText = "Done",
                    ConfirmButtonColor = "#2563eb"
                });
            }
            else
            {
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "Action Failed",
                    Text = "Could not regenerate activation code.",
                    Icon = SweetAlertIcon.Error
                });
            }
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error",
                Text = ex.Message,
                Icon = SweetAlertIcon.Error
            });
        }
    }
}
